play_sparking_wire_sfx = function(self)
    if not self then
        return false
    end
    local now_ms = (socket and socket.gettime and (socket.gettime() * 1000)) or (os.clock() * 1000)
    local cooldown_ms = math.max(100, math.floor(((tonumber(SPARKING_WIRE_HARD_COOLDOWN_S or 1.8) or 1.8) * 1000) + 0.5))
    local next_allowed_ms = tonumber(self.sparking_wire_next_allowed_ms or 0) or 0
    if now_ms < next_allowed_ms then
        return false
    end
    self.sparking_wire_next_allowed_ms = now_ms + cooldown_ms
    local listener_x, listener_y = get_spatial_listener_world_xy(self)
    local nearest_wx = nil
    local nearest_wy = nil
    local nearest_d2 = nil
    if self.world_grid then
        for _, cell in ipairs(self.world_grid) do
            if cell and cell.isPowered == true and cell.tileID ~= hash("empty") then
                local objects = { cell.object1, cell.object2, cell.object3 }
                local has_wiregap = false
                for _, obj in ipairs(objects) do
                    if obj and obj.name and obj.isFixed ~= true then
                        if obj.name == hash("wiregap")
                            or obj.name == hash("wireGap")
                            or obj.name == hash("wiregap_straight")
                            or obj.name == hash("wireGap_straight")
                            or obj.name == hash("wiregap_corner")
                            or obj.name == hash("wireGap_corner")
                        then
                            has_wiregap = true
                            break
                        end
                    end
                end
                if has_wiregap then
                    local wx, wy = coords_to_world_pos(cell.xCell, cell.yCell)
                    local dx = wx - listener_x
                    local dy = wy - listener_y
                    local d2 = (dx * dx) + (dy * dy)
                    if nearest_d2 == nil or d2 < nearest_d2 then
                        nearest_d2 = d2
                        nearest_wx = wx
                        nearest_wy = wy
                    end
                end
            end
        end
    end
    if nearest_wx ~= nil and nearest_wy ~= nil then
        return play_sfx_one_shot_spatial(
            self,
            "sparking_wire",
            nearest_wx,
            nearest_wy,
            tonumber(SPARKING_WIRE_SPATIAL_MIN_DIST or (CELL_WIDTH * 0.9)) or (CELL_WIDTH * 0.9),
            tonumber(SPARKING_WIRE_SPATIAL_MAX_DIST or (CELL_WIDTH * 4.0)) or (CELL_WIDTH * 4.0)
        )
    end
    play_sfx_one_shot(self, "sparking_wire")
    return true
end


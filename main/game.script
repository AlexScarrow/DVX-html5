mp_lobby_y = function(y)
    return (tonumber(y or 0) or 0) + (tonumber(MP_LOBBY_SCREEN_OFFSET_Y or 0) or 0)
end

mp_lobby_sanitize_name = function(raw_name)
    local normalized = string.lower(tostring(raw_name or "host"))
    normalized = string.gsub(normalized, "[^a-z0-9]", "")
    if normalized == "" then
        normalized = "player"
    end
    if #normalized > MP_LOBBY_NAME_MAX_CHARS then
        normalized = string.sub(normalized, 1, MP_LOBBY_NAME_MAX_CHARS)
    end
    return normalized
end

mp_lobby_name_glyph_anim_id = function(ch)
    ch = string.sub(string.lower(tostring(ch or "")), 1, 1)
    if string.match(ch, "%d") then
        return hash("score_" .. ch)
    end
    return hash("letter_" .. ch)
end

mp_lobby_count_glyph_anim_id = function(ch)
    ch = string.sub(tostring(ch or ""), 1, 1)
    if ch == "/" then
        return hash("score_slash")
    end
    return hash("score_" .. ch)
end

leaderboard_sanitize_name = function(raw_name, max_chars)
    local normalized = string.lower(tostring(raw_name or "player"))
    normalized = string.gsub(normalized, "[^a-z]", "")
    if normalized == "" then
        normalized = "player"
    end
    local cap = tonumber(max_chars or LEADERBOARD_DEBUG_NAME_MAX_CHARS_PER_ROW_MP) or LEADERBOARD_DEBUG_NAME_MAX_CHARS_PER_ROW_MP
    cap = math.max(1, cap)
    if #normalized > cap then
        normalized = string.sub(normalized, 1, cap)
    end
    return normalized
end

mp_alpha_label_from_network_id = function(network_id)
    local raw = string.lower(tostring(network_id or ""))
    if raw == "p1" then return "playerone" end
    if raw == "p2" then return "playertwo" end
    if raw == "p3" then return "playerthree" end
    if raw == "p4" then return "playerfour" end
    return mp_lobby_sanitize_name(raw)
end

multiplayer_steam_refresh_local_username = function(self)
    if not (self and self.mp_lobby) then
        return false
    end
    local raw = ""
    if self.mp_transport and self.mp_transport.steam_get_local_persona_name then
        raw = tostring(self.mp_transport.steam_get_local_persona_name() or "")
    end
    if raw ~= "" then
        self.mp_lobby.local_username = mp_lobby_sanitize_name(raw)
        return true
    end
    return false
end

mp_display_name_for_wire_id = function(self, wire_id)
    wire_id = mp_normalize_network_player_id(wire_id or "")
    if wire_id == "" then
        return mp_lobby_sanitize_name("player")
    end
    local session = multiplayer_lobby_get_active_session and multiplayer_lobby_get_active_session(self) or nil
    if type(session) == "table" and type(session.display_name_by_wire_id) == "table" then
        local stored = tostring(session.display_name_by_wire_id[wire_id] or "")
        if stored ~= "" then
            return mp_lobby_sanitize_name(stored)
        end
    end
    local local_id = mp_normalize_network_player_id(self and self.mp_state and self.mp_state.local_player_id or "")
    if wire_id == local_id and self and self.mp_lobby then
        local local_name = tostring(self.mp_lobby.local_username or "")
        if local_name ~= "" then
            return mp_lobby_sanitize_name(local_name)
        end
    end
    return mp_alpha_label_from_network_id(wire_id)
end

multiplayer_lobby_join_wire_payload = function(self, session_id, extra)
    multiplayer_lobby_ensure_runtime(self)
    multiplayer_steam_refresh_local_username(self)
    local payload = {
        session_id = tostring(session_id or ""),
        protocol_version = tostring(NET_PROTOCOL_VERSION or "1"),
        display_name = tostring(self.mp_lobby.local_username or mp_lobby_sanitize_name("guest"))
    }
    if type(extra) == "table" then
        for key, value in pairs(extra) do
            payload[key] = value
        end
    end
    return payload
end

multiplayer_lobby_offer_map_key = function(offer)
    if type(offer) ~= "table" then
        return ""
    end
    if offer.steam_discovery == true then
        local steam_lobby_id = tostring(offer.steam_lobby_id or "")
        if steam_lobby_id ~= "" then
            return "sl:" .. steam_lobby_id
        end
    end
    return tostring(offer.id or offer.session_key or "")
end

multiplayer_lobby_sync_discovery_from_steam_list = function(self, seen_lobby_ids, match_count)
    if not multiplayer_lobby_is_find_intent(self) then
        return 0
    end
    multiplayer_lobby_ensure_runtime(self)
    seen_lobby_ids = type(seen_lobby_ids) == "table" and seen_lobby_ids or {}
    match_count = tonumber(match_count or 0) or 0
    local lobby = self.mp_lobby
    lobby.discovery_list_miss_by_sl = lobby.discovery_list_miss_by_sl or {}
    for seen_sl, _ in pairs(seen_lobby_ids) do
        lobby.discovery_list_miss_by_sl[tostring(seen_sl or "")] = 0
    end
    local removed = 0
    for map_key, offer in pairs(lobby.offers_by_id or {}) do
        if type(offer) == "table" then
            local is_discovery = offer.steam_discovery == true or string.sub(tostring(map_key or ""), 1, 3) == "sl:"
            if is_discovery then
                local steam_lobby_id = tostring(offer.steam_lobby_id or "")
                if steam_lobby_id == "" and string.sub(tostring(map_key or ""), 1, 3) == "sl:" then
                    steam_lobby_id = string.sub(tostring(map_key or ""), 4)
                end
                if steam_lobby_id == "" then
                    -- Keep offers without a steam lobby id until stale prune removes them.
                elseif seen_lobby_ids[steam_lobby_id] == true then
                    lobby.discovery_list_miss_by_sl[steam_lobby_id] = 0
                else
                    local miss = (tonumber(lobby.discovery_list_miss_by_sl[steam_lobby_id] or 0) or 0) + 1
                    lobby.discovery_list_miss_by_sl[steam_lobby_id] = miss
                    if miss >= 2 then
                        lobby.offers_by_id[map_key] = nil
                        removed = removed + 1
                        local ticket_id = tostring(offer.id or offer.session_key or "")
                        if ticket_id ~= "" and lobby.offer_removed_at_ms_by_id then
                            lobby.offer_removed_at_ms_by_id[ticket_id] = nil
                        end
                    end
                end
            end
        end
    end
    if removed > 0 then
        multiplayer_debug_log(self, string.format(
            "MP STEAM GATED | discovery_prune_not_in_list removed=%d match_count=%d",
            removed,
            match_count
        ))
        multiplayer_lobby_sync_sessions_from_offers(self)
    end
    return removed
end

mp_normalize_network_player_id = function(raw_id)
    local raw = string.lower(tostring(raw_id or ""))
    if raw == "playerone" then return "p1" end
    if raw == "playertwo" then return "p2" end
    if raw == "playerthree" then return "p3" end
    if raw == "playerfour" then return "p4" end
    return raw ~= "" and raw or tostring(raw_id or "")
end

mp_network_id_for_slot = function(self, slot_player_id)
    local slot_id = tostring(slot_player_id or "")
    if slot_id == "" then
        return ""
    end
    if not (self and self.mp_state and self.mp_state.enabled) then
        return slot_id
    end
    local slot_index = tonumber(string.sub(slot_id, 2))
    if not slot_index then
        return slot_id
    end
    local host_id = tostring(self.mp_state.host_player_id or "p1")
    if multiplayer_lobby_is_host and multiplayer_lobby_is_host(self) then
        host_id = tostring(self.mp_state.local_player_id or host_id)
    end
    local ordered = {}
    ordered[1] = host_id
    for i = 1, 4 do
        local pid = "p" .. tostring(i)
        if pid ~= host_id then
            ordered[#ordered + 1] = pid
        end
    end
    return tostring(ordered[slot_index] or slot_id)
end

mp_setup_get_joined_slot_lookup = function(self)
    local joined_slots = {}
    if not (self and self.mp_state and self.mp_state.enabled) then
        joined_slots["p1"] = true
        return joined_slots
    end
    local active_offer = nil
    local active_session_id = multiplayer_lobby_get_lobby_ticket_id(self)
    if active_session_id ~= "" and active_session_id ~= "local_session" and string.sub(active_session_id, 1, 14) ~= "local_session_" then
        multiplayer_lobby_ensure_runtime(self)
        active_offer = multiplayer_lobby_get_session_by_id(self, active_session_id)
    end
    local joined_player_ids = active_offer and active_offer.joined_player_ids or nil
    if type(joined_player_ids) == "table" and #joined_player_ids > 0 then
        for _, network_player_id in ipairs(joined_player_ids) do
            local slot_player_id = multiplayer_get_slot_player_id_for_network(self, network_player_id)
            joined_slots[tostring(slot_player_id or "")] = true
        end
        local local_network_id = tostring(self.mp_state.local_player_id or "")
        if local_network_id ~= "" then
            local local_slot_id = multiplayer_get_slot_player_id_for_network(self, local_network_id)
            joined_slots[tostring(local_slot_id or "")] = true
        end
        return joined_slots
    end
    local owner_network_id = tostring((active_offer and active_offer.owner_player_id) or self.mp_state.host_player_id or "p1")
    local owner_slot_id = multiplayer_get_slot_player_id_for_network(self, owner_network_id)
    joined_slots[tostring(owner_slot_id or "p1")] = true
    return joined_slots
end

    local target = active and 1 or 0
    if target > 0 and entry.playing ~= true then
        entry.playing = true
        pcall(msg.post, entry.url, "play_sound")
        if sound and sound.play then
            pcall(sound.play, entry.url)
        end
        state.gain = 0
        if sound and sound.set_gain then
            pcall(sound.set_gain, entry.url, 0)
        end
    end
    local now_gain = tonumber(state.gain or 0) or 0
    if target >= now_gain then
        now_gain = math.min(target, now_gain + ((tonumber(dt or 0) or 0) * 5))
    else
        local fade_out_s = math.max(0.05, tonumber(DEMO_LOSE_MUSIC_FADE_OUT_S or 5.0) or 5.0)
        now_gain = math.max(target, now_gain - ((tonumber(dt or 0) or 0) * (1 / fade_out_s)))
    end
    state.gain = now_gain
    state.target = target
    if entry.playing == true and sound and sound.set_gain then
        pcall(sound.set_gain, entry.url, now_gain)
    end
    if target <= 0 and entry.playing == true and now_gain <= 0.001 then
        entry.playing = false
        pcall(msg.post, entry.url, "stop_sound")
        if sound and sound.stop then
            pcall(sound.stop, entry.url)
        end
    end
    self.sfx_state.demo_lose_music_state = state
end

play_sfx_one_shot = function(self, key)
    if not self or not self.sfx_state then
        return
    end
    if self.sfx_state.loops ~= true then
        return
    end
    if self.sfx_state.enabled_by_key and self.sfx_state.enabled_by_key[key] ~= true then
        return
    end
    local entry = self.sfx_state[key]
    if not entry or not entry.url then
        return
    end
    pcall(msg.post, entry.url, "play_sound")
end

play_human_shoot_sfx = function(self, world_x, world_y)
    if self and self.sfx_state then
        self.sfx_state.music_combat_hold_s = math.max(
            tonumber(self.sfx_state.music_combat_hold_s or 0) or 0,
            tonumber(ADAPTIVE_MUSIC_COMBAT_HOLD_S or 1.5) or 1.5
        )
    end
    local roll = math.random(1, 2)
    local shot_key = (roll == 2) and "human_shoot_2" or "human_shoot"
    local has_world = world_x ~= nil and world_y ~= nil
    if has_world then
        local played = play_sfx_one_shot_spatial(
            self,
            shot_key,
            world_x,
            world_y,
            tonumber(HUMAN_SHOOT_SPATIAL_MIN_DIST or (CELL_WIDTH * 0.7)) or (CELL_WIDTH * 0.7),
            tonumber(HUMAN_SHOOT_SPATIAL_MAX_DIST or (CELL_WIDTH * 5.0)) or (CELL_WIDTH * 5.0)
        )
        if played then
            return
        end
    end
    if roll == 2 then
        play_sfx_one_shot(self, "human_shoot_2")
    else
        play_sfx_one_shot(self, "human_shoot")
    end
end


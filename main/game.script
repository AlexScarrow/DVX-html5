            if window.set_resizable then
                pcall(window.set_resizable, true)
            end
            -- Prefer fullscreen startup for desktop distribution.
            if window.set_fullscreen then
                pcall(window.set_fullscreen, true)
            elseif window.set_maximized then
                pcall(window.set_maximized, true)

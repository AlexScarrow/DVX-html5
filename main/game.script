        sfx_key = "sarge_confirm_select"
    elseif class_id == UNIT_CLASS_TECHIE then
        sfx_key = "techie_confirm_select"
    elseif class_id == UNIT_CLASS_MEDIC then
        sfx_key = "medic_confirm_select"
    elseif class_id == UNIT_CLASS_GUNNER then
        sfx_key = "gunner_confirm_select"
    end
    if not sfx_key then
        return
    end
    if wx ~= nil and wy ~= nil then
        local played = play_sfx_one_shot_spatial(
            self,
            sfx_key,
            wx,
            wy,
            tonumber(HUMAN_CONFIRM_SPATIAL_MIN_DIST or (CELL_WIDTH * 0.7)) or (CELL_WIDTH * 0.7),
            tonumber(HUMAN_CONFIRM_SPATIAL_MAX_DIST or (CELL_WIDTH * 4.8)) or (CELL_WIDTH * 4.8)
        )
        if played then
            return
        end
    end
    play_sfx_one_shot(self, sfx_key)
end


has_powered_wiregap_object = function(self)
    if not self or not self.world_grid then
        return false
    end
    for _, cell in ipairs(self.world_grid) do
        if cell and cell.isPowered == true and cell.tileID ~= hash("empty") then
            local objects = { cell.object1, cell.object2, cell.object3 }
            for _, obj in ipairs(objects) do
                if obj and obj.name and obj.isFixed ~= true then
                    if obj.name == hash("wiregap")
                        or obj.name == hash("wireGap")
                        or obj.name == hash("wiregap_straight")
                        or obj.name == hash("wireGap_straight")
                        or obj.name == hash("wiregap_corner")
                        or obj.name == hash("wireGap_corner")
                    then
                        return true
                    end
                end
            end
        end
    end
    return false
end

update_sparking_wire_ambient_sfx = function(self, dt)
    if not self or (self.game_flow_state or FLOW_STATE_GAME) ~= FLOW_STATE_GAME then
        return
    end
    if self.realtime_rules_enabled ~= true and self.alien_turn_active then
        -- Keep timing stable during heavy turn-phase transitions.
        return
    end
    local has_powered_wiregap = has_powered_wiregap_object(self)
    if not has_powered_wiregap then
        self.sparking_wire_timer_s = nil
        self.sparking_wire_next_allowed_ms = nil
        return
    end
    local min_i = math.max(0.2, tonumber(SPARKING_WIRE_MIN_INTERVAL_S or 1.2) or 1.2)
    local max_i = math.max(min_i, tonumber(SPARKING_WIRE_MAX_INTERVAL_S or min_i) or min_i)
    if self.sparking_wire_timer_s == nil then
        self.sparking_wire_timer_s = min_i + (math.random() * (max_i - min_i))
        return
    end
    self.sparking_wire_timer_s = (tonumber(self.sparking_wire_timer_s or 0) or 0) - (tonumber(dt or 0) or 0)
    if self.sparking_wire_timer_s <= 0 then
        play_sparking_wire_sfx(self)
        self.sparking_wire_timer_s = min_i + (math.random() * (max_i - min_i))
    end
end

play_human_item_recieve_sfx = function(self, unit)
    local wx = nil
    local wy = nil
    if unit and unit.go_path then
        local pos = go.get_position(unit.go_path)
        if pos then
            wx = pos.x
            wy = pos.y

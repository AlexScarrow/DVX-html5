    self.civilian_shadow_visuals = {}
    self.civilian_hp_bar_bg_visuals = {}
    self.civilian_hp_bar_fill_visuals = {}
    self.civilian_hp_bar_bg_visuals = {}
    self.civilian_hp_bar_fill_visuals = {}

    spawn_visuals(self)
    if CLEANSE_RUNTIME and CLEANSE_RUNTIME.cleanse_initialize_for_level then
        CLEANSE_RUNTIME.cleanse_initialize_for_level(self)
    end
    refresh_cleanse_global_blocked_cells(self)
    apply_aesthetic_mode(self)
    setup_startup_room_tile_fade(self)
    if self.spawn_human_unit_fn then
        self.spawn_human_unit_fn(self)
    else
        spawn_human_unit(self)
    end
    center_camera_on_living_humans_max_zoom_out(self)
    spawn_initial_blips(self, INITIAL_BLIP_COUNT)
    spawn_civilians_for_current_mission(self)
    refresh_civilian_visuals(self)
    print("SCORE TRACE READY | scoring runtime initialized")
    score_log_snapshot(self, "level_reset")
    spawn_exit_test_stash(self)
    LOOT_RUNTIME.refresh_exit_objective_state(self)
    refresh_dna_marker_runtime(self)
    update_human_visual_state(self)
    update_selected_unit_ui(self)
    if self.mp_state and self.mp_state.enabled then
        multiplayer_enforce_controlled_unit(self, true)
    end
    if loading_tutorial == true then
        tutorial_set_current_step(self, self.tutorial_step_index or 1)
    end
    if holdout_reset_runtime then
        holdout_reset_runtime(self)
    end
    log_runtime_reference_audit(self, "post_load")
    print("Loaded level " .. tostring(level_index))
    return true
end

function reset_and_load_level(self, level_index, defer_spawn)
    if not self.level_library or not self.level_library[level_index] then
        print("Level index not found: " .. tostring(level_index))
        return false
    end

    self.current_level_index = level_index
    local level_def = self.level_library and self.level_library[level_index] or nil
    local level_mission = get_level_mission_type(level_def)
    self.current_mission_type = multiplayer_normalize_mission_type(
        self.selected_mission_type or (self.mp_state and self.mp_state.mission_type) or level_mission
    )
    if self and self.sfx_state then
        self.sfx_state.vertical_active_by_unit = {}
        self.sfx_state.vertical_active_count = 0
        self.sfx_state.horizontal_active_by_actor = {}
        self.sfx_state.horizontal_active_count = 0
        self.sfx_state.speedy_active_count = 0
        set_sound_loop_state(self, "human_vertical", false)
        set_sound_loop_state(self, "human_horizontal", false)
        set_sound_loop_state(self, "furnace_fire", false)
        set_sound_loop_state(self, "demo_win_music", false)
        set_sound_loop_state(self, "demo_lose_music", false)
        stop_speedy_move_sfx(self)
    end
    if self.mp_state and self.mp_state.enabled then
        self.mp_state.mission_type = self.current_mission_type
        self.mp_state.match_end_dispatched = false
        self.mp_state.match_end_last_event_id = ""
    end
    log_runtime_reference_audit(self, "pre_clear")
    clear_path_visuals(self)
    self.selected_start_cell = nil
    self.furnace_tile_instances = nil
    self.furnace_runtime = {}
    self.furnace_active_cells = {}
    furnace_clear_debug_markers(self)
    furnace_clear_fire_fx(self)
    furnace_clear_flail_corpses(self)
    self.path_highlight_cells = {}
    self.ui_close_on_next_non_unit_click = false
    self.awaiting_slot_shuffle_click = false
    self.startup_room_tile_fade = nil
    clear_ranged_hit_preview(self)

    local function safe_delete(go_id)
        if go_id then
            pcall(go.delete, go_id)
        end
    end
    local function safe_delete_map(map_table)
        if not map_table then
            return
        end
        for key, go_id in pairs(map_table) do
            safe_delete(go_id)
            map_table[key] = nil
        end
    end
    local function safe_delete_array(list_table)
        if not list_table then
            return
        end
        for i, go_id in ipairs(list_table) do
            safe_delete(go_id)
            list_table[i] = nil
        end
    end

    if self.sheen_overlay then
        go.delete(self.sheen_overlay)
        self.sheen_overlay = nil
    end
    if self.table_sweep_shadow_overlay then
        go.delete(self.table_sweep_shadow_overlay)
        self.table_sweep_shadow_overlay = nil
        self.table_sweep_shadow_anim = nil
    end
    if self.world_backdrop then
        go.delete(self.world_backdrop)
        self.world_backdrop = nil
        self.world_backdrop_anim = nil
    end
    if self.world_backdrop_dice then
        go.delete(self.world_backdrop_dice)
        self.world_backdrop_dice = nil
    end
    if self.backdrop_cloud_fx then
        go.delete(self.backdrop_cloud_fx)
        self.backdrop_cloud_fx = nil
    end
    if self.world_backdrop_tiles then
        safe_delete_array(self.world_backdrop_tiles)
        self.world_backdrop_anim = nil
    end
    self.tile_base_objects = nil
    safe_delete_array(tile_objects)
    safe_delete_map(self.tile_room_shadows)
    safe_delete_map(self.entry_fire_fx_objects)
    safe_delete_map(self.exit_green_smoke_fx_objects)
    safe_delete_map(cell_objects)
    safe_delete_map(loot_objects)
    safe_delete_map(self.loot_shadow_objects)
    safe_delete_map(machine_objects)
    safe_delete_map(self.tile_light_layers)
    safe_delete_map(self.tile_alpha_layers)
    safe_delete(self.alien_turn_overlay)
    self.alien_turn_overlay = nil
    safe_delete_map(self.fix_objects)
    safe_delete_map(self.power_node_objects)
    safe_delete_map(self.vent_objects)
    safe_delete_map(self.door_objects)
    safe_delete_map(self.civilian_visuals)
    safe_delete_map(self.civilian_shadow_visuals)
    safe_delete_map(self.civilian_hp_bar_bg_visuals)
    safe_delete_map(self.civilian_hp_bar_fill_visuals)
    safe_delete_map(self.machine_shadow_objects)
    safe_delete_map(self.turret_shadow_objects)
    safe_delete_map(self.power_node_shadow_objects)
    safe_delete_array(self.escape_pod_power_slot_markers)
    safe_delete_map(self.vent_shadow_objects)
    safe_delete_map(self.door_shadow_objects)
    safe_delete_map(self.turret_tripod_objects)
    safe_delete_map(self.turret_gun_objects)
    safe_delete_array(self.wiregap_objects)
    safe_delete_array(self.wiregap_shadow_objects)
    safe_delete_array(self.wiregap_fx_objects)
    safe_delete_array(self.light_value_objects)
    safe_delete_array(self.dna_lab_progress_markers)
    safe_delete_map(self.ladder_markers)
    safe_delete_array(self.workshop_conveyor_tokens)
    safe_delete_map(self.workshop_underlay_visuals)
    self.workshop_states = {}
    if self.aliens then
        for _, alien in ipairs(self.aliens) do
            delete_brute_ghost_fx(alien)
            safe_delete(alien and alien.go_id)
        end
    end
    if self.spitter_projectiles then
        for _, p in ipairs(self.spitter_projectiles) do
            if p and p.go_id then
                go.delete(p.go_id)
            end
        end
    end
    if self.turret_projectiles then
        for _, p in ipairs(self.turret_projectiles) do
            if p and p.go_id then
                go.delete(p.go_id)
            end
        end
    end

    if self.world_item_visuals then
        for _, go_id in pairs(self.world_item_visuals) do
            if go_id then
                go.delete(go_id)
            end
        end
    end
    if self.world_item_shadow_visuals then
        for _, go_id in pairs(self.world_item_shadow_visuals) do
            if go_id then
                go.delete(go_id)
            end
        end
    end
    if self.power_node_loop_fx then
        for _, fx_id in pairs(self.power_node_loop_fx) do
            if fx_id then
                go.delete(fx_id)
            end
        end
    end
    if self.melee_swipe_fx then
        for _, fx in pairs(self.melee_swipe_fx) do
            if fx and fx.go_id then
                go.delete(fx.go_id)
            end
        end
    end

    if defer_spawn == true then
        self.pending_level_load = self.pending_level_load or {}
        self.pending_level_load.level_index = level_index
        self.pending_level_load.frames_until_spawn = 1
        print(string.format("Level load deferred after clear -> level %d", level_index))
        return true
    end

    return finish_level_load_after_clear(self, level_index)
end

local function get_level_button_screen_x(level_index)
    return LEVEL1_BUTTON_X + ((level_index - 1) * (LEVEL_BUTTON_W + LEVEL_BUTTON_GAP))
end

function update_global_ui_buttons(self)
    if (self.game_flow_state or FLOW_STATE_GAME) ~= FLOW_STATE_GAME then
        local hidden = vmath.vector4(0, 0, 0, 0)
        set_ui_square_transform(self, self.ui.new_turn_button, -9999, -9999, NEW_TURN_BUTTON_Z, hidden, NEW_TURN_BUTTON_W, NEW_TURN_BUTTON_H)
        if self.ui.ready_buttons then
            for _, btn in ipairs(self.ui.ready_buttons) do
                set_ui_square_transform(self, btn, -9999, -9999, MULTIPLAYER_READY_BUTTON_Z, hidden, MULTIPLAYER_READY_ICON_DRAW_SIZE * 0.021, MULTIPLAYER_READY_ICON_DRAW_SIZE * 0.021)
            end
        end
        if self.ui.mp_debug_player_buttons then
            for _, btn in ipairs(self.ui.mp_debug_player_buttons) do
                set_ui_square_transform(self, btn, -9999, -9999, MULTIPLAYER_DEBUG_BUTTON_Z, hidden, MULTIPLAYER_DEBUG_BUTTON_DRAW_SIZE * 0.021, MULTIPLAYER_DEBUG_BUTTON_DRAW_SIZE * 0.021)
            end
        end
        set_ui_square_transform(self, self.ui.launch_button, -9999, -9999, LAUNCH_BUTTON_Z, hidden, LAUNCH_BUTTON_W, LAUNCH_BUTTON_H)
        set_ui_square_transform(self, self.ui.launch_button_art, -9999, -9999, LAUNCH_BUTTON_Z + 0.001, hidden, 1, (LAUNCH_BUTTON_H * 0.021) * 0.75)
        set_ui_square_transform(self, self.ui.exit_button, -9999, -9999, EXIT_BUTTON_Z + 0.001, hidden, 1, 1)
        set_ui_square_transform(self, self.ui.exit_button_debug_hitbox, -9999, -9999, EXIT_BUTTON_Z + 0.03, hidden, EXIT_BUTTON_W, EXIT_BUTTON_H)
        set_ui_square_transform(self, self.ui.lag_sim_button, -9999, -9999, EXIT_BUTTON_Z + 0.001, hidden, MP_LAG_SIM_BUTTON_W, MP_LAG_SIM_BUTTON_H)
        set_ui_square_transform(self, self.ui.realtime_toggle_button, -9999, -9999, LAUNCH_BUTTON_Z, hidden, REALTIME_TOGGLE_BUTTON_DRAW_W * 0.021, REALTIME_TOGGLE_BUTTON_DRAW_H * 0.021)
        set_ui_square_transform(self, self.ui.aesthetic_toggle_button, -9999, -9999, AESTHETIC_BUTTON_Z, hidden, AESTHETIC_BUTTON_W, AESTHETIC_BUTTON_H)
        set_ui_square_transform(self, self.ui.aesthetic_toggle_button_art, -9999, -9999, AESTHETIC_BUTTON_Z + 0.001, hidden, 1, 1)
        set_ui_square_transform(self, self.ui.zoom_in_button, -9999, -9999, ZOOM_IN_BUTTON_Z, hidden, ZOOM_IN_BUTTON_W, ZOOM_IN_BUTTON_H)
        set_ui_square_transform(self, self.ui.zoom_out_button, -9999, -9999, ZOOM_OUT_BUTTON_Z, hidden, ZOOM_OUT_BUTTON_W, ZOOM_OUT_BUTTON_H)
        set_ui_square_transform(self, self.ui.zoom_slider_track, -9999, -9999, ZOOM_SLIDER_Z, hidden, 1, 1)
        set_ui_square_transform(self, self.ui.zoom_slider_knob, -9999, -9999, ZOOM_SLIDER_Z + 0.001, hidden, 1, 1)
        set_ui_square_transform(self, self.ui.transport_status_dot, -9999, -9999, MP_NET_STATUS_DOT_Z, hidden, MP_NET_STATUS_DOT_W, MP_NET_STATUS_DOT_H)
        update_objective_ui(self, false)
        update_score_hud(self, false)
        update_mp_build_hud(self, true)
        return
    end
    local tutorial_locked = tutorial_rules_locked and tutorial_rules_locked(self)
    local alien_cycle_active = self.alien_turn_active
        or self.pending_spitter_attack_phase
        or self.pending_melee_attack_phase
        or any_alien_is_moving(self)
        or (self.mp_state
            and self.mp_state.enabled
            and self.mp_state.local_player_id ~= self.mp_state.host_player_id
            and self.mp_state.client_alien_activity_visible == true)
    if self.mp_state
        and self.mp_state.enabled
        and self.mp_state.local_player_id == self.mp_state.host_player_id
    then
        local activity_state = alien_cycle_active == true
        if self.mp_state.last_broadcast_alien_activity_state ~= activity_state then
            self.mp_state.last_broadcast_alien_activity_state = activity_state
            multiplayer_transport_broadcast_event(self, "alien_activity_state", {
                active = activity_state
            })
        end
    end
    if alien_cycle_active then
        self.new_turn_button_mode = "alien_activity"
        set_ui_square_transform(
            self,
            self.ui.new_turn_button,
            NEW_TURN_BUTTON_X,
            NEW_TURN_BUTTON_Y,
            NEW_TURN_BUTTON_Z,
            vmath.vector4(1, 1, 1, 1),
            NEW_TURN_BUTTON_VISUAL_SCALE,
            NEW_TURN_BUTTON_VISUAL_SCALE
        )
        update_multiplayer_new_turn_button_visual(self)
    elseif self.realtime_rules_enabled == true then
        self.new_turn_button_mode = "hidden"
        set_ui_square_transform(
            self,
            self.ui.new_turn_button,
            -9999,
            -9999,
            NEW_TURN_BUTTON_Z,
            vmath.vector4(0, 0, 0, 0),
            NEW_TURN_BUTTON_W,
            NEW_TURN_BUTTON_H
        )
        update_multiplayer_new_turn_button_visual(self)
    elseif tutorial_locked then
        self.new_turn_button_mode = "tutorial_locked"
        set_ui_square_transform(
            self,
            self.ui.new_turn_button,
            NEW_TURN_BUTTON_X,
            NEW_TURN_BUTTON_Y,
            NEW_TURN_BUTTON_Z,
            vmath.vector4(0.85, 0.2, 0.2, 0.95),
            NEW_TURN_BUTTON_VISUAL_SCALE,
            NEW_TURN_BUTTON_VISUAL_SCALE
        )
        update_multiplayer_new_turn_button_visual(self)
    else
        self.new_turn_button_mode = "standard"
        local new_turn_button_w = NEW_TURN_BUTTON_VISUAL_SCALE
        local new_turn_button_h = NEW_TURN_BUTTON_VISUAL_SCALE
        if self.mp_state and self.mp_state.enabled and self.mp_state.local_player_id ~= self.mp_state.host_player_id then
            new_turn_button_w = 1.0
            new_turn_button_h = 1.0
        end
        set_ui_square_transform(
            self,
            self.ui.new_turn_button,
            NEW_TURN_BUTTON_X,
            NEW_TURN_BUTTON_Y,
            NEW_TURN_BUTTON_Z,
            vmath.vector4(1, 1, 1, 1),
            new_turn_button_w,
            new_turn_button_h
        )
        update_multiplayer_new_turn_button_visual(self)
    end
    if self.ui.ready_buttons then
        local hidden = vmath.vector4(0, 0, 0, 0)
        if self.mp_state and self.mp_state.enabled and self.mp_state.local_player_id == self.mp_state.host_player_id and self.mp_state.required_ready_player_ids then
            for i, btn in ipairs(self.ui.ready_buttons) do
                local player_id = self.mp_state.required_ready_player_ids[i]
                if player_id then
                    local ready_on = self.mp_state.ready_by_player_id[player_id] == true
                    local color = ready_on and vmath.vector4(0.2, 0.8, 0.3, 0.95) or vmath.vector4(0.75, 0.2, 0.2, 0.95)
                    local bx = get_multiplayer_ready_button_x(i)
                    set_ui_square_transform(self, btn, bx, MULTIPLAYER_READY_BUTTON_Y, MULTIPLAYER_READY_BUTTON_Z, color, MULTIPLAYER_READY_ICON_DRAW_SIZE * 0.021, MULTIPLAYER_READY_ICON_DRAW_SIZE * 0.021)
                else
                    set_ui_square_transform(self, btn, -9999, -9999, MULTIPLAYER_READY_BUTTON_Z, hidden, MULTIPLAYER_READY_ICON_DRAW_SIZE * 0.021, MULTIPLAYER_READY_ICON_DRAW_SIZE * 0.021)
                end
            end
        else
            for _, btn in ipairs(self.ui.ready_buttons) do
                set_ui_square_transform(self, btn, -9999, -9999, MULTIPLAYER_READY_BUTTON_Z, hidden, MULTIPLAYER_READY_ICON_DRAW_SIZE * 0.021, MULTIPLAYER_READY_ICON_DRAW_SIZE * 0.021)
            end
        end
    end
    if self.ui.mp_debug_player_buttons then
        local hidden = vmath.vector4(0, 0, 0, 0)
        local can_show_debug_switch = self.mp_state
            and self.mp_state.enabled
            and self.mp_state.local_player_id == self.mp_state.host_player_id
        if can_show_debug_switch and self.mp_state.required_ready_player_ids then
            for i, btn in ipairs(self.ui.mp_debug_player_buttons) do
                local by = MULTIPLAYER_DEBUG_BUTTON_START_Y - ((i - 1) * MULTIPLAYER_DEBUG_BUTTON_Y_GAP)
                local player_id = self.mp_state.required_ready_player_ids[i]
                if player_id then
                    local remote_connected = (player_id ~= self.mp_state.host_player_id)
                        and multiplayer_is_match_player_connected(self, player_id)
                    local active = self.mp_state.debug_active_player_id == player_id
                    local tint = nil
                    if remote_connected then
                        tint = vmath.vector4(0.4, 0.4, 0.4, 0.7)
                    else
                        tint = active and vmath.vector4(0.2, 0.95, 1, 0.95) or vmath.vector4(1, 1, 1, 0.9)
                    end
                    set_ui_square_transform(self, btn, MULTIPLAYER_DEBUG_BUTTON_X, by, MULTIPLAYER_DEBUG_BUTTON_Z, tint, MULTIPLAYER_DEBUG_BUTTON_DRAW_SIZE * 0.021, MULTIPLAYER_DEBUG_BUTTON_DRAW_SIZE * 0.021)
                    msg.post(msg.url(nil, btn, "sprite"), "play_animation", { id = hash("score_" .. tostring(i + 1)) })
                else
                    set_ui_square_transform(self, btn, -9999, -9999, MULTIPLAYER_DEBUG_BUTTON_Z, hidden, MULTIPLAYER_DEBUG_BUTTON_DRAW_SIZE * 0.021, MULTIPLAYER_DEBUG_BUTTON_DRAW_SIZE * 0.021)
                end
            end
        else
            for _, btn in ipairs(self.ui.mp_debug_player_buttons) do
                set_ui_square_transform(self, btn, -9999, -9999, MULTIPLAYER_DEBUG_BUTTON_Z, hidden, MULTIPLAYER_DEBUG_BUTTON_DRAW_SIZE * 0.021, MULTIPLAYER_DEBUG_BUTTON_DRAW_SIZE * 0.021)
            end
        end
    end
    local launch_status = LOOT_RUNTIME.get_launch_status and LOOT_RUNTIME.get_launch_status(self) or nil
    local holdout_survival_pending = holdout_has_survived_pending_confirmation(self)
    local launch_enabled = self.game_won or holdout_survival_pending or (launch_status and launch_status.can_launch)
    local client_no_launch_authority = self.mp_state and self.mp_state.enabled and self.mp_state.local_player_id ~= self.mp_state.host_player_id
    if client_no_launch_authority then
        launch_enabled = false
    end
    local launch_anim = launch_enabled and hash("launch_button") or hash("disabled_button")
    if holdout_survival_pending and not client_no_launch_authority then
        launch_anim = hash("survived_button")
    end
    pcall(msg.post, msg.url(nil, self.ui.launch_button_art, "sprite"), "play_animation", { id = launch_anim })
    local realtime_btn_color = (REALTIME_TOGGLE_BUTTON_DISABLED == true)
        and vmath.vector4(0.4, 0.4, 0.4, 0.9)
        or vmath.vector4(1, 1, 1, 1)
    update_realtime_toggle_button_visual(self)
    set_ui_square_transform(
        self,
        self.ui.exit_button,
        EXIT_BUTTON_X,
        EXIT_BUTTON_Y,
        EXIT_BUTTON_Z + 0.001,
        vmath.vector4(1, 1, 1, 1),
        1,
        1
    )
    local lag_sim_btn_visible = MP_LAG_SIM_UI_ENABLED and ((self.game_flow_state or FLOW_STATE_GAME) == FLOW_STATE_GAME)
    local lag_btn_tint = lag_sim_btn_visible and vmath.vector4(1, 1, 1, 0.001) or vmath.vector4(1, 1, 1, 0)
    set_ui_square_transform(
        self,
        self.ui.lag_sim_button,
        lag_sim_btn_visible and MP_LAG_SIM_BUTTON_X or -9999,
        lag_sim_btn_visible and MP_LAG_SIM_BUTTON_Y or -9999,
        EXIT_BUTTON_Z + 0.001,
        lag_btn_tint,
        MP_LAG_SIM_BUTTON_W,
        MP_LAG_SIM_BUTTON_H
    )
    if lag_sim_btn_visible then
        update_mp_lag_sim_button_visual(self)
    end
    if FLOW_BUTTON_HITBOX_DEBUG_VISIBLE then
        set_ui_square_transform(self, self.ui.exit_button_debug_hitbox, EXIT_BUTTON_X, EXIT_BUTTON_Y, EXIT_BUTTON_Z + 0.03, vmath.vector4(0.1, 1.0, 0.2, 0), EXIT_BUTTON_W, EXIT_BUTTON_H)
    else
        set_ui_square_transform(self, self.ui.exit_button_debug_hitbox, -9999, -9999, EXIT_BUTTON_Z + 0.03, vmath.vector4(0, 0, 0, 0), EXIT_BUTTON_W, EXIT_BUTTON_H)
    end
    if client_no_launch_authority then
        set_ui_square_transform(
            self,
            self.ui.launch_button,
            -9999,
            -9999,
            LAUNCH_BUTTON_Z,
            vmath.vector4(1, 1, 1, 0),
            LAUNCH_BUTTON_W,
            LAUNCH_BUTTON_H
        )
        set_ui_square_transform(
            self,
            self.ui.launch_button_art,
            -9999,
            -9999,
            LAUNCH_BUTTON_Z + 0.001,
            vmath.vector4(1, 1, 1, 0),
            1,
            (LAUNCH_BUTTON_H * 0.021) * 0.75
        )
    else
        set_ui_square_transform(
            self,
            self.ui.launch_button,
            LAUNCH_BUTTON_X,
            LAUNCH_BUTTON_Y,
            LAUNCH_BUTTON_Z,
            vmath.vector4(1, 1, 1, 0),
            LAUNCH_BUTTON_W,
            LAUNCH_BUTTON_H
        )
        set_ui_square_transform(
            self,
            self.ui.launch_button_art,
            LAUNCH_BUTTON_X,
            LAUNCH_BUTTON_Y,
            LAUNCH_BUTTON_Z + 0.001,
            vmath.vector4(1, 1, 1, 1),
            1,
            (LAUNCH_BUTTON_H * 0.021) * 0.75
        )
    end
    set_ui_square_transform(
        self,
        self.ui.realtime_toggle_button,
        REALTIME_TOGGLE_BUTTON_X,
        REALTIME_TOGGLE_BUTTON_Y,
        LAUNCH_BUTTON_Z,
        vmath.vector4(realtime_btn_color.x, realtime_btn_color.y, realtime_btn_color.z, 0),
        REALTIME_TOGGLE_BUTTON_DRAW_W * 0.021,
        REALTIME_TOGGLE_BUTTON_DRAW_H * 0.021
    )
    update_aesthetic_toggle_button_visual(self)
    set_ui_square_transform(
        self,
        self.ui.aesthetic_toggle_button,
        AESTHETIC_BUTTON_X,
        AESTHETIC_BUTTON_Y,
        AESTHETIC_BUTTON_Z,
        vmath.vector4(1, 1, 1, 0),
        AESTHETIC_BUTTON_W,
        AESTHETIC_BUTTON_H
    )
    set_ui_square_transform(
        self,
        self.ui.aesthetic_toggle_button_art,
        AESTHETIC_BUTTON_X,
        AESTHETIC_BUTTON_Y,
        AESTHETIC_BUTTON_Z + 0.001,
        vmath.vector4(1, 1, 1, 1),
        1,
        1
    )
    set_ui_square_transform(
        self,
        self.ui.zoom_in_button,
        ZOOM_IN_BUTTON_X,
        ZOOM_IN_BUTTON_Y,
        ZOOM_IN_BUTTON_Z,
        vmath.vector4(0.2, 0.55, 0.95, 0),
        ZOOM_IN_BUTTON_W,
        ZOOM_IN_BUTTON_H
    )
    set_ui_square_transform(
        self,
        self.ui.zoom_out_button,
        ZOOM_OUT_BUTTON_X,
        ZOOM_OUT_BUTTON_Y,
        ZOOM_OUT_BUTTON_Z,
        vmath.vector4(0.2, 0.55, 0.95, 0),
        ZOOM_OUT_BUTTON_W,
        ZOOM_OUT_BUTTON_H
    )
    update_zoom_slider_ui(self)
    if self.mp_state and self.mp_state.enabled then
        set_ui_square_transform(
            self,
            self.ui.transport_status_dot,
            MP_NET_STATUS_DOT_X,
            MP_NET_STATUS_DOT_Y,
            MP_NET_STATUS_DOT_Z,
            get_multiplayer_transport_status_tint(self),
            MP_NET_STATUS_DOT_W,
            MP_NET_STATUS_DOT_H
        )
    else
        set_ui_square_transform(self, self.ui.transport_status_dot, -9999, -9999, MP_NET_STATUS_DOT_Z, vmath.vector4(0, 0, 0, 0), MP_NET_STATUS_DOT_W, MP_NET_STATUS_DOT_H)
    end
    update_objective_ui(self, true)
    update_score_hud(self, true)
    update_mp_build_hud(self, true)
    update_purge_timer_hud(self, true)
end

local function update_tutorial_overlay_ui(self)
    if not (self and self.ui and self.ui.tutorial_panel) then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    if self.tutorial_mode == true and self.tutorial_overlay_active == true and self.tutorial_panel_screen_x and self.tutorial_panel_screen_y then
        local world_x, world_y = nil, nil
        if self.tutorial_anchor_world_x and self.tutorial_anchor_world_y then
            local sx, sy = tutorial_world_to_screen(self, self.tutorial_anchor_world_x, self.tutorial_anchor_world_y)
            self.tutorial_panel_screen_x = sx
            self.tutorial_panel_screen_y = sy
            world_x = self.tutorial_anchor_world_x
            world_y = self.tutorial_anchor_world_y
        else
            world_x, world_y = screen_to_world(self.tutorial_panel_screen_x, self.tutorial_panel_screen_y, self.camera_pos, self.camera_zoom)
        end
        go.set_position(vmath.vector3(world_x, world_y, TUTORIAL_PANEL_Z), self.ui.tutorial_panel)
        go.set_scale(vmath.vector3(TUTORIAL_PANEL_DRAW_SCALE, TUTORIAL_PANEL_DRAW_SCALE, 1), self.ui.tutorial_panel)
        go.set(msg.url(nil, self.ui.tutorial_panel, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
    else
        go.set_position(vmath.vector3(-9999, -9999, TUTORIAL_PANEL_Z), self.ui.tutorial_panel)
        go.set_scale(vmath.vector3(TUTORIAL_PANEL_DRAW_SCALE, TUTORIAL_PANEL_DRAW_SCALE, 1), self.ui.tutorial_panel)
        go.set(msg.url(nil, self.ui.tutorial_panel, "sprite"), "tint", hidden)
    end
end

get_aesthetic_profile = function(self)
    local mode = self.aesthetic_mode or AESTHETIC_MODE_BOARDGAME
    return AESTHETIC_PROFILES[mode] or AESTHETIC_PROFILES[AESTHETIC_MODE_BOARDGAME]
end

get_world_shadow_alpha = function(self)
    local profile = get_aesthetic_profile(self)
    if not profile or profile.world_drop_shadows_enabled ~= true then
        return 0
    end
    return profile.world_shadow_alpha or 0.5
end

get_ui_panel_shadow_alpha = function(self)
    local profile = get_aesthetic_profile(self)
    if not profile or profile.ui_panel_shadow_enabled ~= true then
        return 0
    end
    return profile.ui_panel_shadow_alpha or 0.35
end

get_human_anim_for_aesthetic = function(self, unit)
    if not unit then
        return nil
    end
    if (unit.current_health or 0) <= 0 then
        if self.aesthetic_mode == AESTHETIC_MODE_BOARDGAME then
            return hash("human_dead_boardgame")
        end
        return hash("human_dead")
    end
    local class_id = tostring(unit.class_id or "")
    local base_name = nil
    if class_id == tostring(UNIT_CLASS_SARGE or "") then
        base_name = "sarge"
    elseif class_id == tostring(UNIT_CLASS_TECHIE or "") then
        base_name = "techie"
    elseif class_id == tostring(UNIT_CLASS_MEDIC or "") then
        base_name = "medic"
    elseif class_id == tostring(UNIT_CLASS_GUNNER or "") then
        base_name = "gunner"
    end
    if base_name then
        if self.aesthetic_mode == AESTHETIC_MODE_BOARDGAME then
            return hash("human_" .. base_name .. "_boardgame")
        end
        if unit_has_equipped_buff_kind(unit, "hazmat_suit") then
            return hash("human_" .. base_name .. "_hazmat")
        end
        local cell = self.world_grid and unit.cell_id and self.world_grid[unit.cell_id] or nil
        if cell then
            local is_outside = (cell.isOutside == true)
                or (cell.isOutsideHazard == true)
                or (cell.has_outside_hazard == true)
                or (cell.hasOutsideHazard == true)
            if is_outside then
                return hash("human_" .. base_name .. "_outside")
            end
            if cell.isPowered ~= true then
                return hash("human_" .. base_name .. "_25")
            end
            local light_value = math.max(0, math.min(3, tonumber(cell.lightValue or 0) or 0))
            if light_value <= 0 then
                return hash("human_" .. base_name .. "_25")
            elseif light_value == 1 then
                return hash("human_" .. base_name .. "_50")
            elseif light_value == 2 then
                return hash("human_" .. base_name .. "_75")
            end
            return hash("human_" .. base_name .. "_normal")
        end
        return hash("human_" .. base_name .. "_normal")
    end
    return nil
end

apply_human_aesthetic_animations = function(self)
    if not self or not self.squad_units then
        return
    end
    for _, unit in pairs(self.squad_units) do
        if unit and unit.sprite_path then
            local anim = get_human_anim_for_aesthetic(self, unit)
            if anim then
                pcall(msg.post, unit.sprite_path, "play_animation", { id = anim })
                unit.current_aesthetic_anim = anim
            else
                unit.current_aesthetic_anim = nil
            end
        end
    end
end

apply_alien_aesthetic_animations = function(self)
    if not self or not self.aliens then
        return
    end
    for _, alien in ipairs(self.aliens) do
        if alien and (not alien.is_dead) and alien.go_id then
            local anim = get_alien_anim_for_aesthetic(self, alien.type)
            if anim then
                pcall(msg.post, msg.url(nil, alien.go_id, "sprite"), "play_animation", { id = anim })
                alien.current_aesthetic_anim = anim
            else
                alien.current_aesthetic_anim = nil
            end
            if alien.type == ALIEN_TYPE_BRUTE then
                local shadow_anim = hash("alien_cannonFodder_shadow")
                if self.aesthetic_mode == AESTHETIC_MODE_BOARDGAME then
                    shadow_anim = hash("alien_brute_shadow")
                end
                pcall(msg.post, msg.url(nil, alien.go_id, "shadow"), "play_animation", { id = shadow_anim })
            end
        end
    end
end

apply_computer_emissive_accents = function(self, dt)
    local profile = get_aesthetic_profile(self)
    local enabled = profile
        and profile.computer_emissive_enabled == true
        and self.aesthetic_mode == AESTHETIC_MODE_COMPUTER

    local white_tint = vmath.vector4(1, 1, 1, 1)
    local base = profile and profile.computer_emissive_tint or vmath.vector4(0.7, 0.92, 1.18, 1)
    local min_mul = profile and profile.computer_emissive_min_mul or 0.84
    local max_mul = profile and profile.computer_emissive_max_mul or 1.22
    local variation_amount = profile and profile.computer_emissive_variation_amount or 0.2
    local global_intensity_mul = 1
    if enabled then
        self.computer_emissive_variation_phase = (self.computer_emissive_variation_phase or 0) + (dt * ((profile.computer_emissive_variation_speed or 0.2) * math.pi * 2))
        local variation_wave = math.sin(self.computer_emissive_variation_phase)
        local speed_mul = 1 + (variation_wave * variation_amount)
        global_intensity_mul = 1 + (math.cos(self.computer_emissive_variation_phase * 0.73) * variation_amount)
        local speed = (profile.computer_emissive_pulse_speed or 1.25) * speed_mul * math.pi * 2
        self.computer_emissive_phase = (self.computer_emissive_phase or 0) + (dt * speed)
        self.workshop_emissive_phase = (self.workshop_emissive_phase or 0) + (dt * math.pi * 2 * 0.42)
    end

    local human_tile_instances = {}
    local nearby_human_tile_instances = {}
    if self.world_grid and self.squad_units then
        for _, unit in pairs(self.squad_units) do
            if unit and (unit.current_health or 0) > 0 and unit.cell_id then
                local cell = self.world_grid[unit.cell_id]
                local tile_id = cell and cell.tileInstanceId or nil
                if tile_id and tile_id > 0 then
                    human_tile_instances[tile_id] = true
                    nearby_human_tile_instances[tile_id] = true
                end
            end
        end
    end
    local selected_level = self.level_library and self.level_library[self.current_level_index or 1] or nil
    local nightvision_reveal_enabled, nightvision_tile_instance_id, nightvision_reveal_alpha = get_nightvision_reveal_context(self)
    if selected_level and next(human_tile_instances) ~= nil then
        for human_tile_id, _ in pairs(human_tile_instances) do
            local a = selected_level[human_tile_id]
            if a then
                local a_left = a.x - 1
                local a_right = a.x + 1
                local a_bottom = a.y - 1
                local a_top = a.y + 1
                for tile_id, b in ipairs(selected_level) do
                    if tile_id ~= human_tile_id then
                        local b_left = b.x - 1
                        local b_right = b.x + 1
                        local b_bottom = b.y - 1
                        local b_top = b.y + 1
                        local overlap_y = not (b_top < a_bottom or b_bottom > a_top)
                        local overlap_x = not (b_right < a_left or b_left > a_right)
                        local horizontal_adjacent = overlap_y and (b_left == (a_right + 1) or b_right == (a_left - 1))
                        local vertical_adjacent = overlap_x and (b_bottom == (a_top + 1) or b_top == (a_bottom - 1))
                        if horizontal_adjacent or vertical_adjacent then
                            nearby_human_tile_instances[tile_id] = true
                        end
                    end
                end
            end
        end
    end

    local function get_instance_tint(instance_key, powered, apply_off_human_proximity_rule)
        local n = tonumber(instance_key) or 0
        if (not powered) and nightvision_reveal_enabled and n == nightvision_tile_instance_id then
            local a = math.max(0, math.min(1, tonumber(nightvision_reveal_alpha or 0) or 0))
            return vmath.vector4(
                NIGHTVISION_UNPOWERED_TINT.x * a,
                NIGHTVISION_UNPOWERED_TINT.y * a,
                NIGHTVISION_UNPOWERED_TINT.z * a,
                a
            )
        end
        if apply_off_human_proximity_rule and not powered then
            return white_tint
        end
        if not powered then
            if self.aesthetic_mode == AESTHETIC_MODE_COMPUTER then
                return vmath.vector4(0.42, 0.42, 0.42, 1)
            end
            return white_tint
        end
        if not enabled then
            return white_tint
        end
        local placement = selected_level and selected_level[n] or nil
        if placement and placement.tile == "workshop" then
            local workshop_wave = 0.5 + (0.5 * math.sin((self.workshop_emissive_phase or 0) + (n * 0.11)))
            local workshop_mul = 0.8 + (0.2 * workshop_wave)
            return vmath.vector4(base.x * workshop_mul, base.y * workshop_mul, base.z * workshop_mul, 1)
        end
        local phase_offset = (0.5 + (0.5 * math.sin((n + 1) * 12.9898))) * math.pi * 2
        local drift = (self.computer_emissive_variation_phase or 0) + phase_offset
        local speed_jitter = 1
            + (math.sin((n + 1) * 4.123 + 1.7) * variation_amount * 1.2)
            + (math.sin(drift * 0.55 + (n * 0.17)) * variation_amount * 0.35)
        local max_speed_jitter = profile and profile.computer_emissive_max_speed_jitter or 1.08
        if speed_jitter > max_speed_jitter then
            speed_jitter = max_speed_jitter
        end
        local intensity_jitter = 1
            + (math.cos((n + 1) * 7.777 + 0.3) * variation_amount * 1.35)
            + (math.cos(drift * 0.42 + (n * 0.11)) * variation_amount * 0.4)
        local wave = 0.5 + (0.5 * math.sin((self.computer_emissive_phase or 0) * speed_jitter + phase_offset))
        local mul = (min_mul + ((max_mul - min_mul) * wave)) * global_intensity_mul * intensity_jitter
        return vmath.vector4(base.x * mul, base.y * mul, base.z * mul, 1)
    end

    if self.tile_light_layers then
        for tile_instance_id, light_go in pairs(self.tile_light_layers) do
            local powered = self.tile_light_power_state and self.tile_light_power_state[tile_instance_id] == true
            local tint = get_instance_tint(tile_instance_id, powered, true)
            if powered and self.tile_light_is_lab and self.tile_light_is_lab[tile_instance_id] then
                tint = vmath.vector4(base.x * max_mul, base.y * max_mul, base.z * max_mul, 1)
            elseif powered and self.tile_light_is_jungle and self.tile_light_is_jungle[tile_instance_id] then
                tint = white_tint
            end
            pcall(go.set, msg.url(nil, light_go, "sprite"), "tint", apply_startup_room_tile_fade_to_tint(self, tile_instance_id, tint))
        end
    end

    for cell_id, marker_id in pairs(machine_objects or {}) do
        local tint = get_instance_tint(cell_id, true)
        pcall(go.set, msg.url(nil, marker_id, "sprite"), "tint", tint)
    end

    if self.power_node_objects then
        for cell_id, marker_id in pairs(self.power_node_objects) do
            local cell = self.world_grid and self.world_grid[cell_id] or nil
            local powered = self.power_node_power_state and self.power_node_power_state[cell_id] == true
            local visible_in_unpowered = nightvision_reveal_enabled
                and cell
                and tonumber(cell.tileInstanceId or 0) == nightvision_tile_instance_id
            local should_show = powered or visible_in_unpowered
            local tint = vmath.vector4(0, 0, 0, 0)
            if should_show then
                if visible_in_unpowered and not powered then
                        local a = math.max(0, math.min(1, tonumber(nightvision_reveal_alpha or 0) or 0))
                        tint = vmath.vector4(
                            NIGHTVISION_POWER_NODE_TINT.x * a,
                            NIGHTVISION_POWER_NODE_TINT.y * a,
                            NIGHTVISION_POWER_NODE_TINT.z * a,
                            a
                        )
                else
                    tint = get_instance_tint(cell_id, powered)
                end
            end
            pcall(go.set, msg.url(nil, marker_id, "sprite"), "tint", tint)
            local shadow_id = self.power_node_shadow_objects and self.power_node_shadow_objects[cell_id] or nil
            if shadow_id then
                local shadow_alpha = should_show and 0.33 or 0
                if visible_in_unpowered and not powered then
                    shadow_alpha = shadow_alpha * (math.max(0, math.min(1, tonumber(nightvision_reveal_alpha or 0) or 0)))
                end
                pcall(go.set, msg.url(nil, shadow_id, "sprite"), "tint", vmath.vector4(0, 0, 0, shadow_alpha))
            end
        end
    end

    if self.wiregap_objects then
        for i, marker_id in ipairs(self.wiregap_objects) do
            local tint = get_instance_tint(i * 97, true)
            pcall(go.set, msg.url(nil, marker_id, "sprite"), "tint", tint)
        end
    end
end

get_tile_alpha_overlay_anim_id = function(tile_def, aesthetic_mode)
    if not tile_def then
        return hash("tile_generic_alpha_layer")
    end
    local mode = tostring(tile_def.alphaOverlayMode or "generic")
    if mode ~= "specified" then
        return hash("tile_generic_alpha_layer")
    end
    local overlay_name = nil
    if aesthetic_mode == AESTHETIC_MODE_BOARDGAME then
        overlay_name = tile_def.alphaOverlayBoardgame
    elseif aesthetic_mode == AESTHETIC_MODE_COMPUTER then
        overlay_name = tile_def.alphaOverlayComputer
    end
    if not overlay_name or overlay_name == "" then
        overlay_name = tile_def.alphaOverlay
    end
    if not overlay_name or overlay_name == "" then
        return hash("tile_generic_alpha_layer")
    end
    local anim = tostring(overlay_name)
    if string.sub(anim, 1, 5) ~= "tile_" then
        anim = "tile_" .. anim
    end
    return hash(anim)
end

apply_aesthetic_mode = function(self)
    local profile = get_aesthetic_profile(self)
    local sheen_enabled = profile and profile.sheen_enabled == true
    local backdrop_enabled = profile and profile.backdrop_enabled == true
    local backdrop_tiled = profile and profile.backdrop_tiled == true
    local backdrop_clouds_enabled = profile and profile.backdrop_clouds_enabled == true
    local table_sweep_shadow_enabled = profile and profile.table_sweep_shadow_enabled == true
    local backdrop_anim = (profile and profile.backdrop_anim) or "tile_generic_alpha_layer"
    if self.aesthetic_mode == AESTHETIC_MODE_COMPUTER then
        backdrop_anim = get_computer_backdrop_anim_for_mission(self)
    end
    local backdrop_tint = (profile and profile.backdrop_tint) or vmath.vector4(1, 1, 1, 0.2)
    local table_sweep_shadow_anim = (profile and profile.table_sweep_shadow_anim) or "tile_generic_alpha_layer"
    local table_sweep_shadow_tint = (profile and profile.table_sweep_shadow_tint) or vmath.vector4(0.2, 0.17, 0.13, 0.2)
    local table_sweep_shadow_factory = "/tile_factory#tile_factory"
    local backdrop_factory = "/tile_factory#tile_factory"
    if self.aesthetic_mode == AESTHETIC_MODE_COMPUTER and backdrop_tiled ~= true then
        backdrop_factory = "/backdrop_computer_factory#backdrop_computer_factory"
    end
    local boardgame_dice_enabled = (self.aesthetic_mode == AESTHETIC_MODE_BOARDGAME) and backdrop_enabled == true

    if backdrop_enabled then
        if backdrop_tiled then
            if self.world_backdrop then
                go.delete(self.world_backdrop)
                self.world_backdrop = nil
            end
            local base_cols = (profile and profile.backdrop_tile_cols) or 5
            local right_extra_cols = math.max(0, math.floor((profile and profile.backdrop_tile_right_extra_cols) or 0))
            local cols = base_cols + right_extra_cols
            local rows = (profile and profile.backdrop_tile_rows) or 5
            local needed = math.max(1, cols * rows)
            self.world_backdrop_tiles = self.world_backdrop_tiles or {}
            while #self.world_backdrop_tiles < needed do
                local tile_id = factory.create("/tile_factory#tile_factory", vmath.vector3(self.camera_pos.x, self.camera_pos.y, self.world_backdrop_z or -0.2))
                if not tile_id then
                    break
                end
                pcall(go.set, msg.url(nil, tile_id, "sprite"), "blend_mode", (render and render.BLEND_ALPHA) or 0)
                table.insert(self.world_backdrop_tiles, tile_id)
            end
            while #self.world_backdrop_tiles > needed do
                local idx = #self.world_backdrop_tiles
                go.delete(self.world_backdrop_tiles[idx])
                self.world_backdrop_tiles[idx] = nil
            end
            if self.world_backdrop_anim ~= backdrop_anim then
                for _, tile_id in ipairs(self.world_backdrop_tiles) do
                    msg.post(msg.url(nil, tile_id, "sprite"), "play_animation", { id = hash(backdrop_anim) })
                end
                self.world_backdrop_anim = backdrop_anim
            end
            for _, tile_id in ipairs(self.world_backdrop_tiles) do
                go.set(msg.url(nil, tile_id, "sprite"), "tint", backdrop_tint)
            end
        else
            if self.world_backdrop_tiles then
                for i, tile_id in ipairs(self.world_backdrop_tiles) do
                    go.delete(tile_id)
                    self.world_backdrop_tiles[i] = nil
                end
            end
            if not self.world_backdrop then
                self.world_backdrop = factory.create(backdrop_factory, vmath.vector3(self.camera_pos.x, self.camera_pos.y, self.world_backdrop_z or -0.2))
                if self.world_backdrop then
                    pcall(go.set, msg.url(nil, self.world_backdrop, "sprite"), "blend_mode", (render and render.BLEND_ALPHA) or 0)
                end
            end
            if self.world_backdrop then
                if self.world_backdrop_anim ~= backdrop_anim then
                    msg.post(msg.url(nil, self.world_backdrop, "sprite"), "play_animation", { id = hash(backdrop_anim) })
                    self.world_backdrop_anim = backdrop_anim
                end
                go.set(msg.url(nil, self.world_backdrop, "sprite"), "tint", backdrop_tint)
            end
        end
    else
        if self.world_backdrop then
            go.delete(self.world_backdrop)
            self.world_backdrop = nil
        end
        if self.world_backdrop_tiles then
            for i, tile_id in ipairs(self.world_backdrop_tiles) do
                go.delete(tile_id)
                self.world_backdrop_tiles[i] = nil
            end
        end
        self.world_backdrop_anim = nil
    end
    if boardgame_dice_enabled then
        if not self.world_backdrop_dice then
            self.world_backdrop_dice = factory.create("/tile_factory#tile_factory", vmath.vector3(self.camera_pos.x, self.camera_pos.y, (self.world_backdrop_z or -0.2) + BOARDGAME_BACKDROP_DICE_Z_OFFSET))
            if self.world_backdrop_dice then
                msg.post(msg.url(nil, self.world_backdrop_dice, "sprite"), "play_animation", { id = BOARDGAME_BACKDROP_DICE_ANIM })
            end
        end
        if self.world_backdrop_dice then
            go.set(msg.url(nil, self.world_backdrop_dice, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
        end
    elseif self.world_backdrop_dice then
        go.delete(self.world_backdrop_dice)
        self.world_backdrop_dice = nil
    end

    if backdrop_clouds_enabled then
        if not self.backdrop_cloud_fx then
            self.backdrop_cloud_fx = factory.create(
                "/swirling_clouds1_fx_factory#swirling_clouds1_fx_factory",
                vmath.vector3(self.camera_pos.x, self.camera_pos.y, self.backdrop_cloud_fx_z or 0.015)
            )
            if self.backdrop_cloud_fx then
                go.set_rotation(vmath.quat_rotation_z(math.rad(-90)), self.backdrop_cloud_fx)
                pcall(particlefx.play, msg.url(nil, self.backdrop_cloud_fx, "particlefx"))
            end
        end
    elseif self.backdrop_cloud_fx then
        go.delete(self.backdrop_cloud_fx)
        self.backdrop_cloud_fx = nil
    end

    if table_sweep_shadow_enabled then
        if self.table_sweep_shadow_overlay and self.table_sweep_shadow_factory ~= table_sweep_shadow_factory then
            go.delete(self.table_sweep_shadow_overlay)
            self.table_sweep_shadow_overlay = nil
            self.table_sweep_shadow_anim = nil
        end
        if not self.table_sweep_shadow_overlay then
            self.table_sweep_shadow_overlay = factory.create(
                table_sweep_shadow_factory,
                vmath.vector3(self.camera_pos.x, self.camera_pos.y, self.table_sweep_shadow_z or 0.74)
            )
            self.table_sweep_shadow_factory = table_sweep_shadow_factory
        end
        if self.table_sweep_shadow_overlay then
            if self.table_sweep_shadow_anim ~= table_sweep_shadow_anim then
                msg.post(msg.url(nil, self.table_sweep_shadow_overlay, "sprite"), "play_animation", { id = hash(table_sweep_shadow_anim) })
                self.table_sweep_shadow_anim = table_sweep_shadow_anim
            end
            go.set(msg.url(nil, self.table_sweep_shadow_overlay, "sprite"), "tint", table_sweep_shadow_tint)
        end
    elseif self.table_sweep_shadow_overlay then
        go.delete(self.table_sweep_shadow_overlay)
        self.table_sweep_shadow_overlay = nil
        self.table_sweep_shadow_anim = nil
        self.table_sweep_shadow_factory = nil
    end

    if sheen_enabled then
        if not self.sheen_overlay then
            local sheen_id = factory.create("/ui_factory#ui_factory", vmath.vector3(self.camera_pos.x + (self.sheen_offset_x or 0), self.camera_pos.y + (self.sheen_offset_y or 0), self.sheen_z or 0.4))
            if sheen_id then
                msg.post(msg.url(nil, sheen_id, "sprite"), "play_animation", { id = hash("DVX_sheen") })
                self.sheen_overlay = sheen_id
            end
        end
        if self.sheen_overlay then
            go.set(msg.url(nil, self.sheen_overlay, "sprite"), "tint", vmath.vector4(1, 1, 1, self.sheen_alpha or 0.4))
            local sx = (SCREEN_WIDTH / self.camera_zoom) / (self.sheen_art_w or 550)
            local sy = (SCREEN_HEIGHT / self.camera_zoom) / (self.sheen_art_h or 300)
            go.set_position(vmath.vector3(self.camera_pos.x + (self.sheen_offset_x or 0), self.camera_pos.y + (self.sheen_offset_y or 0), self.sheen_z or 0.4), self.sheen_overlay)
            go.set_scale(vmath.vector3(sx, sy, 1), self.sheen_overlay)
        end
    elseif self.sheen_overlay then
        go.delete(self.sheen_overlay)
        self.sheen_overlay = nil
    end
    if self.tile_room_shadows then
        local tile_shadow_alpha = (profile and profile.tile_room_shadow_alpha) or 0
        local tile_shadow_tint = vmath.vector4(0, 0, 0, tile_shadow_alpha)
        for _, shadow_id in pairs(self.tile_room_shadows) do
            if shadow_id then
                pcall(go.set, msg.url(nil, shadow_id, "sprite"), "tint", tile_shadow_tint)
            end
        end
    end
    if self.exterior_detail_objects then
        local exterior_alpha = (self.aesthetic_mode == AESTHETIC_MODE_BOARDGAME) and 0 or 1
        for _, exterior_id in ipairs(self.exterior_detail_objects) do
            if exterior_id then
                pcall(go.set, msg.url(nil, exterior_id, "sprite"), "tint", vmath.vector4(1, 1, 1, exterior_alpha))
            end
        end
    end
    if self.tile_base_objects and self.level_library and self.current_level_index then
        local selected_level = self.level_library[self.current_level_index]
        for placement_index, placement in ipairs(selected_level or {}) do
            local tile_id = self.tile_base_objects[placement_index]
            local tile_def = self.tile_library and self.tile_library[placement.tile] or nil
            if tile_id then
                local visual_tile_name = (tile_def and tile_def.visualTile) or placement.tile
                if tile_def then
                    if self.aesthetic_mode == AESTHETIC_MODE_BOARDGAME and tile_def.visualTileBoardgame then
                        visual_tile_name = tile_def.visualTileBoardgame
                    elseif self.aesthetic_mode == AESTHETIC_MODE_COMPUTER and tile_def.visualTileComputer then
                        visual_tile_name = tile_def.visualTileComputer
                    end
                end
                msg.post(msg.url(nil, tile_id, "sprite"), "play_animation", { id = hash("tile_" .. visual_tile_name) })
            end
            local alpha_id = self.tile_alpha_layers and self.tile_alpha_layers[placement_index] or nil
            if alpha_id then
                msg.post(
                    msg.url(nil, alpha_id, "sprite"),
                    "play_animation",
                    { id = get_tile_alpha_overlay_anim_id(tile_def, self.aesthetic_mode) }
                )
                local always_visible = tile_def and tile_def.alphaOverlayAlwaysVisible == true
                local now_on = always_visible
                if not now_on and self.world_grid then
                    for _, cell in ipairs(self.world_grid) do
                        if cell.tileInstanceId == placement_index and cell.isPowered then
                            now_on = true
                            break
                        end
                    end
                end
                go.set(msg.url(nil, alpha_id, "sprite"), "tint", vmath.vector4(1, 1, 1, now_on and 1 or 0))
                if self.tile_alpha_power_state then
                    self.tile_alpha_power_state[placement_index] = now_on
                end
            end
        end
    end
    apply_human_aesthetic_animations(self)
    apply_alien_aesthetic_animations(self)
end

apply_backdrop_emissive_tint = function(self, dt, profile)
    if not self.world_backdrop then
        return
    end
    local base = (profile and profile.backdrop_tint) or vmath.vector4(1, 1, 1, 1)
    if not (profile and profile.backdrop_emissive_enabled == true and self.aesthetic_mode == AESTHETIC_MODE_COMPUTER) then
        go.set(msg.url(nil, self.world_backdrop, "sprite"), "tint", base)
        return
    end
    local base_speed = profile.backdrop_emissive_speed or 0.03
    local speed_variation = profile.backdrop_emissive_speed_variation_amount or 0
    local speed = base_speed
    if speed_variation > 0 then
        self.backdrop_emissive_speed_timer = (self.backdrop_emissive_speed_timer or 0) - dt
        if self.backdrop_emissive_speed_mul_target == nil then
            self.backdrop_emissive_speed_mul_target = 1
        end
        if self.backdrop_emissive_speed_mul_current == nil then
            self.backdrop_emissive_speed_mul_current = self.backdrop_emissive_speed_mul_target
        end
        if self.backdrop_emissive_speed_timer <= 0 then
            self.backdrop_emissive_speed_mul_target = 1 + (math.random() * 2 - 1) * speed_variation
            local min_s = profile.backdrop_emissive_speed_variation_min_seconds or 3.0
            local max_s = profile.backdrop_emissive_speed_variation_max_seconds or 8.0
            self.backdrop_emissive_speed_timer = min_s + (math.random() * math.max(0, max_s - min_s))
        end
        local blend = math.min(1, dt * 1.25)
        self.backdrop_emissive_speed_mul_current = self.backdrop_emissive_speed_mul_current
            + ((self.backdrop_emissive_speed_mul_target - self.backdrop_emissive_speed_mul_current) * blend)
        speed = base_speed * self.backdrop_emissive_speed_mul_current
    end
    speed = speed * math.pi * 2
    local amount = profile.backdrop_emissive_amount or 0.015
    self.backdrop_emissive_phase = (self.backdrop_emissive_phase or 0) + (dt * speed)
    local wave_a = math.sin(self.backdrop_emissive_phase)
    local wave_b = math.sin((self.backdrop_emissive_phase * 0.37) + 1.2)
    local wave = (wave_a * 0.75) + (wave_b * 0.25)
    local mul = 1 + (wave * amount)
    local alpha = math.max(0, math.min(1, base.w * (1 + (wave * amount * 0.45))))
    go.set(
        msg.url(nil, self.world_backdrop, "sprite"),
        "tint",
        vmath.vector4(base.x * mul, base.y * mul, base.z * mul, alpha)
    )
end

update_backdrop_cloud_fx = function(self)
    if not self.backdrop_cloud_fx then
        local profile = get_aesthetic_profile(self)
        if profile and profile.backdrop_clouds_enabled == true then
            self.backdrop_cloud_fx = factory.create(
                "/swirling_clouds1_fx_factory#swirling_clouds1_fx_factory",
                vmath.vector3(self.camera_pos.x, self.camera_pos.y, self.backdrop_cloud_fx_z or 0.015)
            )
            if self.backdrop_cloud_fx then
                go.set_rotation(vmath.quat_rotation_z(math.rad(-90)), self.backdrop_cloud_fx)
                pcall(particlefx.play, msg.url(nil, self.backdrop_cloud_fx, "particlefx"))
            else
                return
            end
        else
            return
        end
    end
    if self.backdrop_cloud_fx_anchor_y == nil then
        self.backdrop_cloud_fx_anchor_y = self.camera_pos.y + 100
    end
    local left_margin_world = (self.backdrop_cloud_fx_left_margin_screen or 80) / self.camera_zoom
    local left_extra_world = (self.backdrop_cloud_fx_left_extra_screen or 1500) / self.camera_zoom
    local px = self.camera_pos.x - ((SCREEN_WIDTH * 0.5) / self.camera_zoom) - left_margin_world - left_extra_world
    local py = self.backdrop_cloud_fx_anchor_y
    go.set_position(vmath.vector3(px, py, self.backdrop_cloud_fx_z or 0.015), self.backdrop_cloud_fx)
    go.set_rotation(vmath.quat_rotation_z(math.rad(-90)), self.backdrop_cloud_fx)
end

set_aesthetic_mode = function(self, mode)
    if mode ~= AESTHETIC_MODE_COMPUTER and mode ~= AESTHETIC_MODE_BOARDGAME then
        return
    end
    self.aesthetic_mode = mode
    self.world_backdrop_pan_x = 0
    self.world_backdrop_pan_y = 0
    self.world_backdrop_prev_camera_x = nil
    self.world_backdrop_prev_camera_y = nil
    self.world_backdrop_parallax_x = nil
    self.world_backdrop_parallax_y = nil
    self.world_backdrop_anchor_camera_y = nil
    self.world_backdrop_anchor_world_x = nil
    self.world_backdrop_anchor_world_y = nil
    if self.backdrop_cloud_fx then
        go.delete(self.backdrop_cloud_fx)
    end
    self.backdrop_cloud_fx = nil
    self.backdrop_cloud_fx_anchor_y = nil
    self.backdrop_cloud_fx_z = 0.015
    self.backdrop_cloud_fx_left_margin_screen = 80
    self.backdrop_cloud_fx_left_extra_screen = 1500
    self.backdrop_emissive_phase = 0
    self.backdrop_emissive_speed_timer = nil
    self.backdrop_emissive_speed_mul_target = nil
    self.backdrop_emissive_speed_mul_current = nil
    self.table_sweep_shadow_pan_x = nil
    self.table_sweep_shadow_pan_y = 0
    self.table_sweep_shadow_pause_timer = nil
    self.computer_emissive_phase = 0
    self.computer_emissive_variation_phase = 0
    apply_aesthetic_mode(self)
    if LOOT_RUNTIME and LOOT_RUNTIME.refresh_world_item_visuals then
        LOOT_RUNTIME.refresh_world_item_visuals(self)
    end
    if LEVEL_EDITOR and LEVEL_EDITOR.on_aesthetic_changed then
        LEVEL_EDITOR.on_aesthetic_changed(self)
    end
    if LOOT_RUNTIME then
        if LOOT_RUNTIME.refresh_loot_markers then
            LOOT_RUNTIME.refresh_loot_markers(self)
        end
        if LOOT_RUNTIME.refresh_hazard_fx then
            LOOT_RUNTIME.refresh_hazard_fx(self)
        end
        if LOOT_RUNTIME.refresh_machine_markers then
            LOOT_RUNTIME.refresh_machine_markers(self)
        end
        if LOOT_RUNTIME.refresh_turret_markers then
            LOOT_RUNTIME.refresh_turret_markers(self)
        end
        if LOOT_RUNTIME.refresh_power_node_markers then
            LOOT_RUNTIME.refresh_power_node_markers(self)
        end
        if LOOT_RUNTIME.refresh_door_markers then
            LOOT_RUNTIME.refresh_door_markers(self)
        end
        if LOOT_RUNTIME.refresh_wiregap_markers then
            LOOT_RUNTIME.refresh_wiregap_markers(self)
        end
        if LOOT_RUNTIME.refresh_vent_markers then
            LOOT_RUNTIME.refresh_vent_markers(self)
        end
        if LOOT_RUNTIME.refresh_factory_underlay_visuals then
            LOOT_RUNTIME.refresh_factory_underlay_visuals(self)
        end
    end
    print("Aesthetic mode set to: " .. tostring(mode))
end

toggle_aesthetic_mode = function(self)
    if self.aesthetic_mode == AESTHETIC_MODE_BOARDGAME then
        set_aesthetic_mode(self, AESTHETIC_MODE_COMPUTER)
    else
        set_aesthetic_mode(self, AESTHETIC_MODE_BOARDGAME)
    end
end

function request_level_load(self, level_index, source_tag)
    if self.level_switch_in_progress then
        return false
    end
    if not self.level_library or not self.level_library[level_index] then
        print("Level load request ignored (invalid index): " .. tostring(level_index))
        return false
    end
    self.level_switch_in_progress = true
    local ok = reset_and_load_level(self, level_index, true)
    self.level_switch_in_progress = false
    if ok then
        print(string.format("Level load requested from %s -> level %d", tostring(source_tag or "unknown"), level_index))
    end
    return ok
end

function try_select_level_button(self, screen_x, screen_y)
    if DEBUG_LEVEL_BUTTONS_ENABLED ~= true then
        return false
    end
    if not self.ui or not self.ui.level_buttons then
        return false
    end
    local half_w = LEVEL_BUTTON_W * 0.5
    local half_h = LEVEL_BUTTON_H * 0.5
    for level_index, btn in ipairs(self.ui.level_buttons) do
        if btn then
            local bx = get_level_button_screen_x(level_index)
            local by = LEVEL_BUTTON_Y
            if screen_x >= (bx - half_w)
                and screen_x <= (bx + half_w)
                and screen_y >= (by - half_h)
                and screen_y <= (by + half_h)
            then
                if self.mp_state and self.mp_state.enabled and self.mp_state.local_player_id ~= self.mp_state.host_player_id then
                    print("Level restart is host-only in multiplayer.")
                    return true
                end
                return request_level_load(self, level_index, "top_bar_button")
            end
        end
    end
    return false
end

LOOT_RUNTIME = require("main.loot_runtime_utils").create({
    LOOT_UI = LOOT_UI,
    COMMAND_UI = COMMAND_UI,
    COMPONENT_UI = COMPONENT_UI,
    UI_COLOR_SLOT = UI_COLOR_SLOT,
    UI_BACKPACK_COLS = UI_BACKPACK_COLS,
    UI_BACKPACK_ROWS = UI_BACKPACK_ROWS,
    UI_BACKPACK_SLOT_SIZE = UI_BACKPACK_SLOT_SIZE,
    UI_BACKPACK_SLOT_GAP = UI_BACKPACK_SLOT_GAP,
    UI_BACKPACK_START_X = UI_BACKPACK_START_X,
    UI_BACKPACK_START_Y = UI_BACKPACK_START_Y,
    UNIT_CLASS_SARGE = UNIT_CLASS_SARGE,
    UI_BAR_START_Y = UI_BAR_START_Y,
    UI_MAX_PIPS = UI_MAX_PIPS,
    UI_BAR_PIP_SIZE = UI_BAR_PIP_SIZE,
    UI_BAR_PIP_GAP = UI_BAR_PIP_GAP,
    UI_BAR_AMMO_X = UI_BAR_AMMO_X,
    UI_BAR_HP_X = UI_BAR_HP_X,
    UI_PANEL_X = UI_PANEL_X,
    UI_PANEL_Y = UI_PANEL_Y,
    UI_PANEL_W = UI_PANEL_W,
    UI_PANEL_H = UI_PANEL_H,
    SCREEN_WIDTH = SCREEN_WIDTH,
    SCREEN_HEIGHT = SCREEN_HEIGHT,
    NEW_TURN_BUTTON_X = NEW_TURN_BUTTON_X,
    NEW_TURN_BUTTON_Y = NEW_TURN_BUTTON_Y,
    NEW_TURN_BUTTON_W = NEW_TURN_BUTTON_W,
    NEW_TURN_BUTTON_H = NEW_TURN_BUTTON_H,
    FABRICATOR_PANEL_UI_Z = NEW_TURN_BUTTON_Z,
    BUFF_SLOT_ORDER = BUFF_SLOT_ORDER,
    BUFF_DROP_ZONE_OFFSET_X = BUFF_DROP_ZONE_OFFSET_X,
    BUFF_DROP_ZONE_OFFSET_Y = BUFF_DROP_ZONE_OFFSET_Y,
    BUFF_DROP_ZONE_W = BUFF_DROP_ZONE_W,
    BUFF_DROP_ZONE_H = BUFF_DROP_ZONE_H,
    BUFF_SLOT_RELATIVE_OFFSETS = BUFF_SLOT_RELATIVE_OFFSETS,
    BUFF_SLOT_HIT_SIZE = BUFF_SLOT_HIT_SIZE,
    BUFFS = BUFFS,
    id_to_coords = id_to_coords,
    can_human_cross_between_cells = can_human_cross_between_cells
})

ui_feedback_state_ensure = function(self)
    if not self then
        return nil
    end
    self.ui_action_feedback = self.ui_action_feedback or {
        selected_unit_id = nil,
        last_ammo = 0,
        last_hp = 0,
        ammo_gain_timer_s = 0,
        hp_gain_timer_s = 0,
        buff_item_by_slot = {},
        buff_gain_timer_by_slot = {}
    }
    return self.ui_action_feedback
end

ui_feedback_alpha_from_timer = function(timer_s)
    local max_t = tonumber(UI_ACTION_FEEDBACK_FADE_IN_S or 0.16) or 0.16
    if max_t <= 0 then
        return 1
    end
    local t = tonumber(timer_s or 0) or 0
    if t <= 0 then
        return 1
    end
    local min_a = tonumber(UI_ACTION_FEEDBACK_MIN_ALPHA or 0.35) or 0.35
    local progress = 1 - math.max(0, math.min(1, t / max_t))
    return min_a + ((1 - min_a) * progress)
end

is_human_ui_panel_open = function(self)
    return self and self.human_ui_panel_open == true and get_selected_unit(self) ~= nil
end

hide_selected_unit_panel_ui = function(self)
    if not (self and self.ui) then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    set_ui_panel_transform(self, self.ui.panel_art, -9999, -9999, 0.8, UI_PANEL_W, UI_PANEL_H, vmath.vector4(1, 1, 1, 1))
    set_ui_panel_transform(self, self.ui.panel_shadow, -9999, -9999, 0.79, UI_PANEL_W, UI_PANEL_H, hidden)
    for i = 1, UI_MAX_PIPS do
        set_ui_square_transform(self, self.ui.ap_pips[i], -9999, -9999, HUMAN_UI_BASE_Z, hidden, UI_BAR_PIP_SIZE, UI_BAR_PIP_SIZE)
        set_ui_square_transform(self, self.ui.hp_pips[i], -9999, -9999, HUMAN_UI_BASE_Z, hidden, UI_BAR_PIP_SIZE, UI_BAR_PIP_SIZE)
        set_ui_square_transform(self, self.ui.ammo_pips[i], -9999, -9999, HUMAN_UI_BASE_Z, hidden, UI_BAR_PIP_SIZE, UI_BAR_PIP_SIZE)
    end
    for i = 1, COMMAND_UI.max_pips do
        set_ui_square_transform(self, self.ui.command_pips[i], -9999, -9999, HUMAN_UI_BASE_Z, hidden, COMMAND_UI.pip_size, COMMAND_UI.pip_size)
        set_ui_square_transform(self, self.ui.command_pip_icons[i], -9999, -9999, HUMAN_UI_COMMAND_ICON_Z, hidden, COMMAND_UI.pip_size * 0.021 * 0.75, COMMAND_UI.pip_size * 0.021 * 0.75)
    end
    for i = 1, (UI_BACKPACK_COLS * UI_BACKPACK_ROWS) do
        set_ui_square_transform(self, self.ui.backpack_slots[i], -9999, -9999, HUMAN_UI_BASE_Z, hidden, UI_BACKPACK_SLOT_SIZE, UI_BACKPACK_SLOT_SIZE)
        set_ui_square_transform(self, self.ui.backpack_item_icons[i], -9999, -9999, HUMAN_UI_BACKPACK_ICON_Z, hidden, UI_BACKPACK_SLOT_SIZE * 0.021, UI_BACKPACK_SLOT_SIZE * 0.021)
    end
    for i = 1, #BUFF_SLOT_ORDER do
        set_ui_square_transform(self, self.ui.buff_slots[i], -9999, -9999, HUMAN_UI_BUFF_SLOT_Z, hidden, BUFF_SLOT_FRAME_SIZE, BUFF_SLOT_FRAME_SIZE)
        set_ui_square_transform(self, self.ui.buff_item_icons[i], -9999, -9999, HUMAN_UI_BUFF_ICON_Z, hidden, 1, 1)
    end
    set_ui_square_transform(self, self.ui.component_button, -9999, -9999, 0.82, hidden, COMPONENT_UI.button_size, COMPONENT_UI.button_size)
    set_ui_square_transform(self, self.ui.fix_button, -9999, -9999, 0.82, hidden, COMPONENT_UI.fix_button_size, COMPONENT_UI.fix_button_size)
    set_ui_square_transform(self, self.ui.loot_button, -9999, -9999, 0.82, hidden, LOOT_UI.button_size, LOOT_UI.button_size)
    set_ui_square_transform(self, self.ui.retrieve_button, -9999, -9999, 0.82, hidden, LOOT_UI.retrieve_button_size, LOOT_UI.retrieve_button_size)
    set_ui_square_transform(self, self.ui.comms_toggle_button, -9999, -9999, COMMS_TOGGLE_BTN_Z, hidden, COMMS_TOGGLE_BTN_DRAW, COMMS_TOGGLE_BTN_DRAW)
    set_ui_panel_transform(self, self.ui.comms_panel, -9999, -9999, COMMS_PANEL_Z, COMMS_PANEL_W, COMMS_PANEL_H, hidden)
    set_ui_square_transform(self, self.ui.close_button, -9999, -9999, 0.83, hidden, 28, 28)
    set_ui_square_transform(self, self.ui.not_enough_ap_icon, -9999, -9999, 0.835, hidden, 0.81, 0.81)
    if self.ui.flamer_ammo_icons then
        for _, icon_id in ipairs(self.ui.flamer_ammo_icons) do
            set_ui_square_transform(self, icon_id, -9999, -9999, HUMAN_UI_COMMAND_ICON_Z, hidden, (70 * 0.021) * 0.5, (70 * 0.021) * 0.5)
        end
    end
    set_ui_square_transform(self, self.ui.reactive_toggle_button, -9999, -9999, 0.84, hidden, 64, 32)
    close_comms_panel(self)
end

mark_selected_unit_panel_dirty = function(self)
    if self then
        self.human_ui_panel_hidden_for_unit_id = nil
    end
end

update_ui_action_feedback = function(self, dt)
    local state = ui_feedback_state_ensure(self)
    if not state then
        return
    end
    local step = tonumber(dt or 0) or 0
    state.ammo_gain_timer_s = math.max(0, (tonumber(state.ammo_gain_timer_s or 0) or 0) - step)
    state.hp_gain_timer_s = math.max(0, (tonumber(state.hp_gain_timer_s or 0) or 0) - step)
    for slot_name, timer_s in pairs(state.buff_gain_timer_by_slot or {}) do
        state.buff_gain_timer_by_slot[slot_name] = math.max(0, (tonumber(timer_s or 0) or 0) - step)
    end
end

record_ui_action_feedback_snapshot = function(self, unit)
    local state = ui_feedback_state_ensure(self)
    if not state then
        return nil
    end
    if not unit then
        state.selected_unit_id = nil
        state.last_ammo = 0
        state.last_hp = 0
        state.ammo_gain_timer_s = 0
        state.hp_gain_timer_s = 0
        state.buff_item_by_slot = {}
        state.buff_gain_timer_by_slot = {}
        return state
    end
    local unit_id = tostring(unit.id or "")
    if state.selected_unit_id ~= unit_id then
        state.selected_unit_id = unit_id
        state.last_ammo = tonumber(unit.current_ammo or 0) or 0
        state.last_hp = tonumber(unit.current_health or 0) or 0
        state.ammo_gain_timer_s = 0
        state.hp_gain_timer_s = 0
        state.buff_item_by_slot = {}
        state.buff_gain_timer_by_slot = {}
        for _, slot_name in ipairs(BUFF_SLOT_ORDER or {}) do
            state.buff_item_by_slot[slot_name] = tostring((unit.equipment and unit.equipment[slot_name]) or "")
            state.buff_gain_timer_by_slot[slot_name] = 0
        end
        return state
    end
    local ammo_now = tonumber(unit.current_ammo or 0) or 0
    if ammo_now > (tonumber(state.last_ammo or 0) or 0) then
        state.ammo_gain_timer_s = UI_ACTION_FEEDBACK_FADE_IN_S
    end
    state.last_ammo = ammo_now
    local hp_now = tonumber(unit.current_health or 0) or 0
    if hp_now > (tonumber(state.last_hp or 0) or 0) then
        state.hp_gain_timer_s = UI_ACTION_FEEDBACK_FADE_IN_S
    end
    state.last_hp = hp_now
    for _, slot_name in ipairs(BUFF_SLOT_ORDER or {}) do
        local prev_item = tostring((state.buff_item_by_slot and state.buff_item_by_slot[slot_name]) or "")
        local now_item = tostring((unit.equipment and unit.equipment[slot_name]) or "")
        if now_item ~= prev_item then
            state.buff_item_by_slot[slot_name] = now_item
            if now_item ~= "" and now_item ~= "_" then
                state.buff_gain_timer_by_slot[slot_name] = UI_ACTION_FEEDBACK_FADE_IN_S
            else
                state.buff_gain_timer_by_slot[slot_name] = 0
            end
        end
    end
    return state
end

function update_selected_unit_ui(self)
    if (self.game_flow_state or FLOW_STATE_GAME) ~= FLOW_STATE_GAME then
        set_ui_hidden(self)
        return
    end
    local unit = get_selected_unit(self)
    if not self.ui then
        return
    end
    if self.ui.level_buttons then
        local current_idx = self.current_level_index or 1
        for i, btn in ipairs(self.ui.level_buttons) do
            if btn then
                if DEBUG_LEVEL_BUTTONS_ENABLED == true then
                    local bx = get_level_button_screen_x(i)
                    local active = (i == current_idx)
                    local col = active and vmath.vector4(0.2, 0.85, 0.35, 0.95) or vmath.vector4(0.2, 0.6, 0.95, 0.9)
                    set_ui_square_transform(self, btn, bx, LEVEL_BUTTON_Y, LEVEL_BUTTON_Z, col, LEVEL_BUTTON_W, LEVEL_BUTTON_H)
                else
                    set_ui_square_transform(self, btn, -9999, -9999, LEVEL_BUTTON_Z, vmath.vector4(0, 0, 0, 0), LEVEL_BUTTON_W, LEVEL_BUTTON_H)
                end
            end
        end
    end
    if not unit then
        self.human_ui_panel_open = false
        mark_selected_unit_panel_dirty(self)
        record_ui_action_feedback_snapshot(self, nil)
        set_ui_hidden(self)
        update_human_portrait_ui(self)
        update_global_ui_buttons(self)
        if self.ui.level_buttons then
            local current_idx = self.current_level_index or 1
            for i, btn in ipairs(self.ui.level_buttons) do
                if btn then
                    if DEBUG_LEVEL_BUTTONS_ENABLED == true then
                        local bx = get_level_button_screen_x(i)
                        local active = (i == current_idx)
                        local col = active and vmath.vector4(0.2, 0.85, 0.35, 0.95) or vmath.vector4(0.2, 0.6, 0.95, 0.9)
                        set_ui_square_transform(self, btn, bx, LEVEL_BUTTON_Y, LEVEL_BUTTON_Z, col, LEVEL_BUTTON_W, LEVEL_BUTTON_H)
                    else
                        set_ui_square_transform(self, btn, -9999, -9999, LEVEL_BUTTON_Z, vmath.vector4(0, 0, 0, 0), LEVEL_BUTTON_W, LEVEL_BUTTON_H)
                    end
                end
            end
        end
        set_ui_square_transform(
            self,
            self.ui.reactive_toggle_button,
            -9999,
            -9999,
            0.84,
            vmath.vector4(0, 0, 0, 0),
            64,
            32
        )
        set_ui_square_transform(
            self,
            self.ui.reactive_advance_button,
            -9999,
            -9999,
            0.84,
            vmath.vector4(0, 0, 0, 0),
            70,
            30
        )
        close_comms_panel(self)
        return
    end
    local ui_feedback = record_ui_action_feedback_snapshot(self, unit)
    if self.human_ui_panel_open ~= true then
        local unit_id = tostring(unit.id or "")
        if self.human_ui_panel_hidden_for_unit_id ~= unit_id then
            hide_selected_unit_panel_ui(self)
            self.human_ui_panel_hidden_for_unit_id = unit_id
        end
        update_global_ui_buttons(self)
        update_human_portrait_ui(self)
        return
    end
    self.human_ui_panel_hidden_for_unit_id = nil
    local hp_fill_alpha = ui_feedback_alpha_from_timer(ui_feedback and ui_feedback.hp_gain_timer_s or 0)
    local ammo_fill_alpha = ui_feedback_alpha_from_timer(ui_feedback and ui_feedback.ammo_gain_timer_s or 0)

    local panel_dx = (tonumber(UI_PANEL_X or 0) or 0) - (tonumber(HUD_LAYOUT_BASE_UI_PANEL_X or UI_PANEL_X or 0) or 0)
    local panel_dy = (tonumber(UI_PANEL_Y or 0) or 0) - (tonumber(HUD_LAYOUT_BASE_UI_PANEL_Y or UI_PANEL_Y or 0) or 0)
    local panel_shadow_alpha = get_ui_panel_shadow_alpha(self)
    set_ui_panel_transform(
        self,
        self.ui.panel_shadow,
        UI_PANEL_X + 14,
        UI_PANEL_Y - 12,
        0.79,
        UI_PANEL_W,
        UI_PANEL_H,
        vmath.vector4(0, 0, 0, panel_shadow_alpha)
    )
    set_ui_panel_transform(self, self.ui.panel_art, UI_PANEL_X, UI_PANEL_Y, 0.8, UI_PANEL_W, UI_PANEL_H, vmath.vector4(1, 1, 1, 1))
    local panel_anim = get_unit_panel_anim(unit)
    if panel_anim ~= self.ui_panel_anim then
        msg.post(msg.url(nil, self.ui.panel_art, "sprite"), "play_animation", { id = panel_anim })
        self.ui_panel_anim = panel_anim
    end
    local show_not_enough_ap_icon = false
    if self.derple_feedback_by_unit_id and self.derple_feedback_entries and unit.id then
        local entry_index = self.derple_feedback_by_unit_id[unit.id]
        local entry = entry_index and self.derple_feedback_entries[entry_index] or nil
        show_not_enough_ap_icon = entry
            and entry.event_type == "NOT_ENOUGH_AP"
            and (entry.ttl or 0) > 0
            and entry.go_id ~= nil
            and true
            or false
    end
    if show_not_enough_ap_icon then
        set_ui_square_transform(
            self,
            self.ui.not_enough_ap_icon,
            UI_PANEL_X + (UI_PANEL_W * 0.5) + 23,
            UI_PANEL_Y + (UI_PANEL_H * 0.5) + 3,
            0.835,
            vmath.vector4(1, 1, 1, 1),
            0.81,
            0.81
        )
    else
        set_ui_square_transform(self, self.ui.not_enough_ap_icon, -9999, -9999, 0.835, vmath.vector4(0, 0, 0, 0), 0.81, 0.81)
    end

    for i = 1, UI_MAX_PIPS do
        local pip_step = (UI_BAR_PIP_SIZE + UI_BAR_PIP_GAP) * 0.8
        local pip_y = (UI_BAR_START_Y - 32) - (i - 1) * pip_step
        local pip_h = UI_BAR_PIP_SIZE * 0.8
        local ap_count = math.min(unit.current_ap or 0, UI_MAX_PIPS)
        local hp_count = math.min(unit.current_health or 0, UI_MAX_PIPS)
        local ammo_count = math.min(unit.current_ammo or 0, UI_MAX_PIPS)
        -- Count "down": higher pips drain first as values decrease.
        local ap_on = i > (UI_MAX_PIPS - ap_count)
        local hp_on = i > (UI_MAX_PIPS - hp_count)
        local ammo_on = i > (UI_MAX_PIPS - ammo_count)
        local ap_color = ap_on and UI_COLOR_AP or vmath.vector4(UI_COLOR_AP.x, UI_COLOR_AP.y, UI_COLOR_AP.z, 0.2)
        local hp_color = hp_on
            and vmath.vector4(UI_COLOR_HP.x, UI_COLOR_HP.y, UI_COLOR_HP.z, hp_fill_alpha)
            or vmath.vector4(UI_COLOR_HP.x, UI_COLOR_HP.y, UI_COLOR_HP.z, 0.2)
        local ammo_color = ammo_on
            and vmath.vector4(UI_COLOR_AMMO.x, UI_COLOR_AMMO.y, UI_COLOR_AMMO.z, ammo_fill_alpha)
            or vmath.vector4(UI_COLOR_AMMO.x, UI_COLOR_AMMO.y, UI_COLOR_AMMO.z, 0.2)

        set_ui_square_transform(self, self.ui.ap_pips[i], UI_BAR_AP_X + panel_dx, pip_y + panel_dy, HUMAN_UI_BASE_Z, ap_color, UI_BAR_PIP_SIZE, pip_h)
        set_ui_square_transform(self, self.ui.hp_pips[i], UI_BAR_HP_X + panel_dx, pip_y + panel_dy, HUMAN_UI_BASE_Z, hp_color, UI_BAR_PIP_SIZE, pip_h)
        set_ui_square_transform(self, self.ui.ammo_pips[i], UI_BAR_AMMO_X + panel_dx, pip_y + panel_dy, HUMAN_UI_BASE_Z, ammo_color, UI_BAR_PIP_SIZE, pip_h)
    end
    local flamer_shots = 0
    if unit_has_equipped_buff_kind(unit, "flamer")
        and CLEANSE_RUNTIME
        and CLEANSE_RUNTIME.cleanse_get_flamer_shots
    then
        flamer_shots = math.max(0, math.floor((tonumber(CLEANSE_RUNTIME.cleanse_get_flamer_shots(self, unit) or 0) or 0) + 0.5))
    end
    if self.ui.flamer_ammo_icons then
        local max_icons = #self.ui.flamer_ammo_icons
        local consumed = math.max(0, max_icons - flamer_shots)
        local icon_x = (UI_PANEL_X + (UI_PANEL_W * 0.5) + 28)
        local top_y = (UI_PANEL_Y + 140)
        local step_y = 24
        local flamer_icon_scale = (70 * 0.021) * 0.5 * 0.75 * 0.5
        for i, icon_id in ipairs(self.ui.flamer_ammo_icons) do
            if i > consumed and flamer_shots > 0 then
                local icon_y = top_y - ((i - 1) * step_y)
                set_ui_square_transform(self, icon_id, icon_x, icon_y, HUMAN_UI_COMMAND_ICON_Z, vmath.vector4(1, 1, 1, 1), flamer_icon_scale, flamer_icon_scale)
            else
                set_ui_square_transform(self, icon_id, -9999, -9999, HUMAN_UI_COMMAND_ICON_Z, vmath.vector4(0, 0, 0, 0), flamer_icon_scale, flamer_icon_scale)
            end
        end
    end

    local show_command = unit.class_id == UNIT_CLASS_SARGE
    local command_count = show_command and math.min(unit.command_points or 0, COMMAND_UI.max_pips) or 0
    for i = 1, COMMAND_UI.max_pips do
        local cx, cy = LOOT_RUNTIME.get_command_pip_screen_pos(i)
        local command_color = (i <= command_count) and COMMAND_UI.active_color or COMMAND_UI.inactive_color
        if self.drag_resource and self.drag_resource.active and self.drag_resource.drag_type == "command" and self.drag_resource.source_slot_index == i then
            command_color = vmath.vector4(command_color.x, command_color.y, command_color.z, 0.25)
        end
        if show_command then
            set_ui_square_transform(self, self.ui.command_pips[i], cx, cy, HUMAN_UI_BASE_Z, vmath.vector4(0.08, 0.08, 0.1, 0.22), COMMAND_UI.pip_size, COMMAND_UI.pip_size)
            set_ui_square_transform(self, self.ui.command_pip_icons[i], cx, cy, HUMAN_UI_COMMAND_ICON_Z, command_color, COMMAND_UI.pip_size * 0.021 * 0.75, COMMAND_UI.pip_size * 0.021 * 0.75)
        else
            set_ui_square_transform(self, self.ui.command_pips[i], -9999, -9999, HUMAN_UI_BASE_Z, vmath.vector4(0, 0, 0, 0), COMMAND_UI.pip_size, COMMAND_UI.pip_size)
            set_ui_square_transform(self, self.ui.command_pip_icons[i], -9999, -9999, HUMAN_UI_COMMAND_ICON_Z, vmath.vector4(0, 0, 0, 0), COMMAND_UI.pip_size * 0.021 * 0.75, COMMAND_UI.pip_size * 0.021 * 0.75)
        end
    end

    local total_slots = UI_BACKPACK_COLS * UI_BACKPACK_ROWS
    local full_backpack_item_type = nil
    if unit.backpack_items and total_slots > 0 and #unit.backpack_items == total_slots then
        local first_item_type = unit.backpack_items[1]
        if first_item_type == "turret_packed" or first_item_type == "corpse" then
            full_backpack_item_type = first_item_type
        end
        for i = 1, total_slots do
            if unit.backpack_items[i] ~= full_backpack_item_type then
                full_backpack_item_type = nil
                break
            end
        end
    end
    for i = 1, total_slots do
        local slot_x, slot_y = LOOT_RUNTIME.get_backpack_slot_screen_pos(i)
        local item_type = unit.backpack_items and unit.backpack_items[i] or nil
        local slot_color = UI_COLOR_SLOT
        local icon_anim = nil
        if not full_backpack_item_type then
            icon_anim = LOOT_RUNTIME.get_item_visual_animation and LOOT_RUNTIME.get_item_visual_animation(item_type) or nil
        end
        if self.drag_resource and self.drag_resource.active and self.drag_resource.source_unit_id == unit.id and self.drag_resource.source_slot_index == i then
            slot_color = vmath.vector4(slot_color.x, slot_color.y, slot_color.z, 0.25)
        end
        set_ui_square_transform(self, self.ui.backpack_slots[i], slot_x, slot_y, HUMAN_UI_BASE_Z, slot_color, UI_BACKPACK_SLOT_SIZE, UI_BACKPACK_SLOT_SIZE)
        if icon_anim then
            local icon_color = vmath.vector4(1, 1, 1, 1)
            if self.drag_resource and self.drag_resource.active and self.drag_resource.source_unit_id == unit.id and self.drag_resource.source_slot_index == i then
                icon_color = vmath.vector4(1, 1, 1, 0.25)
            end
            msg.post(msg.url(nil, self.ui.backpack_item_icons[i], "sprite"), "play_animation", { id = icon_anim })
            local icon_scale_x = UI_BACKPACK_SLOT_SIZE * 0.021
            local icon_scale_y = UI_BACKPACK_SLOT_SIZE * 0.021
            local buff_def = item_type and BUFFS_BY_ITEM_TYPE[item_type] or nil
            if buff_def then
                local draw_w = math.max(1, tonumber(buff_def.ui_pixel_w or UI_BACKPACK_SLOT_SIZE) or UI_BACKPACK_SLOT_SIZE)
                local draw_h = math.max(1, tonumber(buff_def.ui_pixel_h or UI_BACKPACK_SLOT_SIZE) or UI_BACKPACK_SLOT_SIZE)
                local draw_scale = tonumber(buff_def.backpack_draw_scale or 1.0) or 1.0
                icon_scale_x = (draw_w * 0.021) * draw_scale
                icon_scale_y = (draw_h * 0.021) * draw_scale
            end
            set_ui_square_transform(self, self.ui.backpack_item_icons[i], slot_x, slot_y, HUMAN_UI_BACKPACK_ICON_Z, icon_color, icon_scale_x, icon_scale_y)
        else
            set_ui_square_transform(self, self.ui.backpack_item_icons[i], -9999, -9999, HUMAN_UI_BACKPACK_ICON_Z, vmath.vector4(0, 0, 0, 0), UI_BACKPACK_SLOT_SIZE * 0.021, UI_BACKPACK_SLOT_SIZE * 0.021)
        end
    end
    if full_backpack_item_type and total_slots > 0 then
        local first_x, first_y = LOOT_RUNTIME.get_backpack_slot_screen_pos(1)
        local last_x, last_y = LOOT_RUNTIME.get_backpack_slot_screen_pos(total_slots)
        local center_x = (first_x + last_x) * 0.5
        local center_y = ((first_y + last_y) * 0.5) + 10
        local grid_w = math.abs(last_x - first_x) + UI_BACKPACK_SLOT_SIZE
        local grid_h = math.abs(last_y - first_y) + UI_BACKPACK_SLOT_SIZE
        local packed_turret_ui_scale = 0.021 * 0.576
        local packed_item_ui_scale_x = packed_turret_ui_scale
        local packed_item_ui_scale_y = packed_turret_ui_scale
        local packed_alpha = 1
        local full_backpack_anim = hash("gun_turret_icon")
        if full_backpack_item_type == "corpse" then
            full_backpack_anim = hash("human_dead_ui")
            local corpse_base_scale = packed_turret_ui_scale * 0.5
            packed_item_ui_scale_x = corpse_base_scale * 0.8
            packed_item_ui_scale_y = corpse_base_scale * 0.6
        end
        if self.drag_resource
            and self.drag_resource.active
            and self.drag_resource.source_unit_id == unit.id
            and self.drag_resource.drag_type == "resource"
            and unit.backpack_items
            and unit.backpack_items[self.drag_resource.source_slot_index] == full_backpack_item_type
        then
            packed_alpha = 0.25
        end
        msg.post(msg.url(nil, self.ui.backpack_item_icons[1], "sprite"), "play_animation", { id = full_backpack_anim })
        set_ui_square_transform(
            self,
            self.ui.backpack_item_icons[1],
            center_x,
            center_y,
            HUMAN_UI_BACKPACK_ICON_Z,
            vmath.vector4(1, 1, 1, packed_alpha),
            grid_w * packed_item_ui_scale_x,
            grid_h * packed_item_ui_scale_y
        )
    end

    local equipment = unit.equipment or {}
    local hotspot_cx = UI_PANEL_X + BUFF_DROP_ZONE_OFFSET_X
    local hotspot_cy = UI_PANEL_Y + BUFF_DROP_ZONE_OFFSET_Y
    for i, slot_name in ipairs(BUFF_SLOT_ORDER) do
        local anchor = BUFF_SLOT_RELATIVE_OFFSETS[slot_name] or { x = 0, y = 0 }
        local slot_x = hotspot_cx + (anchor.x or 0)
        local slot_y = hotspot_cy + (anchor.y or 0)
        local slot_tint = vmath.vector4(0.16, 0.2, 0.18, 0.85)
        if self.drag_resource and self.drag_resource.active and self.drag_resource.drag_type == "equipped_buff" and self.drag_resource.source_unit_id == unit.id and self.drag_resource.source_slot_name == slot_name then
            slot_tint = vmath.vector4(slot_tint.x, slot_tint.y, slot_tint.z, 0.35)
        end
        set_ui_square_transform(self, self.ui.buff_slots[i], slot_x, slot_y, HUMAN_UI_BUFF_SLOT_Z, slot_tint, BUFF_SLOT_FRAME_SIZE, BUFF_SLOT_FRAME_SIZE)
        local equipped_item = equipment[slot_name]
        local buff_def = equipped_item and BUFFS_BY_ITEM_TYPE[equipped_item] or nil
        if buff_def and buff_def.ui_anim then
            local icon_go = self.ui.buff_item_icons[i]
            local icon_color = vmath.vector4(1, 1, 1, 1)
            if self.drag_resource and self.drag_resource.active and self.drag_resource.drag_type == "equipped_buff" and self.drag_resource.source_unit_id == unit.id and self.drag_resource.source_slot_name == slot_name then
                icon_color = vmath.vector4(1, 1, 1, 0.35)
            else
                local buff_fade_alpha = ui_feedback_alpha_from_timer(ui_feedback and ui_feedback.buff_gain_timer_by_slot and ui_feedback.buff_gain_timer_by_slot[slot_name] or 0)
                icon_color = vmath.vector4(1, 1, 1, buff_fade_alpha)
            end
            msg.post(msg.url(nil, icon_go, "sprite"), "play_animation", { id = hash(buff_def.ui_anim) })
            local draw_w = math.max(1, tonumber(buff_def.ui_pixel_w or BUFF_SLOT_FRAME_SIZE) or BUFF_SLOT_FRAME_SIZE)
            local draw_h = math.max(1, tonumber(buff_def.ui_pixel_h or BUFF_SLOT_FRAME_SIZE) or BUFF_SLOT_FRAME_SIZE)
            local draw_scale = tonumber(buff_def.equipped_draw_scale or buff_def.backpack_draw_scale or 1.0) or 1.0
            set_ui_square_transform(self, icon_go, slot_x, slot_y, HUMAN_UI_BUFF_ICON_Z, icon_color, (draw_w * 0.021) * draw_scale, (draw_h * 0.021) * draw_scale)
        else
            set_ui_square_transform(self, self.ui.buff_item_icons[i], -9999, -9999, HUMAN_UI_BUFF_ICON_Z, vmath.vector4(0, 0, 0, 0), 1, 1)
        end
    end

    set_ui_square_transform(self, self.ui.component_button, -9999, -9999, 0.82, vmath.vector4(0, 0, 0, 0), COMPONENT_UI.button_size, COMPONENT_UI.button_size)
    set_ui_square_transform(self, self.ui.fix_button, -9999, -9999, 0.82, vmath.vector4(0, 0, 0, 0), COMPONENT_UI.fix_button_size, COMPONENT_UI.fix_button_size)
    set_ui_square_transform(self, self.ui.loot_button, -9999, -9999, 0.82, vmath.vector4(0, 0, 0, 0), LOOT_UI.button_size, LOOT_UI.button_size)
    set_ui_square_transform(self, self.ui.retrieve_button, -9999, -9999, 0.82, vmath.vector4(0, 0, 0, 0), LOOT_UI.retrieve_button_size, LOOT_UI.retrieve_button_size)
    local comms_visible = should_show_comms_ui(self, unit)
    if not comms_visible then
        close_comms_panel(self)
    end
    if comms_visible then
        local toggle_tint = self.comms_panel_open and vmath.vector4(1, 1, 1, 1) or vmath.vector4(1, 1, 1, 0.75)
        set_ui_square_transform(self, self.ui.comms_toggle_button, COMMS_TOGGLE_BTN_X, COMMS_TOGGLE_BTN_Y, COMMS_TOGGLE_BTN_Z, toggle_tint, COMMS_TOGGLE_BTN_DRAW, COMMS_TOGGLE_BTN_DRAW)
    else
        set_ui_square_transform(self, self.ui.comms_toggle_button, -9999, -9999, COMMS_TOGGLE_BTN_Z, vmath.vector4(0, 0, 0, 0), COMMS_TOGGLE_BTN_DRAW, COMMS_TOGGLE_BTN_DRAW)
    end
    if comms_visible and self.comms_panel_open then
        set_ui_panel_transform(self, self.ui.comms_panel, COMMS_PANEL_X, COMMS_PANEL_Y, COMMS_PANEL_Z, COMMS_PANEL_W, COMMS_PANEL_H, vmath.vector4(1, 1, 1, 1))
    else
        set_ui_panel_transform(self, self.ui.comms_panel, -9999, -9999, COMMS_PANEL_Z, COMMS_PANEL_W, COMMS_PANEL_H, vmath.vector4(0, 0, 0, 0))
    end
    local close_button_x, close_button_y = get_ui_panel_close_button_center()
    set_ui_square_transform(
        self,
        self.ui.close_button,
        close_button_x,
        close_button_y,
        0.83,
        vmath.vector4(0, 0, 0, 0),
        28,
        28
    )
    local reactive_button_x, reactive_button_y = get_ui_panel_reactive_button_center()
    local unit_reactive_enabled = unit.reactive_fire_enabled ~= false
    local toggle_color = unit_reactive_enabled and vmath.vector4(0.2, 0.8, 0.2, 0.95) or vmath.vector4(0.8, 0.2, 0.2, 0.95)
    set_ui_square_transform(
        self,
        self.ui.reactive_toggle_button,
        reactive_button_x,
        reactive_button_y,
        0.84,
        toggle_color,
        64,
        32
    )
    if self.alien_turn_active and (not self.reactive_combat_enabled) then
        local adv_color = self.alien_turn_waiting_for_advance and vmath.vector4(0.2, 0.8, 0.2, 0.95) or vmath.vector4(0.8, 0.2, 0.2, 0.95)
        set_ui_square_transform(
            self,
            self.ui.reactive_advance_button,
            105,
            SCREEN_HEIGHT - 40,
            0.84,
            adv_color,
            70,
            30
        )
    else
        set_ui_square_transform(
            self,
            self.ui.reactive_advance_button,
            -9999,
            -9999,
            0.84,
            vmath.vector4(0, 0, 0, 0),
            70,
            30
        )
    end
    update_global_ui_buttons(self)
    update_human_portrait_ui(self)
end

local function is_point_in_ui_panel(screen_x, screen_y)
    local min_x = UI_PANEL_X - UI_PANEL_W * 0.5
    local max_x = UI_PANEL_X + UI_PANEL_W * 0.5
    local min_y = UI_PANEL_Y - UI_PANEL_H * 0.5
    local max_y = UI_PANEL_Y + UI_PANEL_H * 0.5
    return screen_x >= min_x and screen_x <= max_x and screen_y >= min_y and screen_y <= max_y
end

get_human_portrait_screen_pos = function(slot_index)
    local step_y = HUMAN_PORTRAIT_DRAW_H + HUMAN_PORTRAIT_GAP_Y
    return HUMAN_PORTRAIT_START_X, HUMAN_PORTRAIT_START_Y - ((slot_index - 1) * step_y)
end

get_visible_human_portrait_unit_ids = function(self)
    local visible_ids = {}
    for _, unit_id in ipairs(HUMAN_PORTRAIT_IDS) do
        table.insert(visible_ids, unit_id)
    end
    return visible_ids
end

center_camera_on_unit = function(self, unit)
    if not (self and unit) then
        return
    end
    local ux, uy = nil, nil
    if unit.go_path then
        local p = go.get_position(unit.go_path)
        ux = p and p.x or nil
        uy = p and p.y or nil
    end
    if (not ux or not uy) and unit.cell_id then
        local cx, cy = id_to_coords(unit.cell_id)
        if cx and cy then
            ux = ((cx - 1) * CELL_WIDTH) + (CELL_WIDTH * 0.5)
            uy = ((cy - 1) * CELL_HEIGHT) + (CELL_HEIGHT * 0.5)
        end
    end
    if ux and uy then
        self.camera_pos.x = ux
        self.camera_pos.y = uy
        apply_camera_transform(self)
    end
end

update_human_portrait_ui = function(self)
    if not (self and self.ui and self.ui.human_portrait_icons) then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    local visible_ids = get_visible_human_portrait_unit_ids(self)
    self.human_portrait_visible_unit_ids = visible_ids
    for i, icon in ipairs(self.ui.human_portrait_icons) do
        local unit_id = visible_ids[i]
        if unit_id then
            local sx, sy = get_human_portrait_screen_pos(i)
            local unit = self.squad_units and self.squad_units[unit_id] or nil
            local alive = unit and (unit.current_health or 0) > 0
            local selected = unit and unit.is_selected and (self.controlled_unit_id == unit_id)
            local owned = (not (self.mp_state and self.mp_state.enabled)) or multiplayer_can_control_unit(self, unit_id)
            local tint = vmath.vector4(0.85, 0.85, 0.85, 1)
            if not owned then
                tint = vmath.vector4(0.35, 0.35, 0.35, 0.75)
            end
            if not alive then
                tint = vmath.vector4(0.4, 0.4, 0.4, 0.7)
            end
            set_ui_square_transform(
                self,
                icon,
                sx,
                sy,
                HUMAN_PORTRAIT_Z,
                tint,
                HUMAN_PORTRAIT_DRAW_W * 0.021,
                HUMAN_PORTRAIT_DRAW_H * 0.021
            )
            if self.ui.human_portrait_selected_overlays and self.ui.human_portrait_selected_overlays[i] then
                local overlay_tint = hidden
                local hit_timer = alive and math.max(0, tonumber(unit and unit.portrait_hit_flash_timer or 0) or 0) or 0
                if hit_timer > 0 then
                    local duration = math.max(0.001, tonumber(unit.portrait_hit_flash_duration or HUMAN_PORTRAIT_HIT_FLASH_DURATION) or HUMAN_PORTRAIT_HIT_FLASH_DURATION)
                    local alpha = math.max(0, math.min(1, hit_timer / duration))
                    overlay_tint = vmath.vector4(1.0, 0.1, 0.1, alpha)
                elseif selected then
                    overlay_tint = vmath.vector4(0.25, 1.45, 0.25, 1)
                end
                set_ui_square_transform(
                    self,
                    self.ui.human_portrait_selected_overlays[i],
                    sx,
                    sy,
                    HUMAN_PORTRAIT_SELECTED_Z,
                    overlay_tint,
                    HUMAN_PORTRAIT_DRAW_W * 0.021,
                    HUMAN_PORTRAIT_DRAW_H * 0.021
                )
            end
            local ap_blips = self.ui.human_portrait_ap_blips and self.ui.human_portrait_ap_blips[i] or nil
            local hp_blips = self.ui.human_portrait_hp_blips and self.ui.human_portrait_hp_blips[i] or nil
            local ap_count = math.max(0, math.min(HUMAN_PORTRAIT_BAR_BLIP_COUNT, math.floor((unit and unit.current_ap or 0) + 0.5)))
            local hp_count = math.max(0, math.min(HUMAN_PORTRAIT_BAR_BLIP_COUNT, math.floor((unit and unit.current_health or 0) + 0.5)))
            local ap_on = vmath.vector4(UI_COLOR_AP.x, UI_COLOR_AP.y, UI_COLOR_AP.z, 1)
            local ap_off = vmath.vector4(UI_COLOR_AP.x, UI_COLOR_AP.y, UI_COLOR_AP.z, HUMAN_PORTRAIT_BAR_OFF_ALPHA)
            local hp_on = vmath.vector4(UI_COLOR_HP.x, UI_COLOR_HP.y, UI_COLOR_HP.z, 1)
            local hp_off = vmath.vector4(UI_COLOR_HP.x, UI_COLOR_HP.y, UI_COLOR_HP.z, HUMAN_PORTRAIT_BAR_OFF_ALPHA)
            for pip_idx = 1, HUMAN_PORTRAIT_BAR_BLIP_COUNT do
                local pip_x = sx + HUMAN_PORTRAIT_BAR_START_X_OFFSET + ((pip_idx - 1) * HUMAN_PORTRAIT_BAR_BLIP_W)
                if ap_blips and ap_blips[pip_idx] then
                    local ap_tint = (pip_idx <= ap_count) and ap_on or ap_off
                    set_ui_square_transform(
                        self,
                        ap_blips[pip_idx],
                        pip_x,
                        sy + HUMAN_PORTRAIT_BAR_AP_Y_OFFSET,
                        HUMAN_PORTRAIT_SELECTED_Z + 0.001,
                        ap_tint,
                        HUMAN_PORTRAIT_BAR_BLIP_W,
                        HUMAN_PORTRAIT_BAR_BLIP_H
                    )
                end
                if hp_blips and hp_blips[pip_idx] then
                    local hp_tint = (pip_idx <= hp_count) and hp_on or hp_off
                    set_ui_square_transform(
                        self,
                        hp_blips[pip_idx],
                        pip_x,
                        sy + HUMAN_PORTRAIT_BAR_HP_Y_OFFSET,
                        HUMAN_PORTRAIT_SELECTED_Z + 0.001,
                        hp_tint,
                        HUMAN_PORTRAIT_BAR_BLIP_W,
                        HUMAN_PORTRAIT_BAR_BLIP_H
                    )
                end
            end
            if self.ui.human_portrait_hitbox_debug then
                local hx, hy = get_human_portrait_screen_pos(i)
                local hitbox_tint = HUMAN_PORTRAIT_HITBOX_DEBUG_VISIBLE
                    and vmath.vector4(0.1, 1.0, 0.25, 0)
                    or hidden
                set_ui_square_transform(
                    self,
                    self.ui.human_portrait_hitbox_debug[i],
                    hx,
                    hy,
                    HUMAN_PORTRAIT_HITBOX_DEBUG_Z,
                    hitbox_tint,
                    HUMAN_PORTRAIT_HIT_W,
                    HUMAN_PORTRAIT_HIT_H
                )
            end
        else
            set_ui_square_transform(self, icon, -9999, -9999, HUMAN_PORTRAIT_Z, hidden, HUMAN_PORTRAIT_DRAW_W * 0.021, HUMAN_PORTRAIT_DRAW_H * 0.021)
            if self.ui.human_portrait_selected_overlays and self.ui.human_portrait_selected_overlays[i] then
                set_ui_square_transform(
                    self,
                    self.ui.human_portrait_selected_overlays[i],
                    -9999,
                    -9999,
                    HUMAN_PORTRAIT_SELECTED_Z,
                    hidden,
                    HUMAN_PORTRAIT_DRAW_W * 0.021,
                    HUMAN_PORTRAIT_DRAW_H * 0.021
                )
            end
            local ap_blips = self.ui.human_portrait_ap_blips and self.ui.human_portrait_ap_blips[i] or nil
            local hp_blips = self.ui.human_portrait_hp_blips and self.ui.human_portrait_hp_blips[i] or nil
            for pip_idx = 1, HUMAN_PORTRAIT_BAR_BLIP_COUNT do
                if ap_blips and ap_blips[pip_idx] then
                    set_ui_square_transform(
                        self,
                        ap_blips[pip_idx],
                        -9999,
                        -9999,
                        HUMAN_PORTRAIT_SELECTED_Z + 0.001,
                        hidden,
                        HUMAN_PORTRAIT_BAR_BLIP_W,
                        HUMAN_PORTRAIT_BAR_BLIP_H
                    )
                end
                if hp_blips and hp_blips[pip_idx] then
                    set_ui_square_transform(
                        self,
                        hp_blips[pip_idx],
                        -9999,
                        -9999,
                        HUMAN_PORTRAIT_SELECTED_Z + 0.001,
                        hidden,
                        HUMAN_PORTRAIT_BAR_BLIP_W,
                        HUMAN_PORTRAIT_BAR_BLIP_H
                    )
                end
            end
            if self.ui.human_portrait_hitbox_debug then
                set_ui_square_transform(self, self.ui.human_portrait_hitbox_debug[i], -9999, -9999, HUMAN_PORTRAIT_HITBOX_DEBUG_Z, hidden, HUMAN_PORTRAIT_HIT_W, HUMAN_PORTRAIT_HIT_H)
            end
        end
    end
end

trigger_human_portrait_hit_feedback = function(self, unit, damage_amount, suppress_mp_emit)
    if not (self and unit and (unit.current_health or 0) > 0) then
        return
    end
    local damage = math.max(0, math.floor((tonumber(damage_amount or 0) or 0) + 0.0001))
    if damage <= 0 then
        return
    end
    unit.portrait_hit_flash_duration = HUMAN_PORTRAIT_HIT_FLASH_DURATION
    unit.portrait_hit_flash_timer = HUMAN_PORTRAIT_HIT_FLASH_DURATION
    unit.portrait_hit_flash_phase = 0
    if LOOT_RUNTIME and LOOT_RUNTIME.spawn_impact_ring_at_world and self.camera_pos and self.camera_zoom then
        local portrait_slot = nil
        for i, unit_id in ipairs(HUMAN_PORTRAIT_IDS or {}) do
            if tostring(unit_id) == tostring(unit.id) then
                portrait_slot = i
                break
            end
        end
        if portrait_slot then
            local px, py = get_human_portrait_screen_pos(portrait_slot)
            px = (tonumber(px or 0) or 0) + (tonumber(HUMAN_PORTRAIT_DAMAGE_RING_X_OFFSET or 0) or 0)
            local wx, wy = screen_to_world(px, py, self.camera_pos, self.camera_zoom)
            if wx and wy then
                LOOT_RUNTIME.spawn_impact_ring_at_world(self, wx, wy, vmath.vector4(1.0, 0.16, 0.16, 1), 0.6)
            end
        end
    end
    if suppress_mp_emit ~= true then
        multiplayer_emit_combat_fx_event(self, {
            fx_type = "human_damage_feedback",
            target_id = unit.id,
            damage = damage
        })
    end
end

local function tick_human_portrait_hit_feedback(self, dt)
    if not (self and self.squad_units) then
        return
    end
    local dt_step = math.max(0, tonumber(dt or 0) or 0)
    if dt_step <= 0 then
        return
    end
    local flicker_speed = (math.pi * 2) * HUMAN_PORTRAIT_HIT_FLICKER_HZ
    for _, unit in pairs(self.squad_units) do
        local remaining = math.max(0, tonumber(unit and unit.portrait_hit_flash_timer or 0) or 0)
        if remaining > 0 and unit then
            unit.portrait_hit_flash_timer = math.max(0, remaining - dt_step)
            unit.portrait_hit_flash_phase = (tonumber(unit.portrait_hit_flash_phase or 0) or 0) + (dt_step * flicker_speed)
        end
        local selection_green_remaining = math.max(0, tonumber(unit and unit.selection_green_flash_timer or 0) or 0)
        if selection_green_remaining > 0 and unit then
            unit.selection_green_flash_timer = math.max(0, selection_green_remaining - dt_step)
        end
    end
end

try_select_human_portrait = function(self, screen_x, screen_y)
    if not (self and self.squad_units and self.ui and self.ui.human_portrait_icons) then
        return false
    end
    local visible_ids = self.human_portrait_visible_unit_ids or get_visible_human_portrait_unit_ids(self)
    local chosen_unit_id = nil
    local best_dist_sq = math.huge
    for i, unit_id in ipairs(visible_ids) do
        local cx, cy = get_human_portrait_screen_pos(i)
        if is_point_in_screen_rect(screen_x, screen_y, cx, cy, HUMAN_PORTRAIT_HIT_W, HUMAN_PORTRAIT_HIT_H) then
            local dx = (screen_x or cx) - cx
            local dy = (screen_y or cy) - cy
            local dist_sq = (dx * dx) + (dy * dy)
            if dist_sq < best_dist_sq then
                best_dist_sq = dist_sq
                chosen_unit_id = unit_id
            end
        end
    end
    if not chosen_unit_id then
        return false
    end
    local unit = self.squad_units[chosen_unit_id]
    if self.mp_state and self.mp_state.enabled and not multiplayer_can_control_unit(self, chosen_unit_id) then
        return true
    end
    if unit and (unit.current_health or 0) > 0 then
        local was_selected = self.controlled_unit_id == chosen_unit_id and unit.is_selected == true
        if self.controlled_unit_id ~= chosen_unit_id then
            clear_locked_manual_target(self)
        end
        self.controlled_unit_id = chosen_unit_id
        deselect_all_units(self)
        unit.is_selected = true
        self.camera_follow_disabled_by_pan = false
        self.ui_close_on_next_non_unit_click = false
        self.awaiting_slot_shuffle_click = false
        self.selected_start_cell = nil
        self.human_ui_panel_open = was_selected == true
        mark_selected_unit_panel_dirty(self)
        close_comms_panel(self)
        play_human_confirm_select_sfx(self, unit)
        local unit_world_x = nil
        local unit_world_y = nil
        if unit.go_path then
            local pos = go.get_position(unit.go_path)
            unit_world_x = pos and pos.x or nil
            unit_world_y = pos and pos.y or nil
        end
        if (not unit_world_x or not unit_world_y) and unit.cell_id then
            local ucx, ucy = id_to_coords(unit.cell_id)
            if ucx and ucy then
                unit_world_x = ((ucx - 1) * CELL_WIDTH) + (CELL_WIDTH * 0.5)
                unit_world_y = ((ucy - 1) * CELL_HEIGHT) + (CELL_HEIGHT * 0.5)
            end
        end
        local unit_on_screen = false
        if unit_world_x and unit_world_y and self.camera_pos and self.camera_zoom then
            local screen_unit_x = ((unit_world_x - self.camera_pos.x) * self.camera_zoom) + (SCREEN_WIDTH * 0.5)
            local screen_unit_y = ((unit_world_y - self.camera_pos.y) * self.camera_zoom) + (SCREEN_HEIGHT * 0.5)
            local margin = 48
            unit_on_screen = screen_unit_x >= margin
                and screen_unit_x <= (SCREEN_WIDTH - margin)
                and screen_unit_y >= margin
                and screen_unit_y <= (SCREEN_HEIGHT - margin)
        end
        if not unit_on_screen then
            center_camera_on_unit(self, unit)
        end
        if not was_selected then
            spawn_green_impact_ring_for_unit(self, unit, 0.6)
            unit.selection_green_flash_duration = HUMAN_SELECTION_GREEN_FLASH_DURATION
            unit.selection_green_flash_timer = HUMAN_SELECTION_GREEN_FLASH_DURATION
        end
        update_human_visual_state(self)
        update_selected_unit_ui(self)
    end
    return true
end

get_human_portrait_unit_id_at = function(self, screen_x, screen_y)
    if not (self and self.squad_units and self.ui and self.ui.human_portrait_icons) then
        return nil
    end
    local visible_ids = self.human_portrait_visible_unit_ids or get_visible_human_portrait_unit_ids(self)
    local chosen_unit_id = nil
    local best_dist_sq = math.huge
    for i, unit_id in ipairs(visible_ids) do
        local cx, cy = get_human_portrait_screen_pos(i)
        if is_point_in_screen_rect(screen_x, screen_y, cx, cy, HUMAN_PORTRAIT_HIT_W, HUMAN_PORTRAIT_HIT_H) then
            local dx = (screen_x or cx) - cx
            local dy = (screen_y or cy) - cy
            local dist_sq = (dx * dx) + (dy * dy)
            if dist_sq < best_dist_sq then
                best_dist_sq = dist_sq
                chosen_unit_id = unit_id
            end
        end
    end
    return chosen_unit_id
end

function is_point_in_close_ui_button(screen_x, screen_y)
    local button_x, button_y = get_ui_panel_close_button_center()
    local half = 14
    return screen_x >= (button_x - half)
        and screen_x <= (button_x + half)
        and screen_y >= (button_y - half)
        and screen_y <= (button_y + half)
end

function try_close_selected_unit_ui(self, screen_x, screen_y)
    if not is_human_ui_panel_open(self) then
        return false
    end
    if not is_point_in_close_ui_button(screen_x, screen_y) then
        return false
    end
    self.human_ui_panel_open = false
    mark_selected_unit_panel_dirty(self)
    self.ui_close_on_next_non_unit_click = false
    self.awaiting_slot_shuffle_click = false
    self.objective_reminder_visible = false
    self.selected_start_cell = nil
    close_comms_panel(self)
    update_selected_unit_ui(self)
    print("Unit panel closed.")
    return true
end

local function is_point_in_comms_panel(screen_x, screen_y)
    return is_point_in_screen_rect(screen_x, screen_y, COMMS_PANEL_X, COMMS_PANEL_Y, COMMS_PANEL_W, COMMS_PANEL_H)
end

local function try_toggle_comms_panel(self, screen_x, screen_y)
    if not is_human_ui_panel_open(self) then
        return false
    end
    local unit = get_selected_unit(self)
    if not should_show_comms_ui(self, unit) then
        close_comms_panel(self)
        return false
    end
    if is_point_in_screen_rect(screen_x, screen_y, COMMS_TOGGLE_BTN_X, COMMS_TOGGLE_BTN_Y, COMMS_TOGGLE_BTN_HIT_W, COMMS_TOGGLE_BTN_HIT_H) then
        self.comms_panel_open = not (self.comms_panel_open == true)
        return true
    end
    return false
end

local function emit_comms_command(self, unit, slot_index)
    if not (unit and unit.id) then
        return false
    end
    local event_type = COMMS_EVENT_TYPE_BY_INDEX[slot_index]
    if not is_valid_comms_event_type(event_type) then
        return false
    end
    if self.mp_state and self.mp_state.enabled then
        multiplayer_transport_send_command(self, "comms_command", {
            turn_id = self.mp_state.turn_id or 1,
            unit_id = unit.id,
            comms_event_type = event_type
        }, multiplayer_get_active_player_id_for_commands(self))
    elseif LOOT_RUNTIME and LOOT_RUNTIME.emit_derple_feedback then
        LOOT_RUNTIME.emit_derple_feedback(self, unit.id, event_type)
    end
    self.comms_panel_open = false
    return true
end

local function try_activate_comms_slot(self, screen_x, screen_y)
    if not is_human_ui_panel_open(self) then
        return false
    end
    local unit = get_selected_unit(self)
    if not should_show_comms_ui(self, unit) then
        close_comms_panel(self)
        return false
    end
    if self.comms_panel_open ~= true then
        return false
    end
    if not is_point_in_comms_panel(screen_x, screen_y) then
        return false
    end
    for slot_index = 1, (COMMS_SLOT_ROWS * COMMS_SLOT_COLS) do
        local cx, cy = get_comms_slot_center(slot_index)
        if is_point_in_screen_rect(screen_x, screen_y, cx, cy, COMMS_SLOT_HIT_W, COMMS_SLOT_HIT_H) then
            return emit_comms_command(self, unit, slot_index)
        end
    end
    return true
end

function try_toggle_reactive_combat(self, screen_x, screen_y)
    if not is_human_ui_panel_open(self) then
        return false
    end
    local selected_unit = get_selected_unit(self)
    if not selected_unit then
        return false
    end
    local tx, ty = get_ui_panel_reactive_button_center()
    tx = tx + 5
    ty = ty - 5
    local half_w = 32
    local half_h = 16
    if screen_x >= (tx - half_w) and screen_x <= (tx + half_w) and screen_y >= (ty - half_h) and screen_y <= (ty + half_h) then
        local new_enabled = not (selected_unit.reactive_fire_enabled ~= false)
        if self.mp_state and self.mp_state.enabled then
            multiplayer_transport_send_command(self, "set_reactive_fire", {
                turn_id = self.mp_state.turn_id or 1,
                unit_id = selected_unit.id,
                reactive_fire_enabled = new_enabled
            }, multiplayer_get_active_player_id_for_commands(self))
        else
            selected_unit.reactive_fire_enabled = new_enabled
            print(string.format("%s reactive fire: %s", selected_unit.display_name or "Unit", (selected_unit.reactive_fire_enabled ~= false) and "ON" or "OFF"))
        end
        return true
    end
    return false
end

function try_advance_reactive_alien_turn(self, screen_x, screen_y)
    if not self.alien_turn_active then
        return false
    end
    if self.reactive_combat_enabled then
        return false
    end
    local ax = 105
    local ay = SCREEN_HEIGHT - 40
    if screen_x >= (ax - 35) and screen_x <= (ax + 35) and screen_y >= (ay - 15) and screen_y <= (ay + 15) then
        if self.alien_turn_waiting_for_advance then
            self.alien_turn_waiting_for_advance = false
            print("Alien turn step advanced.")
        elseif not self.reactive_combat_enabled then
            self.alien_turn_manual_pause = true
            self.alien_turn_waiting_for_advance = true
            print("Alien turn paused. Press again to advance steps.")
        end
        return true
    end
    return false
end

function try_next_turn_button(self, screen_x, screen_y)
    if self.realtime_rules_enabled == true then
        return false
    end
    local half_w = NEW_TURN_BUTTON_W * 0.5
    local half_h = NEW_TURN_BUTTON_H * 0.5
    local inside_button = screen_x >= (NEW_TURN_BUTTON_X - half_w)
        and screen_x <= (NEW_TURN_BUTTON_X + half_w)
        and screen_y >= (NEW_TURN_BUTTON_Y - half_h)
        and screen_y <= (NEW_TURN_BUTTON_Y + half_h)
    if not inside_button then
        return false
    end
    if self.alien_turn_active
        or self.pending_spitter_attack_phase
        or self.pending_melee_attack_phase
        or any_alien_is_moving(self)
        or any_civilian_is_moving(self)
    then
        return false
    end
    if inside_button then
        if tutorial_rules_locked and tutorial_rules_locked(self) then
            return true
        end
        if not can_advance_next_turn(self, true) then
            return true
        end
        if self.mp_state and self.mp_state.enabled then
            multiplayer_transport_send_command(self, "new_turn_request", {
                turn_id = self.mp_state and self.mp_state.turn_id or 1
            }, self.mp_state and self.mp_state.host_player_id or "p1")
        else
            msg.post(".", "next_turn")
        end
        return true
    end
    return false
end

local multiplayer_sync_trace

multiplayer_transport_emit_event = function(self, event_type, payload)
    local sender_id = self.mp_state and self.mp_state.host_player_id or "p1"
    if self.mp_state then
        self.mp_state.event_seq = (self.mp_state.event_seq or 0) + 1
    end
    local event_id = string.format(
        "evt_%s_%d",
        tostring((self.mp_state and self.mp_state.session_id) or "local_session"),
        tonumber(self.mp_state and self.mp_state.event_seq or 0) or 0
    )
    local evt = {
        version = 1,
        session_id = (self.mp_state and self.mp_state.session_id) or "local_session",
        event_id = event_id,
        sender_player_id = sender_id,
        type = event_type,
        payload = payload or {}
    }
    multiplayer_sync_trace(self, "emit_event", string.format("event=%s id=%s sender=%s", tostring(event_type), tostring(event_id), tostring(sender_id)))
    return evt
end

multiplayer_broadcast_turn_state_heartbeat_now = function(self)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return
    end
    if self.mp_state.local_player_id ~= self.mp_state.host_player_id then
        return
    end
    if self.realtime_rules_enabled == true then
        return
    end
    local heartbeat_buckets = multiplayer_compute_turn_checksum_buckets(self)
    multiplayer_transport_broadcast_event(self, "turn_state_heartbeat", {
        turn_id = self.mp_state.turn_id or 1,
        alien_activity_active = self.alien_turn_active
            or self.pending_spitter_attack_phase
            or self.pending_melee_attack_phase
            or any_alien_is_moving(self)
            or any_civilian_is_moving(self),
        checksum = multiplayer_compute_turn_checksum(self),
        checksum_units = heartbeat_buckets.units,
        checksum_actors = heartbeat_buckets.actors,
        checksum_world = heartbeat_buckets.world,
        checksum_items = heartbeat_buckets.items,
        unit_digest = multiplayer_build_unit_state_digest(self),
        actor_digest = multiplayer_build_actor_state_digest(self),
        world_digest = multiplayer_build_world_state_digest(self),
        item_digest = multiplayer_build_item_state_digest(self)
    })
end

multiplayer_sync_trace = function(self, tag, details)
    if MP_SYNC_TRACE_ENABLED ~= true then
        return
    end
    local turn_id = tonumber(self and self.mp_state and self.mp_state.turn_id or 0) or 0
    local local_id = tostring(self and self.mp_state and self.mp_state.local_player_id or "p?")
    local host_id = tostring(self and self.mp_state and self.mp_state.host_player_id or "p?")
    local role = (local_id == host_id) and "host" or "client"
    local checksum = "na"
    if multiplayer_compute_turn_checksum then
        local ok, value = pcall(multiplayer_compute_turn_checksum, self)
        if ok and value then
            checksum = tostring(value)
        end
    end
    local suffix = details and (" | " .. tostring(details)) or ""
    print(string.format(
        "MP TRACE | %s | role=%s local=%s host=%s turn=%d checksum=%s%s",
        tostring(tag or "unknown"),
        role,
        local_id,
        host_id,
        turn_id,
        checksum,
        suffix
    ))
end

multiplayer_telemetry_on_send_command = function(self, cmd_type)
    local t = self and self.mp_telemetry or nil
    if not (t and t.enabled) then
        return
    end
    t.tx_command_count = (tonumber(t.tx_command_count or 0) or 0) + 1
    if cmd_type == "ping" then
        local now_ms = (socket and socket.gettime and (socket.gettime() * 1000)) or (os.clock() * 1000)
        t.last_ping_sent_ms = now_ms
    end
end

multiplayer_telemetry_on_recv_event = function(self, event_type)
    local t = self and self.mp_telemetry or nil
    if not (t and t.enabled) then
        return
    end
    t.rx_event_count = (tonumber(t.rx_event_count or 0) or 0) + 1
    if event_type == "realtime_state_snapshot" or event_type == "turn_state_snapshot" or event_type == "snapshot_state" then
        t.rx_snapshot_count = (tonumber(t.rx_snapshot_count or 0) or 0) + 1
    end
end

multiplayer_telemetry_on_snapshot_applied = function(self)
    local t = self and self.mp_telemetry or nil
    if not (t and t.enabled) then
        return
    end
    t.snapshot_apply_count = (tonumber(t.snapshot_apply_count or 0) or 0) + 1
end

multiplayer_telemetry_on_snapshot_apply_failed = function(self)
    local t = self and self.mp_telemetry or nil
    if not (t and t.enabled) then
        return
    end
    t.snapshot_apply_failed_count = (tonumber(t.snapshot_apply_failed_count or 0) or 0) + 1
end

multiplayer_telemetry_on_snapshot_correction = function(self, error_px)
    local t = self and self.mp_telemetry or nil
    if not (t and t.enabled) then
        return
    end
    t.state_correction_count = (tonumber(t.state_correction_count or 0) or 0) + 1
    local err = tonumber(error_px or 0) or 0
    if err > (tonumber(t.max_position_error_px or 0) or 0) then
        t.max_position_error_px = err
    end
end

multiplayer_update_telemetry = function(self, dt)
    local t = self and self.mp_telemetry or nil
    if not (t and t.enabled and self.mp_state and self.mp_state.enabled) then
        return
    end
    if (tonumber(dt or 0) or 0) > MP_TELEMETRY_DT_SPIKE_S then
        t.dt_spike_count = (tonumber(t.dt_spike_count or 0) or 0) + 1
    end
    t.queued_event_count = self.mp_state.pending_events and #self.mp_state.pending_events or 0
    t.log_accum_s = (tonumber(t.log_accum_s or 0) or 0) + (tonumber(dt or 0) or 0)
    t.ping_accum_s = (tonumber(t.ping_accum_s or 0) or 0) + (tonumber(dt or 0) or 0)
    if t.ping_accum_s >= MP_TELEMETRY_PING_INTERVAL_S
        and self.mp_state.local_player_id ~= self.mp_state.host_player_id
    then
        t.ping_accum_s = 0
        multiplayer_transport_send_command(self, "ping", {
            turn_id = self.mp_state and self.mp_state.turn_id or 1,
            sent_ms = (socket and socket.gettime and (socket.gettime() * 1000)) or (os.clock() * 1000)
        }, self.mp_state and self.mp_state.local_player_id or "p1")
    end
    if t.log_accum_s < MP_TELEMETRY_LOG_INTERVAL_S then
        return
    end
    local window_s = math.max(0.001, t.log_accum_s)
    t.log_accum_s = 0
    local rtt_avg = tonumber(t.rtt_last_ms or 0) or 0
    local rtt_p95 = rtt_avg
    local samples = t.rtt_samples_ms or {}
    if #samples > 0 then
        local ordered = {}
        for i = 1, #samples do
            ordered[i] = samples[i]
        end
        table.sort(ordered)
        local sum = 0
        for i = 1, #ordered do
            sum = sum + ordered[i]
        end
        rtt_avg = sum / #ordered
        local p95_index = math.max(1, math.floor((#ordered * 0.95) + 0.5))
        if p95_index > #ordered then
            p95_index = #ordered
        end
        rtt_p95 = ordered[p95_index]
    end
    local tx_cmd = tonumber(t.tx_command_count or 0) or 0
    local tx_evt = tonumber(t.tx_event_count or 0) or 0
    local rx_evt = tonumber(t.rx_event_count or 0) or 0
    local rx_snap = tonumber(t.rx_snapshot_count or 0) or 0
    local corr = tonumber(t.state_correction_count or 0) or 0
    local max_err = tonumber(t.max_position_error_px or 0) or 0
    local dt_spikes = tonumber(t.dt_spike_count or 0) or 0
    local checksum_mismatch = tonumber(t.checksum_mismatch_count or 0) or 0
    local checksum_mismatch_units = tonumber(t.checksum_mismatch_units_count or 0) or 0
    local checksum_mismatch_actors = tonumber(t.checksum_mismatch_actors_count or 0) or 0
    local checksum_mismatch_world = tonumber(t.checksum_mismatch_world_count or 0) or 0
    local checksum_mismatch_items = tonumber(t.checksum_mismatch_items_count or 0) or 0
    local turn_mismatch = tonumber(t.turn_id_mismatch_count or 0) or 0
    local qlen = tonumber(t.queued_event_count or 0) or 0
    print(string.format(
        "MP TELEMETRY | role=%s turn=%d rtt=%.1f/%.1fms tx_cmd=%.1f/s tx_evt=%.1f/s rx_evt=%.1f/s rx_snap=%.1f/s q=%d corr=%d maxErr=%.1f dtSpike=%d chkMis=%d chkU=%d chkA=%d chkW=%d chkI=%d turnMis=%d snapOk=%d snapFail=%d",
        (self.mp_state.local_player_id == self.mp_state.host_player_id) and "host" or "client",
        tonumber(self.mp_state.turn_id or 0) or 0,
        rtt_avg,
        rtt_p95,
        tx_cmd / window_s,
        tx_evt / window_s,
        rx_evt / window_s,
        rx_snap / window_s,
        qlen,
        corr,
        max_err,
        dt_spikes,
        checksum_mismatch,
        checksum_mismatch_units,
        checksum_mismatch_actors,
        checksum_mismatch_world,
        checksum_mismatch_items,
        turn_mismatch,
        tonumber(t.snapshot_apply_count or 0) or 0,
        tonumber(t.snapshot_apply_failed_count or 0) or 0
    ))
    print(string.format(
        "MPCSV,role=%s,turn=%d,rtt_avg=%.1f,rtt_p95=%.1f,tx_cmd_ps=%.2f,tx_evt_ps=%.2f,rx_evt_ps=%.2f,rx_snap_ps=%.2f,q=%d,corr=%d,max_err=%.1f,dt_spike=%d,chk_mis=%d,chk_u=%d,chk_a=%d,chk_w=%d,chk_i=%d,turn_mis=%d,snap_ok=%d,snap_fail=%d",
        (self.mp_state.local_player_id == self.mp_state.host_player_id) and "host" or "client",
        tonumber(self.mp_state.turn_id or 0) or 0,
        rtt_avg,
        rtt_p95,
        tx_cmd / window_s,
        tx_evt / window_s,
        rx_evt / window_s,
        rx_snap / window_s,
        qlen,
        corr,
        max_err,
        dt_spikes,
        checksum_mismatch,
        checksum_mismatch_units,
        checksum_mismatch_actors,
        checksum_mismatch_world,
        checksum_mismatch_items,
        turn_mismatch,
        tonumber(t.snapshot_apply_count or 0) or 0,
        tonumber(t.snapshot_apply_failed_count or 0) or 0
    ))
    t.tx_command_count = 0
    t.tx_event_count = 0
    t.rx_event_count = 0
    t.rx_snapshot_count = 0
    t.state_correction_count = 0
    t.max_position_error_px = 0
    t.dt_spike_count = 0
    t.checksum_mismatch_count = 0
    t.checksum_mismatch_units_count = 0
    t.checksum_mismatch_actors_count = 0
    t.checksum_mismatch_world_count = 0
    t.checksum_mismatch_items_count = 0
    t.turn_id_mismatch_count = 0
    t.snapshot_apply_count = 0
    t.snapshot_apply_failed_count = 0
end

multiplayer_hash_serial_parts = function(parts)
    local serial = table.concat(parts or {}, "|")
    local h = 7
    for i = 1, #serial do
        h = ((h * 131) + string.byte(serial, i) + i) % 2147483647
    end
    return tostring(h)
end

multiplayer_build_unit_state_digest = function(self)
    local digest = {}
    if not self then
        return digest
    end
    for _, unit_id in ipairs(get_spawn_order_unit_id_list() or {}) do
        local unit = self.squad_units and self.squad_units[unit_id] or nil
        local key = tostring(unit_id)
        if unit then
            local backpack_items = {}
            for i = 1, #(unit.backpack_items or {}) do
                backpack_items[i] = tostring(unit.backpack_items[i] or "_")
            end
            local equipment_state = {}
            for _, slot_name in ipairs(BUFF_SLOT_ORDER or {}) do
                equipment_state[slot_name] = tostring((unit.equipment and unit.equipment[slot_name]) or "_")
            end
            digest[key] = {
                cell = tonumber(unit.cell_id or 0) or 0,
                ap = tonumber(unit.current_ap or 0) or 0,
                hp = tonumber(unit.current_health or 0) or 0,
                ammo = tonumber(unit.current_ammo or 0) or 0,
                backpack_used = tonumber(unit.backpack_used or 0) or 0,
                backpack_items = backpack_items,
                equipment = equipment_state,
                moving = unit.is_moving == true and 1 or 0,
                dead = ((tonumber(unit.current_health or 0) or 0) <= 0) and 1 or 0,
                shuttle = unit.in_shuttle == true and 1 or 0
            }
        else
            digest[key] = {
                missing = 1
            }
        end
    end
    return digest
end

multiplayer_log_unit_state_mismatch = function(self, host_digest)
    if type(host_digest) ~= "table" then
        print("MP DESYNC | unit_diff | host_digest_missing")
        return
    end
    local local_digest = multiplayer_build_unit_state_digest(self)
    local keys_seen = {}
    local keys = {}
    for key, _ in pairs(host_digest) do
        local k = tostring(key)
        if keys_seen[k] ~= true then
            keys_seen[k] = true
            keys[#keys + 1] = k
        end
    end
    for key, _ in pairs(local_digest) do
        local k = tostring(key)
        if keys_seen[k] ~= true then
            keys_seen[k] = true
            keys[#keys + 1] = k
        end
    end
    table.sort(keys)
    local printed = 0
    local max_lines = 8
    for _, key in ipairs(keys) do
        local h = host_digest[key] or host_digest[tonumber(key)] or {}
        local l = local_digest[key] or local_digest[tonumber(key)] or {}
        local h_missing = tonumber(h.missing or 0) or 0
        local l_missing = tonumber(l.missing or 0) or 0
        local h_cell = tonumber(h.cell or 0) or 0
        local l_cell = tonumber(l.cell or 0) or 0
        local h_ap = tonumber(h.ap or 0) or 0
        local l_ap = tonumber(l.ap or 0) or 0
        local h_hp = tonumber(h.hp or 0) or 0
        local l_hp = tonumber(l.hp or 0) or 0
        local h_ammo = tonumber(h.ammo or 0) or 0
        local l_ammo = tonumber(l.ammo or 0) or 0
        local h_backpack_used = tonumber(h.backpack_used or 0) or 0
        local l_backpack_used = tonumber(l.backpack_used or 0) or 0
        local h_backpack_sig = table.concat(h.backpack_items or {}, ",")
        local l_backpack_sig = table.concat(l.backpack_items or {}, ",")
        local h_equipment_sig_parts = {}
        local l_equipment_sig_parts = {}
        for _, slot_name in ipairs(BUFF_SLOT_ORDER or {}) do
            h_equipment_sig_parts[#h_equipment_sig_parts + 1] = tostring((h.equipment and h.equipment[slot_name]) or "_")
            l_equipment_sig_parts[#l_equipment_sig_parts + 1] = tostring((l.equipment and l.equipment[slot_name]) or "_")
        end
        local h_equipment_sig = table.concat(h_equipment_sig_parts, ",")
        local l_equipment_sig = table.concat(l_equipment_sig_parts, ",")
        local h_moving = tonumber(h.moving or 0) or 0
        local l_moving = tonumber(l.moving or 0) or 0
        local h_dead = tonumber(h.dead or 0) or 0
        local l_dead = tonumber(l.dead or 0) or 0
        local h_shuttle = tonumber(h.shuttle or 0) or 0
        local l_shuttle = tonumber(l.shuttle or 0) or 0
        local changed = (
            h_missing ~= l_missing
            or h_cell ~= l_cell
            or h_ap ~= l_ap
            or h_hp ~= l_hp
            or h_ammo ~= l_ammo
            or h_backpack_used ~= l_backpack_used
            or h_backpack_sig ~= l_backpack_sig
            or h_equipment_sig ~= l_equipment_sig
            or h_moving ~= l_moving
            or h_dead ~= l_dead
            or h_shuttle ~= l_shuttle
        )
        if changed then
            printed = printed + 1
            if printed <= max_lines then
                print(string.format(
                    "MP DESYNC | unit_diff | unit=%s host[c=%d ap=%d hp=%d am=%d bu=%d bp=%s eq=%s mv=%d dead=%d sh=%d miss=%d] local[c=%d ap=%d hp=%d am=%d bu=%d bp=%s eq=%s mv=%d dead=%d sh=%d miss=%d]",
                    key,
                    h_cell, h_ap, h_hp, h_ammo, h_backpack_used, h_backpack_sig, h_equipment_sig, h_moving, h_dead, h_shuttle, h_missing,
                    l_cell, l_ap, l_hp, l_ammo, l_backpack_used, l_backpack_sig, l_equipment_sig, l_moving, l_dead, l_shuttle, l_missing
                ))
            end
        end
    end
    if printed == 0 then
        print("MP DESYNC | unit_diff | no_row_delta")
    elseif printed > max_lines then
        print(string.format("MP DESYNC | unit_diff | truncated=%d", printed - max_lines))
    end
end

multiplayer_apply_authoritative_unit_digest = function(self, unit_digest)
    if not self or type(unit_digest) ~= "table" then
        return false
    end
    local applied_any = false
    local moved_unit_ids = {}
    local moved_unit_target_cells = {}
    for key, row in pairs(unit_digest) do
        local unit_id = tostring(key or "")
        local unit = self.squad_units and self.squad_units[unit_id] or nil
        if unit and type(row) == "table" then
            local cell = tonumber(row.cell)
            if cell and cell > 0 and unit.cell_id ~= cell then
                local old_cell_id = unit.cell_id
                if old_cell_id and self.world_grid and self.world_grid[old_cell_id] then
                    self.world_grid[old_cell_id].isOccupied = hash("empty")
                end
                unit.cell_id = cell
                if self.world_grid and self.world_grid[cell] then
                    self.world_grid[cell].isOccupied = unit.occupancy_hash or hash("human")
                end
                unit.is_moving = false
                unit.move_path = nil
                unit.move_path_index = 0
                unit.desired_destination_cell_id = nil
                unit.desired_destination_slot_index = nil
                moved_unit_ids[unit_id] = true
                moved_unit_target_cells[unit_id] = cell
                applied_any = true
            end
            local ap = tonumber(row.ap)
            local ammo = tonumber(row.ammo)
            local hp = tonumber(row.hp)
            if ap then
                unit.current_ap = math.max(0, math.floor(ap + 0.5))
                applied_any = true
            end
            if ammo then
                unit.current_ammo = math.max(0, math.floor(ammo + 0.5))
                applied_any = true
            end
            if hp then
                unit.current_health = math.max(0, math.floor(hp + 0.5))
                applied_any = true
            end
            if row.backpack_used ~= nil then
                unit.backpack_used = math.max(0, math.floor((tonumber(row.backpack_used or 0) or 0) + 0.5))
                applied_any = true
            end
            if type(row.backpack_items) == "table" then
                local backpack_items = {}
                for i = 1, #row.backpack_items do
                    backpack_items[i] = tostring(row.backpack_items[i] or "_")
                end
                unit.backpack_items = backpack_items
                applied_any = true
            end
            if type(row.equipment) == "table" then
                unit.equipment = unit.equipment or {}
                for _, slot_name in ipairs(BUFF_SLOT_ORDER or {}) do
                    unit.equipment[slot_name] = tostring(row.equipment[slot_name] or "_")
                end
                applied_any = true
            end
        end
    end
    if applied_any then
        update_human_visual_state(self)
        update_human_ap_debug_label(self)
        update_selected_unit_ui(self)
        for unit_id, _ in pairs(moved_unit_ids) do
            local unit = self.squad_units and self.squad_units[unit_id] or nil
            if unit and unit.go_path then
                local target_cell = tonumber(moved_unit_target_cells[unit_id] or unit.cell_id)
                local cell = target_cell and self.world_grid and self.world_grid[target_cell] or nil
                if cell then
                    local tx, ty = coords_to_world_pos(cell.xCell, cell.yCell)
                    go.cancel_animations(unit.go_path, "position")
                    go.set_position(vmath.vector3(tx, ty, 0.5), unit.go_path)
                else
                    local pos = go.get_position(unit.go_path)
                    go.set_position(vmath.vector3(pos.x, pos.y, 0.5), unit.go_path)
                end
            end
        end
    end
    return applied_any
end

multiplayer_build_actor_state_digest = function(self)
    local digest = {
        aliens = {},
        civilians = {}
    }
    if not self then
        return digest
    end
    for _, alien in ipairs(self.aliens or {}) do
        if alien and alien.id ~= nil then
            local key = tostring(alien.id)
            digest.aliens[key] = {
                id = tonumber(alien.id or 0) or 0,
                cell = tonumber(alien.cell_id or 0) or 0,
                slot = tostring(alien.slot_name or ensure_alien_slot_name(self, alien, alien.cell_id, false) or "center"),
                hp = tonumber(alien.hp_current or 0) or 0,
                dead = alien.is_dead == true and 1 or 0,
                moving = alien.is_moving == true and 1 or 0,
                type = tostring(alien.type or "blip")
            }
        end
    end
    for _, civilian in ipairs(self.civilians or {}) do
        if civilian and civilian.id ~= nil then
            local key = tostring(civilian.id)
            digest.civilians[key] = {
                id = tonumber(civilian.id or 0) or 0,
                cell = tonumber(civilian.cell_id or 0) or 0,
                hp = tonumber(civilian.current_health or 0) or 0,
                dead = civilian.is_dead == true and 1 or 0,
                awake = civilian.is_awake == true and 1 or 0,
                rescued = civilian.is_rescued == true and 1 or 0
            }
        end
    end
    return digest
end

multiplayer_build_item_state_digest = function(self)
    local digest = {
        next_world_item_id = tonumber(self and self.next_world_item_id or 0) or 0,
        items = {}
    }
    if not self then
        return digest
    end
    for key, item in pairs(self.world_item_instances or {}) do
        local item_id = tonumber(key) or tonumber(item and item.id or 0) or 0
        if item_id > 0 and type(item) == "table" then
            digest.items[tostring(item_id)] = multiplayer_clone_simple_table(item) or {}
        end
    end
    return digest
end

multiplayer_build_world_state_digest = function(self)
    local digest = {
        cells = {}
    }
    if not self then
        return digest
    end
    for cell_id, cell in ipairs(self.world_grid or {}) do
        if cell then
            local row = {
                id = tonumber(cell_id or 0) or 0,
                isPowered = cell.isPowered == true,
                lightValue = tonumber(cell.lightValue or 0) or 0,
                doors = {},
                turrets = {},
                obstacles = {}
            }
            local objects = { cell.object1, cell.object2, cell.object3 }
            for slot_idx, obj in ipairs(objects) do
                if obj and obj.name == hash("door") then
                    row.doors[tostring(slot_idx)] = {
                        slot = slot_idx,
                        objectId = tonumber(obj.objectId or 0) or 0,
                        isOpen = obj.isOpen == true,
                        isFixed = obj.isFixed == true,
                        isWelded = obj.isWelded == true,
                        door_hp = tonumber(obj.door_hp or 0) or 0
                    }
                elseif obj and obj.name == hash("gun_turret") then
                    row.turrets[tostring(slot_idx)] = {
                        slot = slot_idx,
                        objectId = tonumber(obj.objectId or 0) or 0,
                        isFixed = obj.isFixed == true,
                        isWelded = obj.isWelded == true,
                        offsetX = tonumber(obj.offsetX or 0) or 0,
                        offsetY = tonumber(obj.offsetY or 0) or 0,
                        hitW = tonumber(obj.hitW or 48) or 48,
                        hitH = tonumber(obj.hitH or 48) or 48,
                        turretArmingTurns = tonumber(obj.turretArmingTurns or 0) or 0
                    }
                elseif obj and obj.name == hash("obstacle") then
                    row.obstacles[tostring(slot_idx)] = {
                        slot = slot_idx,
                        objectId = tonumber(obj.objectId or 0) or 0,
                        isFixed = obj.isFixed == true,
                        isWelded = obj.isWelded == true,
                        offsetX = tonumber(obj.offsetX or 0) or 0,
                        offsetY = tonumber(obj.offsetY or 0) or 0,
                        hitW = tonumber(obj.hitW or 24) or 24,
                        hitH = tonumber(obj.hitH or 24) or 24,
                        obstacleCount = tonumber(obj.obstacleCount or obj.stackCount or 1) or 1,
                        stackCount = tonumber(obj.stackCount or obj.obstacleCount or 1) or 1
                    }
                end
            end
            digest.cells[tostring(cell_id)] = row
        end
    end
    return digest
end

multiplayer_apply_authoritative_world_digest = function(self, world_digest)
    if not self or type(world_digest) ~= "table" then
        return false
    end
    local cells = type(world_digest.cells) == "table" and world_digest.cells or world_digest
    local applied_any = false
    for key, row in pairs(cells or {}) do
        local cell_id = tonumber((type(row) == "table" and row.id) or key)
        local cell = cell_id and self.world_grid and self.world_grid[cell_id] or nil
        if cell and type(row) == "table" then
            local powered = row.isPowered == true
            local light_value = tonumber(row.lightValue or cell.lightValue or 0) or 0
            if cell.isPowered ~= powered then
                cell.isPowered = powered
                applied_any = true
            end
            if tonumber(cell.lightValue or 0) ~= light_value then
                cell.lightValue = light_value
                applied_any = true
            end
            local host_doors = type(row.doors) == "table" and row.doors or {}
            local host_turrets = type(row.turrets) == "table" and row.turrets or {}
            local host_obstacles = type(row.obstacles) == "table" and row.obstacles or {}
            local objects = { cell.object1, cell.object2, cell.object3 }
            for slot_idx, obj in ipairs(objects) do
                local door_state = host_doors[slot_idx] or host_doors[tostring(slot_idx)]
                if type(door_state) == "table" then
                    if obj then
                        if obj.name ~= hash("door") then
                            obj.name = hash("door")
                        end
                        local object_id = tonumber(door_state.objectId or obj.objectId or 0) or 0
                        local door_open = door_state.isOpen == true
                        local door_fixed = door_state.isFixed == true
                        local door_welded = door_state.isWelded == true
                        if tonumber(obj.objectId or 0) ~= object_id then
                            obj.objectId = object_id
                            applied_any = true
                        end
                        if obj.isOpen ~= door_open then
                            obj.isOpen = door_open
                            applied_any = true
                        end
                        if obj.isFixed ~= door_fixed then
                            obj.isFixed = door_fixed
                            applied_any = true
                        end
                        if obj.isWelded ~= door_welded then
                            obj.isWelded = door_welded
                            applied_any = true
                        end
                        local hp = tonumber(door_state.door_hp or 0) or 0
                        if hp > 0 then
                            if tonumber(obj.door_hp or 0) ~= hp then
                                obj.door_hp = hp
                                applied_any = true
                            end
                        elseif obj.door_hp ~= nil then
                            obj.door_hp = nil
                            applied_any = true
                        end
                    end
                elseif obj and obj.name == hash("door") then
                    reset_runtime_object_slot_to_empty(obj)
                    applied_any = true
                end
                local turret_state = host_turrets[slot_idx] or host_turrets[tostring(slot_idx)]
                if type(turret_state) == "table" then
                    if obj then
                        if obj.name ~= hash("gun_turret") then
                            obj.name = hash("gun_turret")
                            applied_any = true
                        end
                        local turret_object_id = tonumber(turret_state.objectId or obj.objectId or 0) or 0
                        if tonumber(obj.objectId or 0) ~= turret_object_id then
                            obj.objectId = turret_object_id
                            applied_any = true
                        end
                        local turret_fixed = turret_state.isFixed == true
                        local turret_welded = turret_state.isWelded == true
                        if obj.isFixed ~= turret_fixed then
                            obj.isFixed = turret_fixed
                            applied_any = true
                        end
                        if obj.isWelded ~= turret_welded then
                            obj.isWelded = turret_welded
                            applied_any = true
                        end
                        local offset_x = tonumber(turret_state.offsetX or obj.offsetX or 0) or 0
                        local offset_y = tonumber(turret_state.offsetY or obj.offsetY or 0) or 0
                        if tonumber(obj.offsetX or 0) ~= offset_x then
                            obj.offsetX = offset_x
                            applied_any = true
                        end
                        if tonumber(obj.offsetY or 0) ~= offset_y then
                            obj.offsetY = offset_y
                            applied_any = true
                        end
                        local hit_w = tonumber(turret_state.hitW or obj.hitW or 48) or 48
                        local hit_h = tonumber(turret_state.hitH or obj.hitH or 48) or 48
                        if tonumber(obj.hitW or 0) ~= hit_w then
                            obj.hitW = hit_w
                            applied_any = true
                        end
                        if tonumber(obj.hitH or 0) ~= hit_h then
                            obj.hitH = hit_h
                            applied_any = true
                        end
                        local arming_turns = tonumber(turret_state.turretArmingTurns or obj.turretArmingTurns or 0) or 0
                        if tonumber(obj.turretArmingTurns or 0) ~= arming_turns then
                            obj.turretArmingTurns = arming_turns
                            applied_any = true
                        end
                    end
                elseif obj and obj.name == hash("gun_turret") then
                    reset_runtime_object_slot_to_empty(obj)
                    applied_any = true
                end
                local obstacle_state = host_obstacles[slot_idx] or host_obstacles[tostring(slot_idx)]
                if type(obstacle_state) == "table" then
                    if obj then
                        if obj.name ~= hash("obstacle") then
                            obj.name = hash("obstacle")
                            applied_any = true
                        end
                        local obstacle_object_id = tonumber(obstacle_state.objectId or obj.objectId or 0) or 0
                        if tonumber(obj.objectId or 0) ~= obstacle_object_id then
                            obj.objectId = obstacle_object_id
                            applied_any = true
                        end
                        local obstacle_fixed = obstacle_state.isFixed == true
                        local obstacle_welded = obstacle_state.isWelded == true
                        if obj.isFixed ~= obstacle_fixed then
                            obj.isFixed = obstacle_fixed
                            applied_any = true
                        end
                        if obj.isWelded ~= obstacle_welded then
                            obj.isWelded = obstacle_welded
                            applied_any = true
                        end
                        local offset_x = tonumber(obstacle_state.offsetX or obj.offsetX or 0) or 0
                        local offset_y = tonumber(obstacle_state.offsetY or obj.offsetY or 0) or 0
                        if tonumber(obj.offsetX or 0) ~= offset_x then
                            obj.offsetX = offset_x
                            applied_any = true
                        end
                        if tonumber(obj.offsetY or 0) ~= offset_y then
                            obj.offsetY = offset_y
                            applied_any = true
                        end
                        local hit_w = tonumber(obstacle_state.hitW or obj.hitW or 24) or 24
                        local hit_h = tonumber(obstacle_state.hitH or obj.hitH or 24) or 24
                        if tonumber(obj.hitW or 0) ~= hit_w then
                            obj.hitW = hit_w
                            applied_any = true
                        end
                        if tonumber(obj.hitH or 0) ~= hit_h then
                            obj.hitH = hit_h
                            applied_any = true
                        end
                        local stack_count = tonumber(obstacle_state.stackCount or obstacle_state.obstacleCount or obj.stackCount or obj.obstacleCount or 1) or 1
                        if tonumber(obj.stackCount or 0) ~= stack_count then
                            obj.stackCount = stack_count
                            applied_any = true
                        end
                        if tonumber(obj.obstacleCount or 0) ~= stack_count then
                            obj.obstacleCount = stack_count
                            applied_any = true
                        end
                    end
                elseif obj and obj.name == hash("obstacle") then
                    reset_runtime_object_slot_to_empty(obj)
                    applied_any = true
                end
            end
        end
    end
    if applied_any and LOOT_RUNTIME and LOOT_RUNTIME.refresh_door_markers then
        LOOT_RUNTIME.refresh_door_markers(self)
    end
    if applied_any and LOOT_RUNTIME and LOOT_RUNTIME.refresh_turret_markers then
        LOOT_RUNTIME.refresh_turret_markers(self)
    end
    if applied_any and LOOT_RUNTIME and LOOT_RUNTIME.refresh_fix_markers then
        LOOT_RUNTIME.refresh_fix_markers(self)
    end
    if applied_any and LOOT_RUNTIME and LOOT_RUNTIME.refresh_machine_markers then
        LOOT_RUNTIME.refresh_machine_markers(self)
    end
    if applied_any and LOOT_RUNTIME and LOOT_RUNTIME.refresh_power_node_markers then
        LOOT_RUNTIME.refresh_power_node_markers(self)
    end
    if applied_any and LOOT_RUNTIME and LOOT_RUNTIME.refresh_wiregap_markers then
        LOOT_RUNTIME.refresh_wiregap_markers(self)
    end
    if applied_any and LOOT_RUNTIME and LOOT_RUNTIME.refresh_vent_markers then
        LOOT_RUNTIME.refresh_vent_markers(self)
    end
    if applied_any and LOOT_RUNTIME and LOOT_RUNTIME.refresh_world_item_visuals then
        LOOT_RUNTIME.refresh_world_item_visuals(self)
    end
    return applied_any
end

multiplayer_apply_authoritative_item_digest = function(self, item_digest)
    if not self or type(item_digest) ~= "table" then
        return false
    end
    local source_items = type(item_digest.items) == "table" and item_digest.items or item_digest
    local staged = {}
    for key, item in pairs(source_items or {}) do
        if type(item) == "table" then
            local item_id = tonumber(item.id) or tonumber(key) or 0
            if item_id > 0 then
                local cloned = multiplayer_clone_simple_table(item) or {}
                cloned.id = item_id
                table.insert(staged, cloned)
            end
        end
    end
    table.sort(staged, function(a, b)
        local a_id = tonumber(a and a.id or 0) or 0
        local b_id = tonumber(b and b.id or 0) or 0
        return a_id < b_id
    end)
    local rebuilt = {}
    for _, item in ipairs(staged) do
        table.insert(rebuilt, item)
    end
    self.world_item_instances = rebuilt
    if item_digest.next_world_item_id ~= nil then
        self.next_world_item_id = tonumber(item_digest.next_world_item_id or self.next_world_item_id or 0) or 0
    end
    if LOOT_RUNTIME and LOOT_RUNTIME.refresh_world_item_visuals then
        LOOT_RUNTIME.refresh_world_item_visuals(self)
    end
    if LOOT_RUNTIME and LOOT_RUNTIME.refresh_loot_markers then
        LOOT_RUNTIME.refresh_loot_markers(self)
    end
    return true
end

multiplayer_apply_authoritative_actor_digest = function(self, actor_digest)
    if not self or type(actor_digest) ~= "table" then
        return false
    end
    local applied_any = false
    local aliens_digest = type(actor_digest.aliens) == "table" and actor_digest.aliens or {}
    local civilians_digest = type(actor_digest.civilians) == "table" and actor_digest.civilians or {}
    for key, row in pairs(aliens_digest) do
        if type(row) == "table" then
            local alien = find_alien_by_id(self, tonumber(row.id) or tonumber(key))
            if alien then
                local cell = tonumber(row.cell)
                local hp = tonumber(row.hp)
                if cell and cell > 0 and alien.cell_id ~= cell then
                    alien.cell_id = cell
                    applied_any = true
                end
                local host_slot_name = tostring(row.slot or "")
                if host_slot_name == "left" or host_slot_name == "center" or host_slot_name == "right" then
                    if tostring(alien.slot_name or "") ~= host_slot_name then
                        alien.slot_name = host_slot_name
                        applied_any = true
                    end
                elseif alien.slot_name == nil then
                    alien.slot_name = ensure_alien_slot_name(self, alien, alien.cell_id, false)
                end
                if hp then
                    alien.hp_current = hp
                    applied_any = true
                end
                if row.dead ~= nil then
                    alien.is_dead = (tonumber(row.dead or 0) or 0) == 1
                    applied_any = true
                end
                if row.moving ~= nil then
                    alien.is_moving = (tonumber(row.moving or 0) or 0) == 1
                    if alien.is_moving ~= true then
                        alien.move_path = nil
                        alien.move_path_index = nil
                        alien.move_target_cell_id = nil
                    end
                    applied_any = true
                end
            end
        end
    end
    for key, row in pairs(civilians_digest) do
        if type(row) == "table" then
            local target_id = tonumber(row.id) or tonumber(key)
            if target_id then
                for _, civilian in ipairs(self.civilians or {}) do
                    if civilian and civilian.id == target_id then
                        local cell = tonumber(row.cell)
                        local hp = tonumber(row.hp)
                        if cell and cell > 0 and civilian.cell_id ~= cell then
                            civilian.cell_id = cell
                            applied_any = true
                        end
                        if hp then
                            civilian.current_health = hp
                            applied_any = true
                        end
                        if row.dead ~= nil then
                            civilian.is_dead = (tonumber(row.dead or 0) or 0) == 1
                            applied_any = true
                        end
                        if row.awake ~= nil then
                            civilian.is_awake = (tonumber(row.awake or 0) or 0) == 1
                            applied_any = true
                        end
                        if row.rescued ~= nil then
                            civilian.is_rescued = (tonumber(row.rescued or 0) or 0) == 1
                            applied_any = true
                        end
                        break
                    end
                end
            end
        end
    end
    if applied_any then
        for _, alien in ipairs(self.aliens or {}) do
            if alien
                and alien.go_id
                and (
                    alien.is_moving ~= true
                    or alien.move_path == nil
                    or alien.move_path[tonumber(alien.move_path_index or 0) or 0] == nil
                )
            then
                refresh_alien_visual(self, alien)
            end
        end
        refresh_civilian_visuals(self)
    end
    return applied_any
end

multiplayer_apply_actor_cell_reconcile = function(self, actor_digest)
    if not self or type(actor_digest) ~= "table" then
        return false
    end
    local changed = false
    local aliens_digest = type(actor_digest.aliens) == "table" and actor_digest.aliens or {}
    for key, row in pairs(aliens_digest) do
        if type(row) == "table" then
            local alien = find_alien_by_id(self, tonumber(row.id) or tonumber(key))
            if alien then
                local cell = tonumber(row.cell)
                if cell and cell > 0 and alien.cell_id ~= cell then
                    alien.cell_id = cell
                    alien.is_moving = false
                    alien.move_path = nil
                    alien.move_path_index = nil
                    alien.move_target_cell_id = nil
                    changed = true
                end
            end
        end
    end
    if changed then
        for _, alien in ipairs(self.aliens or {}) do
            if alien and alien.go_id then
                refresh_alien_visual(self, alien)
            end
        end
    end
    return changed
end

multiplayer_compute_turn_checksum_buckets = function(self)
    local buckets = {
        units = "0",
        actors = "0",
        world = "0",
        items = "0"
    }
    if not self then
        return buckets
    end

    local unit_parts = {}
    local function unit_push(...)
        for i = 1, select("#", ...) do
            unit_parts[#unit_parts + 1] = tostring(select(i, ...))
        end
    end
    unit_push("turn", self.mp_state and self.mp_state.turn_id or 1)
    for _, unit_id in ipairs(get_spawn_order_unit_id_list() or {}) do
        local unit = self.squad_units and self.squad_units[unit_id] or nil
        if unit then
            unit_push(
                "u",
                unit_id,
                unit.cell_id or 0,
                unit.current_ap or 0,
                unit.current_health or 0,
                unit.current_ammo or 0,
                unit.backpack_used or 0,
                unit.in_shuttle == true and 1 or 0
            )
            for i = 1, #(unit.backpack_items or {}) do
                unit_push("bi", unit_id, i, unit.backpack_items[i] or "_")
            end
            local equipment = unit.equipment or {}
            for _, slot_name in ipairs(BUFF_SLOT_ORDER) do
                unit_push("eq", unit_id, slot_name, tostring(equipment[slot_name] or "_"))
            end
        else
            unit_push("u", unit_id, "missing")
        end
    end
    buckets.units = multiplayer_hash_serial_parts(unit_parts)

    local actor_parts = {}
    local function actor_push(...)
        for i = 1, select("#", ...) do
            actor_parts[#actor_parts + 1] = tostring(select(i, ...))
        end
    end
    local alien_rows = {}
    for _, alien in ipairs(self.aliens or {}) do
        alien_rows[#alien_rows + 1] = string.format(
            "%d|%s|%d|%s|%d|%d|%d",
            tonumber(alien and alien.id or 0) or 0,
            tostring(alien and alien.type or "blip"),
            tonumber(alien and alien.cell_id or 0) or 0,
            tostring(alien and alien.slot_name or "_"),
            tonumber(alien and alien.hp_current or 0) or 0,
            (alien and alien.is_dead == true) and 1 or 0,
            (alien and alien.is_moving == true) and 1 or 0
        )
    end
    table.sort(alien_rows)
    for _, row in ipairs(alien_rows) do
        actor_push("a", row)
    end
    local civilian_rows = {}
    for _, civilian in ipairs(self.civilians or {}) do
        civilian_rows[#civilian_rows + 1] = string.format(
            "%d|%d|%d|%d|%d|%d",
            tonumber(civilian and civilian.id or 0) or 0,
            tonumber(civilian and civilian.cell_id or 0) or 0,
            tonumber(civilian and civilian.current_health or 0) or 0,
            (civilian and civilian.is_awake == true) and 1 or 0,
            (civilian and civilian.is_dead == true) and 1 or 0,
            (civilian and civilian.is_rescued == true) and 1 or 0
        )
    end
    table.sort(civilian_rows)
    for _, row in ipairs(civilian_rows) do
        actor_push("cv", row)
    end
    buckets.actors = multiplayer_hash_serial_parts(actor_parts)

    local world_parts = {}
    local function world_push(...)
        for i = 1, select("#", ...) do
            world_parts[#world_parts + 1] = tostring(select(i, ...))
        end
    end
    for cell_id, cell in ipairs(self.world_grid or {}) do
        if cell then
            world_push(
                "c",
                cell_id,
                cell.isPowered == true and 1 or 0,
                tonumber(cell.lightValue or 0) or 0
            )
            local door_rows = {}
            local turret_rows = {}
            local obstacle_rows = {}
            local objects = { cell.object1, cell.object2, cell.object3 }
            for slot_idx, obj in ipairs(objects) do
                if obj and obj.name == hash("door") then
                    door_rows[#door_rows + 1] = string.format(
                        "%d|%d|%d",
                        slot_idx,
                        tonumber(obj.objectId or 0) or 0,
                        obj.isOpen == true and 1 or 0
                    )
                elseif obj and obj.name == hash("gun_turret") then
                    turret_rows[#turret_rows + 1] = string.format(
                        "%d|%d|%d|%d|%d|%d",
                        slot_idx,
                        tonumber(obj.objectId or 0) or 0,
                        obj.isFixed == true and 1 or 0,
                        obj.isWelded == true and 1 or 0,
                        tonumber(obj.offsetX or 0) or 0,
                        tonumber(obj.offsetY or 0) or 0
                    )
                elseif obj and obj.name == hash("obstacle") then
                    obstacle_rows[#obstacle_rows + 1] = string.format(
                        "%d|%d|%d|%d|%d|%d|%d",
                        slot_idx,
                        tonumber(obj.objectId or 0) or 0,
                        tonumber(obj.stackCount or obj.obstacleCount or 1) or 1,
                        obj.isFixed == true and 1 or 0,
                        obj.isWelded == true and 1 or 0,
                        tonumber(obj.offsetX or 0) or 0,
                        tonumber(obj.offsetY or 0) or 0
                    )
                end
            end
            table.sort(door_rows)
            for _, row in ipairs(door_rows) do
                world_push("d", cell_id, row)
            end
            table.sort(turret_rows)
            for _, row in ipairs(turret_rows) do
                world_push("t", cell_id, row)
            end
            table.sort(obstacle_rows)
            for _, row in ipairs(obstacle_rows) do
                world_push("o", cell_id, row)
            end
        end
    end
    buckets.world = multiplayer_hash_serial_parts(world_parts)

    local item_parts = {}
    local function item_push(...)
        for i = 1, select("#", ...) do
            item_parts[#item_parts + 1] = tostring(select(i, ...))
        end
    end
    local world_item_ids = {}
    for key, _ in pairs(self.world_item_instances or {}) do
        world_item_ids[#world_item_ids + 1] = tonumber(key) or 0
    end
    table.sort(world_item_ids)
    for _, item_id in ipairs(world_item_ids) do
        local item = (self.world_item_instances and (self.world_item_instances[item_id] or self.world_item_instances[tostring(item_id)])) or nil
        if item then
            item_push(
                "wi",
                item_id,
                tostring(item.item_type or item.type or "_"),
                tonumber(item.cell_id or 0) or 0,
                tonumber(item.world_x or 0) or 0,
                tonumber(item.world_y or 0) or 0
            )
        end
    end
    buckets.items = multiplayer_hash_serial_parts(item_parts)

    return buckets
end

multiplayer_compute_turn_checksum = function(self)
    if not self then
        return "0"
    end
    local parts = {}
    local function push(...)
        for i = 1, select("#", ...) do
            parts[#parts + 1] = tostring(select(i, ...))
        end
    end

    push("turn", self.mp_state and self.mp_state.turn_id or 1)
    local unit_order = get_spawn_order_unit_id_list()
    for _, unit_id in ipairs(unit_order or {}) do
        local unit = self.squad_units and self.squad_units[unit_id] or nil
        if unit then
            push(
                "u",
                unit_id,
                unit.cell_id or 0,
                unit.current_ap or 0,
                unit.current_health or 0,
                unit.current_ammo or 0,
                unit.backpack_used or 0,
                unit.in_shuttle == true and 1 or 0
            )
            local backpack = unit.backpack_items or {}
            for i = 1, #backpack do
                push("bi", unit_id, i, backpack[i] or "_")
            end
            local equipment = unit.equipment or {}
            for _, slot_name in ipairs(BUFF_SLOT_ORDER) do
                push("eq", unit_id, slot_name, tostring(equipment[slot_name] or "_"))
            end
        else
            push("u", unit_id, "missing")
        end
    end

    local alien_rows = {}
    for _, alien in ipairs(self.aliens or {}) do
        alien_rows[#alien_rows + 1] = string.format(
            "%d|%s|%d|%s|%d|%d|%d",
            tonumber(alien and alien.id or 0) or 0,
            tostring(alien and alien.type or "blip"),
            tonumber(alien and alien.cell_id or 0) or 0,
            tostring(alien and alien.slot_name or "_"),
            tonumber(alien and alien.hp_current or 0) or 0,
            (alien and alien.is_dead == true) and 1 or 0,
            (alien and alien.is_moving == true) and 1 or 0
        )
    end
    table.sort(alien_rows)
    for _, row in ipairs(alien_rows) do
        push("a", row)
    end

    local civilian_rows = {}
    for _, civilian in ipairs(self.civilians or {}) do
        civilian_rows[#civilian_rows + 1] = string.format(
            "%d|%d|%d|%d|%d|%d",
            tonumber(civilian and civilian.id or 0) or 0,
            tonumber(civilian and civilian.cell_id or 0) or 0,
            tonumber(civilian and civilian.current_health or 0) or 0,
            (civilian and civilian.is_awake == true) and 1 or 0,
            (civilian and civilian.is_dead == true) and 1 or 0,
            (civilian and civilian.is_rescued == true) and 1 or 0
        )
    end
    table.sort(civilian_rows)
    for _, row in ipairs(civilian_rows) do
        push("cv", row)
    end

    for cell_id, cell in ipairs(self.world_grid or {}) do
        if cell then
            push(
                "c",
                cell_id,
                cell.isPowered == true and 1 or 0,
                tonumber(cell.lightValue or 0) or 0
            )
            local door_rows = {}
            local turret_rows = {}
            local obstacle_rows = {}
            local objects = { cell.object1, cell.object2, cell.object3 }
            for slot_idx, obj in ipairs(objects) do
                if obj and obj.name == hash("door") then
                    door_rows[#door_rows + 1] = string.format(
                        "%d|%d|%d",
                        slot_idx,
                        tonumber(obj.objectId or 0) or 0,
                        obj.isOpen == true and 1 or 0
                    )
                elseif obj and obj.name == hash("gun_turret") then
                    turret_rows[#turret_rows + 1] = string.format(
                        "%d|%d|%d|%d|%d|%d",
                        slot_idx,
                        tonumber(obj.objectId or 0) or 0,
                        obj.isFixed == true and 1 or 0,
                        obj.isWelded == true and 1 or 0,
                        tonumber(obj.offsetX or 0) or 0,
                        tonumber(obj.offsetY or 0) or 0
                    )
                elseif obj and obj.name == hash("obstacle") then
                    obstacle_rows[#obstacle_rows + 1] = string.format(
                        "%d|%d|%d|%d|%d|%d|%d",
                        slot_idx,
                        tonumber(obj.objectId or 0) or 0,
                        tonumber(obj.stackCount or obj.obstacleCount or 1) or 1,
                        obj.isFixed == true and 1 or 0,
                        obj.isWelded == true and 1 or 0,
                        tonumber(obj.offsetX or 0) or 0,
                        tonumber(obj.offsetY or 0) or 0
                    )
                end
            end
            table.sort(door_rows)
            for _, row in ipairs(door_rows) do
                push("d", cell_id, row)
            end
            table.sort(turret_rows)
            for _, row in ipairs(turret_rows) do
                push("t", cell_id, row)
            end
            table.sort(obstacle_rows)
            for _, row in ipairs(obstacle_rows) do
                push("o", cell_id, row)
            end
        end
    end

    local world_item_ids = {}
    for key, _ in pairs(self.world_item_instances or {}) do
        world_item_ids[#world_item_ids + 1] = tonumber(key) or 0
    end
    table.sort(world_item_ids)
    for _, item_id in ipairs(world_item_ids) do
        local item = (self.world_item_instances and (self.world_item_instances[item_id] or self.world_item_instances[tostring(item_id)])) or nil
        if item then
            push(
                "wi",
                item_id,
                tostring(item.item_type or item.type or "_"),
                tonumber(item.cell_id or 0) or 0,
                tonumber(item.world_x or 0) or 0,
                tonumber(item.world_y or 0) or 0
            )
        end
    end

    return multiplayer_hash_serial_parts(parts)
end

multiplayer_transport_command_passes_dispatch_gate = function(self, cmd_type, payload)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return false
    end
    local offer_plane_command = (
        cmd_type == "lobby_offer_upsert"
        or cmd_type == "lobby_offer_remove"
        or cmd_type == "lobby_offer_heartbeat"
        or cmd_type == "lobby_offer_join_response"
        or cmd_type == "lobby_request_offer_reannounce"
    )
    if offer_plane_command then
        return true
    end
    if cmd_type == "lobby_join_session"
        or cmd_type == "request_setup_state"
        or cmd_type == "lobby_leave_session"
    then
        multiplayer_lobby_ensure_runtime(self)
        local session_id = tostring(payload and payload.session_id or "")
        local session = session_id ~= "" and multiplayer_lobby_get_session_by_id(self, session_id) or nil
        if session and multiplayer_lobby_is_session_host(self, session) then
            return true
        end
        if cmd_type == "request_setup_state" and session_id == "" then
            return multiplayer_lobby_is_session_host(self)
        end
    end
    return multiplayer_is_wire_dispatch_host(self)
end

multiplayer_transport_handle_command = function(self, command)
    local events = {}
    if not (self.mp_state and self.mp_state.enabled) then
        return events
    end
    if not command or type(command) ~= "table" then
        return events
    end
    local cmd_type = command.type
    local sender = command.sender_player_id
    local payload = command.payload or {}
    local cmd_message_id = command.message_id
    multiplayer_sync_trace(
        self,
        "recv_command",
        string.format(
            "type=%s sender=%s msg=%s payload_turn=%s",
            tostring(cmd_type),
            tostring(sender),
            tostring(cmd_message_id or "-"),
            tostring(payload.turn_id or "-")
        )
    )
    if not multiplayer_transport_command_passes_dispatch_gate(self, cmd_type, payload) then
        multiplayer_debug_log(self, string.format(
            "MP NET | command_gate_drop type=%s local=%s host=%s",
            tostring(cmd_type or ""),
            tostring(self.mp_state.local_player_id or ""),
            tostring(self.mp_state.host_player_id or "")
        ))
        return events
    end
    if multiplayer_is_wire_dispatch_host(self) then
        local sender_network_id = mp_normalize_network_player_id(sender or "")
        local host_network_id = mp_normalize_network_player_id(self.mp_state.host_player_id or "")
        if sender_network_id ~= "" and sender_network_id ~= host_network_id then
            multiplayer_mark_remote_player_alive(self, sender_network_id)
        end
    end
    if cmd_message_id and cmd_message_id ~= "" then
        self.mp_state.seen_command_ids = self.mp_state.seen_command_ids or {}
        local dedupe_key = string.format("%s|%s", tostring(sender or "unknown"), tostring(cmd_message_id))
        if cmd_type == "lobby_join_session" then
            local join_identity = tostring(command.guest_steam_id or "")
            if join_identity == "" then
                join_identity = tostring(sender or "unknown")
            end
            dedupe_key = string.format(
                "%s|%s|%s",
                tostring(payload.session_id or ""),
                join_identity,
                tostring(cmd_message_id)
            )
        end
        if self.mp_state.seen_command_ids[dedupe_key] == true then
            multiplayer_sync_trace(self, "drop_command_duplicate", string.format("key=%s type=%s", dedupe_key, tostring(cmd_type)))
            return events
        end
        self.mp_state.seen_command_ids[dedupe_key] = true
    end
    if cmd_type == "set_ready" then
        local target_player_id = tostring(payload.player_id or sender or "")
        local ready_on = payload.ready == true
        local sender_player_id = tostring(sender or "")
        local sender_slot_player_id = sender_player_id
        if multiplayer_get_slot_player_id_for_network then
            sender_slot_player_id = tostring(multiplayer_get_slot_player_id_for_network(self, sender_player_id) or sender_player_id)
        end
        local is_required = false
        for _, required_id in ipairs(self.mp_state.required_ready_player_ids or {}) do
            if required_id == target_player_id then
                is_required = true
                break
            end
        end
        if not is_required and sender_slot_player_id ~= target_player_id then
            target_player_id = sender_slot_player_id
            for _, required_id in ipairs(self.mp_state.required_ready_player_ids or {}) do
                if required_id == target_player_id then
                    is_required = true
                    break
                end
            end
        end
        if (not is_required) or sender_player_id == tostring(self.mp_state.host_player_id or "") then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "set_ready",
                reason = "invalid_ready_sender_or_target"
            }))
            return events
        end
        table.insert(events, multiplayer_transport_emit_event(self, "ready_state_changed", {
            player_id = target_player_id,
            ready = ready_on,
            turn_id = self.mp_state.turn_id or 1
        }))
        return events
    end

    if cmd_type == "new_turn_request" then
        if sender ~= self.mp_state.host_player_id then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "new_turn_request",
                reason = "not_host"
            }))
            return events
        end
        if multiplayer_reconcile_departed_ownership_on_turn_boundary(self) then
            table.insert(events, multiplayer_transport_emit_event(self, "player_departed_in_match", {
                session_id = tostring(self.mp_state and self.mp_state.session_id or ""),
                departed_player_id = "turn_boundary_reclaim",
                seat_assignments = multiplayer_clone_seat_assignments(self.mp_state.seat_assignments, self.mp_state.player_count or 4),
                required_ready_player_ids = multiplayer_clone_simple_table(self.mp_state.required_ready_player_ids or {}),
                ready_by_player_id = multiplayer_clone_simple_table(self.mp_state.ready_by_player_id or {})
            }))
        end
        if not can_advance_next_turn(self, true) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "new_turn_request",
                reason = "ready_gate_not_satisfied"
            }))
            return events
        end
        self.mp_state.pending_turn_state_snapshot_turn_id = (self.mp_state.turn_id or 1) + 1
        table.insert(events, multiplayer_transport_emit_event(self, "turn_advanced", {
            turn_id = (self.mp_state.turn_id or 1) + 1
        }))
        return events
    end

    if cmd_type == "request_snapshot" then
        if sender == self.mp_state.host_player_id then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "request_snapshot",
                reason = "host_does_not_request_snapshot"
            }))
            return events
        end
        local snapshot = multiplayer_build_snapshot_state(self)
        table.insert(events, multiplayer_transport_emit_event(self, "snapshot_state", {
            target_player_id = sender,
            snapshot = snapshot
        }))
        return events
    end

    if cmd_type == "ping" then
        if sender == self.mp_state.host_player_id then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "ping",
                reason = "host_does_not_ping_itself"
            }))
            return events
        end
        table.insert(events, multiplayer_transport_emit_event(self, "pong_echo", {
            target_player_id = sender,
            sent_ms = tonumber(payload.sent_ms or 0) or 0,
            turn_id = self.mp_state.turn_id or 1
        }))
        return events
    end

    if cmd_type == "request_setup_state" then
        multiplayer_lobby_ensure_runtime(self)
        local session = multiplayer_lobby_get_active_session(self)
        local requester_id = multiplayer_steam_resolve_guest_wire_id(self, session, command)
        if requester_id == "" then
            requester_id = mp_normalize_network_player_id(sender or "")
        end
        if requester_id ~= "" then
            self.mp_lobby.setup_sync_player_ids = self.mp_lobby.setup_sync_player_ids or {}
            self.mp_lobby.setup_sync_player_ids[requester_id] = true
            if self.mp_lobby.guest_join_resend_pending then
                self.mp_lobby.guest_join_resend_pending[requester_id] = nil
            end
            multiplayer_debug_log(self, string.format(
                "MP LOBBY | setup_sync_ack guest=%s sender=%s steam=%s",
                requester_id,
                tostring(sender or ""),
                tostring(command.guest_steam_id or "")
            ))
        end
        local config = multiplayer_setup_build_guest_wire_config(self, session)
        table.insert(events, multiplayer_transport_emit_event(self, "setup_state_updated", {
            target_player_id = requester_id,
            session_config = config
        }))
        return events
    end

    if cmd_type == "request_lobby_state" then
        multiplayer_lobby_ensure_runtime(self)
        table.insert(events, multiplayer_transport_emit_event(self, "lobby_state_updated", {
            target_player_id = sender,
            lobby_state = multiplayer_lobby_build_state_payload(self)
        }))
        return events
    end

    if cmd_type == "lobby_request_offer_reannounce" then
        multiplayer_lobby_ensure_runtime(self)
        local requester_player_id = tostring(sender or "")
        local target_player_id = tostring(payload.target_player_id or requester_player_id)
        local offer_id = tostring(self.mp_lobby.local_active_offer_id or "")
        local session = multiplayer_lobby_get_session_by_id(self, offer_id)
        if session and target_player_id ~= "" then
            local refresh_ms = get_wall_clock_ms()
            session.updated_at_ms = refresh_ms
            table.insert(events, multiplayer_transport_emit_event(self, "lobby_offer_upsert", {
                target_player_id = target_player_id,
                offer = {
                    id = tostring(session.id or ""),
                    owner_player_id = tostring(session.owner_player_id or "p1"),
                    host_name = tostring(session.host_name or "Host"),
                    status = tostring(session.status or "published_open"),
                    env_name = tostring(session.env_name or ENV_NAME or "LOCAL"),
                    game_version = tostring(session.game_version or GAME_VERSION_LABEL or "0"),
                    protocol_version = tostring(session.protocol_version or NET_PROTOCOL_VERSION or "1"),
                    players = math.max(1, tonumber(session.players or 1) or 1),
                    max_players = math.max(2, tonumber(session.max_players or 2) or 2),
                    is_locked = session.is_locked == true,
                    joined_player_ids = multiplayer_clone_simple_table(session.joined_player_ids or {}),
                    session_key = tostring(session.session_key or session.id or ""),
                    session_number = tonumber(session.session_number or 0) or 0,
                    host_steam_id = tostring(session.host_steam_id or ""),
                    lobby_status = tostring(session.lobby_status or MP_SESSION_TICKET.LOBBY_STATUS_OPEN),
                    publish_status = tostring(session.publish_status or session.status or MP_SESSION_TICKET.PUBLISH_OPEN),
                    updated_at_ms = refresh_ms
                }
            }))
        end
        return events
    end

    if cmd_type == "lobby_join_session" then
        multiplayer_lobby_ensure_runtime(self)
        local session_id = tostring(payload.session_id or "")
        local requested_protocol_version = tostring(payload.protocol_version or "")
        local session = multiplayer_lobby_get_session_by_id(self, session_id)
        if not session or not multiplayer_lobby_is_session_host(self, session) then
            multiplayer_debug_log(self, string.format(
                "MP LOBBY | join_session_reject session=%s found=%s session_host=%s",
                session_id,
                tostring(session ~= nil),
                tostring(session and multiplayer_lobby_is_session_host(self, session) == true)
            ))
            return events
        end
        local expected_protocol_version = tostring(session and session.protocol_version or NET_PROTOCOL_VERSION or "1")
        if requested_protocol_version == "" then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_join_session",
                reason = "protocol_version_missing",
                expected_protocol_version = expected_protocol_version,
                received_protocol_version = ""
            }))
            return events
        end
        if requested_protocol_version ~= expected_protocol_version then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_join_session",
                reason = "protocol_mismatch",
                expected_protocol_version = expected_protocol_version,
                received_protocol_version = tostring(requested_protocol_version)
            }))
            return events
        end
        if not session or session.status == "draft" then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_join_session",
                reason = "session_not_found"
            }))
            return events
        end
        if MP_SESSION_TICKET.is_terminal_lobby_status(session.lobby_status) then
            local reject_target = multiplayer_steam_resolve_guest_wire_id(self, session, command)
            if reject_target == "" then
                reject_target = tostring(sender or "")
            end
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_join_session",
                reason = "session_full",
                session_id = session_id,
                target_player_id = reject_target
            }))
            return events
        end
        local requester_player_id = multiplayer_steam_resolve_guest_wire_id(self, session, command)
        if requester_player_id == "" then
            local reject_reason = tostring(command.guest_steam_id or "") ~= "" and "session_full" or "requester_missing"
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_join_session",
                reason = reject_reason
            }))
            return events
        end
        local session_max_players = math.max(2, math.min(4, tonumber(session.max_players or 4) or 4))
        local guest_capacity = math.max(0, session_max_players - 1)
        local already_joined = false
        for _, joined_id in ipairs(session.joined_player_ids or {}) do
            if mp_normalize_network_player_id(joined_id) == mp_normalize_network_player_id(requester_player_id) then
                already_joined = true
                break
            end
        end
        if not already_joined and multiplayer_lobby_count_session_guests(self, session) >= guest_capacity then
            multiplayer_debug_log(self, string.format(
                "MP LOBBY | join_session_reject session=%s reason=session_full guests=%d capacity=%d",
                session_id,
                multiplayer_lobby_count_session_guests(self, session),
                guest_capacity
            ))
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_join_session",
                reason = "session_full",
                session_id = session_id,
                target_player_id = requester_player_id
            }))
            return events
        end
        if tostring(MULTIPLAYER_TRANSPORT_MODE or "") == "steam" then
            multiplayer_steam_sync_transport_peer_map(self, session)
        end
        if session.is_locked == true then
            local expected_pin = tostring(session.pin or "")
            local received_pin = tostring(payload.pin or "")
            local pin_ok = expected_pin ~= "" and received_pin == expected_pin
            multiplayer_debug_log(self, string.format(
                "MP LOBBY | join_pin_check session=%s expected_len=%d received_len=%d ok=%s",
                session_id,
                #expected_pin,
                #received_pin,
                tostring(pin_ok)
            ))
            if not pin_ok then
                table.insert(events, multiplayer_transport_emit_event(self, "lobby_offer_join_reject", {
                    target_player_id = requester_player_id,
                    offer_id = session_id,
                    session_id = session_id,
                    reason = "pin_invalid"
                }))
                return events
            end
        end
        session.joined_player_ids = session.joined_player_ids or {}
        already_joined = false
        for _, joined_id in ipairs(session.joined_player_ids) do
            if mp_normalize_network_player_id(joined_id) == mp_normalize_network_player_id(requester_player_id) then
                already_joined = true
                break
            end
        end
        if not already_joined then
            session.joined_player_ids[#session.joined_player_ids + 1] = requester_player_id
            multiplayer_mark_remote_player_alive(self, requester_player_id)
        end
        session.display_name_by_wire_id = multiplayer_lobby_merge_display_name_maps(
            session.display_name_by_wire_id,
            { [requester_player_id] = payload.display_name or "" }
        )
        self.mp_lobby.guest_join_resend_pending = self.mp_lobby.guest_join_resend_pending or {}
        self.mp_lobby.guest_join_resend_pending[requester_player_id] = true
        if self.mp_lobby.setup_sync_player_ids then
            self.mp_lobby.setup_sync_player_ids[requester_player_id] = nil
        end
        session.players = math.min(session_max_players, tonumber(#session.joined_player_ids) or 1)
        session.updated_at_ms = get_wall_clock_ms()
        self.mp_lobby.offers_by_id[session_id] = session
        multiplayer_lobby_sync_sessions_from_offers(self)
        multiplayer_lobby_emit_offer_upsert(self, session)
        table.insert(events, multiplayer_transport_emit_event(self, "lobby_offer_upsert", {
            offer = {
                id = tostring(session.id or ""),
                session_key = tostring(session.session_key or session.id or ""),
                session_number = tonumber(session.session_number or 0) or 0,
                host_steam_id = tostring(session.host_steam_id or ""),
                lobby_status = tostring(session.lobby_status or MP_SESSION_TICKET.LOBBY_STATUS_OPEN),
                owner_player_id = tostring(session.owner_player_id or "p1"),
                host_name = tostring(session.host_name or "Host"),
                status = tostring(session.status or "published_open"),
                publish_status = tostring(session.publish_status or session.status or "published_open"),
                env_name = tostring(session.env_name or ENV_NAME or "LOCAL"),
                game_version = tostring(session.game_version or GAME_VERSION_LABEL or "0"),
                protocol_version = tostring(session.protocol_version or NET_PROTOCOL_VERSION or "1"),
                players = math.max(1, tonumber(session.players or 1) or 1),
                max_players = session_max_players,
                is_locked = session.is_locked == true,
                joined_player_ids = multiplayer_clone_simple_table(session.joined_player_ids or {}),
                display_name_by_wire_id = multiplayer_clone_simple_table(session.display_name_by_wire_id or {}),
                updated_at_ms = tonumber(session.updated_at_ms or get_wall_clock_ms()) or get_wall_clock_ms()
            }
        }))
        table.insert(events, multiplayer_transport_emit_event(self, "lobby_offer_join_accept", {
            target_player_id = requester_player_id,
            offer_id = session_id,
            session_id = session_id
        }))
        local setup_config = multiplayer_setup_build_session_config(self, multiplayer_setup_roster_player_count(self, session))
        if multiplayer_lobby_is_session_host(self, session) then
            multiplayer_setup_sync_player_count_from_roster(self, session)
            setup_config = multiplayer_setup_build_session_config(self, multiplayer_setup_roster_player_count(self, session))
        end
        setup_config.player_count = multiplayer_setup_roster_player_count(self, session)
        table.insert(events, multiplayer_transport_emit_event(self, "setup_state_updated", {
            target_player_id = requester_player_id,
            session_config = setup_config
        }))
        multiplayer_lobby_append_roster_setup_sync_events(self, events, session, setup_config, requester_player_id)
        if self.mp_state then
            self.mp_state.player_count = setup_config.player_count
        end
        if self.mp_setup and multiplayer_lobby_is_session_host(self, session) then
            multiplayer_setup_apply_session_config(self, setup_config)
        end
        table.insert(events, multiplayer_transport_emit_event(self, "lobby_join_accepted", {
            target_player_id = requester_player_id,
            session_id = tostring(session.id or ""),
            session_max_players = session_max_players,
            session_config = setup_config
        }))
        if tostring(MULTIPLAYER_TRANSPORT_MODE or "") == "steam" then
            multiplayer_steam_sync_transport_peer_map(self, session)
        end
        local roster_str = table.concat(session.joined_player_ids or {}, ",")
        multiplayer_debug_log(self, string.format(
            "MP LOBBY | join_session_complete requester=%s roster=%s events=%d",
            requester_player_id,
            roster_str,
            #events
        ))
        multiplayer_debug_log(self, string.format(
            "MP LOBBY | roster_after_join session=%s requester=%s roster=%s rev=%d",
            session_id,
            requester_player_id,
            roster_str,
            tonumber(session.setup_roster_revision or 0) or 0
        ))
        if multiplayer_lobby_is_session_host(self, session) then
            multiplayer_lobby_lifecycle_refresh_host(self, session)
        end
        return events
    end

    if cmd_type == "lobby_offer_join_response" then
        multiplayer_lobby_ensure_runtime(self)
        local offer_id = tostring(payload.offer_id or "")
        local requester_player_id = tostring(payload.requester_player_id or "")
        local accepted = payload.accepted == true
        local reason = tostring(payload.reason or "")
        local session = multiplayer_lobby_get_session_by_id(self, offer_id)
        if not session or offer_id == "" or requester_player_id == "" then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_offer_join_response",
                reason = "offer_not_found"
            }))
            return events
        end
        local owner_player_id = tostring(session.owner_player_id or MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID)
        local session_max_players = math.max(2, math.min(4, tonumber(session.max_players or 4) or 4))
        if not multiplayer_lobby_sender_is_session_host(session, sender) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_offer_join_response",
                reason = "not_offer_owner"
            }))
            return events
        end
        if accepted then
            session.joined_player_ids = session.joined_player_ids or {}
            local already_joined = false
            for _, joined_id in ipairs(session.joined_player_ids) do
                if tostring(joined_id or "") == requester_player_id then
                    already_joined = true
                    break
                end
            end
            if not already_joined then
                session.joined_player_ids[#session.joined_player_ids + 1] = requester_player_id
            end
            session.players = math.min(tonumber(session.max_players or 4) or 4, tonumber(#session.joined_player_ids) or 1)
            self.mp_lobby.offers_by_id[offer_id] = session
            multiplayer_lobby_sync_sessions_from_offers(self)
            multiplayer_lobby_emit_offer_upsert(self, session)
            table.insert(events, multiplayer_transport_emit_event(self, "lobby_offer_upsert", {
                offer = {
                    id = tostring(session.id or ""),
                    session_key = tostring(session.session_key or session.id or ""),
                    session_number = tonumber(session.session_number or 0) or 0,
                    host_steam_id = tostring(session.host_steam_id or ""),
                    lobby_status = tostring(session.lobby_status or MP_SESSION_TICKET.LOBBY_STATUS_OPEN),
                    owner_player_id = owner_player_id,
                    host_name = tostring(session.host_name or "Host"),
                    status = tostring(session.status or "published_open"),
                    publish_status = tostring(session.publish_status or session.status or "published_open"),
                    players = math.max(1, tonumber(session.players or 1) or 1),
                    max_players = math.max(2, tonumber(session.max_players or session_max_players) or session_max_players),
                    is_locked = session.is_locked == true,
                    joined_player_ids = multiplayer_clone_simple_table(session.joined_player_ids or {})
                }
            }))
        end
        table.insert(events, multiplayer_transport_emit_event(self, accepted and "lobby_offer_join_accept" or "lobby_offer_join_reject", {
            target_player_id = requester_player_id,
            offer_id = offer_id,
            session_id = offer_id,
            reason = reason
        }))
        if accepted then
            local roster_n = multiplayer_setup_roster_player_count(self, session)
            if multiplayer_lobby_is_session_host(self, session) then
                multiplayer_setup_sync_player_count_from_roster(self, session)
                roster_n = multiplayer_setup_roster_player_count(self, session)
            end
            local setup_config = multiplayer_setup_build_session_config(self, roster_n)
            setup_config.player_count = roster_n
            table.insert(events, multiplayer_transport_emit_event(self, "setup_state_updated", {
                target_player_id = requester_player_id,
                session_config = setup_config
            }))
            multiplayer_lobby_append_roster_setup_sync_events(self, events, session, setup_config, requester_player_id)
            if self.mp_state then
                self.mp_state.player_count = setup_config.player_count
            end
            if self.mp_setup and multiplayer_lobby_is_session_host(self, session) then
                multiplayer_setup_apply_session_config(self, setup_config)
            end
            table.insert(events, multiplayer_transport_emit_event(self, "lobby_join_accepted", {
                target_player_id = requester_player_id,
                session_id = tostring(session.id or ""),
                session_max_players = session_max_players,
                session_config = setup_config
            }))
        end
        return events
    end

    if cmd_type == "lobby_offer_upsert" then
        multiplayer_lobby_ensure_runtime(self)
        local offer = payload.offer or {}
        local offer_id = tostring(offer.id or "")
        local target_player_id = tostring(payload.target_player_id or "")
        local local_player_id = tostring(self.mp_state and self.mp_state.local_player_id or "p1")
        if target_player_id ~= "" and target_player_id ~= local_player_id then
            return events
        end
        if offer_id == "" then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_offer_upsert",
                reason = "offer_id_missing"
            }))
            return events
        end
        local host_wire_player_id = multiplayer_lobby_session_host_wire_id(offer)
        if host_wire_player_id == "" or not multiplayer_lobby_sender_is_session_host(offer, sender) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_offer_upsert",
                reason = "session_host_mismatch"
            }))
            return events
        end
        offer.owner_player_id = tostring(offer.owner_player_id or MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID)
        offer.host_wire_player_id = host_wire_player_id
        if tonumber(offer.updated_at_ms or 0) == 0 then
            offer.updated_at_ms = get_wall_clock_ms()
        end
        print(string.format("LOBBY_COMMAND | offer_upsert_recv_command | offer=%s owner=%s", offer_id, tostring(offer.owner_player_id or "")))
        multiplayer_lobby_apply_offer_upsert(self, offer)
        table.insert(events, multiplayer_transport_emit_event(self, "lobby_offer_upsert", {
            offer = offer
        }))
        return events
    end

    if cmd_type == "lobby_offer_remove" then
        multiplayer_lobby_ensure_runtime(self)
        local offer_id = tostring(payload.offer_id or "")
        local removed_at_ms = tonumber(payload.removed_at_ms or get_wall_clock_ms()) or get_wall_clock_ms()
        if offer_id == "" then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_offer_remove",
                reason = "offer_id_missing"
            }))
            return events
        end
        local session = multiplayer_lobby_get_session_by_id(self, offer_id)
        if not session or not multiplayer_lobby_sender_is_session_host(session, sender) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_offer_remove",
                reason = "session_host_mismatch"
            }))
            return events
        end
        local host_wire_player_id = multiplayer_lobby_session_host_wire_id(session)
        multiplayer_lobby_note_offer_removed(self, offer_id, removed_at_ms)
        print(string.format("LOBBY_COMMAND | offer_remove_recv_command | offer=%s host_wire=%s", offer_id, host_wire_player_id))
        multiplayer_lobby_apply_offer_remove(self, offer_id)
        table.insert(events, multiplayer_transport_emit_event(self, "lobby_offer_remove", {
            offer_id = offer_id,
            owner_player_id = host_wire_player_id,
            host_wire_player_id = host_wire_player_id,
            removed_at_ms = removed_at_ms
        }))
        return events
    end

    if cmd_type == "lobby_leave_session" then
        multiplayer_lobby_ensure_runtime(self)
        local session_id = tostring(payload.session_id or "")
        if session_id == "" then
            local existing = multiplayer_lobby_find_session_joined_by_player(self, sender)
            session_id = tostring(existing and existing.id or "")
        end
        if session_id == "" then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_leave_session",
                reason = "session_not_found"
            }))
            return events
        end
        local session = multiplayer_lobby_get_session_by_id(self, session_id)
        local departing_id = mp_normalize_network_player_id(sender)
        local guest_steam_id = tostring(command.guest_steam_id or "")
        if guest_steam_id ~= "" and type(session) == "table" then
            multiplayer_steam_ensure_session_roster_maps(session)
            local mapped_wire = tostring(session.wire_id_by_steam_id[guest_steam_id] or "")
            if mapped_wire ~= "" then
                departing_id = mp_normalize_network_player_id(mapped_wire)
            end
        end
        local departing_steam_id = guest_steam_id
        if departing_steam_id == "" and type(session) == "table" then
            multiplayer_steam_ensure_session_roster_maps(session)
            departing_steam_id = tostring(session.steam_id_by_wire_id[departing_id] or "")
        end
        if multiplayer_lobby_remove_player_from_session(self, session_id, departing_id) then
            if departing_steam_id ~= ""
                and self.mp_transport
                and self.mp_transport.steam_forget_peer
            then
                pcall(self.mp_transport.steam_forget_peer, departing_steam_id)
            end
            self.mp_lobby.guest_join_resend_pending = self.mp_lobby.guest_join_resend_pending or {}
            self.mp_lobby.guest_join_resend_pending[departing_id] = nil
            if self.mp_lobby.setup_sync_player_ids then
                self.mp_lobby.setup_sync_player_ids[departing_id] = nil
            end
            multiplayer_lobby_prune_guest_sync_maps(self, multiplayer_lobby_get_session_by_id(self, session_id))
            multiplayer_lobby_prune_steam_disconnected_guests(self)
            if (self.game_flow_state or FLOW_STATE_GAME) == FLOW_STATE_MP_SETUP
                and multiplayer_lobby_is_session_host(self, multiplayer_lobby_get_session_by_id(self, session_id)) then
                local active_session = multiplayer_lobby_get_session_by_id(self, session_id)
                multiplayer_setup_sync_player_count_from_roster(self, active_session)
                multiplayer_setup_push_state(self)
                multiplayer_lobby_lifecycle_refresh_host(self, active_session)
            end
            multiplayer_debug_log(self, string.format(
                "MP LOBBY | leave_session_roster_prune session=%s player=%s guests=%d players=%d",
                session_id,
                departing_id,
                multiplayer_lobby_count_session_guests(self, multiplayer_lobby_get_session_by_id(self, session_id)),
                tonumber(multiplayer_lobby_get_session_by_id(self, session_id) and multiplayer_lobby_get_session_by_id(self, session_id).players or 1) or 1
            ))
        else
            multiplayer_debug_log(self, string.format(
                "MP LOBBY | leave_session_reject session=%s sender=%s steam=%s",
                session_id,
                tostring(sender or ""),
                guest_steam_id
            ))
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "lobby_leave_session",
                reason = "player_not_in_session"
            }))
        end
        return events
    end

    if cmd_type == "push_setup_state" then
        if sender ~= self.mp_state.host_player_id then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "push_setup_state",
                reason = "not_host"
            }))
            return events
        end
        -- Host local state is already authoritative; never re-apply pushed setup to host.
        local config = multiplayer_setup_build_guest_wire_config(self, multiplayer_lobby_get_active_session(self))
        table.insert(events, multiplayer_transport_emit_event(self, "setup_state_updated", {
            session_config = config
        }))
        return events
    end

    if cmd_type == "start_match_request" then
        if sender ~= self.mp_state.host_player_id then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "start_match_request",
                reason = "not_host"
            }))
            return events
        end
        local session = multiplayer_lobby_get_active_session(self)
        multiplayer_setup_sync_player_count_from_roster(self, session)
        local launch_count = multiplayer_setup_roster_player_count(self, session)
        local launch_guest_ids = multiplayer_lobby_collect_launch_guest_ids(self, session)
        local config = multiplayer_setup_build_session_config(self, launch_count)
        config.player_count = launch_count
        if not multiplayer_setup_is_valid(self) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "start_match_request",
                reason = "invalid_setup"
            }))
            return events
        end
        multiplayer_lobby_ensure_runtime(self)
        local active_offer_id = tostring(self.mp_lobby and self.mp_lobby.local_active_offer_id or "")
        if active_offer_id ~= "" then
            multiplayer_lobby_note_offer_removed(self, active_offer_id, get_wall_clock_ms())
            multiplayer_lobby_apply_offer_remove(self, active_offer_id)
            table.insert(events, multiplayer_transport_emit_event(self, "lobby_offer_remove", {
                offer_id = active_offer_id,
                owner_player_id = tostring(self.mp_state.host_player_id or sender or "p1"),
                removed_at_ms = get_wall_clock_ms()
            }))
        end
        config.level_index = select_level_index_for_mission(self, config.mission_type or MISSION_TYPE_ESCAPE)
        table.insert(events, multiplayer_transport_emit_event(self, "match_started", {
            session_config = config
        }))
        local host_id = mp_normalize_network_player_id(self.mp_state.host_player_id or sender or "p1")
        for _, guest_id in ipairs(launch_guest_ids) do
            if guest_id ~= "" and guest_id ~= host_id then
                table.insert(events, multiplayer_transport_emit_event(self, "match_started", {
                    target_player_id = guest_id,
                    session_config = config
                }))
            end
        end
        return events
    end

    if cmd_type == "leave_match_request" then
        if sender == self.mp_state.host_player_id then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "leave_match_request",
                reason = "host_cannot_leave_via_client_command"
            }))
            return events
        end
        local requested_session_id = tostring(payload.session_id or "")
        local active_session_id = tostring(self.mp_state.session_id or "")
        if requested_session_id ~= "" and active_session_id ~= "" and requested_session_id ~= active_session_id then
            print(string.format(
                "MP MATCH | leave_request_session_mismatch_ignored | sender=%s requested=%s active=%s",
                tostring(sender or ""),
                requested_session_id,
                active_session_id
            ))
        end
        if not multiplayer_apply_in_match_player_departure(self, sender) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "leave_match_request",
                reason = "player_not_in_match"
            }))
            return events
        end
        local lobby_session_id = tostring(self.mp_state.lobby_ticket_id or active_session_id or "")
        if lobby_session_id ~= "" and lobby_session_id ~= "local_session" then
            if multiplayer_lobby_remove_player_from_session(self, lobby_session_id, sender) then
                multiplayer_debug_log(self, string.format(
                    "MP LOBBY | leave_match_roster_prune session=%s player=%s",
                    lobby_session_id,
                    tostring(sender or "")
                ))
            end
        end
        table.insert(events, multiplayer_transport_emit_event(self, "player_departed_in_match", {
            session_id = active_session_id,
            departed_player_id = tostring(sender or ""),
            seat_assignments = multiplayer_clone_seat_assignments(self.mp_state.seat_assignments, self.mp_state.player_count or 4),
            required_ready_player_ids = multiplayer_clone_simple_table(self.mp_state.required_ready_player_ids or {}),
            ready_by_player_id = multiplayer_clone_simple_table(self.mp_state.ready_by_player_id or {})
        }))
        return events
    end

    if cmd_type == "move_unit" then
        local unit_id = payload.unit_id
        local destination_cell_id = tonumber(payload.destination_cell_id)
        local requested_slot = tonumber(payload.destination_slot_index)
        local expected_turn_id = tonumber(payload.turn_id or (self.mp_state.turn_id or 1))
        if expected_turn_id ~= (self.mp_state.turn_id or 1) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "move_unit",
                reason = "stale_turn_id"
            }))
            return events
        end
        if not multiplayer_player_owns_unit(self, sender, unit_id) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "move_unit",
                reason = "unit_not_owned_by_sender"
            }))
            return events
        end
        local unit = self.squad_units and self.squad_units[unit_id] or nil
        if not unit or (unit.current_health or 0) <= 0 or unit.is_moving then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "move_unit",
                reason = "unit_not_actionable"
            }))
            return events
        end
        local is_same_cell_reposition = destination_cell_id and (unit.cell_id == destination_cell_id)
        if not destination_cell_id or (not is_same_cell_reposition and not is_walkable_cell(self.world_grid, destination_cell_id)) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "move_unit",
                reason = "invalid_destination"
            }))
            return events
        end
        if is_same_cell_reposition then
            if requested_slot == nil then
                table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                    command_type = "move_unit",
                    reason = "invalid_destination"
                }))
                return events
            end
            local ap_now = tonumber(unit.current_ap or 0) or 0
            table.insert(events, multiplayer_transport_emit_event(self, "move_unit_applied", {
                unit_id = unit_id,
                destination_cell_id = destination_cell_id,
                destination_slot_index = multiplayer_resolve_destination_slot(self, unit, destination_cell_id, requested_slot),
                path = { unit.cell_id },
                ap_cost = 0,
                ap_before = ap_now,
                ap_after = ap_now
            }))
            return events
        end
        local path_context = { allow_closed_doors = true }
        local path, total_cost = find_path(self.world_grid, unit.cell_id, destination_cell_id, nil, MOVEMENT_PROFILE_HUMAN, path_context)
        if not path then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "move_unit",
                reason = "no_path"
            }))
            return events
        end
        total_cost = tonumber(total_cost)
        if not total_cost then
            total_cost = 0
            for i = 2, #path do
                total_cost = total_cost + (get_human_step_move_cost(self.world_grid, path[i - 1], path[i], true) or 0)
            end
        end
        local ap_before = tonumber(unit.current_ap or 0) or 0
        if total_cost <= 0 or ap_before <= 0 then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "move_unit",
                reason = "insufficient_ap"
            }))
            return events
        end
        local approved_path = { path[1] }
        local approved_cost = 0
        for i = 2, #path do
            local step_cost = tonumber(get_human_step_move_cost(self.world_grid, path[i - 1], path[i], true) or 0) or 0
            if step_cost <= 0 then
                break
            end
            if (approved_cost + step_cost) > ap_before then
                break
            end
            approved_cost = approved_cost + step_cost
            table.insert(approved_path, path[i])
        end
        if #approved_path <= 1 or approved_cost <= 0 then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "move_unit",
                reason = "insufficient_ap"
            }))
            return events
        end
        local approved_destination_cell_id = approved_path[#approved_path]
        local ap_after = math.max(0, ap_before - approved_cost)
        table.insert(events, multiplayer_transport_emit_event(self, "move_unit_applied", {
            unit_id = unit_id,
            destination_cell_id = approved_destination_cell_id,
            destination_slot_index = multiplayer_resolve_destination_slot(self, unit, approved_destination_cell_id, requested_slot),
            path = multiplayer_clone_simple_table(approved_path),
            ap_cost = approved_cost,
            ap_before = ap_before,
            ap_after = ap_after
        }))
        return events
    end

    if cmd_type == "manual_shot" then
        local unit_id = payload.unit_id
        local alien_id = tonumber(payload.alien_id)
        local expected_turn_id = tonumber(payload.turn_id or (self.mp_state.turn_id or 1))
        if expected_turn_id ~= (self.mp_state.turn_id or 1) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "manual_shot",
                reason = "stale_turn_id"
            }))
            return events
        end
        if not multiplayer_player_owns_unit(self, sender, unit_id) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "manual_shot",
                reason = "unit_not_owned_by_sender"
            }))
            return events
        end
        local unit = self.squad_units and self.squad_units[unit_id] or nil
        local alien = find_alien_by_id(self, alien_id)
        local shot_ap_cost = get_ap_cost_value("manual_ranged_shot", 1)
        local melee_ap_cost = get_ap_cost_value("melee_attack", 1)
        if not unit or (unit.current_health or 0) <= 0 or unit.is_moving then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "manual_shot",
                reason = "unit_not_actionable"
            }))
            return events
        end
        if not alien or alien.is_dead then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "manual_shot",
                reason = "invalid_target"
            }))
            return events
        end
        local shot_is_ranged = (tonumber(unit.cell_id or 0) or 0) ~= (tonumber(alien.cell_id or 0) or 0)
        local required_ap = shot_is_ranged and shot_ap_cost or melee_ap_cost
        if (tonumber(unit.current_ap or 0) or 0) < required_ap then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "manual_shot",
                reason = "unit_not_actionable"
            }))
            return events
        end
        if shot_is_ranged then
            try_realtime_auto_load_ammo_from_backpack(self, unit)
            local alien_cell = self.world_grid and self.world_grid[alien.cell_id] or nil
            if not alien_cell or alien_cell.tileID == hash("empty") then
                table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                    command_type = "manual_shot",
                    reason = "invalid_target"
                }))
                return events
            end
            if not has_unobstructed_human_ranged_los(self.world_grid, unit.cell_id, alien.cell_id) then
                table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                    command_type = "manual_shot",
                    reason = "invalid_target"
                }))
                return events
            end
            if (tonumber(unit.current_ammo or 0) or 0) <= 0 then
                table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                    command_type = "manual_shot",
                    reason = "unit_not_actionable"
                }))
                return events
            end
            if not unit.go_path or not alien.go_id then
                table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                    command_type = "manual_shot",
                    reason = "invalid_target"
                }))
                return events
            end
        end
        local hit_chance = compute_manual_ranged_hit_chance(self, unit, alien) or 0
        hit_chance = math.max(0, math.min(100, tonumber(hit_chance) or 0))
        local roll = math.random(1, 100)
        local impact_hit = roll <= hit_chance
        local ap_before = tonumber(unit.current_ap or 0) or 0
        local ammo_before = tonumber(unit.current_ammo or 0) or 0
        local ap_cost = shot_is_ranged and shot_ap_cost or melee_ap_cost
        local ammo_cost = shot_is_ranged and 1 or 0
        local ap_after = math.max(0, ap_before - ap_cost)
        local ammo_after = math.max(0, ammo_before - ammo_cost)
        table.insert(events, multiplayer_transport_emit_event(self, "manual_shot_applied", {
            unit_id = unit_id,
            alien_id = alien_id,
            hit_chance = hit_chance,
            roll = roll,
            impact_hit = impact_hit,
            shot_is_ranged = shot_is_ranged and 1 or 0,
            ap_before = ap_before,
            ap_after = ap_after,
            ap_cost = ap_cost,
            ammo_before = ammo_before,
            ammo_after = ammo_after,
            ammo_cost = ammo_cost
        }))
        return events
    end

    if cmd_type == "cleanse_flamer" then
        local unit_id = payload.unit_id
        local target_cell_id = tonumber(payload.target_cell_id or 0) or 0
        local expected_turn_id = tonumber(payload.turn_id or (self.mp_state.turn_id or 1))
        if expected_turn_id ~= (self.mp_state.turn_id or 1) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "cleanse_flamer",
                reason = "stale_turn_id"
            }))
            return events
        end
        if not multiplayer_player_owns_unit(self, sender, unit_id) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "cleanse_flamer",
                reason = "unit_not_owned_by_sender"
            }))
            return events
        end
        local unit = self.squad_units and self.squad_units[unit_id] or nil
        if not unit or (tonumber(unit.current_health or 0) or 0) <= 0 then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "cleanse_flamer",
                reason = "unit_not_actionable"
            }))
            return events
        end
        if target_cell_id <= 0 then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "cleanse_flamer",
                reason = "invalid_target"
            }))
            return events
        end
        table.insert(events, multiplayer_transport_emit_event(self, "cleanse_flamer_applied", {
            unit_id = unit_id,
            target_cell_id = target_cell_id
        }))
        return events
    end

    if cmd_type == "release_civilian" then
        local expected_turn_id = tonumber(payload.turn_id or (self.mp_state.turn_id or 1))
        if expected_turn_id ~= (self.mp_state.turn_id or 1) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "release_civilian",
                reason = "stale_turn_id"
            }))
            return events
        end
        local unit_id = payload.unit_id
        local civilian_id = tonumber(payload.civilian_id)
        if not multiplayer_player_owns_unit(self, sender, unit_id) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "release_civilian",
                reason = "unit_not_owned_by_sender"
            }))
            return events
        end
        local unit = self.squad_units and self.squad_units[unit_id] or nil
        if not unit or (unit.current_health or 0) <= 0 then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "release_civilian",
                reason = "unit_not_actionable"
            }))
            return events
        end
        if not civilian_id then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "release_civilian",
                reason = "invalid_civilian_id"
            }))
            return events
        end
        local target_civilian = nil
        for _, civilian in ipairs(self.civilians or {}) do
            if civilian and tonumber(civilian.id or 0) == civilian_id then
                target_civilian = civilian
                break
            end
        end
        if not target_civilian or target_civilian.is_dead == true or target_civilian.is_awake == true then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "release_civilian",
                reason = "civilian_not_releasable"
            }))
            return events
        end
        if tonumber(unit.cell_id or 0) ~= tonumber(target_civilian.cell_id or 0) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "release_civilian",
                reason = "human_not_same_cell"
            }))
            return events
        end
        local civ_cell = self.world_grid and self.world_grid[target_civilian.cell_id] or nil
        if not civ_cell or civ_cell.isPowered ~= true then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "release_civilian",
                reason = "cell_not_powered"
            }))
            return events
        end
        if not set_civilian_awake_from_release(self, target_civilian, unit_id) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "release_civilian",
                reason = "apply_failed_on_host"
            }))
            return events
        end
        table.insert(events, multiplayer_transport_emit_event(self, "release_civilian_applied", {
            civilian_id = civilian_id,
            unit_id = unit_id,
            host_applied = true,
            actor_digest = multiplayer_build_actor_state_digest(self)
        }))
        return events
    end

    if cmd_type == "comms_command" then
        local expected_turn_id = tonumber(payload.turn_id or (self.mp_state.turn_id or 1))
        if expected_turn_id ~= (self.mp_state.turn_id or 1) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "comms_command",
                reason = "stale_turn_id"
            }))
            return events
        end
        local unit_id = payload.unit_id
        local event_type = tostring(payload.comms_event_type or "")
        if not multiplayer_player_owns_unit(self, sender, unit_id) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "comms_command",
                reason = "unit_not_owned_by_sender"
            }))
            return events
        end
        local unit = self.squad_units and self.squad_units[unit_id] or nil
        if not unit or (unit.current_health or 0) <= 0 then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "comms_command",
                reason = "unit_not_actionable"
            }))
            return events
        end
        if not is_valid_comms_event_type(event_type) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "comms_command",
                reason = "invalid_payload"
            }))
            return events
        end
        table.insert(events, multiplayer_transport_emit_event(self, "comms_command_applied", {
            unit_id = unit_id,
            comms_event_type = event_type
        }))
        return events
    end

    if cmd_type == "set_reactive_fire" then
        local expected_turn_id = tonumber(payload.turn_id or (self.mp_state.turn_id or 1))
        if expected_turn_id ~= (self.mp_state.turn_id or 1) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "set_reactive_fire",
                reason = "stale_turn_id"
            }))
            return events
        end
        local unit_id = payload.unit_id
        local enabled = payload.reactive_fire_enabled == true
        if not multiplayer_player_owns_unit(self, sender, unit_id) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "set_reactive_fire",
                reason = "unit_not_owned_by_sender"
            }))
            return events
        end
        local unit = self.squad_units and self.squad_units[unit_id] or nil
        if not unit or (unit.current_health or 0) <= 0 then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "set_reactive_fire",
                reason = "unit_not_actionable"
            }))
            return events
        end
        table.insert(events, multiplayer_transport_emit_event(self, "set_reactive_fire_applied", {
            unit_id = unit_id,
            reactive_fire_enabled = enabled
        }))
        return events
    end

    if cmd_type == "resource_drag_end" then
        local expected_turn_id = tonumber(payload.turn_id or (self.mp_state.turn_id or 1))
        if expected_turn_id ~= (self.mp_state.turn_id or 1) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "resource_drag_end",
                reason = "stale_turn_id"
            }))
            return events
        end
        local drag = payload.drag or {}
        local ui_action = nil
        if type(payload.ui_action) == "table" then
            ui_action = multiplayer_clone_flat_table(payload.ui_action)
        end
        local source_unit_id = drag.source_unit_id
        if not multiplayer_player_owns_unit(self, sender, source_unit_id) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "resource_drag_end",
                reason = "unit_not_owned_by_sender"
            }))
            return events
        end
        if not multiplayer_apply_resource_drag_event(self, {
            screen_x = tonumber(payload.screen_x),
            screen_y = tonumber(payload.screen_y),
            world_x = tonumber(payload.world_x),
            world_y = tonumber(payload.world_y),
            drag = multiplayer_clone_flat_table(drag),
            ui_action = ui_action
        }) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "resource_drag_end",
                reason = "apply_failed_on_host"
            }))
            return events
        end
        table.insert(events, multiplayer_transport_emit_event(self, "resource_drag_applied", {
            screen_x = tonumber(payload.screen_x),
            screen_y = tonumber(payload.screen_y),
            world_x = tonumber(payload.world_x),
            world_y = tonumber(payload.world_y),
            drag = multiplayer_clone_flat_table(drag),
            ui_action = ui_action,
            host_applied = true,
            unit_digest = multiplayer_build_unit_state_digest(self),
            world_digest = multiplayer_build_world_state_digest(self),
            item_digest = multiplayer_build_item_state_digest(self)
        }))
        return events
    end

    if cmd_type == "pickup_obstacle" then
        local expected_turn_id = tonumber(payload.turn_id or (self.mp_state.turn_id or 1))
        if expected_turn_id ~= (self.mp_state.turn_id or 1) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "pickup_obstacle",
                reason = "stale_turn_id"
            }))
            return events
        end
        local unit_id = payload.unit_id
        local cell_id = tonumber(payload.cell_id)
        if not multiplayer_player_owns_unit(self, sender, unit_id) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "pickup_obstacle",
                reason = "unit_not_owned_by_sender"
            }))
            return events
        end
        local unit = self.squad_units and self.squad_units[unit_id] or nil
        local cell = cell_id and self.world_grid and self.world_grid[cell_id] or nil
        if not unit or not cell then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "pickup_obstacle",
                reason = "invalid_payload"
            }))
            return events
        end
        local pre_obstacle_by_slot = {}
        do
            local objects = { cell.object1, cell.object2, cell.object3 }
            for slot_idx, obj in ipairs(objects) do
                if obj and obj.name == hash("obstacle") then
                    pre_obstacle_by_slot[slot_idx] = {
                        has_obstacle = true,
                        object_id = tonumber(obj.objectId or 0) or 0,
                        count = tonumber(obj.stackCount or obj.obstacleCount or 1) or 1
                    }
                else
                    pre_obstacle_by_slot[slot_idx] = {
                        has_obstacle = false,
                        object_id = 0,
                        count = 0
                    }
                end
            end
        end
        if not multiplayer_apply_pickup_obstacle_event(self, {
            unit_id = unit_id,
            cell_id = cell_id,
            world_x = tonumber(payload.world_x),
            world_y = tonumber(payload.world_y),
            obstacle_object_id = tonumber(payload.obstacle_object_id or 0) or 0,
            obstacle_slot_idx = tonumber(payload.obstacle_slot_idx or 0) or 0
        }) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "pickup_obstacle",
                reason = "apply_failed_on_host"
            }))
            return events
        end
        table.insert(events, multiplayer_transport_emit_event(self, "pickup_obstacle_applied", {
            unit_id = unit_id,
            cell_id = cell_id,
            world_x = tonumber(payload.world_x),
            world_y = tonumber(payload.world_y),
            obstacle_object_id = tonumber(payload.obstacle_object_id or 0) or 0,
            obstacle_slot_idx = tonumber(payload.obstacle_slot_idx or 0) or 0,
            host_applied = true,
            unit_digest = multiplayer_build_unit_state_digest(self),
            world_digest = multiplayer_build_world_state_digest(self),
            item_digest = multiplayer_build_item_state_digest(self)
        }))
        do
            local obstacle_slot_idx = 0
            local obstacle_object_id = 0
            local obstacle_count_after = 0
            local objects = { cell.object1, cell.object2, cell.object3 }
            for slot_idx, obj in ipairs(objects) do
                local pre = pre_obstacle_by_slot[slot_idx] or {}
                local pre_has = pre.has_obstacle == true
                local pre_count = tonumber(pre.count or 0) or 0
                local post_has = (obj and obj.name == hash("obstacle")) or false
                local post_count = post_has and (tonumber(obj.stackCount or obj.obstacleCount or 1) or 1) or 0
                if pre_has ~= post_has or pre_count ~= post_count then
                    obstacle_slot_idx = slot_idx
                    obstacle_object_id = post_has and (tonumber(obj.objectId or 0) or 0) or (tonumber(pre.object_id or 0) or 0)
                    obstacle_count_after = post_count
                    break
                end
            end
            if obstacle_slot_idx == 0 then
                obstacle_slot_idx = tonumber(payload.obstacle_slot_idx or 0) or 0
                obstacle_object_id = tonumber(payload.obstacle_object_id or 0) or 0
                if obstacle_slot_idx >= 1 and obstacle_slot_idx <= 3 then
                    local slot = objects[obstacle_slot_idx]
                    if slot and slot.name == hash("obstacle") then
                        obstacle_count_after = tonumber(slot.stackCount or slot.obstacleCount or 1) or 1
                    end
                end
            end
            local obstacle_slots = {}
            for slot_idx, obj in ipairs(objects) do
                if obj and obj.name == hash("obstacle") then
                    obstacle_slots[tostring(slot_idx)] = {
                        is_obstacle = true,
                        object_id = tonumber(obj.objectId or 0) or 0,
                        count = tonumber(obj.stackCount or obj.obstacleCount or 1) or 1,
                        isFixed = obj.isFixed == true,
                        isWelded = obj.isWelded == true,
                        offsetX = tonumber(obj.offsetX or 0) or 0,
                        offsetY = tonumber(obj.offsetY or 0) or 0,
                        hitW = tonumber(obj.hitW or 24) or 24,
                        hitH = tonumber(obj.hitH or 24) or 24
                    }
                else
                    obstacle_slots[tostring(slot_idx)] = {
                        is_obstacle = false
                    }
                end
            end
            table.insert(events, multiplayer_transport_emit_event(self, "obstacle_pickup_fx", {
                cell_id = cell_id,
                obstacle_slot_idx = obstacle_slot_idx,
                obstacle_object_id = obstacle_object_id,
                obstacle_count_after = obstacle_count_after,
                obstacle_slots = obstacle_slots
            }))
        end
        return events
    end


[project]
title = Derples vs Xenos
version = 1.1
developer = Grrr Games
dependencies#0 = https://github.com/defold/extension-websocket/archive/master.zip

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 1280
height = 720
high_dpi = 0
resizable = 1

[render]
clear_color_red = 0.0
clear_color_green = 0.0
clear_color_blue = 0.0
clear_color_alpha = 1

[physics]
scale = 0.02
debug = 0

[script]
shared_state = 1

[sprite]
max_count = 5000

[sound]
max_component_count = 128

[collection]
max_instances = 4096

[html5]
htmlfile = /web/index.html

[multiplayer]
sync_trace = 0

[debug]
outro_preview = 0
outro_preview_sequence = title
outro_preview_result = win

[dvx]
env_name = LOCAL
net_protocol_version = 1
transport_mode = websocket
transport_ws_url = ws://90.192.116.103:8080/ws
transport_room_id = dvx_local_room
lock_fixed_window = 0
start_maximized = 1


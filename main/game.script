    set_ui_square_transform(self, self.ui.reactive_toggle_button, -9999, -9999, 0.84, hidden, 64, 32)
    set_ui_square_transform(self, self.ui.reactive_advance_button, -9999, -9999, 0.84, hidden, 70, 30)
    set_ui_square_transform(self, self.ui.drag_command_pip, -9999, -9999, 0.9, hidden, LOOT_UI.drag_pip_size, LOOT_UI.drag_pip_size)
    set_ui_square_transform(self, self.ui.drag_pip, -9999, -9999, 0.9, hidden, LOOT_UI.drag_pip_size, LOOT_UI.drag_pip_size)
    set_ui_square_transform(self, self.ui.flow_overlay, -9999, -9999, FLOW_UI_OVERLAY_Z, hidden, SCREEN_WIDTH, SCREEN_HEIGHT)
    set_ui_square_transform(self, self.ui.flow_panel, -9999, -9999, FLOW_UI_PANEL_Z, hidden, FLOW_UI_SCREEN_W, FLOW_UI_SCREEN_H)
    set_ui_square_transform(self, self.ui.flow_outro_slide, -9999, -9999, FLOW_UI_PANEL_Z + 0.001, hidden, OUTRO_SLIDE_DEFAULT_W * 0.021, OUTRO_SLIDE_DEFAULT_H * 0.021)
    set_ui_square_transform(self, self.ui.flow_outro_ship, -9999, -9999, FLOW_UI_PANEL_Z, hidden, 280, 120)
    set_ui_square_transform(self, self.ui.flow_outro_skip_button, -9999, -9999, FLOW_UI_BUTTON_Z, hidden, 170, 52)
    set_ui_square_transform(self, self.ui.flow_debug_outro_skip_hitbox, -9999, -9999, FLOW_UI_BUTTON_Z + 0.03, hidden, 170, 52)
    set_ui_square_transform(self, self.ui.flow_outro_skip_button_art, -9999, -9999, FLOW_UI_BUTTON_Z + 0.001, hidden, 1, 1)
    set_ui_square_transform(self, self.ui.flow_score_submit_button, -9999, -9999, FLOW_UI_BUTTON_Z, hidden, 250, 56)
    set_ui_square_transform(self, self.ui.flow_score_title_button, -9999, -9999, FLOW_UI_BUTTON_Z, hidden, 250, 56)
    set_ui_square_transform(self, self.ui.flow_leaderboard_panel, -9999, -9999, FLOW_UI_PANEL_Z + 0.002, hidden, 1, 1)

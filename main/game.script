BUFFS_BY_ITEM_TYPE = {}
do
    for _, buff_def in pairs(BUFFS) do
        if type(buff_def) == "table" and type(buff_def.item_type) == "string" then
            BUFFS_BY_ITEM_TYPE[buff_def.item_type] = buff_def
        end
    end
end

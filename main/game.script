multiplayer_lobby_render_pin_modal = function(self, pin_display_tint, pin_bg_tint, pin_key_tint)
    set_ui_square_transform(self, self.ui.flow_overlay, SCREEN_WIDTH * 0.5, SCREEN_HEIGHT * 0.5, FLOW_UI_OVERLAY_Z, vmath.vector4(0, 0, 0, 0), FLOW_UI_SCREEN_W, FLOW_UI_SCREEN_H)
    if self.ui.flow_mp_lobby_boxes and self.ui.flow_mp_lobby_boxes[6] then
        set_ui_square_transform(self, self.ui.flow_mp_lobby_boxes[6], -9999, -9999, MP_SETUP_UI_Z, vmath.vector4(0, 0, 0, 0), 1, 1)
    end
    set_ui_square_transform(self, self.ui.flow_solo_setup_panel, -9999, -9999, SOLO_SETUP_UI_Z + 0.001, vmath.vector4(0, 0, 0, 0), 1, 1)
    set_ui_square_transform(self, self.ui.flow_solo_mission_select, -9999, -9999, SOLO_SETUP_UI_Z + 0.002, vmath.vector4(0, 0, 0, 0), 1, 1)
    set_ui_square_transform(self, self.ui.flow_mp_lobby_pin_modal_bg, MP_LOBBY_PIN_MODAL_X, mp_lobby_y(MP_LOBBY_PIN_MODAL_Y), MP_LOBBY_PIN_MODAL_Z, vmath.vector4(1, 1, 1, 1), 1, 1)
    if self.ui.flow_mp_lobby_pin_modal_bg then
        pcall(go.set, msg.url(nil, self.ui.flow_mp_lobby_pin_modal_bg, "sprite"), "blend_mode", (render and render.BLEND_ALPHA) or 0)
        pcall(go.set, msg.url(nil, self.ui.flow_mp_lobby_pin_modal_bg, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
    end
    set_ui_square_transform(self, self.ui.flow_mp_lobby_pin_display, -9999, -9999, SOLO_SETUP_UI_Z + 0.002, vmath.vector4(0, 0, 0, 0), MP_LOBBY_PIN_DISPLAY_W, MP_LOBBY_PIN_DISPLAY_H)
    if self.ui.flow_mp_lobby_pin_enter then
        set_ui_square_transform(self, self.ui.flow_mp_lobby_pin_enter, -9999, -9999, SOLO_SETUP_UI_Z + 0.003, vmath.vector4(0, 0, 0, 0), MP_LOBBY_PIN_ENTER_W, MP_LOBBY_PIN_ENTER_H)
    end
    local key_index = 1
    if self.ui.flow_mp_mission_buttons then
        for _, btn in ipairs(self.ui.flow_mp_mission_buttons) do
            set_ui_square_transform(self, btn, -9999, -9999, MP_SETUP_UI_Z, vmath.vector4(0, 0, 0, 0), MP_SETUP_MISSION_BTN_W * 0.021, MP_SETUP_MISSION_BTN_H * 0.021)
        end
    end
    if self.ui.flow_mp_lobby_pin_keys then
        local lobby = self.mp_lobby or {}
        for row = 1, 3 do
            for col = 1, 3 do
                local key_btn = self.ui.flow_mp_lobby_pin_keys[key_index]
                if key_btn then
                    local flash_key_index = ((row - 1) * 3) + col
                    local flash_t = tonumber(lobby.pin_key_flash_timers and lobby.pin_key_flash_timers[flash_key_index] or 0) or 0
                    local key_tint = flash_t > 0 and vmath.vector4(0.24, 0.9, 0.34, 1) or pin_key_tint
                    set_ui_square_transform(self, key_btn, MP_LOBBY_PIN_KEYPAD_COL_X[col], mp_lobby_y(MP_LOBBY_PIN_KEYPAD_ROW_Y[row]), MP_LOBBY_PIN_KEYS_Z, key_tint, 1, 1)
                    pcall(go.set, msg.url(nil, key_btn, "sprite"), "blend_mode", (render and render.BLEND_ALPHA) or 0)
                end
                key_index = key_index + 1
            end
        end
    end
end

multiplayer_lobby_render_ui = function(self, dt, hidden)
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    local page_count = multiplayer_lobby_page_count(self)
    lobby.page_index = math.max(1, math.min(page_count, tonumber(lobby.page_index or 1) or 1))
    local visible_sessions = multiplayer_lobby_get_visible_sessions(self)
    local published_total, compatible_total = multiplayer_lobby_count_compatible_published_sessions(self)
    local card_bg = vmath.vector4(0.18, 0.24, 0.34, 0.94)
    local open_bg = vmath.vector4(0.2, 0.58, 0.28, 0.92)
    local locked_bg = vmath.vector4(0.58, 0.26, 0.26, 0.92)
    local empty_bg = vmath.vector4(0.1, 0.12, 0.18, 0.65)
    local page_btn_tint = vmath.vector4(0.74, 0.74, 0.82, 0.98)
    local create_tint = vmath.vector4(0.18, 0.76, 0.36, 0.98)
    local host_open_tint = vmath.vector4(0.12, 0.7, 0.34, 0.96)
    local host_private_tint = vmath.vector4(0.72, 0.44, 0.16, 0.96)
    local host_info_tint = vmath.vector4(0.66, 0.74, 0.86, 0.92)
    local pin_bg_tint = vmath.vector4(1, 1, 1, 1)
    local pin_key_tint = vmath.vector4(0.28, 0.34, 0.46, 1)
    local pin_display_tint = vmath.vector4(0.7, 0.84, 0.96, 0.92)
    if lobby.pin_feedback == "ok" then
        pin_display_tint = vmath.vector4(0.24, 0.9, 0.34, 0.95)
    elseif lobby.pin_feedback == "bad" then
        pin_display_tint = vmath.vector4(0.92, 0.24, 0.24, 0.95)
    end
    set_ui_square_transform(self, self.ui.flow_panel, MP_LOBBY_PANEL_X, mp_lobby_y(MP_LOBBY_PANEL_Y), FLOW_UI_PANEL_Z, vmath.vector4(0, 0, 0, 0), MP_LOBBY_PANEL_W, MP_LOBBY_PANEL_H)
    if self.ui.flow_mp_lobby_backpanel then
        set_ui_square_transform(self, self.ui.flow_mp_lobby_backpanel, MP_LOBBY_PANEL_X - 21, mp_lobby_y(MP_LOBBY_PANEL_Y - 90), FLOW_UI_PANEL_Z + 0.005, vmath.vector4(1, 1, 1, 1), 1, 1)
    end
    if self.ui.flow_mp_lobby_pin_modal_bg then
        set_ui_square_transform(self, self.ui.flow_mp_lobby_pin_modal_bg, -9999, -9999, MP_LOBBY_PIN_MODAL_Z, hidden, MP_LOBBY_PIN_MODAL_W, MP_LOBBY_PIN_MODAL_H)
    end
    if self.ui.flow_mp_lobby_pin_display then
        set_ui_square_transform(self, self.ui.flow_mp_lobby_pin_display, -9999, -9999, SOLO_SETUP_UI_Z + 0.002, hidden, MP_LOBBY_PIN_DISPLAY_W, MP_LOBBY_PIN_DISPLAY_H)
    end
    if self.ui.flow_mp_lobby_pin_keys then
        for _, key_btn in ipairs(self.ui.flow_mp_lobby_pin_keys) do
            set_ui_square_transform(self, key_btn, -9999, -9999, MP_LOBBY_PIN_KEYS_Z, hidden, 1, 1)
        end
    end
    multiplayer_lobby_hide_non_lobby_ui(self, hidden)
    multiplayer_lobby_render_nav_and_actions(
        self,
        create_tint,
        page_btn_tint,
        host_info_tint,
        hidden
    )
    local only_incompatible_published = published_total > 0 and compatible_total == 0
    if only_incompatible_published and lobby.pin_mode == "" then
        if lobby.protocol_mismatch_hint_active ~= true then
            show_advisory(self, ADVISORY_MSG_PROTOCOL_MISMATCH, 1.8)
            lobby.protocol_mismatch_hint_active = true
        end
    else
        lobby.protocol_mismatch_hint_active = false
    end
    multiplayer_lobby_render_session_cards(self, visible_sessions, card_bg, open_bg, locked_bg, empty_bg)
    if lobby.pin_mode ~= "" then
        multiplayer_lobby_render_host_publish_buttons(self, host_open_tint, host_private_tint, hidden)
        multiplayer_lobby_render_pin_modal(self, pin_display_tint, pin_bg_tint, pin_key_tint)
    else
        multiplayer_lobby_render_host_publish_buttons(self, host_open_tint, host_private_tint, hidden)
        set_ui_square_transform(self, self.ui.flow_overlay, SCREEN_WIDTH * 0.5, SCREEN_HEIGHT * 0.5, FLOW_UI_OVERLAY_Z, vmath.vector4(0.03, 0.03, 0.06, 1), FLOW_UI_SCREEN_W, FLOW_UI_SCREEN_H)
    end
    multiplayer_lobby_update_pin_feedback_timer(self, dt)
    multiplayer_lobby_update_pin_join_wire_timeout(self, dt)
end

local function stop_outro_slideshow_runtime(self, reason)
    if self.outro_slideshow_state then
        OUTRO_SLIDESHOW.stop(self.outro_slideshow_state, reason or "stopped")
        self.outro_slideshow_state = nil
    end
    if self.outro_slide_layer_nodes then
        for i = 2, #self.outro_slide_layer_nodes do
            local node = self.outro_slide_layer_nodes[i]
            if node then
                pcall(go.delete, node)
            end
        end
    end
    self.outro_slide_layer_nodes = { self.ui and self.ui.flow_outro_slide or nil }
    self.outro_slide_layer_anim_ids = {}
    if self.outro_fx_instances then
        for _, fx_id in ipairs(self.outro_fx_instances) do
            pcall(go.delete, fx_id)
        end
        self.outro_fx_instances = {}
    end
    self.outro_slide_anim_id = nil
end

local function ensure_outro_slide_layer_nodes(self, needed)
    needed = math.max(1, tonumber(needed or 1) or 1)
    self.outro_slide_layer_nodes = self.outro_slide_layer_nodes or { self.ui and self.ui.flow_outro_slide or nil }
    self.outro_slide_layer_anim_ids = self.outro_slide_layer_anim_ids or {}
    while #self.outro_slide_layer_nodes < needed do
        local id = create_outro_marker_sprite(hash("outro_purge_win_spaceship_fadeBlack"), FLOW_UI_PANEL_Z + 0.001)
        table.insert(self.outro_slide_layer_nodes, id)
    end
end

local function start_outro_slideshow_runtime(self)
    stop_outro_slideshow_runtime(self, "restart")
    self.flow_outro_timer = 0
    self.outro_fx_instances = {}
    self.outro_slide_layer_nodes = { self.ui and self.ui.flow_outro_slide or nil }
    self.outro_slide_layer_anim_ids = {}
    local sequence = OUTRO_SEQUENCES.get_sequence(self.end_outro_sequence_id)
    if not sequence then
        print(string.format("OUTRO | no sequence for id=%s, using placeholder timer", tostring(self.end_outro_sequence_id)))
        self.outro_slideshow_state = nil
        return
    end
    local hooks = {
        on_frame = function(pose, state)
            if not (self.ui and self.ui.flow_outro_slide and pose) then
                return
            end
            local layers = pose.layers or {}
            ensure_outro_slide_layer_nodes(self, #layers)
            local shake_x = tonumber(pose.camera_shake_x or 0) or 0
            local shake_y = tonumber(pose.camera_shake_y or 0) or 0
            for i, layer in ipairs(layers) do
                local node = self.outro_slide_layer_nodes and self.outro_slide_layer_nodes[i] or nil
                if node then
                    local anim_name = tostring(layer.anim or "")
                    if anim_name ~= "" and anim_name ~= (self.outro_slide_layer_anim_ids[i] or "") then
                        self.outro_slide_layer_anim_ids[i] = anim_name
                        pcall(msg.post, msg.url(nil, node, "sprite"), "play_animation", { id = hash(anim_name) })
                    end
                    local x = OUTRO_SLIDE_CENTER_X + (tonumber(layer.x or 0) or 0) + shake_x
                    local y = OUTRO_SLIDE_CENTER_Y + (tonumber(layer.y or 0) or 0) + shake_y
                    -- Allow tiny values for comic overlays (e.g. scale 0.002 start points).
                    local scale_x = math.max(0.0001, tonumber(layer.scale_x or layer.scale or 1) or 1)
                    local scale_y = math.max(0.0001, tonumber(layer.scale_y or layer.scale or 1) or 1)
                    local alpha = math.max(0, math.min(1, tonumber(layer.alpha or 1) or 1))
                    local draw_w = tonumber(layer.draw_w or OUTRO_SLIDE_DEFAULT_W) or OUTRO_SLIDE_DEFAULT_W
                    if draw_w <= 0 then draw_w = OUTRO_SLIDE_DEFAULT_W end
                    local draw_h = tonumber(layer.draw_h or OUTRO_SLIDE_DEFAULT_H) or OUTRO_SLIDE_DEFAULT_H
                    if draw_h <= 0 then draw_h = OUTRO_SLIDE_DEFAULT_H end
                    local z = FLOW_UI_PANEL_Z + 0.001 + ((tonumber(layer.z or 0) or 0) * 0.0001)
                    set_ui_square_transform(
                        self,
                        node,
                        x,
                        y,
                        z,
                        vmath.vector4(
                            tonumber(layer.tint_r or 1) or 1,
                            tonumber(layer.tint_g or 1) or 1,
                            tonumber(layer.tint_b or 1) or 1,
                            alpha
                        ),
                        (draw_w * scale_x) * 0.021,
                        (draw_h * scale_y) * 0.021,
                        tonumber(layer.rotation_deg or 0) or 0
                    )
                end
            end
            if self.outro_slide_layer_nodes then
                local hidden = vmath.vector4(0, 0, 0, 0)
                for i = (#layers + 1), #self.outro_slide_layer_nodes do
                    local node = self.outro_slide_layer_nodes[i]
                    if node then
                        set_ui_square_transform(
                            self,
                            node,
                            -9999,
                            -9999,
                            FLOW_UI_PANEL_Z + 0.001,
                            hidden,
                            OUTRO_SLIDE_DEFAULT_W * 0.021,
                            OUTRO_SLIDE_DEFAULT_H * 0.021
                        )
                    end
                end
            end
        end,
        on_complete = function(done_reason, state)
            self.outro_slideshow_state = nil
            self.outro_slide_anim_id = nil
            stop_outro_slideshow_runtime(self, "completed")
            local finish_reason = tostring(done_reason or "")
            if finish_reason == "restart" or finish_reason == "score_flow" or finish_reason == "stopped" then
                return
            end
            if (self.game_flow_state or FLOW_STATE_GAME) == FLOW_STATE_OUTRO then
                if tostring(self.end_outro_sequence_id or "") == "title" then
                    enter_flow_state(self, FLOW_STATE_TITLE)
                else
                    enter_score_flow(self)
                end
            end
        end,
        spawn_fx = function(cue, state)
            local factory_path = tostring((cue and cue.factory) or "")
            if factory_path == "" then
                return nil
            end
            local x = OUTRO_SLIDE_CENTER_X + (tonumber(cue.x or cue.offset_x or 0) or 0)
            local y = OUTRO_SLIDE_CENTER_Y + (tonumber(cue.y or cue.offset_y or 0) or 0)
            -- Match slideshow layer z semantics (relative stack), not absolute world z.
            local z_local = tonumber(cue and cue.z or 0) or 0
            local z = FLOW_UI_PANEL_Z + 0.002 + (z_local * 0.0001)
            local wx, wy = screen_to_world(x, y, self.camera_pos, self.camera_zoom)
            local fx_id = factory.create(factory_path, vmath.vector3(wx, wy, z))
            if fx_id then
                if cue.rotation_deg ~= nil then
                    pcall(go.set_rotation, vmath.quat_rotation_z(math.rad(tonumber(cue.rotation_deg) or 0)), fx_id)
                end
                pcall(particlefx.play, msg.url(nil, fx_id, "particlefx"))
                table.insert(self.outro_fx_instances, fx_id)
            end
            return fx_id
        end,
        stop_fx = function(handle, cue, state)
            if handle then
                pcall(go.delete, handle)
            end
        end,
        update_fx = function(handle, cue, fx_pose, state)
            if not handle or not fx_pose then
                return
            end
            local x = OUTRO_SLIDE_CENTER_X + (tonumber(fx_pose.x or 0) or 0)
            local y = OUTRO_SLIDE_CENTER_Y + (tonumber(fx_pose.y or 0) or 0)
            local z_local = tonumber(fx_pose.z or (cue and cue.z) or 0) or 0
            local z = FLOW_UI_PANEL_Z + 0.002 + (z_local * 0.0001)
            local wx, wy = screen_to_world(x, y, self.camera_pos, self.camera_zoom)
            pcall(go.set_position, vmath.vector3(wx, wy, z), handle)
        end,
        play_sfx = function(cue, state)
        end,
        start_music = function(soundtrack, state)
        end,
        stop_music = function(soundtrack, state)
        end
    }
    self.outro_slideshow_state = OUTRO_SLIDESHOW.start(sequence, hooks)
    if not self.outro_slideshow_state then
        print(string.format("OUTRO | sequence start failed for id=%s, using placeholder timer", tostring(self.end_outro_sequence_id)))
    end
end

stop_level_fx_before_outro = function(self)
    if not self then
        return
    end
    furnace_clear_fire_fx(self)
    set_sound_loop_state(self, "furnace_fire", false)
    furnace_clear_flail_corpses(self)
    local function stop_and_delete_fx(go_id)
        if not go_id then
            return
        end
        pcall(particlefx.stop, msg.url(nil, go_id, "particlefx"), { clear = true })
        pcall(go.delete, go_id)
    end
    if self.hazard_fx_objects then
        for _, entry in ipairs(self.hazard_fx_objects) do
            if entry then
                if entry.fire_id then stop_and_delete_fx(entry.fire_id) end
                if entry.gas_id then stop_and_delete_fx(entry.gas_id) end
            end
        end
        self.hazard_fx_objects = {}
    end
    if self.entry_fire_fx_objects then
        for key, fx_id in pairs(self.entry_fire_fx_objects) do
            if fx_id then stop_and_delete_fx(fx_id) end
            self.entry_fire_fx_objects[key] = nil
        end
    end
    if self.exit_green_smoke_fx_objects then
        for key, fx_id in pairs(self.exit_green_smoke_fx_objects) do
            if fx_id then stop_and_delete_fx(fx_id) end
            self.exit_green_smoke_fx_objects[key] = nil
        end
    end
    if CLEANSE_RUNTIME and CLEANSE_RUNTIME.cleanse_clear_state then
        CLEANSE_RUNTIME.cleanse_clear_state(self)
    end
    self.exit_green_smoke_fx_power_state = {}
    if self.wiregap_fx_objects then
        for i, fx_id in ipairs(self.wiregap_fx_objects) do
            if fx_id then stop_and_delete_fx(fx_id) end
            self.wiregap_fx_objects[i] = nil
        end
    end
    if self.power_node_loop_fx then
        for key, fx_id in pairs(self.power_node_loop_fx) do
            if fx_id then stop_and_delete_fx(fx_id) end
            self.power_node_loop_fx[key] = nil
        end
    end
    if self.medbay_underlay_visuals then
        for _, entry in pairs(self.medbay_underlay_visuals) do
            if entry and entry.bubbles_fx_id then
                stop_and_delete_fx(entry.bubbles_fx_id)
                entry.bubbles_fx_id = nil
            end
        end
    end
    if self.backdrop_cloud_fx then
        stop_and_delete_fx(self.backdrop_cloud_fx)
        self.backdrop_cloud_fx = nil
    end
end

local function update_outro_slideshow_runtime(self, dt)
    if (self.game_flow_state or FLOW_STATE_GAME) ~= FLOW_STATE_OUTRO then
        return
    end
    if self.outro_slideshow_state then
        OUTRO_SLIDESHOW.update(self.outro_slideshow_state, dt)
    else
        self.flow_outro_timer = (self.flow_outro_timer or 0) + dt
        if (self.flow_outro_timer or 0) >= 8.0 then
            stop_outro_slideshow_runtime(self, "timeout")
            if tostring(self.end_outro_sequence_id or "") == "title" then
                enter_flow_state(self, FLOW_STATE_TITLE)
            else
                enter_score_flow(self)
            end
        end
    end
end

function enter_mission_outro(self, result, reason)
    if demo_is_build_enabled(self) then
        enter_demo_result_flow(self, result, reason)
        return
    end
    if self.mp_state and self.mp_state.enabled then
        local local_pid = tostring(self.mp_state.local_player_id or "")
        local host_pid = tostring(self.mp_state.host_player_id or "")
        local is_host = (local_pid ~= "" and host_pid ~= "" and local_pid == host_pid) or (local_pid == "" and host_pid == "")
        if is_host and self.mp_state.match_end_dispatched ~= true then
            local final_result_for_event = tostring(result or (self.game_won and "win" or "lose"))
            if final_result_for_event ~= "win" and final_result_for_event ~= "lose" then
                final_result_for_event = self.game_won and "win" or "lose"
            end
            local final_score_breakdown = compute_placeholder_score_breakdown(self)
            self.flow_score_breakdown = final_score_breakdown
            local payload_team_ids = {}
            local payload_team_seen = {}
            local function add_team_id(pid)
                local norm = tostring(pid or "")
                if norm == "" then
                    return
                end
                if payload_team_seen[norm] == true then
                    return
                end
                payload_team_seen[norm] = true
                payload_team_ids[#payload_team_ids + 1] = norm
            end
            add_team_id(host_pid)
            add_team_id(local_pid)
            if self.mp_state then
                local configured_player_count = math.max(2, math.min(4, tonumber(self.mp_state.player_count or 2) or 2))
                for i = 1, configured_player_count do
                    add_team_id("p" .. tostring(i))
                end
            end
            if self.mp_state and type(self.mp_state.connected_players) == "table" then
                local connected_ids = {}
                for pid, is_connected in pairs(self.mp_state.connected_players) do
                    if is_connected == true then
                        connected_ids[#connected_ids + 1] = tostring(pid)
                    end
                end
                table.sort(connected_ids)
                for _, pid in ipairs(connected_ids) do
                    add_team_id(pid)
                end
            end
            if self.mp_state and type(self.mp_state.required_ready_player_ids) == "table" then
                for _, pid in ipairs(self.mp_state.required_ready_player_ids) do
                    add_team_id(pid)
                end
            end
            local payload_team_names = {}
            for _, pid in ipairs(payload_team_ids) do
                payload_team_names[#payload_team_names + 1] = mp_alpha_label_from_network_id(pid)
            end
            if #payload_team_names <= 0 then
                payload_team_names[1] = mp_alpha_label_from_network_id(self.mp_state.local_player_id or self.mp_state.host_player_id or "p1")
            end
            self.flow_score_team_display_names = payload_team_names
            multiplayer_transport_broadcast_event(self, "match_ended", {
                result = final_result_for_event,
                reason = tostring(reason or "unknown"),
                score_breakdown = final_score_breakdown,
                team_display_names = payload_team_names
            })
            self.mp_state.match_end_dispatched = true
            print(string.format(
                "MP OUTRO | host broadcast match_ended | result=%s reason=%s",
                tostring(final_result_for_event),
                tostring(reason or "unknown")
            ))
        end
    end
    self.flow_score_breakdown = compute_placeholder_score_breakdown(self)
    self.flow_outro_timer = 0
    self.flow_submit_done = false
    self.drag_resource = { active = false }
    self.is_panning = false
    self.did_drag = false
    stop_level_fx_before_outro(self)
    local mission_type = multiplayer_normalize_mission_type(get_current_mission_type(self))
    local final_result = tostring(result or (self.game_won and "win" or "lose"))
    if final_result ~= "win" and final_result ~= "lose" then
        final_result = self.game_won and "win" or "lose"
    end
    if (not (self.mp_state and self.mp_state.enabled))
        and self.tutorial_mode ~= true
        and self.solo_active_mission_slot
    then
        local solo_score_total = math.max(0, tonumber(self.flow_score_breakdown and self.flow_score_breakdown.total or 0) or 0)
        solo_progress_record_result(self, self.solo_active_mission_slot, final_result, solo_score_total, self.flow_score_breakdown and self.flow_score_breakdown.score_breakdown or nil)
    end
    self.end_result = final_result
    self.end_mission_type = mission_type
    local outro_mission_type = mission_type
    if mission_type == MISSION_TYPE_CLEANSE then
        outro_mission_type = MISSION_TYPE_PURGE
    end
    local preview_override = tostring(self.debug_outro_sequence_override or "")
    if preview_override ~= "" then
        self.end_outro_sequence_id = preview_override
    else
        self.end_outro_sequence_id = string.format("%s_%s", outro_mission_type, final_result)
    end
    self.end_reason = tostring(reason or "unknown")
    self.end_session_origin = (self.mp_state and self.mp_state.enabled) and "multiplayer" or "solo"
    enter_flow_state(self, FLOW_STATE_OUTRO)
    start_outro_slideshow_runtime(self)
    print(string.format(
        "FLOW | mission_end -> outro | mission=%s result=%s reason=%s origin=%s sequence=%s",
        tostring(self.end_mission_type),
        tostring(self.end_result),
        tostring(self.end_reason),
        tostring(self.end_session_origin),
        tostring(self.end_outro_sequence_id)
    ))
end

function enter_outro_flow_from_launch(self)
    if demo_is_build_enabled(self) then
        enter_demo_result_flow(self, "win", "launch")
        return
    end
    local mission_type = multiplayer_normalize_mission_type(get_current_mission_type(self))
    if mission_type == MISSION_TYPE_TUTORIAL then
        local preview_override = tostring(self.debug_outro_sequence_override or "")
        if preview_override == "" then
            self.end_outro_sequence_id = "escape_win"
            self.flow_outro_timer = 0
            self.flow_submit_done = false
            self.drag_resource = { active = false }
            self.is_panning = false
            self.did_drag = false
            self.end_result = "win"
            self.end_mission_type = "escape"
            self.end_reason = "launch"
            self.end_session_origin = (self.mp_state and self.mp_state.enabled) and "multiplayer" or "solo"
            enter_flow_state(self, FLOW_STATE_OUTRO)
            start_outro_slideshow_runtime(self)
            print("FLOW | tutorial launch -> forced escape_win outro")
            return
        end
    end
    enter_mission_outro(self, "win", "launch")
end

function enter_score_flow(self)
    stop_outro_slideshow_runtime(self, "score_flow")
    if not self.flow_score_breakdown then
        self.flow_score_breakdown = compute_placeholder_score_breakdown(self)
    end
    local score_state = FLOW_STATE_SCORE_SOLO
    if tostring(self.end_session_origin or "") == "multiplayer" or (self.mp_state and self.mp_state.enabled) then
        score_state = FLOW_STATE_SCORE_MP
    end
    enter_flow_state(self, score_state)
    self.leaderboard_debug_page = 1
    score_try_auto_publish(self, score_state)
    if score_state == FLOW_STATE_SCORE_MP then
        self.leaderboard_entries_mp = score_load_local_leaderboard_entries(self, FLOW_STATE_SCORE_MP)
    else
        self.leaderboard_entries_solo = score_load_local_leaderboard_entries(self, FLOW_STATE_SCORE_SOLO)
    end
    local s = self.flow_score_breakdown
    print(string.format(
        "SCORE | total=%d survivors=%d seated=%d power=%d objectives=%d dead=%d",
        s.total or 0,
        s.survivors or 0,
        s.seated or 0,
        s.power_units or 0,
        s.objectives or 0,
        s.dead or 0
    ))
end

update_flow_title_space_grid_background = function(self, dt)
    if self.ui then
        if not self.ui.flow_title_space_tiles then
            self.ui.flow_title_space_tiles = {
                self.ui.flow_title_panel,
                self.ui.flow_title_panel_2,
                self.ui.flow_title_panel_3,
                self.ui.flow_title_panel_4
            }
        end
        local target_space_tile_count = TITLE_SPACE_TILE_COLS * TITLE_SPACE_TILE_ROWS
        for i = #self.ui.flow_title_space_tiles + 1, target_space_tile_count do
            local panel = create_outro_marker_sprite(hash("outro_purge_win_space"), FLOW_UI_PANEL_Z + 0.001)
            if panel then
                pcall(go.set, msg.url(nil, panel, "sprite"), "blend_mode", (render and render.BLEND_ALPHA) or 0)
                pcall(go.set, msg.url(nil, panel, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
                table.insert(self.ui.flow_title_space_tiles, panel)
            end
        end
    end
    local gutter_x = 0
    local gutter_y = 0
    if is_expanded_hud_layout_active() then
        local ok_size, win_w, win_h = pcall(window.get_size)
        if ok_size and win_w and win_h and win_w > 0 and win_h > 0 then
            local scale = math.min(win_w / SCREEN_WIDTH, win_h / SCREEN_HEIGHT)
            if scale and scale > 0 then
                gutter_x = math.max(0, (win_w - (SCREEN_WIDTH * scale)) * 0.5 / scale)
                gutter_y = math.max(0, (win_h - (SCREEN_HEIGHT * scale)) * 0.5 / scale)
            end
        end
    end
    local overfill_px = 160
    local cover_w = SCREEN_WIDTH + (gutter_x * 2) + overfill_px
    local cover_h = SCREEN_HEIGHT + (gutter_y * 2) + overfill_px
    local space_scale = math.max(1, cover_w / TITLE_SPACE_TILE_W, cover_h / TITLE_SPACE_TILE_H)
    local space_tile_w = TITLE_SPACE_TILE_W * space_scale
    local space_tile_h = TITLE_SPACE_TILE_H * space_scale
    local grid_scale_mult = math.max(1, space_scale)
    local grid_tile_w = TITLE_GRID_TILE_W * grid_scale_mult
    local grid_tile_h = TITLE_GRID_TILE_H * grid_scale_mult
    local grid_draw_scale = TITLE_GRID_TILE_SCALE * grid_scale_mult

    if self.title_space_scroll_x == nil then
        self.title_space_scroll_x = -math.max(0, (gutter_x * 2.5) + (overfill_px * 2.0))
    end
    if self.title_space_scroll_y == nil then
        self.title_space_scroll_y = math.max(0, (gutter_y * 2.5) + (overfill_px * 2.0))
    end
    self.title_space_scroll_x = self.title_space_scroll_x - (TITLE_SPACE_SCROLL_SPEED_X * (dt or 0))
    self.title_space_scroll_y = self.title_space_scroll_y + (TITLE_SPACE_SCROLL_SPEED_Y * (dt or 0))
    while self.title_space_scroll_x <= -space_tile_w do
        self.title_space_scroll_x = self.title_space_scroll_x + space_tile_w
    end
    while self.title_space_scroll_y >= space_tile_h do
        self.title_space_scroll_y = self.title_space_scroll_y - space_tile_h
    end
    if self.title_grid_scroll_x == nil then
        self.title_grid_scroll_x = -math.max(0, (gutter_x * 2.0) + (overfill_px * 1.4))
    end
    if self.title_grid_scroll_y == nil then
        self.title_grid_scroll_y = math.max(0, (gutter_y * 2.0) + (overfill_px * 1.4))
    end
    self.title_grid_scroll_x = self.title_grid_scroll_x + (TITLE_GRID_SCROLL_SPEED_X * (dt or 0))
    self.title_grid_scroll_y = self.title_grid_scroll_y - (TITLE_GRID_SCROLL_SPEED_Y * (dt or 0))
    while self.title_grid_scroll_x >= grid_tile_w do
        self.title_grid_scroll_x = self.title_grid_scroll_x - grid_tile_w
    end
    while self.title_grid_scroll_y <= -grid_tile_h do
        self.title_grid_scroll_y = self.title_grid_scroll_y + grid_tile_h
    end
    local space_tiles = self.ui and self.ui.flow_title_space_tiles or nil
    if space_tiles then
        local base_space_x = (SCREEN_WIDTH * 0.5) + self.title_space_scroll_x - space_tile_w
        local base_space_y = (SCREEN_HEIGHT * 0.5) + self.title_space_scroll_y - space_tile_h
        local tile_i = 1
        for row = 0, TITLE_SPACE_TILE_ROWS - 1 do
            for col = 0, TITLE_SPACE_TILE_COLS - 1 do
                local tile = space_tiles[tile_i]
                if tile then
                    set_ui_square_transform(
                        self,
                        tile,
                        base_space_x + (col * space_tile_w),
                        base_space_y + (row * space_tile_h),
                        FLOW_UI_PANEL_Z + 0.001,
                        vmath.vector4(1, 1, 1, 1),
                        space_scale,
                        space_scale
                    )
                end
                tile_i = tile_i + 1
            end
        end
    end
    if self.ui.flow_title_grid_tiles then
        local base_grid_x = (SCREEN_WIDTH * 0.5) - (((TITLE_GRID_TILE_COLS - 1) * grid_tile_w) * 0.5) + self.title_grid_scroll_x
        local base_grid_y = (SCREEN_HEIGHT * 0.5) - (((TITLE_GRID_TILE_ROWS - 1) * grid_tile_h) * 0.5) + self.title_grid_scroll_y
        local grid_index = 1
        for row = 1, TITLE_GRID_TILE_ROWS do
            for col = 1, TITLE_GRID_TILE_COLS do
                local grid_tile = self.ui.flow_title_grid_tiles[grid_index]
                if grid_tile then
                    set_ui_square_transform(
                        self,
                        grid_tile,
                        base_grid_x + ((col - 1) * grid_tile_w),
                        base_grid_y + ((row - 1) * grid_tile_h),
                        TITLE_GRID_LAYER_Z,
                        vmath.vector4(1, 1, 1, 0.25),
                        grid_draw_scale,
                        grid_draw_scale
                    )
                end
                grid_index = grid_index + 1
            end
        end
    end
end

function update_flow_ui(self, dt)
    if not self.ui then
        return
    end
    update_mp_build_hud(self, true)
    self.flow_overlay_phase = (self.flow_overlay_phase or 0) + (dt or 0)
    local state = self.game_flow_state or FLOW_STATE_GAME
    local hidden = vmath.vector4(0, 0, 0, 0)
    if state ~= FLOW_STATE_SOLO_SETUP then
        solo_progress_ui_hide_nodes(self, hidden)
    end
    set_ui_square_transform(self, self.ui.flow_debug_solo_back_hitbox, -9999, -9999, MP_SETUP_UI_Z + 0.03, hidden, MP_SETUP_ACTION_BTN_W, MP_SETUP_ACTION_BTN_H)
    set_ui_square_transform(self, self.ui.flow_debug_outro_skip_hitbox, -9999, -9999, FLOW_UI_BUTTON_Z + 0.03, hidden, 170, 52)
    if state ~= FLOW_STATE_TITLE and state ~= FLOW_STATE_SOLO_SETUP and state ~= FLOW_STATE_MP_SETUP and state ~= FLOW_STATE_MP_LOBBY then

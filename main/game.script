        return
    end
    if self.aesthetic_mode ~= AESTHETIC_MODE_BOARDGAME then
        return
    end
    if unit_kind == "blip" then
        return
    end
    play_sfx_one_shot(self, "unit_tile_bump")
end

refresh_ambient_sfx_state = function(self)
    if not self or not self.sfx_state then
        return
    end
    local state = self.game_flow_state or FLOW_STATE_GAME
    local adaptive_music_allowed = ADAPTIVE_MUSIC_FOUNDATION_ENABLED == true
    if adaptive_music_allowed and ADAPTIVE_MUSIC_SOLO_FIREWALL == true and self.multiplayer_mode_active == true then
        adaptive_music_allowed = false
    end
    if self.sfx_state.last_flow_state == state
        and self.sfx_state.last_adaptive_music_allowed == adaptive_music_allowed
    then
        return
    end
    self.sfx_state.last_flow_state = state
    self.sfx_state.last_adaptive_music_allowed = adaptive_music_allowed
    local in_gameplay = state == FLOW_STATE_GAME
    if (not in_gameplay) and state == FLOW_STATE_SOLO_SETUP then
        local has_live_world = type(self.world_grid) == "table" and #self.world_grid > 0
        local has_live_squad = type(self.squad_units) == "table" and next(self.squad_units) ~= nil
        local level_load_pending = self.pending_level_load and self.pending_level_load.level_index
        if has_live_world and has_live_squad and (not level_load_pending) then
            in_gameplay = true
        end
    end
    local directional_move_sfx_allowed = is_directional_move_sfx_allowed(self)
    local is_title_outro = (state == FLOW_STATE_OUTRO) and tostring(self.end_outro_sequence_id or "") == "title"
    local in_title_like = (state == FLOW_STATE_TITLE)
        or (state == FLOW_STATE_DEMO_SELECT)
        or (state == FLOW_STATE_DEMO_RESULT)
        or (state == FLOW_STATE_SOLO_SETUP)
        or (state == FLOW_STATE_MP_SETUP)
        or (state == FLOW_STATE_MP_LOBBY)
        or (state == FLOW_STATE_MP_CHOOSER)
        or (state == FLOW_STATE_LEVEL_EDITOR)
        or (state == FLOW_STATE_SCORE_SOLO)
        or (state == FLOW_STATE_SCORE_MP)
        or is_title_outro
    set_sound_loop_state(self, "planet", in_gameplay and (not adaptive_music_allowed))
    local demo_result_active = (state == FLOW_STATE_DEMO_RESULT)
        and ((tostring(self.demo_result or "") == "win") or (tostring(self.demo_result or "") == "lose"))
    set_sound_loop_state(self, "title", in_title_like and (not demo_result_active))
    if (not in_gameplay) or (not directional_move_sfx_allowed) then
        self.sfx_state.vertical_active_by_unit = {}
        self.sfx_state.vertical_active_count = 0
        set_sound_loop_state(self, "human_vertical", false)
        self.sfx_state.horizontal_active_by_actor = {}
        self.sfx_state.horizontal_active_count = 0
        set_sound_loop_state(self, "human_horizontal", false)
        self.sfx_state.speedy_active_count = 0
        stop_speedy_move_sfx(self)
    end
end

update_adaptive_music_trigger_state = function(self, dt)
    if not self or not self.sfx_state then
        return
    end
    local adaptive_music_allowed = ADAPTIVE_MUSIC_FOUNDATION_ENABLED == true
    if adaptive_music_allowed and ADAPTIVE_MUSIC_SOLO_FIREWALL == true and self.multiplayer_mode_active == true then
        adaptive_music_allowed = false
    end
    local state = self.game_flow_state or FLOW_STATE_GAME
    local in_gameplay = state == FLOW_STATE_GAME
    if (not in_gameplay) and state == FLOW_STATE_SOLO_SETUP then
        local has_live_world = type(self.world_grid) == "table" and #self.world_grid > 0
        local has_live_squad = type(self.squad_units) == "table" and next(self.squad_units) ~= nil
        local level_load_pending = self.pending_level_load and self.pending_level_load.level_index
        if has_live_world and has_live_squad and (not level_load_pending) then
            in_gameplay = true
        end
    end
    self.sfx_state.music_target_gain_by_key = self.sfx_state.music_target_gain_by_key or {}
    if ADAPTIVE_MUSIC_FOUNDATION_ENABLED == true and self.sfx_state.music_transport_started == true then
        local bass_loop_duration_s = math.max(0.25, tonumber(ADAPTIVE_MUSIC_BASS_LOOP_DURATION_S or 16.0) or 16.0)
        local bass_loop_timer_s = (tonumber(self.sfx_state.music_bass_loop_timer_s or 0) or 0) + (dt or 0)
        local bass_loop_count = tonumber(self.sfx_state.music_bass_loop_count or 0) or 0
        while bass_loop_timer_s >= bass_loop_duration_s do
            bass_loop_timer_s = bass_loop_timer_s - bass_loop_duration_s
            bass_loop_count = bass_loop_count + 1
        end
        self.sfx_state.music_bass_loop_timer_s = bass_loop_timer_s
        self.sfx_state.music_bass_loop_count = bass_loop_count
    end
    if not (adaptive_music_allowed and in_gameplay) then
        self.sfx_state.music_contact_hold_s = 0
        self.sfx_state.music_combat_hold_s = 0
        self.sfx_state.music_contact_scan_timer_s = 0
        for _, key in ipairs(ADAPTIVE_MUSIC_STEM_KEYS) do
            self.sfx_state.music_target_gain_by_key[key] = ADAPTIVE_MUSIC_GAIN_OFF
        end
        return
    end

    self.sfx_state.music_contact_hold_s = math.max(0, (tonumber(self.sfx_state.music_contact_hold_s or 0) or 0) - (dt or 0))
    self.sfx_state.music_combat_hold_s = math.max(0, (tonumber(self.sfx_state.music_combat_hold_s or 0) or 0) - (dt or 0))
    self.sfx_state.music_contact_scan_timer_s = (tonumber(self.sfx_state.music_contact_scan_timer_s or 0) or 0) - (dt or 0)
    local bass_loop_count = tonumber(self.sfx_state.music_bass_loop_count or 0) or 0
    if self.sfx_state.music_contact_scan_timer_s <= 0 then
        self.sfx_state.music_contact_scan_timer_s = tonumber(ADAPTIVE_MUSIC_CONTACT_SCAN_INTERVAL_S or 0.2) or 0.2
        local has_visible_non_dead_alien = false
        if self.squad_units and self.aliens and self.world_grid then
            for _, unit in pairs(self.squad_units) do
                if unit
                    and (unit.current_health or 0) > 0
                    and unit.cell_id
                    and unit.in_shuttle ~= true
                then
                    for _, alien in ipairs(self.aliens) do
                        if alien
                            and alien.is_dead ~= true
                            and alien.cell_id
                            and has_unobstructed_los(self.world_grid, unit.cell_id, alien.cell_id)
                        then
                            has_visible_non_dead_alien = true
                            break
                        end
                    end
                end
                if has_visible_non_dead_alien then
                    break
                end
            end
        end
        if has_visible_non_dead_alien then
            self.sfx_state.music_contact_hold_s = math.max(
                tonumber(self.sfx_state.music_contact_hold_s or 0) or 0,
                tonumber(ADAPTIVE_MUSIC_CONTACT_HOLD_S or 1.0) or 1.0
            )
        end
    end

    local combat_active = (tonumber(self.sfx_state.music_combat_hold_s or 0) or 0) > 0
    local contact_active = (tonumber(self.sfx_state.music_contact_hold_s or 0) or 0) > 0
    local alien_turn_active = self.alien_turn_active == true
        or self.pending_spitter_attack_phase
        or self.pending_melee_attack_phase
        or any_alien_is_moving(self)
    local bass_on = true
    local drums_on = false
    local pad_on = true
    local melody_on = false
    local sfx_on = false
    local victory_on = false
    if combat_active then
        drums_on = true
        melody_on = true
        sfx_on = true
    elseif alien_turn_active then
        melody_on = true
    elseif contact_active then
        sfx_on = true
    end
    if pad_on then
        local every_n = math.max(1, math.floor(tonumber(ADAPTIVE_MUSIC_PAD_EVERY_N_BASS_LOOPS or 4) or 4))
        local current_loop_index = (bass_loop_count % every_n) + 1
        pad_on = current_loop_index == every_n
    end
    self.sfx_state.music_target_gain_by_key.music_bass = bass_on and ADAPTIVE_MUSIC_GAIN_ON or ADAPTIVE_MUSIC_GAIN_OFF
    self.sfx_state.music_target_gain_by_key.music_drums = drums_on and (tonumber(ADAPTIVE_MUSIC_GAIN_DRUMS_ON or ADAPTIVE_MUSIC_GAIN_ON) or ADAPTIVE_MUSIC_GAIN_ON) or ADAPTIVE_MUSIC_GAIN_OFF
    self.sfx_state.music_target_gain_by_key.music_pad = pad_on and ADAPTIVE_MUSIC_GAIN_ON or ADAPTIVE_MUSIC_GAIN_OFF
    self.sfx_state.music_target_gain_by_key.music_melody = melody_on and (tonumber(ADAPTIVE_MUSIC_GAIN_ALIENS_ON or ADAPTIVE_MUSIC_GAIN_ON) or ADAPTIVE_MUSIC_GAIN_ON) or ADAPTIVE_MUSIC_GAIN_OFF
    self.sfx_state.music_target_gain_by_key.music_sfx = sfx_on and (tonumber(ADAPTIVE_MUSIC_GAIN_BUZZ_ON or ADAPTIVE_MUSIC_GAIN_ON) or ADAPTIVE_MUSIC_GAIN_ON) or ADAPTIVE_MUSIC_GAIN_OFF
    self.sfx_state.music_target_gain_by_key.music_victory = victory_on and ADAPTIVE_MUSIC_GAIN_ON or ADAPTIVE_MUSIC_GAIN_OFF
end

adaptive_music_set_gain = function(self, key, gain_value)
    if not self or not self.sfx_state then
        return
    end
    local entry = self.sfx_state[key]
    if not entry or not entry.url then
        return
    end
    local gain = math.max(0, math.min(1, tonumber(gain_value or 0) or 0))
    if sound and sound.set_gain then
        pcall(sound.set_gain, entry.url, gain)
    end
    pcall(go.set, entry.url, "gain", gain)
    pcall(msg.post, entry.url, "set_gain", { gain = gain })
end

update_adaptive_music_gain_mixer = function(self, dt)
    if not self or not self.sfx_state then
        return
    end
    local adaptive_music_allowed = ADAPTIVE_MUSIC_FOUNDATION_ENABLED == true
    if adaptive_music_allowed and ADAPTIVE_MUSIC_SOLO_FIREWALL == true and self.multiplayer_mode_active == true then
        adaptive_music_allowed = false
    end
    local state = self.game_flow_state or FLOW_STATE_GAME
    local in_gameplay = state == FLOW_STATE_GAME
    if (not in_gameplay) and state == FLOW_STATE_SOLO_SETUP then
        local has_live_world = type(self.world_grid) == "table" and #self.world_grid > 0
        local has_live_squad = type(self.squad_units) == "table" and next(self.squad_units) ~= nil
        local level_load_pending = self.pending_level_load and self.pending_level_load.level_index
        if has_live_world and has_live_squad and (not level_load_pending) then
            in_gameplay = true
        end
    end
    self.sfx_state.music_target_gain_by_key = self.sfx_state.music_target_gain_by_key or {}
    self.sfx_state.music_current_gain_by_key = self.sfx_state.music_current_gain_by_key or {}
    if ADAPTIVE_MUSIC_FOUNDATION_ENABLED == true and self.sfx_state.music_transport_started ~= true then
        for _, key in ipairs(ADAPTIVE_MUSIC_STEM_KEYS) do
            local entry = self.sfx_state[key]
            if entry and entry.url then
                set_sound_loop_state(self, key, true)
                adaptive_music_set_gain(self, key, ADAPTIVE_MUSIC_GAIN_OFF)
                self.sfx_state.music_current_gain_by_key[key] = ADAPTIVE_MUSIC_GAIN_OFF
                self.sfx_state.music_target_gain_by_key[key] = self.sfx_state.music_target_gain_by_key[key] or ADAPTIVE_MUSIC_GAIN_OFF
            end
        end
        self.sfx_state.music_transport_started = true
    end
    if not in_gameplay then
        for _, key in ipairs(ADAPTIVE_MUSIC_STEM_KEYS) do
            self.sfx_state.music_target_gain_by_key[key] = ADAPTIVE_MUSIC_GAIN_OFF
        end
    end
    local fade_in_step = math.max(0.001, tonumber(ADAPTIVE_MUSIC_GAIN_FADE_IN_PER_SEC or 0.6) or 0.6) * (dt or 0)
    local fade_out_step = math.max(0.001, tonumber(ADAPTIVE_MUSIC_GAIN_FADE_OUT_PER_SEC or 0.4) or 0.4) * (dt or 0)
    for _, key in ipairs(ADAPTIVE_MUSIC_STEM_KEYS) do
        local entry = self.sfx_state[key]
        if entry and entry.url then
            local target = tonumber(self.sfx_state.music_target_gain_by_key[key] or ADAPTIVE_MUSIC_GAIN_OFF) or ADAPTIVE_MUSIC_GAIN_OFF
            target = math.max(0, math.min(1, target))
            local current = tonumber(self.sfx_state.music_current_gain_by_key[key] or ADAPTIVE_MUSIC_GAIN_OFF) or ADAPTIVE_MUSIC_GAIN_OFF
            local delta = target - current
            if delta >= 0 and (key == "music_melody" or key == "music_drums") then
                current = target
            else
                local step = fade_out_step
                if delta >= 0 then
                    step = fade_in_step
                end
                if key == "music_pad" then
                    local full_span = math.max(0.001, (tonumber(ADAPTIVE_MUSIC_GAIN_ON or 0.5) or 0.5) - (tonumber(ADAPTIVE_MUSIC_GAIN_OFF or 0.001) or 0.001))
                    if delta >= 0 then
                        local pad_in_s = math.max(0.001, tonumber(ADAPTIVE_MUSIC_PAD_FADE_IN_S or 0.5) or 0.5)
                        step = math.max(0.00001, (full_span / pad_in_s) * (dt or 0))
                    else
                        local pad_out_s = math.max(0.001, tonumber(ADAPTIVE_MUSIC_PAD_FADE_OUT_S or 4.0) or 4.0)
                        step = math.max(0.00001, (full_span / pad_out_s) * (dt or 0))
                    end
                elseif delta < 0 and key == "music_drums" then
                    local drums_out_s = math.max(0.001, tonumber(ADAPTIVE_MUSIC_DRUMS_FADE_OUT_S or 4.0) or 4.0)
                    local full_span = math.max(0.001, (tonumber(ADAPTIVE_MUSIC_GAIN_ON or 0.5) or 0.5) - (tonumber(ADAPTIVE_MUSIC_GAIN_OFF or 0.001) or 0.001))
                    step = math.max(0.00001, (full_span / drums_out_s) * (dt or 0))
                end
                if math.abs(delta) <= step then
                    current = target
                elseif delta > 0 then
                    current = current + step
                else
                    current = current - step
                end
            end
            current = math.max(0, math.min(1, current))
            self.sfx_state.music_current_gain_by_key[key] = current
            adaptive_music_set_gain(self, key, current)
        end
    end
end

update_vertical_move_sfx_for_unit = function(self, unit, is_vertical_now)
    if not (self and self.sfx_state and unit and unit.id) then
        return
    end
    local actor_key = tostring(unit.id)
    local by_unit = self.sfx_state.vertical_active_by_unit
    if not is_directional_move_sfx_allowed(self) then
        if by_unit[actor_key] == true then
            by_unit[actor_key] = nil
            self.sfx_state.vertical_active_count = math.max(0, (self.sfx_state.vertical_active_count or 0) - 1)
        end
        if (self.sfx_state.vertical_active_count or 0) <= 0 then
            self.sfx_state.vertical_active_count = 0
            set_sound_loop_state(self, "human_vertical", false)
        end
        return
    end
    local was_active = by_unit[actor_key] == true
    local now_active = is_vertical_now == true
    if was_active == now_active then
        return
    end
    if now_active then
        by_unit[actor_key] = true
        self.sfx_state.vertical_active_count = (self.sfx_state.vertical_active_count or 0) + 1
    else
        by_unit[actor_key] = nil
        self.sfx_state.vertical_active_count = math.max(0, (self.sfx_state.vertical_active_count or 0) - 1)
    end
    set_sound_loop_state(self, "human_vertical", (self.sfx_state.vertical_active_count or 0) > 0)
end


MULTIPLAYER_DISABLED_BY_CONFIG = (function()
    local default_disabled = FEATURE_FLAGS.multiplayer_enabled == false
    local cfg = tostring((sys.get_config and sys.get_config("dvx.disable_multiplayer")) or (default_disabled and "1" or "0"))
    return cfg == "1" or cfg == "true" or cfg == "on"
end)()

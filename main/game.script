end

update_realtime_toggle_button_visual = function(self)
    if not (self and self.ui and self.ui.realtime_toggle_button) then
        return
    end
    local anim_id = (self.realtime_rules_enabled == true) and hash("realtime_button_on") or hash("realtime_button_off")
    pcall(msg.post, msg.url(nil, self.ui.realtime_toggle_button, "sprite"), "play_animation", { id = anim_id })
    pcall(go.set, msg.url(nil, self.ui.realtime_toggle_button, "sprite"), "blend_mode", hash("alpha"))
    pcall(go.set, msg.url(nil, self.ui.realtime_toggle_button, "sprite"), "tint", vmath.vector4(1, 1, 1, 0))
end

update_aesthetic_toggle_button_visual = function(self)
    if not (self and self.ui and self.ui.aesthetic_toggle_button_art) then
        return
    end
    local anim_id = (self.aesthetic_mode == AESTHETIC_MODE_BOARDGAME)
        and hash("button_boardGame_mode")
        or hash("button_computerGame_mode")
    pcall(msg.post, msg.url(nil, self.ui.aesthetic_toggle_button_art, "sprite"), "play_animation", { id = anim_id })
    pcall(go.set, msg.url(nil, self.ui.aesthetic_toggle_button_art, "sprite"), "blend_mode", hash("alpha"))
    pcall(go.set, msg.url(nil, self.ui.aesthetic_toggle_button_art, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
end

update_mp_lag_sim_button_visual = function(self)
    if not (self and self.ui and self.ui.lag_sim_button) then
        return
    end
    local mode = MP_LAG_SIM_MODE_OFF
    if self.mp_lag_sim and self.mp_lag_sim.mode then
        mode = tostring(self.mp_lag_sim.mode)
    end
    local tint = vmath.vector4(0.2, 0.8, 0.2, 0.78)
    if mode == MP_LAG_SIM_MODE_LOW then
        tint = vmath.vector4(1.0, 0.7, 0.2, 0.82)
    elseif mode == MP_LAG_SIM_MODE_HIGH then
        tint = vmath.vector4(0.95, 0.2, 0.2, 0.86)
    end
    pcall(go.set, msg.url(nil, self.ui.lag_sim_button, "sprite"), "tint", tint)
end

update_multiplayer_new_turn_button_visual = function(self)
    if not (self and self.ui and self.ui.new_turn_button) then
        return
    end
    local alien_activity_active = self.alien_turn_active
        or self.pending_spitter_attack_phase
        or self.pending_melee_attack_phase
        or any_alien_is_moving(self)
        or any_civilian_is_moving(self)
        or (self.mp_state
            and self.mp_state.enabled
            and self.mp_state.local_player_id ~= self.mp_state.host_player_id
            and self.mp_state.client_alien_activity_visible == true)
    local anim_id = hash("button_newTurn")
    local tint = vmath.vector4(1, 1, 1, 1)
    if alien_activity_active or self.new_turn_button_mode == "alien_activity" then
        anim_id = hash("alien_activity_button")
        tint = vmath.vector4(1, 1, 1, 1)
    elseif self.mp_state and self.mp_state.enabled and self.mp_state.local_player_id ~= self.mp_state.host_player_id then
        anim_id = hash("ready_button")
        local local_network_player_id = tostring(self.mp_state.local_player_id or "")
        local local_player_id = local_network_player_id
        if multiplayer_get_slot_player_id_for_network then
            local_player_id = multiplayer_get_slot_player_id_for_network(self, local_player_id)
        end
        local local_ready = self.mp_state.ready_by_player_id
            and (
                self.mp_state.ready_by_player_id[local_player_id] == true
                or self.mp_state.ready_by_player_id[local_network_player_id] == true
            )
        if not local_ready then
            anim_id = hash("ready_not_button")
            tint = vmath.vector4(1, 1, 1, 1)
        end
    end
    pcall(msg.post, msg.url(nil, self.ui.new_turn_button, "sprite"), "play_animation", { id = anim_id })
    pcall(go.set, msg.url(nil, self.ui.new_turn_button, "sprite"), "blend_mode", hash("alpha"))
    pcall(go.set, msg.url(nil, self.ui.new_turn_button, "sprite"), "tint", tint)
end

local function create_outro_marker_sprite(anim_id, z)
    local id = factory.create("/outro_marker_factory#outro_marker_factory", vmath.vector3(-9999, -9999, z or FLOW_UI_BUTTON_Z))
    if id and anim_id then
        msg.post(msg.url(nil, id, "sprite"), "play_animation", { id = anim_id })
    end
    return id
end

clear_ranged_hit_preview = function(self)
    if not self then
        return
    end
    self.pending_manual_shot_alien_id = nil
    self.pending_manual_shot_unit_id = nil
    self.pending_manual_shot_cell_id = nil
    self.pending_manual_shot_chance = nil
    self.ranged_hit_preview_fading_out = false
    self.ranged_hit_preview_fade_alpha = 0
    self.pending_flamer_confirm_unit_id = nil
    self.pending_flamer_confirm_cell_id = nil
    self.pending_flamer_confirm_alien_id = nil
    self.pending_flamer_confirm_is_weed = nil
end

local function clear_locked_manual_target(self)
    if not self then
        return
    end
    self.locked_manual_target_alien_id = nil
    self.locked_manual_target_unit_id = nil
end

dismiss_ranged_hit_preview = function(self)
    if not self then
        return
    end
    if self.pending_manual_shot_alien_id and (self.ranged_hit_preview_fade_alpha or 0) > 0 then
        self.ranged_hit_preview_fading_out = true
    else
        clear_ranged_hit_preview(self)
    end
end

show_ranged_hit_preview = function(self, unit, alien, hit_chance)
    if not (self and unit and alien) then
        return
    end
    self.pending_manual_shot_alien_id = alien.id
    self.pending_manual_shot_unit_id = unit.id
    self.pending_manual_shot_cell_id = alien.cell_id
    self.pending_manual_shot_chance = math.max(0, math.min(99, math.floor((tonumber(hit_chance) or 0) + 0.5)))
    self.ranged_hit_preview_fading_out = false
    self.ranged_hit_preview_fade_alpha = 1
end

show_flamer_confirm_preview = function(self, unit_id, target_cell_id, alien_id, is_weed_target)
    if not self then
        return
    end
    self.pending_flamer_confirm_unit_id = unit_id
    self.pending_flamer_confirm_cell_id = tonumber(target_cell_id or 0) or 0
    self.pending_flamer_confirm_alien_id = tonumber(alien_id or 0) or 0
    self.pending_flamer_confirm_is_weed = is_weed_target == true
end

update_ranged_hit_preview_hud = function(self, visible)
    if not self or not self.ui then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    if not (self.ui.ranged_hit_preview_digits and self.ui.ranged_hit_preview_percent) then
        return
    end
    if visible ~= true
        or not self.pending_manual_shot_alien_id
        or not self.pending_manual_shot_chance
        or (self.ranged_hit_preview_fade_alpha or 0) <= 0
    then
        local function hide_marker(go_id, draw_w, draw_h)
            if not go_id then
                return
            end
            go.set_position(vmath.vector3(-9999, -9999, RANGED_HIT_PREVIEW_Z), go_id)
            go.set_scale(vmath.vector3((draw_w * 0.021) / math.max(0.001, self.camera_zoom or 1), (draw_h * 0.021) / math.max(0.001, self.camera_zoom or 1), 1), go_id)
            go.set(msg.url(nil, go_id, "sprite"), "tint", hidden)
        end
        for _, digit_id in ipairs(self.ui.ranged_hit_preview_digits) do
            hide_marker(digit_id, RANGED_HIT_PREVIEW_DIGIT_DRAW_W, RANGED_HIT_PREVIEW_DIGIT_DRAW_H)
        end
        hide_marker(self.ui.ranged_hit_preview_percent, RANGED_HIT_PREVIEW_PERCENT_DRAW_W, RANGED_HIT_PREVIEW_PERCENT_DRAW_H)
        return
    end
    local alien = find_alien_by_id(self, tonumber(self.pending_manual_shot_alien_id))
    if not alien or alien.is_dead or not alien.go_id then
        clear_ranged_hit_preview(self)
        return
    end
    local pos = go.get_position(alien.go_id)
    local screen_x = ((pos.x - self.camera_pos.x) * self.camera_zoom) + (SCREEN_WIDTH * 0.5)
    local screen_y = ((pos.y - self.camera_pos.y) * self.camera_zoom) + (SCREEN_HEIGHT * 0.5) + (RANGED_HIT_PREVIEW_OFFSET_Y * self.camera_zoom)
    local chance = math.max(0, math.min(99, math.floor((tonumber(self.pending_manual_shot_chance) or 0) + 0.5)))
    local text = string.format("%02d", chance)
    local alpha = math.max(0, math.min(1, tonumber(self.ranged_hit_preview_fade_alpha or 0) or 0))
    local tint = vmath.vector4(1, 1, 1, alpha)
    local digit_count = #text
    local total_count = digit_count + 1
    local start_x = screen_x - (((total_count - 1) * RANGED_HIT_PREVIEW_DIGIT_SPACING_PX) * 0.5)
    local function show_marker(go_id, sx, sy, draw_w, draw_h, marker_tint)
        if not go_id then
            return
        end
        local wx, wy = screen_to_world(sx, sy, self.camera_pos, self.camera_zoom)
        go.set_position(vmath.vector3(wx, wy, RANGED_HIT_PREVIEW_Z), go_id)
        go.set_scale(vmath.vector3((draw_w * 0.021) / math.max(0.001, self.camera_zoom or 1), (draw_h * 0.021) / math.max(0.001, self.camera_zoom or 1), 1), go_id)
        go.set(msg.url(nil, go_id, "sprite"), "tint", marker_tint)
    end
    local function hide_marker(go_id, draw_w, draw_h)
        show_marker(go_id, -9999, -9999, draw_w, draw_h, hidden)
    end
    for i, digit_id in ipairs(self.ui.ranged_hit_preview_digits) do
        if i <= digit_count then
            local ch = string.sub(text, i, i)
            msg.post(msg.url(nil, digit_id, "sprite"), "play_animation", { id = hash("score_" .. ch) })
            local dx = start_x + ((i - 1) * RANGED_HIT_PREVIEW_DIGIT_SPACING_PX)
            show_marker(digit_id, dx, screen_y, RANGED_HIT_PREVIEW_DIGIT_DRAW_W, RANGED_HIT_PREVIEW_DIGIT_DRAW_H, tint)
        else
            hide_marker(digit_id, RANGED_HIT_PREVIEW_DIGIT_DRAW_W, RANGED_HIT_PREVIEW_DIGIT_DRAW_H)
        end
    end
    show_marker(
        self.ui.ranged_hit_preview_percent,
        start_x + (digit_count * RANGED_HIT_PREVIEW_DIGIT_SPACING_PX),
        screen_y,
        RANGED_HIT_PREVIEW_PERCENT_DRAW_W,
        RANGED_HIT_PREVIEW_PERCENT_DRAW_H,
        tint
    )
end

update_flamer_confirm_hud = function(self, visible)
    if not (self and self.ui and self.ui.flamer_confirm_marker) then
        return
    end
    local marker = self.ui.flamer_confirm_marker
    local hidden = vmath.vector4(0, 0, 0, 0)
    local function hide_marker()
        go.set_position(vmath.vector3(-9999, -9999, RANGED_HIT_PREVIEW_Z), marker)
        go.set_scale(vmath.vector3((70 * 0.021) * 0.75, (70 * 0.021) * 0.75, 1), marker)
        go.set(msg.url(nil, marker, "sprite"), "tint", hidden)
    end
    if visible ~= true
        or not self.pending_flamer_confirm_unit_id
        or not self.pending_flamer_confirm_cell_id
    then
        hide_marker()
        return
    end
    local pending_unit = self.squad_units and self.squad_units[self.pending_flamer_confirm_unit_id] or nil
    if not pending_unit
        or (tonumber(pending_unit.current_health or 0) or 0) <= 0
        or unit_has_equipped_buff_kind(pending_unit, "flamer") ~= true
    then
        self.pending_flamer_confirm_unit_id = nil
        self.pending_flamer_confirm_cell_id = nil
        self.pending_flamer_confirm_alien_id = nil
        self.pending_flamer_confirm_is_weed = nil
        hide_marker()
        return
    end
    local world_x = nil
    local world_y = nil
    local alien_id = tonumber(self.pending_flamer_confirm_alien_id or 0) or 0
    if alien_id > 0 then
        local alien = find_alien_by_id(self, alien_id)
        if not alien or alien.is_dead or not alien.go_id then
            self.pending_flamer_confirm_unit_id = nil
            self.pending_flamer_confirm_cell_id = nil
            self.pending_flamer_confirm_alien_id = nil
            self.pending_flamer_confirm_is_weed = nil
            hide_marker()
            return
        end
        local pos = go.get_position(alien.go_id)
        world_x = pos.x
        world_y = pos.y + (RANGED_HIT_PREVIEW_OFFSET_Y * 0.75)
    else
        local cell_id = tonumber(self.pending_flamer_confirm_cell_id or 0) or 0
        local cell = self.world_grid and self.world_grid[cell_id] or nil
        if not cell then
            self.pending_flamer_confirm_unit_id = nil
            self.pending_flamer_confirm_cell_id = nil
            self.pending_flamer_confirm_alien_id = nil
            self.pending_flamer_confirm_is_weed = nil
            hide_marker()
            return
        end
        world_x, world_y = coords_to_world_pos(cell.xCell, cell.yCell)
    end
    local draw_scale = 1 / math.max(0.001, self.camera_zoom or 1)
    go.set_position(vmath.vector3(world_x, world_y, RANGED_HIT_PREVIEW_Z), marker)
    go.set_scale(vmath.vector3((70 * 0.021) * 0.75 * draw_scale, (70 * 0.021) * 0.75 * draw_scale, 1), marker)
    go.set(msg.url(nil, marker, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
end

local function ui_is_button_node(self, go_id)
    if not (self and self.ui and go_id) then
        return false
    end
    if go_id == self.ui.component_button
        or go_id == self.ui.fix_button
        or go_id == self.ui.loot_button
        or go_id == self.ui.retrieve_button
        or go_id == self.ui.comms_toggle_button
        or go_id == self.ui.close_button
        or go_id == self.ui.new_turn_button
        or go_id == self.ui.launch_button
        or go_id == self.ui.realtime_toggle_button
        or go_id == self.ui.aesthetic_toggle_button
        or go_id == self.ui.zoom_in_button
        or go_id == self.ui.zoom_out_button
        or go_id == self.ui.reactive_toggle_button
        or go_id == self.ui.reactive_advance_button
        or go_id == self.ui.objective_button
        or go_id == self.ui.flow_outro_skip_button
        or go_id == self.ui.flow_score_submit_button
        or go_id == self.ui.flow_score_title_button
        or go_id == self.ui.flow_title_tutorial_button
        or go_id == self.ui.flow_title_solo_button
        or go_id == self.ui.flow_title_multiplayer_button
        or go_id == self.ui.flow_mp_back_button
        or go_id == self.ui.flow_mp_start_button
    then
        return true
    end
    local array_fields = {
        "level_buttons",
        "ready_buttons",
        "mp_debug_player_buttons",
        "human_portrait_icons",
        "human_portrait_selected_overlays",
        "flow_mp_mission_buttons",
        "flow_mp_count_buttons",
        "flow_mp_unit_buttons"
    }
    for _, field_name in ipairs(array_fields) do
        local arr = self.ui[field_name]
        if arr then
            for _, node in ipairs(arr) do
                if go_id == node then
                    return true
                end
            end
        end
    end
    return false
end

local function set_ui_square_transform(self, go_id, screen_x, screen_y, z, color, scale_x, scale_y, rotation_deg)
    if not go_id then
        return
    end
    if self and self.ui and scale_x and scale_y and scale_x > 1.2 and scale_y > 1.2 then
        local function scale_div(div_x, div_y)
            if div_x > 0 and div_y > 0 then
                scale_x = scale_x / div_x
                scale_y = scale_y / div_y
            end
        end
        if go_id == self.ui.flow_mp_setup_panel then
            scale_div(MP_SETUP_PANEL_W * 0.021, MP_SETUP_PANEL_H * 0.021)
        elseif go_id == self.ui.flow_mp_count_active_ring then
            scale_div(MP_SETUP_COUNT_ACTIVE_RING_W * 0.021, MP_SETUP_COUNT_ACTIVE_RING_H * 0.021)
        elseif go_id == self.ui.flow_mp_back_button
            or go_id == self.ui.flow_mp_start_button
            or go_id == self.ui.flow_mp_start_disabled_overlay
            or go_id == self.ui.flow_mp_start_enabled_glow then
            scale_div(171 * 0.021, 72 * 0.021)
        elseif self.ui.flow_mp_count_buttons then
            for _, btn in ipairs(self.ui.flow_mp_count_buttons) do
                if go_id == btn then
                    scale_div(120 * 0.021, 64 * 0.021)
                    break
                end
            end
        end
        if self.ui.flow_mp_unit_buttons then
            for _, btn in ipairs(self.ui.flow_mp_unit_buttons) do
                if go_id == btn then
                    scale_div(84 * 0.021, 84 * 0.021)
                    break
                end
            end
        end
        if self.ui.flow_mp_slot_icons then
            for _, slot_icons in pairs(self.ui.flow_mp_slot_icons) do
                for _, slot_icon in ipairs(slot_icons) do
                    if go_id == slot_icon then
                        scale_div(84 * 0.021, 84 * 0.021)
                        break
                    end
                end
            end
        end
    end
    local is_debug_button = FLOW_BUTTON_HITBOX_DEBUG_VISIBLE and self and self.ui and ui_is_button_node(self, go_id)
    local draw_z = z
    local draw_scale_x = scale_x
    local draw_scale_y = scale_y
    if is_debug_button then
        draw_z = (z or 0) + 0.03
        draw_scale_x = (scale_x or 1) * 1.12
        draw_scale_y = (scale_y or 1) * 1.12
    end
    local wx, wy = screen_to_world(screen_x, screen_y, self.camera_pos, self.camera_zoom)
    go.set_position(vmath.vector3(wx, wy, draw_z), go_id)
    go.set_scale(vmath.vector3(draw_scale_x / self.camera_zoom, draw_scale_y / self.camera_zoom, 1), go_id)
    if rotation_deg ~= nil then
        pcall(go.set_rotation, vmath.quat_rotation_z(math.rad(tonumber(rotation_deg) or 0)), go_id)
    end
    local final_color = color
    local preserve_input_alpha = self and self.ui and (
        go_id == self.ui.new_turn_button
        or
        go_id == self.ui.flow_title_tutorial_button
        or go_id == self.ui.flow_title_solo_button
        or go_id == self.ui.flow_title_multiplayer_button
        or go_id == self.ui.flow_outro_skip_button
        or (self.ui.flow_mp_count_buttons and (
            go_id == self.ui.flow_mp_count_buttons[1]
            or go_id == self.ui.flow_mp_count_buttons[2]
            or go_id == self.ui.flow_mp_count_buttons[3]
        ))
        or go_id == self.ui.flow_mp_back_button
        or go_id == self.ui.launch_button
        or go_id == self.ui.realtime_toggle_button
        or go_id == self.ui.aesthetic_toggle_button
        or go_id == self.ui.zoom_in_button
        or go_id == self.ui.zoom_out_button
    )
    if is_debug_button and final_color then
        final_color = vmath.vector4(0.0, 1.0, 0.2, 1.0)
    elseif final_color and ui_is_button_node(self, go_id) and (not preserve_input_alpha) then
        final_color = vmath.vector4(final_color.x, final_color.y, final_color.z, 1)
    end
    go.set(msg.url(nil, go_id, "sprite"), "tint", final_color)
end

local function set_ui_panel_transform(self, go_id, screen_x, screen_y, z, scale_x, scale_y, tint)
    if not go_id then
        return
    end
    local wx, wy = screen_to_world(screen_x, screen_y, self.camera_pos, self.camera_zoom)
    local sx = (scale_x / UI_PANEL_ART_W) / self.camera_zoom
    local sy = (scale_y / UI_PANEL_ART_H) / self.camera_zoom
    go.set_position(vmath.vector3(wx, wy, z), go_id)
    go.set_scale(vmath.vector3(sx, sy, 1), go_id)
    go.set(msg.url(nil, go_id, "sprite"), "tint", tint or vmath.vector4(1, 1, 1, 1))
end

get_zoom_slider_normalized = function(self)
    if not self then
        return 0.5
    end
    local min_zoom = tonumber(self.camera_min_zoom or 0.25) or 0.25
    local max_zoom = tonumber(self.camera_max_zoom or 1.5) or 1.5
    if max_zoom <= min_zoom then
        return 0.5
    end
    local z = tonumber(self.zoom_target or self.camera_zoom or min_zoom) or min_zoom
    local t = (z - min_zoom) / (max_zoom - min_zoom)
    return clamp(t, 0, 1)
end

get_zoom_slider_knob_y_from_t = function(t)
    local clamped_t = clamp(tonumber(t or 0.5) or 0.5, 0, 1)
    return ZOOM_SLIDER_TRACK_BOTTOM_Y + (ZOOM_SLIDER_TRACK_H * clamped_t)
end

set_zoom_from_slider_y = function(self, screen_y)
    if not self then
        return
    end
    local y = clamp(tonumber(screen_y or ZOOM_SLIDER_TRACK_CENTER_Y) or ZOOM_SLIDER_TRACK_CENTER_Y, ZOOM_SLIDER_TRACK_BOTTOM_Y, ZOOM_SLIDER_TRACK_TOP_Y)
    local t = (y - ZOOM_SLIDER_TRACK_BOTTOM_Y) / ZOOM_SLIDER_TRACK_H
    local min_zoom = tonumber(self.camera_min_zoom or 0.25) or 0.25
    local max_zoom = tonumber(self.camera_max_zoom or 1.5) or 1.5
    local target_zoom = min_zoom + ((max_zoom - min_zoom) * t)
    request_zoom_to(self, target_zoom, SCREEN_WIDTH * 0.5, SCREEN_HEIGHT * 0.5)
end

zoom_slider_hit_test = function(self, screen_x, screen_y)
    if not (self and self.ui and self.ui.zoom_slider_knob and self.ui.zoom_slider_track) then
        return false
    end
    local knob_t = get_zoom_slider_normalized(self)
    local knob_y = get_zoom_slider_knob_y_from_t(knob_t)
    if is_point_in_screen_rect(screen_x, screen_y, ZOOM_SLIDER_TRACK_X, knob_y, ZOOM_SLIDER_KNOB_HIT_W, ZOOM_SLIDER_KNOB_HIT_H) then
        return true
    end
    if is_point_in_screen_rect(screen_x, screen_y, ZOOM_SLIDER_TRACK_X, ZOOM_SLIDER_TRACK_CENTER_Y, ZOOM_SLIDER_TRACK_HIT_W, ZOOM_SLIDER_TRACK_HIT_H) then
        return true
    end
    return false
end

update_zoom_slider_ui = function(self)
    if not (self and self.ui and self.ui.zoom_slider_track and self.ui.zoom_slider_knob) then
        return
    end
    set_ui_square_transform(
        self,
        self.ui.zoom_slider_track,
        ZOOM_SLIDER_TRACK_X,
        ZOOM_SLIDER_TRACK_CENTER_Y,
        ZOOM_SLIDER_Z,
        vmath.vector4(1, 1, 1, 1),
        ZOOM_SLIDER_TRACK_SCALE_X,
        ZOOM_SLIDER_TRACK_SCALE_Y
    )
    local knob_t = get_zoom_slider_normalized(self)
    local knob_y = get_zoom_slider_knob_y_from_t(knob_t)
    set_ui_square_transform(
        self,
        self.ui.zoom_slider_knob,
        ZOOM_SLIDER_TRACK_X,
        knob_y,
        ZOOM_SLIDER_Z + 0.001,
        vmath.vector4(1, 1, 1, 1),
        ZOOM_SLIDER_KNOB_SCALE_X,
        ZOOM_SLIDER_KNOB_SCALE_Y
    )
end

get_multiplayer_transport_status_tint = function(self)
    local status = self.mp_state and self.mp_state.transport_status or "idle"
    if status == "connected" then
        return vmath.vector4(0.2, 0.95, 0.3, 0.95)
    elseif status == "gateb_ok" then
        return vmath.vector4(0.1, 0.85, 1, 0.95)
    elseif status == "gatec_ok" then
        return vmath.vector4(0.95, 0.45, 1, 0.95)
    elseif status == "connecting" then
        return vmath.vector4(0.95, 0.8, 0.2, 0.95)
    elseif status == "reconnecting" then
        return vmath.vector4(1, 0.55, 0.2, 0.95)
    elseif status == "fallback_loopback" then
        return vmath.vector4(0.65, 0.55, 1, 0.95)
    elseif status == "shutdown" then
        return vmath.vector4(0.6, 0.6, 0.6, 0.95)
    end
    return vmath.vector4(0.7, 0.7, 0.7, 0.95)
end

get_multiplayer_ready_button_x = function(slot_index)
    local start_x = NEW_TURN_BUTTON_X + (NEW_TURN_BUTTON_W * 0.5) + 26
    return start_x + ((slot_index - 1) * (MULTIPLAYER_READY_BUTTON_W + MULTIPLAYER_READY_BUTTON_GAP))
end

multiplayer_get_unit_anim_id = function(unit_id)
    if unit_id == "sarge" then
        return hash("human_sarge_normal")
    elseif unit_id == "techie" then
        return hash("human_techie_normal")
    elseif unit_id == "medic" then
        return hash("human_medic_normal")
    elseif unit_id == "gunner" then
        return hash("human_gunner_normal")
    end
    return hash("human_sarge_normal")
end

multiplayer_normalize_mission_type = function(mission_type)
    local value = tostring(mission_type or MISSION_TYPE_ESCAPE)
    if value == MISSION_TYPE_ESCAPE
        or value == MISSION_TYPE_RESCUE
        or value == MISSION_TYPE_PURGE
        or value == MISSION_TYPE_CLEANSE
        or value == MISSION_TYPE_DNA_SAMPLE
        or value == MISSION_TYPE_HOLDOUT
        or value == MISSION_TYPE_TUTORIAL
    then
        return value
    end
    return MISSION_TYPE_ESCAPE
end

multiplayer_get_mission_anim_id = function(mission_type)
    local m = multiplayer_normalize_mission_type(mission_type)
    if m == MISSION_TYPE_RESCUE then
        return hash("mp_btn_mission_rescue")
    elseif m == MISSION_TYPE_PURGE then
        return hash("mp_btn_mission_purge")
    elseif m == MISSION_TYPE_CLEANSE then
        return hash("mp_btn_mission_cleanse")
    elseif m == MISSION_TYPE_DNA_SAMPLE then
        return hash("mp_btn_mission_dna")
    elseif m == MISSION_TYPE_HOLDOUT then
        return hash("mp_btn_mission_holdout")
    end
    return hash("mp_btn_mission_escape")
end

get_level_mission_type = function(level_def)
    if type(level_def) ~= "table" then
        return MISSION_TYPE_ESCAPE
    end
    local tagged = rawget(level_def, "mission_type")
    return multiplayer_normalize_mission_type(tagged or MISSION_TYPE_ESCAPE)
end

select_level_index_for_mission = function(self, mission_type)
    local requested = multiplayer_normalize_mission_type(mission_type)
    local levels = self and self.level_library or nil
    local candidates = {}
    if type(levels) == "table" then
        for level_index, level_def in pairs(levels) do
            local idx = tonumber(level_index)
            if idx and type(level_def) == "table" and get_level_mission_type(level_def) == requested then
                table.insert(candidates, idx)
            end
        end
    end
    if #candidates == 0 and requested ~= MISSION_TYPE_ESCAPE and type(levels) == "table" then
        for level_index, level_def in pairs(levels) do
            local idx = tonumber(level_index)
            if idx and type(level_def) == "table" and get_level_mission_type(level_def) == MISSION_TYPE_ESCAPE then
                table.insert(candidates, idx)
            end
        end
    end
    if #candidates == 0 and type(levels) == "table" then
        for level_index, level_def in pairs(levels) do
            local idx = tonumber(level_index)
            if idx and type(level_def) == "table" then
                table.insert(candidates, idx)
            end
        end
    end
    if #candidates == 0 then
        return 1
    end
    if LEVEL_DEBUG_FORCE_NEWEST_MISSION_LEVEL == true then
        table.sort(candidates, function(a, b) return a > b end)
        return candidates[1]
    end
    self.mission_last_level_pick = self.mission_last_level_pick or {}
    local last_pick = self.mission_last_level_pick[requested]
    if #candidates > 1 and last_pick then
        local filtered = {}
        for _, idx in ipairs(candidates) do
            if idx ~= last_pick then
                filtered[#filtered + 1] = idx
            end
        end
        if #filtered > 0 then
            candidates = filtered
        end
    end
    local picked = candidates[math.random(1, #candidates)]
    self.mission_last_level_pick[requested] = picked
    return picked
end

multiplayer_get_slot_count_for_player = function(player_count, player_id)
    if player_count == 1 then
        if player_id == "p1" or player_id == "p2" then
            return 2
        end
        return 0
    elseif player_count == 2 then
        if player_id == "p1" or player_id == "p2" then
            return 2
        end
        return 0
    elseif player_count == 3 then
        if player_id == "p1" then
            return 2
        end
        if player_id == "p2" or player_id == "p3" then
            return 1
        end
        return 0
    end
    if player_id == "p1" or player_id == "p2" or player_id == "p3" or player_id == "p4" then
        return 1
    end
    return 0
end

multiplayer_get_required_ready_player_ids_for_count = function(player_count)
    local ids = {}
    local max_players = math.max(2, math.min(4, player_count or 4))
    for i = 2, max_players do
        table.insert(ids, "p" .. tostring(i))
    end
    return ids
end

multiplayer_get_default_seat_assignments = function(player_count)
    local count = multiplayer_setup_clamp_player_count(player_count)
    if count == 1 or count == 2 then
        return {
            p1 = { "sarge", "techie" },
            p2 = { "medic", "gunner" }
        }
    elseif count == 3 then
        return {
            p1 = { "sarge", "techie" },
            p2 = { "medic" },
            p3 = { "gunner" }
        }
    end
    return {
        p1 = { "sarge" },
        p2 = { "techie" },
        p3 = { "medic" },
        p4 = { "gunner" }
    }
end

multiplayer_clone_seat_assignments = function(src_assignments, player_count)
    local out = {}
    local count = multiplayer_setup_clamp_player_count(player_count)
    for i = 1, count do
        local player_id = "p" .. tostring(i)
        out[player_id] = {}
        local src = src_assignments and src_assignments[player_id] or nil
        if src then
            for _, unit_id in ipairs(src) do
                table.insert(out[player_id], unit_id)
            end
        end
    end
    return out
end

multiplayer_get_player_for_unit = function(assignments, player_count, unit_id)
    if not assignments then
        return nil
    end
    local count = math.max(2, math.min(4, player_count or 4))
    for i = 1, count do
        local player_id = "p" .. tostring(i)
        local units = assignments[player_id] or {}
        for _, owned_id in ipairs(units) do
            if owned_id == unit_id then
                return player_id
            end
        end
    end
    return nil
end

PANEL_ART_ANIM_BY_CLASS_ID = {
    [UNIT_CLASS_SARGE] = hash("sarge_ui"),
    [UNIT_CLASS_MEDIC] = hash("medic_ui"),
    [UNIT_CLASS_TECHIE] = hash("techie_ui"),
    [UNIT_CLASS_GUNNER] = hash("gunner_ui")
}

get_unit_panel_anim = function(unit)
    if not unit then
        return hash("derple_ui_panel")
    end
    return PANEL_ART_ANIM_BY_CLASS_ID[unit.class_id] or hash("derple_ui_panel")
end

get_ui_panel_close_button_center = function()
    return UI_PANEL_X + (UI_PANEL_W * 0.5) - 38, UI_PANEL_Y - (UI_PANEL_H * 0.5) + 38
end

get_ui_panel_reactive_button_center = function()
    local close_x, close_y = get_ui_panel_close_button_center()
    return close_x - 74, close_y
end

local function get_comms_slot_center(slot_index)
    local idx = math.max(1, math.min(COMMS_SLOT_ROWS * COMMS_SLOT_COLS, tonumber(slot_index) or 1))
    local row = math.floor((idx - 1) / COMMS_SLOT_COLS)
    local col = (idx - 1) % COMMS_SLOT_COLS
    local x = COMMS_SLOT_START_X + (col * COMMS_SLOT_SPACING_X)
    local y = COMMS_SLOT_START_Y - (row * COMMS_SLOT_SPACING_Y)
    return x, y
end

local function should_show_comms_ui(self, unit)
    if not (self and unit and unit.id and (unit.current_health or 0) > 0) then
        return false
    end
    if COMMS_SOLO_TEST_ENABLED == true then
        return true
    end
    if not (self.mp_state and self.mp_state.enabled) then
        return false
    end
    return multiplayer_can_control_unit(self, unit.id) == true
end

local function close_comms_panel(self)
    self.comms_panel_open = false
end

local function is_valid_comms_event_type(event_type)
    if type(event_type) ~= "string" or event_type == "" then
        return false
    end
    for _, candidate in ipairs(COMMS_EVENT_TYPE_BY_INDEX) do
        if candidate == event_type then
            return true
        end
    end
    return false
end

count_non_nil_entries = function(t)
    if not t then
        return 0
    end
    local n = 0
    for _, v in pairs(t) do
        if v ~= nil then
            n = n + 1
        end
    end
    return n
end

collect_runtime_reference_counts = function(self)
    local c = {}
    c.tile_objects = count_non_nil_entries(tile_objects)
    c.cell_objects = count_non_nil_entries(cell_objects)
    c.loot_objects = count_non_nil_entries(loot_objects)
    c.machine_objects = count_non_nil_entries(machine_objects)
    c.tile_base_objects = count_non_nil_entries(self.tile_base_objects)
    c.tile_room_shadows = count_non_nil_entries(self.tile_room_shadows)
    c.tile_light_layers = count_non_nil_entries(self.tile_light_layers)
    c.tile_alpha_layers = count_non_nil_entries(self.tile_alpha_layers)
    c.alien_turn_overlay = self.alien_turn_overlay and 1 or 0
    c.entry_fire_fx_objects = count_non_nil_entries(self.entry_fire_fx_objects)
    c.exit_green_smoke_fx_objects = count_non_nil_entries(self.exit_green_smoke_fx_objects)
    c.world_item_visuals = count_non_nil_entries(self.world_item_visuals)
    c.world_item_shadow_visuals = count_non_nil_entries(self.world_item_shadow_visuals)
    c.loot_shadow_objects = count_non_nil_entries(self.loot_shadow_objects)
    c.machine_shadow_objects = count_non_nil_entries(self.machine_shadow_objects)
    c.turret_shadow_objects = count_non_nil_entries(self.turret_shadow_objects)
    c.power_node_shadow_objects = count_non_nil_entries(self.power_node_shadow_objects)
    c.vent_shadow_objects = count_non_nil_entries(self.vent_shadow_objects)
    c.door_shadow_objects = count_non_nil_entries(self.door_shadow_objects)
    c.fix_objects = count_non_nil_entries(self.fix_objects)
    c.power_node_objects = count_non_nil_entries(self.power_node_objects)
    c.vent_objects = count_non_nil_entries(self.vent_objects)
    c.door_objects = count_non_nil_entries(self.door_objects)
    c.turret_tripod_objects = count_non_nil_entries(self.turret_tripod_objects)
    c.turret_gun_objects = count_non_nil_entries(self.turret_gun_objects)
    c.wiregap_objects = count_non_nil_entries(self.wiregap_objects)
    c.wiregap_shadow_objects = count_non_nil_entries(self.wiregap_shadow_objects)
    c.wiregap_fx_objects = count_non_nil_entries(self.wiregap_fx_objects)
    c.light_value_objects = count_non_nil_entries(self.light_value_objects)
    c.escape_pod_power_slot_markers = count_non_nil_entries(self.escape_pod_power_slot_markers)
    c.exit_requirement_markers = count_non_nil_entries(self.exit_requirement_markers)
    c.world_backdrop_tiles = count_non_nil_entries(self.world_backdrop_tiles)
    c.loot_pickup_blips = count_non_nil_entries(self.loot_pickup_blips)
    c.world_item_instances = count_non_nil_entries(self.world_item_instances)
    c.power_node_loop_fx = count_non_nil_entries(self.power_node_loop_fx)
    c.melee_swipe_fx = count_non_nil_entries(self.melee_swipe_fx)
    c.aliens = count_non_nil_entries(self.aliens)
    c.spitter_projectiles = count_non_nil_entries(self.spitter_projectiles)
    c.turret_projectiles = count_non_nil_entries(self.turret_projectiles)
    c.ui_ap_pips = self.ui and self.ui.ap_pips and #self.ui.ap_pips or 0
    c.ui_hp_pips = self.ui and self.ui.hp_pips and #self.ui.hp_pips or 0
    c.ui_ammo_pips = self.ui and self.ui.ammo_pips and #self.ui.ammo_pips or 0
    c.ui_command_pips = self.ui and self.ui.command_pips and #self.ui.command_pips or 0
    c.ui_backpack_slots = self.ui and self.ui.backpack_slots and #self.ui.backpack_slots or 0
    c.ui_backpack_item_icons = self.ui and self.ui.backpack_item_icons and #self.ui.backpack_item_icons or 0
    c.ui_level_buttons = self.ui and self.ui.level_buttons and #self.ui.level_buttons or 0
    c.ui_flow_rows = self.ui and self.ui.flow_score_rows and #self.ui.flow_score_rows or 0
    c.ui_named_nodes = 0
    if self.ui then
        local named = {
            "panel_art", "panel_shadow", "component_button", "fix_button", "loot_button", "retrieve_button",
            "close_button", "not_enough_ap_icon", "new_turn_button", "launch_button", "aesthetic_toggle_button", "reactive_toggle_button",
            "reactive_advance_button", "drag_command_pip", "drag_pip", "flow_overlay", "flow_panel",
            "flow_outro_slide", "flow_outro_ship", "flow_outro_skip_button", "flow_outro_skip_button_art", "flow_score_submit_button", "flow_score_title_button",
            "flow_title_solo_button", "flow_title_multiplayer_button"
        }
        for _, k in ipairs(named) do
            if self.ui[k] ~= nil then
                c.ui_named_nodes = c.ui_named_nodes + 1
            end
        end
    end
    c.total = 0
    for k, v in pairs(c) do
        if k ~= "total" and type(v) == "number" then
            c.total = c.total + v
        end
    end
    return c
end

log_runtime_reference_audit = function(self, phase)
    self.runtime_ref_audit = self.runtime_ref_audit or {}
    local c = collect_runtime_reference_counts(self)
    print(string.format(
        "REF AUDIT | %s | total=%d tiles=%d cells=%d loot=%d machine=%d worldItems=%d itemVisuals=%d uiIcons=%d uiNamed=%d aliens=%d",
        phase or "unknown",
        c.total or 0,
        c.tile_objects or 0,
        c.cell_objects or 0,
        c.loot_objects or 0,
        c.machine_objects or 0,
        c.world_item_instances or 0,
        c.world_item_visuals or 0,
        c.ui_backpack_item_icons or 0,
        c.ui_named_nodes or 0,
        c.aliens or 0
    ))
    if phase == "post_load" then
        local prev = self.runtime_ref_audit.last_post_load
        if prev and prev.total and c.total and c.total > (prev.total + 120) then
            print(string.format(
                "REF AUDIT WARNING | post_load references grew from %d to %d",
                prev.total or 0,
                c.total or 0
            ))
        end
        self.runtime_ref_audit.last_post_load = c
    elseif phase == "pre_clear" then
        self.runtime_ref_audit.last_pre_clear = c
    elseif phase == "post_clear" then
        self.runtime_ref_audit.last_post_clear = c
    end
end

update_runtime_memory_probe = function(self, dt)
    if not self or RUNTIME_MEMORY_PROBE_ENABLED ~= true then
        return
    end
    local interval_s = math.max(1, tonumber(RUNTIME_MEMORY_PROBE_INTERVAL_S or 10.0) or 10.0)
    self.runtime_memory_probe_timer = (tonumber(self.runtime_memory_probe_timer or interval_s) or interval_s) - (tonumber(dt or 0) or 0)
    if self.runtime_memory_probe_timer > 0 then
        return
    end
    self.runtime_memory_probe_timer = interval_s
    local gc_ok, gc_kb_raw = pcall(collectgarbage, "count")
    local gc_kb = gc_ok and math.max(0, tonumber(gc_kb_raw or 0) or 0) or 0
    local refs = collect_runtime_reference_counts(self)
    local aliens_alive = 0
    for _, alien in ipairs(self.aliens or {}) do
        if alien and alien.is_dead ~= true then
            aliens_alive = aliens_alive + 1
        end
    end
    local civilians_alive = 0
    for _, civilian in ipairs(self.civilians or {}) do
        if civilian and civilian.is_dead ~= true then
            civilians_alive = civilians_alive + 1
        end
    end
    local score_events = 0
    if self.score_state and self.score_state.events_log then
        score_events = #self.score_state.events_log
    end
    print(string.format(
        "MEM PROBE | lua_kb=%d refs=%d aliens_alive=%d civilians_alive=%d spitter_proj=%d turret_proj=%d world_items=%d hazard_fx=%d score_events=%d",
        math.floor(gc_kb + 0.5),
        tonumber(refs and refs.total or 0) or 0,
        aliens_alive,
        civilians_alive,
        count_non_nil_entries(self.spitter_projectiles),
        count_non_nil_entries(self.turret_projectiles),
        count_non_nil_entries(self.world_item_instances),
        count_non_nil_entries(self.hazard_fx_objects),
        score_events
    ))
end


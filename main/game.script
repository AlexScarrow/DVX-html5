    if cmd_type == "toggle_door" then
        local expected_turn_id = tonumber(payload.turn_id or (self.mp_state.turn_id or 1))
        if expected_turn_id ~= (self.mp_state.turn_id or 1) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "toggle_door",
                reason = "stale_turn_id"
            }))
            return events
        end
        local unit_id = payload.unit_id
        local object_id = tonumber(payload.object_id)
        if not multiplayer_player_owns_unit(self, sender, unit_id) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "toggle_door",
                reason = "unit_not_owned_by_sender"
            }))
            return events
        end
        local unit = self.squad_units and self.squad_units[unit_id] or nil
        local owner_cell, door_obj = get_door_by_object_id(self.world_grid, object_id)
        if not unit or not owner_cell or not door_obj then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "toggle_door",
                reason = "invalid_door_target"
            }))
            return events
        end
        if not can_unit_reach_door_toggle(unit, owner_cell.idNumber) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "toggle_door",
                reason = "too_far_away"
            }))
            return events
        end
        local door_ap_cost = get_ap_cost_value("door_toggle", 1)
        if unit.current_ap < door_ap_cost then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "toggle_door",
                reason = "no_ap"
            }))
            return events
        end
        if not is_door_functional_runtime(self.world_grid, owner_cell, door_obj) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "toggle_door",
                reason = "door_not_functional"
            }))
            return events
        end
        local desired_open = payload.is_open == true
        local was_open = door_obj.isOpen == true
        door_obj.isOpen = desired_open
        if was_open ~= desired_open then
            local door_wx, door_wy = coords_to_world_pos(owner_cell.xCell, owner_cell.yCell)
            play_door_toggle_sfx(self, door_wx, door_wy)
        end
        local ap_after = math.max(0, (tonumber(unit.current_ap or 0) or 0) - door_ap_cost)
        table.insert(events, multiplayer_transport_emit_event(self, "toggle_door_applied", {
            unit_id = unit_id,
            object_id = object_id,
            owner_cell_id = owner_cell.idNumber,
            is_open = desired_open,
            ap_cost = door_ap_cost,
            ap_after = ap_after
        }))
        return events
    end

    if cmd_type == "scavenge_crate" then
        local expected_turn_id = tonumber(payload.turn_id or (self.mp_state.turn_id or 1))
        if expected_turn_id ~= (self.mp_state.turn_id or 1) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "scavenge_crate",
                reason = "stale_turn_id"
            }))
            return events
        end
        local unit_id = payload.unit_id
        local cell_id = tonumber(payload.cell_id)
        local crate_object_id = tonumber(payload.crate_object_id or 0) or 0
        if not multiplayer_player_owns_unit(self, sender, unit_id) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "scavenge_crate",
                reason = "unit_not_owned_by_sender"
            }))
            return events
        end
        local unit = self.squad_units and self.squad_units[unit_id] or nil
        local cell = cell_id and self.world_grid and self.world_grid[cell_id] or nil
        local crate_obj = cell and LOOT_RUNTIME and LOOT_RUNTIME.get_loot_crate_object and LOOT_RUNTIME.get_loot_crate_object(cell) or nil
        if not unit or not cell or not crate_obj then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "scavenge_crate",
                reason = "invalid_crate_target"
            }))
            return events
        end
        if crate_object_id > 0 and (crate_obj.objectId or 0) ~= crate_object_id then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "scavenge_crate",
                reason = "stale_crate_object_id"
            }))
            return events
        end
        if not multiplayer_apply_scavenge_crate_event(self, {
            unit_id = unit_id,
            cell_id = cell_id,
            crate_object_id = crate_obj.objectId or crate_object_id
        }) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "scavenge_crate",
                reason = "apply_failed_on_host"
            }))
            return events
        end
        table.insert(events, multiplayer_transport_emit_event(self, "scavenge_crate_applied", {
            unit_id = unit_id,
            cell_id = cell_id,
            crate_object_id = crate_obj.objectId or crate_object_id,
            host_applied = true,
            unit_digest = multiplayer_build_unit_state_digest(self),
            world_digest = multiplayer_build_world_state_digest(self),
            item_digest = multiplayer_build_item_state_digest(self)
        }))
        return events
    end

    table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
        command_type = tostring(cmd_type or "unknown"),
        reason = "unsupported_command"
    }))
    return events
end

multiplayer_transport_on_event = function(self, event)
    if not (self.mp_state and self.mp_state.enabled and event and type(event) == "table") then
        return
    end
    local event_id = event.event_id
    multiplayer_telemetry_on_recv_event(self, event.type)
    multiplayer_sync_trace(
        self,
        "recv_event",
        string.format(
            "type=%s id=%s sender=%s payload_turn=%s",
            tostring(event.type),
            tostring(event_id or "-"),
            tostring(event.sender_player_id or "-"),
            tostring(event.payload and event.payload.turn_id or "-")
        )
    )
    if event_id and event_id ~= "" then
        self.mp_state.seen_event_ids = self.mp_state.seen_event_ids or {}
        if self.mp_state.seen_event_ids[event_id] == true then
            multiplayer_sync_trace(self, "drop_event_duplicate", string.format("id=%s type=%s", tostring(event_id), tostring(event.type)))
            return
        end
        self.mp_state.seen_event_ids[event_id] = true
    end
    if event.type == "ready_state_changed" then
        local player_id = event.payload and event.payload.player_id or nil
        if player_id then
            local ready_on = event.payload.ready == true
            self.mp_state.ready_by_player_id[player_id] = ready_on
            if ready_on
                and LOOT_RUNTIME
                and LOOT_RUNTIME.spawn_impact_ring_at_world
                and self.mp_state
                and self.mp_state.local_player_id == self.mp_state.host_player_id
                and player_id ~= self.mp_state.host_player_id
                and self.mp_state.required_ready_player_ids
            then
                for i, required_id in ipairs(self.mp_state.required_ready_player_ids) do
                    if required_id == player_id then
                        local bx = get_multiplayer_ready_button_x(i)
                        LOOT_RUNTIME.spawn_impact_ring_at_world(
                            self,
                            bx,
                            MULTIPLAYER_READY_BUTTON_Y,
                            vmath.vector4(1.0, 0.55, 0.2, 1),
                            0.7
                        )
                        break
                    end
                end
            end
            print(string.format(
                "MP READY | %s | player_id=%s | turn_id=%d",
                ready_on and "ready_on" or "ready_off",
                tostring(player_id),
                self.mp_state.turn_id or 1
            ))
        end
        return
    end
    if event.type == "pong_echo" then
        local target_player_id = event.payload and event.payload.target_player_id or nil
        local local_player_id = self.mp_state and self.mp_state.local_player_id or nil
        if target_player_id and local_player_id and target_player_id ~= local_player_id then
            return
        end
        local sender_player_id = mp_normalize_network_player_id(event.sender_player_id or "")
        if sender_player_id ~= "" then
            self.mp_state.last_seen_by_network_id = self.mp_state.last_seen_by_network_id or {}
            self.mp_state.last_seen_by_network_id[sender_player_id] = (tonumber(get_wall_clock_ms() or 0) or 0) / 1000
        end
        if self.mp_telemetry and self.mp_telemetry.enabled then
            local sent_ms = tonumber(event.payload and event.payload.sent_ms or 0) or 0
            if sent_ms > 0 then
                local now_ms = (socket and socket.gettime and (socket.gettime() * 1000)) or (os.clock() * 1000)
                local rtt = math.max(0, now_ms - sent_ms)
                self.mp_telemetry.rtt_last_ms = rtt
                local samples = self.mp_telemetry.rtt_samples_ms or {}
                samples[#samples + 1] = rtt
                if #samples > 32 then
                    table.remove(samples, 1)
                end
                self.mp_telemetry.rtt_samples_ms = samples
            end
        end
        return
    end
    if event.type == "turn_advanced" then
        print(string.format("MP TURN | request_accepted | next_turn_id=%d", (event.payload and event.payload.turn_id) or 0))
        if self.mp_state and self.mp_state.local_player_id ~= self.mp_state.host_player_id then
            -- Non-host does an AP/UI turn reset and waits for host-broadcast turn_state_snapshot.
            local requested_turn_id = tonumber(event.payload and event.payload.turn_id or 0) or ((self.mp_state.turn_id or 1) + 1)
            self.mp_state.awaiting_snapshot = false
            self.mp_state.snapshot_blocking = false
            self.mp_state.awaiting_snapshot_timeout_s = 0
            self.mp_state.expected_snapshot_turn_id = requested_turn_id
            self.mp_state.client_alien_activity_visible = false
            -- During turn handoff, events/snapshots can arrive slightly out of order.
            -- Skip heartbeat mismatch checks for this turn until authoritative turn snapshot lands.
            self.mp_state.turn_based_heartbeat_suspend_turn_id = requested_turn_id
            self.mp_state.post_turn_snapshot_delay_s = 0
            msg.post(".", "next_turn", { from_mp_turn_advanced = true, skip_authoritative_sim = true })
            print(string.format("MP TURNSTATE | awaiting_host_broadcast | turn_id=%d", requested_turn_id))
        else
            msg.post(".", "next_turn", { from_mp_turn_advanced = true })
        end
        return
    end
    if event.type == "turn_state_snapshot" then
        local sender_player_id = event.sender_player_id or nil
        if self.mp_state.local_player_id == self.mp_state.host_player_id
            and sender_player_id == self.mp_state.host_player_id
        then
            return
        end
        local payload_turn_id = tonumber(event.payload and event.payload.turn_id or 0) or 0
        local expected_turn_id = tonumber(self.mp_state and self.mp_state.expected_snapshot_turn_id or 0) or 0
        local snapshot = event.payload and event.payload.snapshot or nil
        local snapshot_turn_id = tonumber(snapshot and snapshot.turn_id or 0) or payload_turn_id
        if expected_turn_id > 0 and snapshot_turn_id > 0 and snapshot_turn_id < expected_turn_id then
            if self.mp_telemetry and self.mp_telemetry.enabled then
                self.mp_telemetry.turn_id_mismatch_count = (tonumber(self.mp_telemetry.turn_id_mismatch_count or 0) or 0) + 1
            end
            print(string.format(
                "MP TURNSTATE | stale_ignored | snapshot_turn=%d expected_turn=%d",
                snapshot_turn_id,
                expected_turn_id
            ))
            return
        end
        if not multiplayer_apply_snapshot_state(self, snapshot) then
            multiplayer_telemetry_on_snapshot_apply_failed(self)
            print("MP TURNSTATE | apply_failed")
            return
        end
        multiplayer_telemetry_on_snapshot_applied(self)
        self.mp_state.awaiting_snapshot = false
        self.mp_state.snapshot_blocking = false
        self.mp_state.awaiting_snapshot_timeout_s = 0
        self.mp_state.expected_snapshot_turn_id = 0
        self.mp_state.last_snapshot_retry_turn_id = 0
        self.mp_state.client_alien_activity_visible = false
        print(string.format(
            "MP TURNSTATE | applied | turn_id=%d level=%d",
            self.mp_state.turn_id or 1,
            self.current_level_index or 0
        ))
        self.mp_state.turn_based_heartbeat_suspend_turn_id = 0
        self.mp_state.turn_based_heartbeat_mismatch_streak = 0
        self.mp_state.turn_based_heartbeat_last_request_turn_id = 0
        return
    end
    if event.type == "turn_state_heartbeat" then
        if not (self.mp_state and self.mp_state.enabled) then
            return
        end
        if (tonumber(self.realtime_client_settle_timer or 0) or 0) > 0 then
            -- Ignore turn-heartbeat checks while realtime mode settle window is active.
            return
        end
        local sender_player_id = event.sender_player_id or nil
        if sender_player_id ~= self.mp_state.host_player_id then
            return
        end
        if self.mp_state.local_player_id == self.mp_state.host_player_id then
            return
        end
        if self.realtime_rules_enabled == true then
            self.mp_state.turn_based_heartbeat_mismatch_streak = 0
            return
        end
        local payload = event.payload or {}
        local host_turn_id = tonumber(payload.turn_id or 0) or 0
        local local_turn_id = tonumber(self.mp_state.turn_id or 0) or 0
        if self.mp_state and self.mp_state.local_player_id ~= self.mp_state.host_player_id then
            self.mp_state.client_alien_activity_visible = payload.alien_activity_active == true
        end
        local suspended_turn_id = tonumber(self.mp_state.turn_based_heartbeat_suspend_turn_id or 0) or 0
        if suspended_turn_id > 0 and local_turn_id == suspended_turn_id then
            return
        end
        if any_unit_is_moving(self)
            or any_alien_is_moving(self)
            or self.pending_spitter_attack_phase
            or self.pending_melee_attack_phase
        then
            -- Movement/attack phases are transient and can legitimately differ with prediction.
            return
        end
        if host_turn_id > 0 and local_turn_id > 0 and host_turn_id ~= local_turn_id then
            self.mp_state.turn_based_heartbeat_mismatch_streak = 0
            return
        end
        local host_checksum = tostring(payload.checksum or "")
        if host_checksum == "" then
            return
        end
        local local_checksum = tostring(multiplayer_compute_turn_checksum(self))
        local checksum_buckets = multiplayer_compute_turn_checksum_buckets(self)
        local host_units_checksum = tostring(payload.checksum_units or "")
        local host_actors_checksum = tostring(payload.checksum_actors or "")
        local host_world_checksum = tostring(payload.checksum_world or "")
        local host_items_checksum = tostring(payload.checksum_items or "")
        local host_unit_digest = payload.unit_digest
        local host_actor_digest = payload.actor_digest
        local host_world_digest = payload.world_digest
        local host_item_digest = payload.item_digest
        local unit_mismatch = (host_units_checksum ~= "" and host_units_checksum ~= tostring(checksum_buckets.units or ""))
        local actors_mismatch = (host_actors_checksum ~= "" and host_actors_checksum ~= tostring(checksum_buckets.actors or ""))
        local world_mismatch = (host_world_checksum ~= "" and host_world_checksum ~= tostring(checksum_buckets.world or ""))
        local items_mismatch = (host_items_checksum ~= "" and host_items_checksum ~= tostring(checksum_buckets.items or ""))
        if self.mp_telemetry and self.mp_telemetry.enabled then
            if unit_mismatch then
                self.mp_telemetry.checksum_mismatch_units_count = (tonumber(self.mp_telemetry.checksum_mismatch_units_count or 0) or 0) + 1
            end
            if actors_mismatch then
                self.mp_telemetry.checksum_mismatch_actors_count = (tonumber(self.mp_telemetry.checksum_mismatch_actors_count or 0) or 0) + 1
            end
            if world_mismatch then
                self.mp_telemetry.checksum_mismatch_world_count = (tonumber(self.mp_telemetry.checksum_mismatch_world_count or 0) or 0) + 1
            end
            if items_mismatch then
                self.mp_telemetry.checksum_mismatch_items_count = (tonumber(self.mp_telemetry.checksum_mismatch_items_count or 0) or 0) + 1
            end
        end
        if local_checksum == host_checksum then
            self.mp_state.turn_based_heartbeat_mismatch_streak = 0
            return
        end
        if self.mp_telemetry and self.mp_telemetry.enabled then
            self.mp_telemetry.checksum_mismatch_count = (tonumber(self.mp_telemetry.checksum_mismatch_count or 0) or 0) + 1
        end
        if unit_mismatch or actors_mismatch or world_mismatch or items_mismatch then
            print(string.format(
                "MP DESYNC | heartbeat_bucket_mismatch | turn_id=%d units=%d actors=%d world=%d items=%d",
                local_turn_id,
                unit_mismatch and 1 or 0,
                actors_mismatch and 1 or 0,
                world_mismatch and 1 or 0,
                items_mismatch and 1 or 0
            ))
            if unit_mismatch then
                local diff_signature = string.format(
                    "%d|%s|%s",
                    local_turn_id,
                    tostring(host_units_checksum or ""),
                    tostring(checksum_buckets.units or "")
                )
                if self.mp_state.turn_based_last_unit_diff_signature ~= diff_signature then
                    self.mp_state.turn_based_last_unit_diff_signature = diff_signature
                    multiplayer_log_unit_state_mismatch(self, host_unit_digest)
                end
                -- Fast path: if digest is available, reconcile idle unit state immediately.
                -- This avoids repeated heartbeat mismatch churn for stale AP/cell drift.
                if multiplayer_apply_authoritative_unit_digest(self, host_unit_digest) then
                    local post_checksum = tostring(multiplayer_compute_turn_checksum(self))
                    if post_checksum == host_checksum then
                        self.mp_state.turn_based_heartbeat_mismatch_streak = 0
                        return
                    end
                end
            end
            if actors_mismatch and multiplayer_apply_authoritative_actor_digest(self, host_actor_digest) then
                local post_checksum = tostring(multiplayer_compute_turn_checksum(self))
                if post_checksum == host_checksum then
                    self.mp_state.turn_based_heartbeat_mismatch_streak = 0
                    return
                end
            end
            if world_mismatch and multiplayer_apply_authoritative_world_digest(self, host_world_digest) then
                local post_checksum = tostring(multiplayer_compute_turn_checksum(self))
                if post_checksum == host_checksum then
                    self.mp_state.turn_based_heartbeat_mismatch_streak = 0
                    return
                end
            end
            if items_mismatch and multiplayer_apply_authoritative_item_digest(self, host_item_digest) then
                local post_checksum = tostring(multiplayer_compute_turn_checksum(self))
                if post_checksum == host_checksum then
                    self.mp_state.turn_based_heartbeat_mismatch_streak = 0
                    return
                end
            end
        end
        self.mp_state.turn_based_heartbeat_mismatch_streak = (tonumber(self.mp_state.turn_based_heartbeat_mismatch_streak or 0) or 0) + 1
        local mismatch_threshold = math.max(1, tonumber(TURN_BASED_MP_HEARTBEAT_MISMATCH_THRESHOLD or 2) or 2)
        if self.mp_state.turn_based_heartbeat_mismatch_streak < mismatch_threshold then
            return
        end
        local request_turn_id = host_turn_id > 0 and host_turn_id or local_turn_id
        if self.mp_state.turn_based_heartbeat_last_request_turn_id == request_turn_id then
            return
        end
        self.mp_state.turn_based_heartbeat_last_request_turn_id = request_turn_id
        self.mp_state.turn_based_heartbeat_mismatch_streak = 0
        multiplayer_transport_send_command(self, "request_snapshot", {
            turn_id = request_turn_id,
            reason = "heartbeat_checksum_mismatch",
            expected_turn_id = request_turn_id
        }, self.mp_state.local_player_id)
        print(string.format("MP SNAPSHOT | requested_heartbeat_mismatch | turn_id=%d", request_turn_id))
        return
    end
    if event.type == "realtime_state_snapshot" then
        local sender_player_id = event.sender_player_id or nil
        if self.mp_state.local_player_id == self.mp_state.host_player_id
            and sender_player_id == self.mp_state.host_player_id
        then
            return
        end
        if not (self.mp_state and self.mp_state.enabled) then
            return
        end
        local seq = tonumber(event.payload and event.payload.seq or 0) or 0
        local last_seq = tonumber(self.mp_state.realtime_last_applied_snapshot_seq or 0) or 0
        if seq > 0 and last_seq > 0 and seq <= last_seq then
            return
        end
        local snapshot = event.payload and event.payload.snapshot or nil
        if not multiplayer_apply_realtime_snapshot_state(self, snapshot) then
            multiplayer_telemetry_on_snapshot_apply_failed(self)
            print("MP RT SNAPSHOT | apply_failed")
            return
        end
        multiplayer_telemetry_on_snapshot_applied(self)
        if seq > 0 then
            self.mp_state.realtime_last_applied_snapshot_seq = seq
        end
        print(string.format("MP RT SNAPSHOT | applied | seq=%d turn_id=%d", seq, self.mp_state.turn_id or 1))
        return
    end
    if event.type == "realtime_mode_changed" then
        if not (self.mp_state and self.mp_state.enabled) then
            return
        end
        local sender_player_id = event.sender_player_id or nil
        if sender_player_id ~= self.mp_state.host_player_id then
            return
        end
        local enabled = event.payload and event.payload.enabled == true
        self.realtime_rules_enabled = enabled
        update_realtime_toggle_button_visual(self)
        self.realtime_alien_tick_accum = 0
        self.realtime_civilian_tick_accum = 0
        self.realtime_blip_spawn_accum = 0
        self.realtime_client_settle_timer = 0.4
        if self.mp_state and self.mp_state.local_player_id == self.mp_state.host_player_id then
            self.mp_state.realtime_snapshot_accum_s = 0
            self.mp_state.realtime_snapshot_heartbeat_accum_s = 0
            self.mp_state.realtime_last_sent_signature = ""
        end
        if self.mp_state and self.mp_state.local_player_id ~= self.mp_state.host_player_id then
            self.mp_state.awaiting_snapshot = false
            self.mp_state.snapshot_blocking = false
            self.mp_state.awaiting_snapshot_timeout_s = 0
            self.mp_state.expected_snapshot_turn_id = 0
            self.mp_state.post_turn_snapshot_delay_s = 0
            self.mp_state.last_snapshot_retry_turn_id = 0
            self.mp_state.realtime_last_applied_snapshot_seq = 0
            multiplayer_apply_authoritative_unit_digest(self, event.payload and event.payload.unit_digest or nil)
        end
        print(string.format("MP RT MODE | synced_from_host | %s", enabled and "ON" or "OFF"))
        return
    end
    if event.type == "workshop_state_changed" then
        if not (self.mp_state and self.mp_state.enabled) then
            return
        end
        local sender_player_id = event.sender_player_id or nil
        if sender_player_id ~= self.mp_state.host_player_id then
            return
        end
        if self.mp_state.local_player_id == self.mp_state.host_player_id then
            return
        end
        if LOOT_RUNTIME and LOOT_RUNTIME.apply_workshop_sync_state then
            local workshop_state = event.payload and event.payload.workshop_state or {}
            LOOT_RUNTIME.apply_workshop_sync_state(self, workshop_state)
            self.mp_state.workshop_state_sync_signature = workshop_state_signature(workshop_state)
        end
        return
    end
    if event.type == "factory_state_changed" then
        if not (self.mp_state and self.mp_state.enabled) then
            return
        end
        local sender_player_id = event.sender_player_id or nil
        if sender_player_id ~= self.mp_state.host_player_id then
            return
        end
        if self.mp_state.local_player_id == self.mp_state.host_player_id then
            return
        end
        if LOOT_RUNTIME and LOOT_RUNTIME.apply_factory_sync_state then
            LOOT_RUNTIME.apply_factory_sync_state(self, event.payload and event.payload.factory_state or {})
            self.mp_state.factory_state_sync_signature = factory_state_signature(event.payload and event.payload.factory_state or {})
        end
        return
    end
    if event.type == "factory_token_spawned" then
        if not (self.mp_state and self.mp_state.enabled) then
            return
        end
        local sender_player_id = event.sender_player_id or nil
        if sender_player_id ~= self.mp_state.host_player_id then
            return
        end
        if self.mp_state.local_player_id == self.mp_state.host_player_id then
            return
        end
        if LOOT_RUNTIME and LOOT_RUNTIME.spawn_factory_conveyor_token_visual then
            local payload = multiplayer_clone_simple_table(event.payload or {}) or {}
            payload.remote_visual_only = true
            LOOT_RUNTIME.spawn_factory_conveyor_token_visual(self, payload)
        end
        return
    end
    if event.type == "combat_fx" then
        if not (self.mp_state and self.mp_state.enabled) then
            return
        end
        local sender_player_id = event.sender_player_id or nil
        if sender_player_id ~= self.mp_state.host_player_id then
            return
        end
        if self.mp_state.local_player_id == self.mp_state.host_player_id then
            return
        end
        self.mp_state.applying_remote_event = true
        multiplayer_apply_combat_fx_event(self, event.payload or {})
        self.mp_state.applying_remote_event = false
        return
    end
    if event.type == "realtime_spitter_projectile" then
        if not (self.mp_state and self.mp_state.enabled) then
            return
        end
        local sender_player_id = event.sender_player_id or nil
        if sender_player_id ~= self.mp_state.host_player_id then
            return
        end
        if self.mp_state.local_player_id == self.mp_state.host_player_id then
            return
        end
        local from_x = tonumber(event.payload and event.payload.from_x or nil)
        local from_y = tonumber(event.payload and event.payload.from_y or nil)
        local to_x = tonumber(event.payload and event.payload.to_x or nil)
        local to_y = tonumber(event.payload and event.payload.to_y or nil)
        if not (from_x and from_y and to_x and to_y) then
            return
        end
        play_spitter_fires_sfx(self, from_x, from_y)
        local projectile_id = factory.create("/ui_factory#ui_factory", vmath.vector3(from_x, from_y, 0.75))
        if not projectile_id then
            return
        end
        go.set_scale(vmath.vector3(SPITTER_PROJECTILE_SIZE * 0.2, SPITTER_PROJECTILE_SIZE * 0.2, 1), projectile_id)
        msg.post(msg.url(nil, projectile_id, "sprite"), "play_animation", { id = hash("alien_projectile_1") })
        go.set(msg.url(nil, projectile_id, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
        local dir_x = to_x - from_x
        local dir_y = to_y - from_y
        if math.abs(dir_x) > 0.01 or math.abs(dir_y) > 0.01 then
            go.set_rotation(vmath.quat_rotation_z(math.atan2(dir_y, dir_x) + math.pi), projectile_id)
        end
        self.spitter_projectiles = self.spitter_projectiles or {}
        table.insert(self.spitter_projectiles, {
            kind = "alien",
            go_id = projectile_id,
            from = vmath.vector3(from_x, from_y, 0.75),
            to = vmath.vector3(to_x, to_y, 0.75),
            t = 0
        })
        return
    end
    if event.type == "realtime_human_projectile" then
        if not (self.mp_state and self.mp_state.enabled) then
            return
        end
        local sender_player_id = event.sender_player_id or nil
        if sender_player_id ~= self.mp_state.host_player_id then
            return
        end
        if self.mp_state.local_player_id == self.mp_state.host_player_id then
            return
        end
        local from_x = tonumber(event.payload and event.payload.from_x or nil)
        local from_y = tonumber(event.payload and event.payload.from_y or nil)
        local to_x = tonumber(event.payload and event.payload.to_x or nil)
        local to_y = tonumber(event.payload and event.payload.to_y or nil)
        local shooter_unit_id = event.payload and event.payload.shooter_unit_id or nil
        if shooter_unit_id and multiplayer_can_control_unit(self, shooter_unit_id) then
            -- Shooter client already spawned this projectile from manual_shot_applied.
            return
        end
        if not (from_x and from_y and to_x and to_y) then
            return
        end
        local projectile_id = factory.create("/ui_factory#ui_factory", vmath.vector3(from_x, from_y, 0.75))
        if not projectile_id then
            return
        end
        go.set_scale(vmath.vector3(SPITTER_PROJECTILE_SIZE * 0.2, SPITTER_PROJECTILE_SIZE * 0.2, 1), projectile_id)
        msg.post(msg.url(nil, projectile_id, "sprite"), "play_animation", { id = hash("human_projectile_1") })
        go.set(msg.url(nil, projectile_id, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
        local dir_x = to_x - from_x
        local dir_y = to_y - from_y
        if math.abs(dir_x) > 0.01 or math.abs(dir_y) > 0.01 then
            go.set_rotation(vmath.quat_rotation_z(math.atan2(dir_y, dir_x) + math.pi), projectile_id)
        end
        self.spitter_projectiles = self.spitter_projectiles or {}
        table.insert(self.spitter_projectiles, {
            kind = "human_remote",
            go_id = projectile_id,
            from = vmath.vector3(from_x, from_y, 0.75),
            to = vmath.vector3(to_x, to_y, 0.75),
            t = 0,
            speed = SPITTER_PROJECTILE_SPEED * 1.4
        })
        return
    end
    if event.type == "realtime_turret_projectile" then
        if not (self.mp_state and self.mp_state.enabled) then
            return
        end
        local sender_player_id = event.sender_player_id or nil
        if sender_player_id ~= self.mp_state.host_player_id then
            return
        end
        if self.mp_state.local_player_id == self.mp_state.host_player_id then
            return
        end
        local from_x = tonumber(event.payload and event.payload.from_x or nil)
        local from_y = tonumber(event.payload and event.payload.from_y or nil)
        local to_x = tonumber(event.payload and event.payload.to_x or nil)
        local to_y = tonumber(event.payload and event.payload.to_y or nil)
        local delay = tonumber(event.payload and event.payload.delay or 0) or 0
        if not (from_x and from_y and to_x and to_y) then
            return
        end
        local projectile_id = factory.create("/ui_factory#ui_factory", vmath.vector3(from_x, from_y, 0.76))
        if not projectile_id then
            return
        end
        go.set_scale(vmath.vector3(SPITTER_PROJECTILE_SIZE * 0.16, SPITTER_PROJECTILE_SIZE * 0.16, 1), projectile_id)
        msg.post(msg.url(nil, projectile_id, "sprite"), "play_animation", { id = hash("human_projectile_1") })
        go.set(msg.url(nil, projectile_id, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
        local dir_x = to_x - from_x
        local dir_y = to_y - from_y
        if math.abs(dir_x) > 0.001 or math.abs(dir_y) > 0.001 then
            go.set_rotation(vmath.quat_rotation_z(math.atan2(dir_y, dir_x) + math.pi), projectile_id)
        end
        self.turret_projectiles = self.turret_projectiles or {}
        table.insert(self.turret_projectiles, {
            go_id = projectile_id,
            from = vmath.vector3(from_x, from_y, 0.76),
            to = vmath.vector3(to_x, to_y, 0.76),
            t = 0,
            delay = math.max(0, delay)
        })
        return
    end
    if event.type == "turn_checksum" then
        local checksum_turn_id = tonumber(event.payload and event.payload.turn_id or 0) or 0
        local host_checksum = tostring(event.payload and event.payload.checksum or "")
        local local_turn_id = tonumber(self.mp_state and self.mp_state.turn_id or 0) or 0
        if checksum_turn_id ~= local_turn_id then
            print(string.format(
                "MP DESYNC | checksum_skipped | host_turn=%d local_turn=%d",
                checksum_turn_id,
                local_turn_id
            ))
            return
        end
        local local_checksum = multiplayer_compute_turn_checksum(self)
        if local_checksum == host_checksum then
            print(string.format("MP DESYNC | checksum_ok | turn_id=%d checksum=%s", local_turn_id, local_checksum))
            return
        end
        print(string.format(
            "MP DESYNC | checksum_mismatch | turn_id=%d host=%s local=%s",
            local_turn_id,
            host_checksum,
            local_checksum
        ))
        if self.mp_state.local_player_id ~= self.mp_state.host_player_id then
            self.mp_state.awaiting_snapshot = true
            self.mp_state.snapshot_blocking = false
            self.mp_state.awaiting_snapshot_timeout_s = 0
            self.mp_state.expected_snapshot_turn_id = tonumber(self.mp_state.turn_id or 1) or 1
            multiplayer_transport_send_command(self, "request_snapshot", {
                turn_id = self.mp_state.turn_id or 1,
                reason = "checksum_mismatch",
                host_checksum = host_checksum,
                local_checksum = local_checksum
            }, self.mp_state.local_player_id)
            print("MP SNAPSHOT | requested_checksum_mismatch")
        end
        return
    end
    if event.type == "snapshot_state" then
        local target_player_id = event.payload and event.payload.target_player_id or nil
        local local_player_id = self.mp_state and self.mp_state.local_player_id or "p1"
        if target_player_id and target_player_id ~= local_player_id then
            return
        end
        local snapshot = event.payload and event.payload.snapshot or nil
        local snapshot_turn_id = tonumber(snapshot and snapshot.turn_id or 0) or 0
        local local_turn_id = tonumber(self.mp_state and self.mp_state.turn_id or 0) or 0
        local expected_turn_id = tonumber(self.mp_state and self.mp_state.expected_snapshot_turn_id or 0) or 0
        if snapshot_turn_id > 0 and local_turn_id > 0 and snapshot_turn_id < local_turn_id then
            print(string.format(
                "MP SNAPSHOT | stale_ignored | snapshot_turn=%d local_turn=%d",
                snapshot_turn_id,
                local_turn_id
            ))
            if self.mp_state and self.mp_state.local_player_id ~= self.mp_state.host_player_id then
                local retry_turn_id = math.max(local_turn_id, expected_turn_id)
                if retry_turn_id > 0 and self.mp_state.last_snapshot_retry_turn_id ~= retry_turn_id then
                    self.mp_state.last_snapshot_retry_turn_id = retry_turn_id
                    self.mp_state.awaiting_snapshot = true
                    self.mp_state.snapshot_blocking = false
                    self.mp_state.awaiting_snapshot_timeout_s = 0
                    self.mp_state.expected_snapshot_turn_id = retry_turn_id
                    multiplayer_transport_send_command(self, "request_snapshot", {
                        turn_id = retry_turn_id,
                        reason = "stale_snapshot_retry"
                    }, self.mp_state.local_player_id)
                    print(string.format("MP SNAPSHOT | requested_stale_retry | turn_id=%d", retry_turn_id))
                end
            end
            return
        end
        if expected_turn_id > 0 and snapshot_turn_id > 0 and snapshot_turn_id < expected_turn_id then
            print(string.format(
                "MP SNAPSHOT | stale_expected_ignored | snapshot_turn=%d expected_turn=%d",
                snapshot_turn_id,
                expected_turn_id
            ))
            return
        end
        if not multiplayer_apply_snapshot_state(self, snapshot) then
            print("MP SNAPSHOT | apply_failed")
            self.mp_state.awaiting_snapshot = false
            self.mp_state.snapshot_blocking = false
            self.mp_state.awaiting_snapshot_timeout_s = 0
            self.mp_state.expected_snapshot_turn_id = 0
            return
        end
        self.mp_state.awaiting_snapshot = false
        self.mp_state.snapshot_blocking = false
        self.mp_state.awaiting_snapshot_timeout_s = 0
        self.mp_state.expected_snapshot_turn_id = 0
        self.mp_state.last_snapshot_retry_turn_id = 0
        multiplayer_drain_pending_events(self)
        print(string.format(
            "MP SNAPSHOT | applied | turn_id=%d level=%d",
            self.mp_state.turn_id or 1,
            self.current_level_index or 0
        ))
        return
    end
    if event.type == "setup_state_updated" then
        local target_player_id = event.payload and event.payload.target_player_id or nil
        local session_id = event.payload and event.payload.session_id or nil
        if target_player_id then
            multiplayer_lobby_adopt_incoming_target_wire_id(self, target_player_id, session_id)
        end
        local local_player_id = self.mp_state and self.mp_state.local_player_id or "p1"
        if target_player_id and target_player_id ~= local_player_id then
            return
        end
        local config = event.payload and event.payload.session_config or nil
        if type(config) == "table" then
            local is_guest = self.mp_state
                and self.mp_state.enabled
                and self.mp_state.local_player_id ~= self.mp_state.host_player_id
            local prev_player_count = tonumber(self.mp_setup and self.mp_setup.player_count or 0) or 0
            local flow = tostring(self.game_flow_state or FLOW_STATE_GAME)
            local show_joined_advisory = is_guest and (
                flow == FLOW_STATE_MP_LOBBY
                or tostring(self.mp_lobby and self.mp_lobby.pending_join_session_id or "") ~= ""
            )
            if is_guest and flow == FLOW_STATE_MP_LOBBY then
                multiplayer_lobby_ensure_runtime(self)
                local pending_id = tostring(self.mp_lobby.pending_join_session_id or "")
                if pending_id ~= "" then
                    local session = multiplayer_lobby_get_session_by_id(self, pending_id)
                    if not session then
                        session = {
                            id = pending_id,
                            players = math.max(2, tonumber(config.player_count or 2) or 2),
                            max_players = math.max(2, tonumber(config.player_count or 2) or 2)
                        }
                    end
                    multiplayer_lobby_enter_mp_setup_from_session(self, session, true)
                end
            end
            multiplayer_setup_apply_session_config(self, config)
            multiplayer_guest_sync_runtime_from_session_config(self, config)
            if is_guest then
                self.mp_lobby.pending_join_session_id = ""
                self.mp_lobby.pending_steam_lobby_id = ""
                self.mp_lobby.pending_join_wire_sent = false
                self.mp_lobby.pending_join_wire_session_id = ""
                if show_joined_advisory then
                    show_mp_lobby_advisory(self, 1.8, "joined")
                    print("MP LOBBY | Joined game -> setup")
                    print("MP LOBBY | setup_state synced -> setup")
                elseif flow == FLOW_STATE_MP_SETUP and event.payload and event.payload.require_setup_ack == true then
                    local session_id = tostring(event.payload.session_id or self.mp_state.lobby_ticket_id or "")
                    local rev = tonumber(event.payload.roster_revision or 0) or 0
                    local last_session_id = tostring(self.mp_lobby.last_setup_roster_revision_acked_session_id or "")
                    local last_rev = tonumber(self.mp_lobby.last_setup_roster_revision_acked or 0) or 0
                    if rev > 0 and (session_id ~= last_session_id or rev ~= last_rev) then
                        self.mp_lobby.last_setup_roster_revision_acked_session_id = session_id
                        self.mp_lobby.last_setup_roster_revision_acked = rev
                        multiplayer_apply_steam_transport_seat_ids(self)
                        local sync_wire_id = mp_normalize_network_player_id(self.mp_state.local_player_id or "")
                        if sync_wire_id ~= "" then
                            multiplayer_transport_send_command(self, "request_setup_state", {}, sync_wire_id)
                            multiplayer_debug_log(self, string.format(
                                "MP LOBBY | setup_sync_roster_ack guest=%s session=%s rev=%d",
                                sync_wire_id,
                                session_id,
                                rev
                            ))
                        end
                    end
                end
            end
            print(string.format("MP SETUP | synced | player_count=%d", tonumber(config.player_count or 0) or 0))
        end
        return
    end
    if event.type == "lobby_state_updated" then
        -- Offer upserts are authoritative; legacy lobby snapshots can arrive stale after rejoin.
        return
    end
    if event.type == "lobby_offer_upsert" then
        local target_player_id = event.payload and event.payload.target_player_id or nil
        local local_player_id = self.mp_state and self.mp_state.local_player_id or "p1"
        if target_player_id and target_player_id ~= local_player_id then
            return
        end
        multiplayer_lobby_apply_offer_upsert(self, event.payload and event.payload.offer or nil)
        return
    end
    if event.type == "lobby_offer_remove" then
        local target_player_id = event.payload and event.payload.target_player_id or nil
        local local_player_id = self.mp_state and self.mp_state.local_player_id or "p1"
        if target_player_id and target_player_id ~= local_player_id then
            return
        end
        local offer_id = event.payload and event.payload.offer_id or ""
        local remove_reason = tostring(event.payload and event.payload.reason or "")
        local remove_status = tostring(event.payload and event.payload.lobby_status or "")
        local is_launch_remove = remove_reason == "launched"
            or remove_status == MP_SESSION_TICKET.LOBBY_STATUS_LAUNCHED
        local ticket_id = multiplayer_lobby_get_lobby_ticket_id(self)
        local pending_id = tostring(self.mp_lobby and self.mp_lobby.pending_join_session_id or "")
        local pin_target_id = tostring(self.mp_lobby and self.mp_lobby.pin_target_session_id or "")
        local should_disconnect = not multiplayer_lobby_is_session_host(self)
            and not is_launch_remove
            and offer_id ~= ""
            and (offer_id == ticket_id or offer_id == pending_id or offer_id == pin_target_id)
        local removed_at_ms = tonumber(event.payload and event.payload.removed_at_ms or get_wall_clock_ms()) or get_wall_clock_ms()
        multiplayer_lobby_note_offer_removed(self, offer_id, removed_at_ms)
        multiplayer_lobby_apply_offer_remove(self, offer_id)
        if should_disconnect then
            multiplayer_lobby_force_guest_disconnect(self, "offer_removed", "chooser")
        end
        return
    end
    if event.type == "lobby_offer_join_request" then
        multiplayer_lobby_ensure_runtime(self)
        local offer_id = tostring(event.payload and event.payload.offer_id or "")
        local requester_player_id = tostring(event.payload and event.payload.requester_player_id or "")
        local pin = tostring(event.payload and event.payload.pin or "")
        local session = multiplayer_lobby_get_session_by_id(self, offer_id)
        local local_player_id = tostring(self.mp_state and self.mp_state.local_player_id or "p1")
        if not session or requester_player_id == "" or not multiplayer_lobby_is_session_host(self, session) then
            return
        end
        if tonumber(session.players or 0) >= tonumber(session.max_players or 4) then
            multiplayer_transport_send_command(self, "lobby_offer_join_response", {
                offer_id = offer_id,
                requester_player_id = requester_player_id,
                accepted = false,
                reason = "session_full"
            }, local_player_id)
            return
        end
        if session.is_locked == true then
            local expected = tostring(session.pin or "")
            if expected == "" or pin ~= expected then
                multiplayer_transport_send_command(self, "lobby_offer_join_response", {
                    offer_id = offer_id,
                    requester_player_id = requester_player_id,
                    accepted = false,
                    reason = "pin_invalid"
                }, local_player_id)
                return
            end
        end
        multiplayer_transport_send_command(self, "lobby_offer_join_response", {
            offer_id = offer_id,
            requester_player_id = requester_player_id,
            accepted = true
        }, local_player_id)
        return
    end
    if event.type == "lobby_offer_join_accept" then
        -- Join completion is handled by lobby_join_accepted; do not clear pending here
        -- because it runs in the same event batch before lobby_join_accepted.
        return
    end
    if event.type == "lobby_offer_join_reject" then
        local target_player_id = event.payload and event.payload.target_player_id or nil
        local local_player_id = self.mp_state and self.mp_state.local_player_id or "p1"
        if target_player_id and target_player_id ~= local_player_id then
            return
        end
        local reject_session_id = tostring(event.payload and (event.payload.session_id or event.payload.offer_id) or "")
        local reject_reason = tostring(event.payload and event.payload.reason or "rejected")
        multiplayer_lobby_restore_pin_join_after_reject(self, reject_session_id, reject_reason)
        return
    end
    if event.type == "lobby_offer_heartbeat" then
        return
    end
    if event.type == "lobby_join_accepted" then
        local target_player_id = event.payload and event.payload.target_player_id or nil
        local session_id = tostring(event.payload and event.payload.session_id or "")
        if not multiplayer_lobby_should_apply_join_accepted(self, target_player_id, session_id) then
            return
        end
        multiplayer_lobby_ensure_runtime(self)
        local session = multiplayer_lobby_get_session_by_id(self, session_id)
        local setup_config = event.payload and event.payload.session_config or nil
        if session then
            multiplayer_lobby_enter_mp_setup_from_session(self, session, true)
        else
            local host_player_id = tostring(self.mp_state and self.mp_state.host_player_id or "p1")
            local local_network_player_id = tostring(self.mp_state and self.mp_state.local_player_id or "p1")
            local joined_ids = { host_player_id }
            if local_network_player_id ~= "" and local_network_player_id ~= host_player_id then
                joined_ids[#joined_ids + 1] = local_network_player_id
            end
            local synthetic = {
                id = session_id ~= "" and session_id or "remote_session",
                owner_player_id = host_player_id,
                status = "published_open",
                joined_player_ids = joined_ids,
                players = #joined_ids,
                max_players = tonumber(event.payload and event.payload.session_max_players or 2) or 2
            }
            multiplayer_lobby_enter_mp_setup_from_session(self, synthetic, true)
        end
        if type(setup_config) == "table" then
            multiplayer_setup_apply_session_config(self, setup_config)
            multiplayer_guest_sync_runtime_from_session_config(self, setup_config)
        end
        self.mp_lobby.pending_join_session_id = ""
        self.mp_lobby.pending_steam_lobby_id = ""
        self.mp_lobby.pending_join_wire_sent = false
        self.mp_lobby.pending_join_wire_session_id = ""
        multiplayer_lobby_clear_pin_join_state(self)
        multiplayer_lobby_guest_bump_setup_sync_epoch(self)
        multiplayer_lobby_guest_request_setup_sync(self)
        multiplayer_lobby_lifecycle_guest(self, MP_LOBBY_LIFECYCLE.GUEST_IN_ROSTER, {
            session = session_id
        })
        show_mp_lobby_advisory(self, 1.8, "joined")
        print("MP LOBBY | Joined game -> setup")
        print("MP LOBBY | join accepted -> setup")
        return
    end
    if event.type == "lobby_session_closed" then
        local closed_session_id = tostring(event.payload and event.payload.session_id or "")
        local local_session_id = tostring(self.mp_state and self.mp_state.session_id or "")
        local ticket_id = multiplayer_lobby_get_lobby_ticket_id(self)
        local pending_id = tostring(self.mp_lobby and self.mp_lobby.pending_join_session_id or "")
        local is_client = self.mp_state and self.mp_state.local_player_id ~= self.mp_state.host_player_id
        if is_client and closed_session_id ~= "" and (
            closed_session_id == local_session_id
            or closed_session_id == ticket_id
            or closed_session_id == pending_id
        ) then
            multiplayer_lobby_force_guest_disconnect(self, "session_closed", "chooser")
            print("MP LOBBY | host closed session, client ejected to chooser.")
        end
        return
    end
    if event.type == "match_started" then
        local target_player_id = event.payload and event.payload.target_player_id or nil
        local local_player_id = self.mp_state and self.mp_state.local_player_id or "p1"
        if target_player_id and target_player_id ~= local_player_id then
            return
        end
        if self.mp_state and self.mp_state.local_player_id ~= self.mp_state.host_player_id then
            local flow = self.game_flow_state or FLOW_STATE_GAME
            if flow ~= FLOW_STATE_MP_SETUP then
                multiplayer_debug_log(self, string.format(
                    "MP STEAM GATEF | match_started_ignored flow=%s local=%s",
                    tostring(flow),
                    tostring(local_player_id)
                ))
                multiplayer_lobby_abort_guest_join(self)
                self.multiplayer_mode_active = true
                enter_flow_state(self, FLOW_STATE_MP_LOBBY)
                return
            end
        end
        local config = event.payload and event.payload.session_config or nil
        if type(config) == "table" and self.mp_state and self.mp_state.local_player_id ~= self.mp_state.host_player_id then
            multiplayer_lobby_lifecycle_guest(self, MP_LOBBY_LIFECYCLE.GUEST_IN_MATCH, {
                players = tonumber(config.player_count or 0) or 0
            })
        end
        if type(config) ~= "table" then
            config = multiplayer_setup_build_session_config(self)
        end
        if self.mp_state and self.mp_state.local_player_id ~= self.mp_state.host_player_id then
            multiplayer_guest_sync_runtime_from_session_config(self, config)
            local slot = multiplayer_get_slot_player_id_for_network(self, self.mp_state.local_player_id)
            local seat_assignments = config.seat_assignments or {}
            local unit_count = type(seat_assignments[slot]) == "table" and #seat_assignments[slot] or 0
            multiplayer_debug_log(self, string.format(
                "MP STEAM GATEF | match_started_guest local=%s slot=%s units=%d",
                tostring(self.mp_state.local_player_id or ""),
                tostring(slot or ""),
                unit_count
            ))
            if unit_count == 0 then
                local built = multiplayer_setup_build_session_config(self)
                if built.seat_assignments
                    and built.seat_assignments[slot]
                    and #built.seat_assignments[slot] > 0
                then
                    config.seat_assignments = built.seat_assignments
                else
                    config.seat_assignments = multiplayer_get_default_seat_assignments(config.player_count or 2)
                end
            end
        end
        start_multiplayer_game_flow(self, config)
        print("MP SETUP | match_started event applied.")
        return
    end
    if event.type == "match_aborted_to_lobby" then
        local sender_player_id = tostring(event.sender_player_id or "")
        local host_player_id = tostring(self.mp_state and self.mp_state.host_player_id or "")
        if sender_player_id ~= host_player_id then
            return
        end
        local payload_session_id = tostring(event.payload and event.payload.session_id or "")
        local local_session_id = tostring(self.mp_state and self.mp_state.session_id or "")
        if payload_session_id ~= "" and local_session_id ~= "" and payload_session_id ~= local_session_id then
            return
        end
        multiplayer_leave_in_progress_match_to_lobby(self, event.payload and event.payload.reason or "host_aborted_match")
        return
    end
    if event.type == "player_departed_in_match" then
        local payload = event.payload or {}
        local payload_session_id = tostring(payload.session_id or "")
        local local_session_id = tostring(self.mp_state and self.mp_state.session_id or "")
        if payload_session_id ~= "" and local_session_id ~= "" and payload_session_id ~= local_session_id then
            return
        end
        local departed_player_id = tostring(payload.departed_player_id or "")
        local local_player_id = tostring(self.mp_state and self.mp_state.local_player_id or "")
        local host_player_id = tostring(self.mp_state and self.mp_state.host_player_id or "")
        local is_turn_boundary_reclaim = departed_player_id == "turn_boundary_reclaim"
        if departed_player_id ~= "" and not is_turn_boundary_reclaim then
            multiplayer_apply_in_match_player_departure(self, departed_player_id)
        end
        if type(payload.seat_assignments) == "table" then
            local apply_seat_payload = true
            if is_turn_boundary_reclaim and local_player_id ~= host_player_id then
                apply_seat_payload = false
            end
            if apply_seat_payload then
                self.mp_state.seat_assignments = multiplayer_clone_seat_assignments(payload.seat_assignments, self.mp_state.player_count or 4)
            end
        end
        if type(payload.required_ready_player_ids) == "table" then
            self.mp_state.required_ready_player_ids = multiplayer_clone_simple_table(payload.required_ready_player_ids) or {}
        end
        if type(payload.ready_by_player_id) == "table" then
            self.mp_state.ready_by_player_id = multiplayer_clone_simple_table(payload.ready_by_player_id) or {}
        end
        if departed_player_id ~= ""
            and not is_turn_boundary_reclaim
            and local_player_id == departed_player_id
            and local_player_id ~= host_player_id
        then
            multiplayer_leave_in_progress_match_to_lobby(self, "departed_from_match")
            return
        end
        multiplayer_enforce_controlled_unit(self, true)
        update_human_visual_state(self)
        update_selected_unit_ui(self)
        print(string.format("MP MATCH | player_departed_applied | player_id=%s", departed_player_id))
        return
    end
    if event.type == "match_ended" then
        local sender_player_id = tostring(event.sender_player_id or "")
        local local_player_id = tostring(self.mp_state and self.mp_state.local_player_id or "")
        if sender_player_id ~= "" and sender_player_id == local_player_id then
            return
        end
        local evt_id = tostring(event.event_id or "")
        if self.mp_state then
            if evt_id ~= "" and evt_id == tostring(self.mp_state.match_end_last_event_id or "") then
                return
            end
            self.mp_state.match_end_last_event_id = evt_id
        end
        local payload = event.payload or {}
        enter_mission_outro(self, payload.result or "lose", payload.reason or "unknown")
        if type(payload.score_breakdown) == "table" then
            self.flow_score_breakdown = payload.score_breakdown
        end
        if type(payload.team_display_names) == "table" then
            self.flow_score_team_display_names = payload.team_display_names
        end
        print(string.format(
            "MP OUTRO | match_ended event applied | result=%s reason=%s",
            tostring(payload.result or "lose"),
            tostring(payload.reason or "unknown")
        ))
        return
    end
    if event.type == "alien_activity_state" then
        local sender_player_id = event.sender_player_id or nil
        if self.mp_state and self.mp_state.enabled and sender_player_id == self.mp_state.host_player_id then
            self.mp_state.client_alien_activity_visible = event.payload and event.payload.active == true
            if self.mp_state.client_alien_activity_visible ~= true then
                self.mp_state.client_alien_movement_only_phase = false
            end
        end
        return
    end
    if event.type == "alien_pre_attack_sync" then
        local sender_player_id = event.sender_player_id or nil
        if self.mp_state
            and self.mp_state.enabled
            and self.mp_state.local_player_id ~= self.mp_state.host_player_id
            and sender_player_id == self.mp_state.host_player_id
        then
            local payload = event.payload or {}
            multiplayer_apply_actor_cell_reconcile(self, payload.actor_digest)
            self.mp_state.client_alien_movement_only_phase = false
        end
        return
    end
    if event.type == "move_unit_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        multiplayer_sync_trace(self, "apply_event_begin", "type=move_unit_applied")
        if not multiplayer_apply_move_unit_event(self, event.payload or {}) then
            print("MP COMMAND | move_unit_applied ignored.")
            multiplayer_sync_trace(self, "apply_event_end", "type=move_unit_applied ok=false")
        else
            multiplayer_sync_trace(self, "apply_event_end", "type=move_unit_applied ok=true")
        end
        return
    end
    if event.type == "manual_shot_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        multiplayer_sync_trace(self, "apply_event_begin", "type=manual_shot_applied")
        if not multiplayer_apply_manual_shot_event(self, event.payload or {}) then
            print("MP COMMAND | manual_shot_applied ignored.")
            multiplayer_sync_trace(self, "apply_event_end", "type=manual_shot_applied ok=false")
        else
            multiplayer_sync_trace(self, "apply_event_end", "type=manual_shot_applied ok=true")
        end
        return
    end
    if event.type == "cleanse_flamer_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        if not multiplayer_apply_cleanse_flamer_event(self, event.payload or {}) then
            print("MP COMMAND | cleanse_flamer_applied ignored.")
        end
        return
    end
    if event.type == "cleanse_state_sync" then
        if CLEANSE_RUNTIME and CLEANSE_RUNTIME.cleanse_apply_sync_payload then
            local payload = event.payload or {}
            local cleanse_payload = payload.cleanse or {}
            CLEANSE_RUNTIME.cleanse_apply_sync_payload(self, cleanse_payload)
            refresh_cleanse_global_blocked_cells(self)
        end
        return
    end
    if event.type == "release_civilian_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        local payload = event.payload or {}
        local is_local_host = multiplayer_is_wire_dispatch_host(self)
        local should_apply_local = not (payload.host_applied == true and is_local_host)
        local ok = true
        if should_apply_local then
            ok = multiplayer_apply_release_civilian_event(self, payload)
        end
        local reconciled = multiplayer_apply_authoritative_actor_digest(self, payload.actor_digest)
        if not ok then
            print("MP COMMAND | release_civilian_applied ignored.")
        elseif reconciled then
            multiplayer_sync_trace(self, "apply_event_end", "type=release_civilian_applied ok=true reconciled=true")
        else
            multiplayer_sync_trace(self, "apply_event_end", "type=release_civilian_applied ok=true")
        end
        multiplayer_broadcast_turn_state_heartbeat_now(self)
        return
    end
    if event.type == "comms_command_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        if not multiplayer_apply_comms_command_event(self, event.payload or {}) then
            print("MP COMMAND | comms_command_applied ignored.")
        end
        return
    end
    if event.type == "set_reactive_fire_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        if not multiplayer_apply_set_reactive_fire_event(self, event.payload or {}) then
            print("MP COMMAND | set_reactive_fire_applied ignored.")
        end
        return
    end
    if event.type == "resource_drag_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        multiplayer_sync_trace(self, "apply_event_begin", "type=resource_drag_applied")
        local payload = event.payload or {}
        local should_apply_local = (payload.host_applied ~= true) or (self.mp_state.local_player_id ~= self.mp_state.host_player_id)
        local ok = true
        if should_apply_local then
            self.mp_state.applying_remote_event = true
            ok = multiplayer_apply_resource_drag_event(self, payload)
            self.mp_state.applying_remote_event = false
        end
        local reconciled = false
        reconciled = multiplayer_apply_authoritative_unit_digest(self, payload.unit_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_world_digest(self, payload.world_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_item_digest(self, payload.item_digest) or reconciled
        if not ok then
            print("MP COMMAND | resource_drag_applied ignored.")
            multiplayer_sync_trace(self, "apply_event_end", "type=resource_drag_applied ok=false")
        elseif reconciled then
            multiplayer_sync_trace(self, "apply_event_end", "type=resource_drag_applied ok=true reconciled=true")
        else
            multiplayer_sync_trace(self, "apply_event_end", "type=resource_drag_applied ok=true")
        end
        multiplayer_broadcast_turn_state_heartbeat_now(self)
        return
    end
    if event.type == "turret_removed_fx" then
        local payload = event.payload or {}
        local cell_id = tonumber(payload.cell_id)
        if cell_id then
            local cell = self.world_grid and self.world_grid[cell_id] or nil
            if cell then
                local removed_any = false
                local slot_idx = tonumber(payload.turret_slot_idx)
                local turret_object_id = tonumber(payload.turret_object_id)
                local objects = { cell.object1, cell.object2, cell.object3 }
                if slot_idx and slot_idx >= 1 and slot_idx <= 3 then
                    local obj = objects[slot_idx]
                    if obj and obj.name == hash("gun_turret") then
                        reset_runtime_object_slot_to_empty(obj)
                        removed_any = true
                    end
                end
                if (not removed_any) and turret_object_id and turret_object_id > 0 then
                    for _, obj in ipairs(objects) do
                        if obj and obj.name == hash("gun_turret") and (tonumber(obj.objectId or 0) or 0) == turret_object_id then
                            reset_runtime_object_slot_to_empty(obj)
                            removed_any = true
                            break
                        end
                    end
                end
                if not removed_any then
                    for _, obj in ipairs(objects) do
                        if obj and obj.name == hash("gun_turret") then
                            reset_runtime_object_slot_to_empty(obj)
                            removed_any = true
                        end
                    end
                end
                if removed_any then
                    if LOOT_RUNTIME and LOOT_RUNTIME.refresh_turret_markers then
                        LOOT_RUNTIME.refresh_turret_markers(self)
                    end
                    if LOOT_RUNTIME and LOOT_RUNTIME.refresh_fix_markers then
                        LOOT_RUNTIME.refresh_fix_markers(self)
                    end
                    if LOOT_RUNTIME and LOOT_RUNTIME.refresh_world_item_visuals then
                        LOOT_RUNTIME.refresh_world_item_visuals(self)
                    end
                end
            end
        end
        -- Always rebuild turret visuals for this event to clear any stale marker GOs,
        -- even when authoritative state was already updated earlier.
        if LOOT_RUNTIME and LOOT_RUNTIME.refresh_turret_markers then
            LOOT_RUNTIME.refresh_turret_markers(self)
        end
        return
    end
    if event.type == "pickup_obstacle_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        local payload = event.payload or {}
        local is_local_host = multiplayer_is_wire_dispatch_host(self)
        local should_apply_local = not (payload.host_applied == true and is_local_host)
        local applied_ok = true
        if should_apply_local then
            applied_ok = multiplayer_apply_pickup_obstacle_event(self, payload)
        end
        if not applied_ok then
            print("MP COMMAND | pickup_obstacle_applied ignored.")
        end
        local reconciled = false
        reconciled = multiplayer_apply_authoritative_unit_digest(self, payload.unit_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_world_digest(self, payload.world_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_item_digest(self, payload.item_digest) or reconciled
        if (not applied_ok) and (not reconciled) then
            return
        end
        multiplayer_broadcast_turn_state_heartbeat_now(self)
        return
    end
    if event.type == "obstacle_pickup_fx" then
        local payload = event.payload or {}
        local cell_id = tonumber(payload.cell_id)
        local obstacle_slot_idx = tonumber(payload.obstacle_slot_idx or 0) or 0
        local obstacle_count_after = tonumber(payload.obstacle_count_after or 0) or 0
        local cell = cell_id and self.world_grid and self.world_grid[cell_id] or nil
        if cell then
            local objects = { cell.object1, cell.object2, cell.object3 }
            local obstacle_slots = type(payload.obstacle_slots) == "table" and payload.obstacle_slots or nil
            if obstacle_slots then
                for slot_idx, slot in ipairs(objects) do
                    local state = obstacle_slots[slot_idx] or obstacle_slots[tostring(slot_idx)] or {}
                    if state.is_obstacle == true then
                        slot.name = hash("obstacle")
                        slot.objectId = tonumber(state.object_id or slot.objectId or 0) or 0
                        local count = tonumber(state.count or 1) or 1
                        slot.stackCount = count
                        slot.obstacleCount = count
                        slot.isFixed = state.isFixed == true
                        slot.isWelded = state.isWelded == true
                        slot.offsetX = tonumber(state.offsetX or slot.offsetX or 0) or 0
                        slot.offsetY = tonumber(state.offsetY or slot.offsetY or 0) or 0
                        slot.hitW = tonumber(state.hitW or slot.hitW or 24) or 24
                        slot.hitH = tonumber(state.hitH or slot.hitH or 24) or 24
                    elseif slot and slot.name == hash("obstacle") then
                        reset_runtime_object_slot_to_empty(slot)
                    end
                end
            elseif obstacle_slot_idx >= 1 and obstacle_slot_idx <= 3 then
                local slot = objects[obstacle_slot_idx]
                if slot and slot.name == hash("obstacle") then
                    if obstacle_count_after <= 0 then
                        reset_runtime_object_slot_to_empty(slot)
                    else
                        slot.stackCount = obstacle_count_after
                        slot.obstacleCount = obstacle_count_after
                    end
                end
            end
            if LOOT_RUNTIME and LOOT_RUNTIME.refresh_fix_markers then
                LOOT_RUNTIME.refresh_fix_markers(self)
            end
            if LOOT_RUNTIME and LOOT_RUNTIME.refresh_world_item_visuals then
                LOOT_RUNTIME.refresh_world_item_visuals(self)
            end
        end
        return
    end
    if event.type == "pickup_corpse_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        local payload = event.payload or {}
        local is_local_host = multiplayer_is_wire_dispatch_host(self)
        local should_apply_local = not (payload.host_applied == true and is_local_host)
        local applied_ok = true
        if should_apply_local then
            applied_ok = multiplayer_apply_pickup_corpse_event(self, payload)
        end
        if not applied_ok then
            print("MP COMMAND | pickup_corpse_applied ignored.")
        end
        local reconciled = false
        reconciled = multiplayer_apply_authoritative_unit_digest(self, payload.unit_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_world_digest(self, payload.world_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_item_digest(self, payload.item_digest) or reconciled
        if (not applied_ok) and (not reconciled) then
            return
        end
        return
    end
    if event.type == "pickup_turret_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        multiplayer_sync_trace(self, "apply_event_begin", "type=pickup_turret_applied")
        local payload = event.payload or {}
        local is_local_host = multiplayer_is_wire_dispatch_host(self)
        local should_apply_local = not (payload.host_applied == true and is_local_host)
        local applied_ok = true
        if should_apply_local then
            applied_ok = multiplayer_apply_pickup_turret_event(self, payload)
        end
        if not applied_ok then
            print("MP COMMAND | pickup_turret_applied ignored.")
            multiplayer_sync_trace(self, "apply_event_end", "type=pickup_turret_applied ok=false")
        else
            multiplayer_sync_trace(self, "apply_event_end", "type=pickup_turret_applied ok=true")
        end
        local reconciled = false
        reconciled = multiplayer_apply_authoritative_unit_digest(self, payload.unit_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_world_digest(self, payload.world_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_item_digest(self, payload.item_digest) or reconciled
        local turret_cell_id = tonumber(payload.cell_id)
        local turret_slot_idx = tonumber(payload.turret_slot_idx)
        local turret_object_id = tonumber(payload.turret_object_id)
        if turret_cell_id and turret_slot_idx then
            local cell = self.world_grid and self.world_grid[turret_cell_id] or nil
            if cell then
                local turret_obj = nil
                if turret_slot_idx == 1 then turret_obj = cell.object1 end
                if turret_slot_idx == 2 then turret_obj = cell.object2 end
                if turret_slot_idx == 3 then turret_obj = cell.object3 end
                if turret_obj and turret_obj.name == hash("gun_turret") then
                    reset_runtime_object_slot_to_empty(turret_obj)
                    if LOOT_RUNTIME and LOOT_RUNTIME.refresh_turret_markers then
                        LOOT_RUNTIME.refresh_turret_markers(self)
                    end
                    if LOOT_RUNTIME and LOOT_RUNTIME.refresh_fix_markers then
                        LOOT_RUNTIME.refresh_fix_markers(self)
                    end
                    if LOOT_RUNTIME and LOOT_RUNTIME.refresh_world_item_visuals then
                        LOOT_RUNTIME.refresh_world_item_visuals(self)
                    end
                    reconciled = true
                end
            end
        end
        if turret_cell_id and (not turret_slot_idx) and turret_object_id and turret_object_id > 0 then
            local cell = self.world_grid and self.world_grid[turret_cell_id] or nil
            if cell then
                local objects = { cell.object1, cell.object2, cell.object3 }
                for _, obj in ipairs(objects) do
                    if obj and obj.name == hash("gun_turret") and (tonumber(obj.objectId or 0) or 0) == turret_object_id then
                        reset_runtime_object_slot_to_empty(obj)
                        if LOOT_RUNTIME and LOOT_RUNTIME.refresh_turret_markers then
                            LOOT_RUNTIME.refresh_turret_markers(self)
                        end
                        if LOOT_RUNTIME and LOOT_RUNTIME.refresh_fix_markers then
                            LOOT_RUNTIME.refresh_fix_markers(self)
                        end
                        if LOOT_RUNTIME and LOOT_RUNTIME.refresh_world_item_visuals then
                            LOOT_RUNTIME.refresh_world_item_visuals(self)
                        end
                        reconciled = true
                        break
                    end
                end
            end
        end
        if turret_cell_id then
            local cell = self.world_grid and self.world_grid[turret_cell_id] or nil
            if cell then
                local objects = { cell.object1, cell.object2, cell.object3 }
                local removed_any = false
                for _, obj in ipairs(objects) do
                    if obj and obj.name == hash("gun_turret") then
                        reset_runtime_object_slot_to_empty(obj)
                        removed_any = true
                    end
                end
                if removed_any then
                    if LOOT_RUNTIME and LOOT_RUNTIME.refresh_turret_markers then
                        LOOT_RUNTIME.refresh_turret_markers(self)
                    end
                    if LOOT_RUNTIME and LOOT_RUNTIME.refresh_fix_markers then
                        LOOT_RUNTIME.refresh_fix_markers(self)
                    end
                    if LOOT_RUNTIME and LOOT_RUNTIME.refresh_world_item_visuals then
                        LOOT_RUNTIME.refresh_world_item_visuals(self)
                    end
                    reconciled = true
                end
            end
        end
        if (not applied_ok) and (not reconciled) then
            return
        end
        multiplayer_broadcast_turn_state_heartbeat_now(self)
        return
    end
    if event.type == "workshop_select_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        local payload = event.payload or {}
        local is_local_host = multiplayer_is_wire_dispatch_host(self)

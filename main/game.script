score_build_publish_payload = function(self, score_state)
    local breakdown = self.flow_score_breakdown or compute_placeholder_score_breakdown(self)
    local payload = {
        match_id = string.format(
            "%s_t%d_%s",
            tostring((self.mp_state and self.mp_state.session_id) or "solo_session"),
            tonumber(self.mp_state and self.mp_state.turn_id or 1) or 1,
            tostring(self.end_result or "unknown")
        ),
        score_total = tonumber(breakdown.total or 0) or 0,
        mission_type = tostring(self.end_mission_type or multiplayer_normalize_mission_type(get_current_mission_type(self))),
        result = tostring(self.end_result or (self.game_won and "win" or "lose")),
        origin = (score_state == FLOW_STATE_SCORE_MP) and "multiplayer" or "solo",
        team_player_ids = {},
        team_display_names = {}
    }
    if score_state == FLOW_STATE_SCORE_MP and self.mp_state and self.mp_state.enabled then
        local name_seen = {}
        local id_seen = {}
        if type(self.flow_score_team_display_names) == "table" then
            for _, display_name in ipairs(self.flow_score_team_display_names) do
                local clean = leaderboard_sanitize_name(display_name, LEADERBOARD_DEBUG_NAME_MAX_CHARS_PER_ROW_MP)
                if clean ~= "" and name_seen[clean] ~= true then
                    name_seen[clean] = true
                    payload.team_display_names[#payload.team_display_names + 1] = clean
                end
            end
        end
        local configured_player_count = math.max(2, math.min(4, tonumber(self.mp_state.player_count or 2) or 2))
        for i = 1, configured_player_count do
            local pid = "p" .. tostring(i)
            if id_seen[pid] ~= true then
                id_seen[pid] = true
                payload.team_player_ids[#payload.team_player_ids + 1] = pid
            end
            if #payload.team_display_names < configured_player_count then
                local fallback_name = leaderboard_sanitize_name(mp_alpha_label_from_network_id(pid), LEADERBOARD_DEBUG_NAME_MAX_CHARS_PER_ROW_MP)
                if fallback_name ~= "" and name_seen[fallback_name] ~= true then
                    name_seen[fallback_name] = true
                    payload.team_display_names[#payload.team_display_names + 1] = fallback_name
                end
            end
        end
        if #payload.team_display_names <= 0 then
            local host_pid = tostring(self.mp_state.host_player_id or "p1")
            payload.team_display_names[1] = mp_alpha_label_from_network_id(host_pid)
            payload.team_player_ids[1] = host_pid
        end
    else
        local solo_id = tostring((self.mp_state and self.mp_state.local_player_id) or "p1")
        payload.team_player_ids[1] = solo_id
        payload.team_display_names[1] = mp_alpha_label_from_network_id(solo_id)
    end
    return payload
end

score_persist_pending_uploads = function(self)
    local queue = self and self.pending_score_uploads or {}
    local ok = pcall(sys.save, "dvx_score_publish_queue", { entries = queue })
    if not ok then
        print("SCORE | failed to persist pending publish queue.")
    end
end

score_load_pending_uploads = function(self)
    local ok, data = pcall(sys.load, "dvx_score_publish_queue")
    if not ok or type(data) ~= "table" then
        self.pending_score_uploads = {}
        self.flow_score_publish_pending_count = 0
        return
    end
    local entries = type(data.entries) == "table" and data.entries or {}
    self.pending_score_uploads = entries
    self.flow_score_publish_pending_count = #entries
end

score_enqueue_pending_publish = function(self, payload, reason)
    if not self then
        return
    end
    self.pending_score_uploads = self.pending_score_uploads or {}
    self.pending_score_uploads[#self.pending_score_uploads + 1] = {
        payload = payload,
        reason = tostring(reason or "pending"),
        created_at_ms = get_wall_clock_ms(),
        retry_count = 0
    }
    self.flow_score_publish_status = "pending"
    self.flow_score_publish_pending_count = #self.pending_score_uploads
    score_persist_pending_uploads(self)
end

score_get_leaderboard_local_save_key = function(score_state)
    if score_state == FLOW_STATE_SCORE_MP then
        return LEADERBOARD_LOCAL_SAVE_KEY_MP
    end
    return LEADERBOARD_LOCAL_SAVE_KEY_SOLO
end

score_sort_leaderboard_entries = function(entries)
    table.sort(entries, function(a, b)
        local a_score = tonumber(a and a.score_total or 0) or 0
        local b_score = tonumber(b and b.score_total or 0) or 0
        if a_score ~= b_score then
            return a_score > b_score
        end
        local a_ts = tonumber(a and a.created_at_ms or 0) or 0
        local b_ts = tonumber(b and b.created_at_ms or 0) or 0
        return a_ts > b_ts
    end)
end

score_load_local_leaderboard_entries = function(self, score_state)
    local key = score_get_leaderboard_local_save_key(score_state)
    local ok, data = pcall(sys.load, key)
    if not ok or type(data) ~= "table" then
        return {}
    end
    local entries = type(data.entries) == "table" and data.entries or {}
    score_sort_leaderboard_entries(entries)
    return entries
end

score_persist_local_leaderboard_entries = function(self, score_state, entries)
    local key = score_get_leaderboard_local_save_key(score_state)
    local ok = pcall(sys.save, key, { entries = entries })
    if not ok then
        print("SCORE | failed to persist local leaderboard entries.")
    end
end

score_append_local_leaderboard_entry = function(self, score_state, payload)
    if not self or type(payload) ~= "table" then
        return
    end
    local entries = score_load_local_leaderboard_entries(self, score_state)
    entries[#entries + 1] = {
        match_id = tostring(payload.match_id or ""),
        score_total = tonumber(payload.score_total or 0) or 0,
        mission_type = tostring(payload.mission_type or ""),
        result = tostring(payload.result or ""),
        team_display_names = multiplayer_clone_simple_table(payload.team_display_names or {}),
        created_at_ms = get_wall_clock_ms()
    }
    score_sort_leaderboard_entries(entries)
    while #entries > LEADERBOARD_LOCAL_MAX_ENTRIES do
        table.remove(entries)
    end
    score_persist_local_leaderboard_entries(self, score_state, entries)
    if score_state == FLOW_STATE_SCORE_MP then
        self.leaderboard_entries_mp = entries
    else
        self.leaderboard_entries_solo = entries
    end
end

score_try_auto_publish = function(self, score_state)
    local payload = score_build_publish_payload(self, score_state)
    self.flow_score_last_publish_payload = payload
    score_append_local_leaderboard_entry(self, score_state, payload)
    local simulate_failure = tostring((sys.get_config and sys.get_config("leaderboard.simulate_publish_failure")) or "") == "1"
    if simulate_failure then
        self.flow_submit_done = true
        score_enqueue_pending_publish(self, payload, "simulated_failure")
        print("SCORE | auto publish failed (simulated), queued for retry.")
        return
    end
    local is_mp = score_state == FLOW_STATE_SCORE_MP
    if is_mp then
        local is_host = self.mp_state
            and self.mp_state.enabled
            and tostring(self.mp_state.local_player_id or "") == tostring(self.mp_state.host_player_id or "")
        if is_host then
            self.flow_submit_done = true
            self.flow_score_publish_status = "published_host"
            print("SCORE | auto publish attempted (multiplayer host).")
        else
            self.flow_submit_done = true
            self.flow_score_publish_status = "host_only"
            print("SCORE | auto publish handled by host (multiplayer client).")
        end
        return
    end
    self.flow_submit_done = true
    self.flow_score_publish_status = "published_solo"
    print("SCORE | auto publish attempted (solo).")
end

play_alien_death_sfx = function(self, alien_type, world_x, world_y)
    local sfx_key = nil
    if alien_type == ALIEN_TYPE_CANNON then
        sfx_key = "cannonfodder_dies"
    elseif alien_type == ALIEN_TYPE_SPEEDY then
        sfx_key = "speedy_dies"
    elseif alien_type == ALIEN_TYPE_BRUTE then
        sfx_key = "brute_dies"
    elseif alien_type == ALIEN_TYPE_SPITTER then
        sfx_key = "spitter_dies"
    end
    if not sfx_key then
        return
    end
    if world_x ~= nil and world_y ~= nil then
        local played = play_sfx_one_shot_spatial(

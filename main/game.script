    local next_allowed_s = tonumber(self and self.civ_gas_damage_sfx_next_allowed_s or 0) or 0
    if now_s > 0 and now_s < next_allowed_s then
        return
    end
    if self then
        self.civ_gas_damage_sfx_next_allowed_s = now_s + (tonumber(SFX_CIV_GAS_DAMAGE_COOLDOWN_S or 5.0) or 5.0)
    end
    if world_x ~= nil and world_y ~= nil then

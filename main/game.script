HUD_LAYOUT_BASE_ZOOM_IN_BUTTON_Y = ZOOM_IN_BUTTON_Y
HUD_LAYOUT_BASE_ZOOM_OUT_BUTTON_X = ZOOM_OUT_BUTTON_X
HUD_LAYOUT_BASE_ZOOM_OUT_BUTTON_Y = ZOOM_OUT_BUTTON_Y

is_expanded_hud_layout_active = function()
    if IS_HTML5 then
        return false
    end
    local ok_size, win_w, win_h = pcall(window.get_size)
    if not ok_size or not win_w or not win_h or win_w <= 0 or win_h <= 0 then
        return false
    end
    local window_scale = math.min(win_w / SCREEN_WIDTH, win_h / SCREEN_HEIGHT)
    local min_window_scale = tonumber(HUD_EXPANDED_LAYOUT_MIN_WINDOW_SCALE or 2.3) or 2.3
    if INPUT_CALIBRATION_PROFILES_DB and INPUT_CALIBRATION_PROFILES_DB.resolve then
        local info = sys.get_sys_info and sys.get_sys_info() or nil
        local system_name = tostring(info and info.system_name or "")
        local profile = INPUT_CALIBRATION_PROFILES_DB.resolve(system_name, win_w, win_h, window_scale)
        if profile and profile.hud and profile.hud.expanded_min_window_scale ~= nil then
            min_window_scale = tonumber(profile.hud.expanded_min_window_scale) or min_window_scale
        end
    end
    return window_scale >= min_window_scale
end

apply_runtime_hud_layout = function(self)
    local expanded = is_expanded_hud_layout_active()
    local gutter_x = 0
    local gutter_y = 0
    local profile_hud = nil
    local ok_size_for_profile, win_w_for_profile, win_h_for_profile = pcall(window.get_size)
    if ok_size_for_profile and win_w_for_profile and win_h_for_profile and win_w_for_profile > 0 and win_h_for_profile > 0 then
        local scale_for_profile = math.min(win_w_for_profile / SCREEN_WIDTH, win_h_for_profile / SCREEN_HEIGHT)
        if INPUT_CALIBRATION_PROFILES_DB and INPUT_CALIBRATION_PROFILES_DB.resolve then
            local info = sys.get_sys_info and sys.get_sys_info() or nil
            local system_name = tostring(info and info.system_name or "")
            local profile_for_hud = INPUT_CALIBRATION_PROFILES_DB.resolve(system_name, win_w_for_profile, win_h_for_profile, scale_for_profile)
            if profile_for_hud and profile_for_hud.hud then
                profile_hud = profile_for_hud.hud
            end
        end
    end
    local function clamp_center_x(value, half_span)
        if expanded and HUD_EXPANDED_BYPASS_CLAMP == true then
            return value
        end
        local safe = tonumber(HUD_EXPANDED_SAFE_EDGE_MARGIN or 20) or 20
        local min_c = (-gutter_x) + safe + half_span
        local max_c = (SCREEN_WIDTH + gutter_x) - safe - half_span
        return math.max(min_c, math.min(max_c, value))
    end
    local function clamp_center_y(value, half_span)
        if expanded and HUD_EXPANDED_BYPASS_CLAMP == true then
            return value
        end
        local safe = tonumber(HUD_EXPANDED_SAFE_EDGE_MARGIN or 20) or 20
        local min_c = (-gutter_y) + safe + half_span
        local max_c = (SCREEN_HEIGHT + gutter_y) - safe - half_span
        return math.max(min_c, math.min(max_c, value))
    end
    if expanded then
        local ok_size, win_w, win_h = pcall(window.get_size)
        if ok_size and win_w and win_h and win_w > 0 and win_h > 0 then
            local scale = math.min(win_w / SCREEN_WIDTH, win_h / SCREEN_HEIGHT)
            if scale and scale > 0 then
                gutter_x = math.max(0, (win_w - (SCREEN_WIDTH * scale)) * 0.5 / scale)
                gutter_y = math.max(0, (win_h - (SCREEN_HEIGHT * scale)) * 0.5 / scale)
            end
        end
        local edge_margin_x = tonumber(HUD_EXPANDED_TARGET_EDGE_MARGIN_X or -100) or -100
        local edge_margin_y = tonumber(HUD_EXPANDED_TARGET_EDGE_MARGIN_Y or -100) or -100
        local left_edge_x = (-gutter_x) + edge_margin_x
        local right_edge_x = (SCREEN_WIDTH + gutter_x) - edge_margin_x
        local bottom_edge_y = (-gutter_y) + edge_margin_y
        local top_edge_y = (SCREEN_HEIGHT + gutter_y) - edge_margin_y
        UI_PANEL_X = clamp_center_x(left_edge_x + (UI_PANEL_W * 0.5), UI_PANEL_W * 0.5)
        UI_PANEL_Y = clamp_center_y(HUD_LAYOUT_BASE_UI_PANEL_Y, UI_PANEL_H * 0.5)
        HUMAN_PORTRAIT_START_X = clamp_center_x(right_edge_x - (HUMAN_PORTRAIT_HIT_W * 0.5), HUMAN_PORTRAIT_HIT_W * 0.5)
        HUMAN_PORTRAIT_START_Y = HUD_LAYOUT_BASE_HUMAN_PORTRAIT_START_Y
        NEW_TURN_BUTTON_X = clamp_center_x(left_edge_x + (NEW_TURN_BUTTON_W * 0.5), NEW_TURN_BUTTON_W * 0.5)
        NEW_TURN_BUTTON_Y = clamp_center_y(bottom_edge_y + (NEW_TURN_BUTTON_H * 0.5), NEW_TURN_BUTTON_H * 0.5)
        LAUNCH_BUTTON_X = clamp_center_x(right_edge_x - (LAUNCH_BUTTON_W * 0.5), LAUNCH_BUTTON_W * 0.5)
        LAUNCH_BUTTON_Y = clamp_center_y(bottom_edge_y + (LAUNCH_BUTTON_H * 0.5), LAUNCH_BUTTON_H * 0.5)
        EXIT_BUTTON_X = clamp_center_x(left_edge_x + (EXIT_BUTTON_W * 0.5), EXIT_BUTTON_W * 0.5)
        EXIT_BUTTON_Y = clamp_center_y(top_edge_y - (EXIT_BUTTON_H * 0.5), EXIT_BUTTON_H * 0.5)
        SCORE_HUD_CENTER_X = SCREEN_WIDTH * 0.5
        SCORE_HUD_Y = clamp_center_y(top_edge_y - (SCORE_HUD_DIGIT_DRAW_H * 0.5), SCORE_HUD_DIGIT_DRAW_H * 0.5)
        MP_LAG_SIM_BUTTON_X = clamp_center_x((EXIT_BUTTON_X + SCORE_HUD_CENTER_X) * 0.5, MP_LAG_SIM_BUTTON_W * 0.5)
        MP_LAG_SIM_BUTTON_Y = EXIT_BUTTON_Y
        MP_BUILD_HUD_Y = clamp_center_y(top_edge_y - (MP_BUILD_DIGIT_DRAW_H * 0.5), MP_BUILD_DIGIT_DRAW_H * 0.5)
        MP_BUILD_HUD_RIGHT_X = clamp_center_x(right_edge_x - (MP_BUILD_DIGIT_DRAW_W * 0.5), MP_BUILD_DIGIT_DRAW_W * 0.5)
        ZOOM_IN_BUTTON_X = clamp_center_x(right_edge_x - (ZOOM_IN_BUTTON_W * 0.5), ZOOM_IN_BUTTON_W * 0.5)
        ZOOM_IN_BUTTON_Y = HUD_LAYOUT_BASE_ZOOM_IN_BUTTON_Y
        ZOOM_OUT_BUTTON_X = clamp_center_x(right_edge_x - (ZOOM_OUT_BUTTON_W * 0.5), ZOOM_OUT_BUTTON_W * 0.5)
        ZOOM_OUT_BUTTON_Y = HUD_LAYOUT_BASE_ZOOM_OUT_BUTTON_Y
    else
        UI_PANEL_X = HUD_LAYOUT_BASE_UI_PANEL_X
        UI_PANEL_Y = HUD_LAYOUT_BASE_UI_PANEL_Y
        HUMAN_PORTRAIT_START_X = HUD_LAYOUT_BASE_HUMAN_PORTRAIT_START_X + (tonumber(HUMAN_PORTRAIT_WINDOWED_X_OFFSET or -50) or -50)
        HUMAN_PORTRAIT_START_Y = HUD_LAYOUT_BASE_HUMAN_PORTRAIT_START_Y
        NEW_TURN_BUTTON_X = HUD_LAYOUT_BASE_NEW_TURN_BUTTON_X
        NEW_TURN_BUTTON_Y = HUD_LAYOUT_BASE_NEW_TURN_BUTTON_Y
        LAUNCH_BUTTON_X = HUD_LAYOUT_BASE_LAUNCH_BUTTON_X
        LAUNCH_BUTTON_Y = HUD_LAYOUT_BASE_LAUNCH_BUTTON_Y
        EXIT_BUTTON_X = HUD_LAYOUT_BASE_EXIT_BUTTON_X
        EXIT_BUTTON_Y = HUD_LAYOUT_BASE_EXIT_BUTTON_Y
        SCORE_HUD_CENTER_X = HUD_LAYOUT_BASE_SCORE_HUD_CENTER_X
        SCORE_HUD_Y = HUD_LAYOUT_BASE_SCORE_HUD_Y
        MP_LAG_SIM_BUTTON_X = HUD_LAYOUT_BASE_MP_LAG_SIM_BUTTON_X
        MP_LAG_SIM_BUTTON_Y = HUD_LAYOUT_BASE_MP_LAG_SIM_BUTTON_Y
        MP_BUILD_HUD_RIGHT_X = HUD_LAYOUT_BASE_MP_BUILD_HUD_RIGHT_X
        MP_BUILD_HUD_Y = HUD_LAYOUT_BASE_MP_BUILD_HUD_Y
        ZOOM_IN_BUTTON_X = HUD_LAYOUT_BASE_ZOOM_IN_BUTTON_X
        ZOOM_IN_BUTTON_Y = HUD_LAYOUT_BASE_ZOOM_IN_BUTTON_Y
        ZOOM_OUT_BUTTON_X = HUD_LAYOUT_BASE_ZOOM_OUT_BUTTON_X
        ZOOM_OUT_BUTTON_Y = HUD_LAYOUT_BASE_ZOOM_OUT_BUTTON_Y
    end
    local apply_profile_hud_offsets = (self.game_flow_state or FLOW_STATE_GAME) == FLOW_STATE_GAME
    if apply_profile_hud_offsets and profile_hud then
        if profile_hud.portrait_dx then
            HUMAN_PORTRAIT_START_X = HUMAN_PORTRAIT_START_X + (tonumber(profile_hud.portrait_dx) or 0)
        end
        if profile_hud.portrait_dy then
            HUMAN_PORTRAIT_START_Y = HUMAN_PORTRAIT_START_Y + (tonumber(profile_hud.portrait_dy) or 0)
        end
        if profile_hud.human_ui_dx then
            UI_PANEL_X = UI_PANEL_X + (tonumber(profile_hud.human_ui_dx) or 0)
        end
        if profile_hud.human_ui_dy then
            UI_PANEL_Y = UI_PANEL_Y + (tonumber(profile_hud.human_ui_dy) or 0)
        end
        if profile_hud.left_cluster_dx then
            local dx = tonumber(profile_hud.left_cluster_dx) or 0
            NEW_TURN_BUTTON_X = NEW_TURN_BUTTON_X + dx
            AESTHETIC_BUTTON_X = AESTHETIC_BUTTON_X + dx
        end
        if profile_hud.left_cluster_dy then
            local dy = tonumber(profile_hud.left_cluster_dy) or 0
            NEW_TURN_BUTTON_Y = NEW_TURN_BUTTON_Y + dy
            AESTHETIC_BUTTON_Y = AESTHETIC_BUTTON_Y + dy
        end
        if profile_hud.right_cluster_dx then
            local dx = tonumber(profile_hud.right_cluster_dx) or 0
            LAUNCH_BUTTON_X = LAUNCH_BUTTON_X + dx
            OBJECTIVE_BUTTON_X = OBJECTIVE_BUTTON_X + dx
        end
        if profile_hud.right_cluster_dy then
            local dy = tonumber(profile_hud.right_cluster_dy) or 0
            LAUNCH_BUTTON_Y = LAUNCH_BUTTON_Y + dy
            OBJECTIVE_BUTTON_Y = OBJECTIVE_BUTTON_Y + dy
        end
        if profile_hud.exit_dx then
            EXIT_BUTTON_X = EXIT_BUTTON_X + (tonumber(profile_hud.exit_dx) or 0)
        end
        if profile_hud.exit_dy then
            EXIT_BUTTON_Y = EXIT_BUTTON_Y + (tonumber(profile_hud.exit_dy) or 0)
        end
        if profile_hud.score_dx then
            SCORE_HUD_CENTER_X = SCORE_HUD_CENTER_X + (tonumber(profile_hud.score_dx) or 0)
        end
        if profile_hud.score_dy then
            SCORE_HUD_Y = SCORE_HUD_Y + (tonumber(profile_hud.score_dy) or 0)
        end
        if profile_hud.build_version_dx then
            MP_BUILD_HUD_RIGHT_X = MP_BUILD_HUD_RIGHT_X + (tonumber(profile_hud.build_version_dx) or 0)
        end
        if profile_hud.build_version_dy then
            MP_BUILD_HUD_Y = MP_BUILD_HUD_Y + (tonumber(profile_hud.build_version_dy) or 0)
        end
    end
    COMMS_PANEL_X = UI_PANEL_X + UI_PANEL_W
    COMMS_PANEL_Y = UI_PANEL_Y
    COMMS_TOGGLE_BTN_X = UI_PANEL_X + (UI_PANEL_W * 0.5) - 118
    COMMS_TOGGLE_BTN_Y = UI_PANEL_Y - (UI_PANEL_H * 0.5) + 73
    COMMS_SLOT_START_X = COMMS_PANEL_X - 46
    COMMS_SLOT_START_Y = COMMS_PANEL_Y + 149
    REALTIME_TOGGLE_BUTTON_X = LAUNCH_BUTTON_X
    REALTIME_TOGGLE_BUTTON_Y = LAUNCH_BUTTON_Y + 72
    OBJECTIVE_BUTTON_X = LAUNCH_BUTTON_X - (LAUNCH_BUTTON_W + 16)
    OBJECTIVE_BUTTON_Y = LAUNCH_BUTTON_Y
    AESTHETIC_BUTTON_X = NEW_TURN_BUTTON_X + NEW_TURN_BUTTON_W + 64
    AESTHETIC_BUTTON_Y = NEW_TURN_BUTTON_Y
    MULTIPLAYER_READY_BUTTON_Y = NEW_TURN_BUTTON_Y
    ZOOM_SLIDER_TRACK_X = HUMAN_PORTRAIT_START_X + (tonumber(ZOOM_SLIDER_TRACK_X_OFFSET or 0) or 0)
    if expanded then
        ZOOM_SLIDER_TRACK_TOP_Y = (SCREEN_HEIGHT + gutter_y) - ZOOM_SLIDER_TRACK_TOP_SAFE_MARGIN + (tonumber(ZOOM_SLIDER_TRACK_TOP_Y_OFFSET or 0) or 0)
    else
        ZOOM_SLIDER_TRACK_TOP_Y = SCREEN_HEIGHT - ZOOM_SLIDER_TRACK_TOP_SAFE_MARGIN + (tonumber(ZOOM_SLIDER_TRACK_TOP_Y_OFFSET or 0) or 0)
    end
    ZOOM_SLIDER_TRACK_BOTTOM_Y = ZOOM_SLIDER_TRACK_TOP_Y - ZOOM_SLIDER_TRACK_H
    ZOOM_SLIDER_TRACK_CENTER_Y = ZOOM_SLIDER_TRACK_TOP_Y - (ZOOM_SLIDER_TRACK_H * 0.5)
    PURGE_TIMER_HUD_CENTER_X = SCORE_HUD_CENTER_X
    PURGE_TIMER_HUD_Y = SCORE_HUD_Y - 64
    MP_LAG_SIM_BUTTON_X = (EXIT_BUTTON_X + SCORE_HUD_CENTER_X) * 0.5
    MP_LAG_SIM_BUTTON_Y = EXIT_BUTTON_Y
    if LOOT_RUNTIME and LOOT_RUNTIME.set_ui_screen_offset then
        LOOT_RUNTIME.set_ui_screen_offset(
            (tonumber(UI_PANEL_X or 0) or 0) - (tonumber(HUD_LAYOUT_BASE_UI_PANEL_X or UI_PANEL_X or 0) or 0),
            (tonumber(UI_PANEL_Y or 0) or 0) - (tonumber(HUD_LAYOUT_BASE_UI_PANEL_Y or UI_PANEL_Y or 0) or 0)
        )
    end
end
do
    local project_version_cfg = sys.get_config and sys.get_config("project.version") or nil
    if project_version_cfg == nil or project_version_cfg == "" then
        MP_BUILD_VERSION_NUMBER = "0"
    else
        MP_BUILD_VERSION_NUMBER = tostring(project_version_cfg)
    end
end
get_mp_build_version_digits = function(version_text)
    local parts = {}
    for part in string.gmatch(tostring(version_text or ""), "(%d+)") do
        parts[#parts + 1] = tostring(tonumber(part) or 0)
        if #parts >= 3 then
            break
        end
    end
    while #parts < 3 do
        parts[#parts + 1] = "0"
    end
    return table.concat(parts, ".")
end

get_boardgame_dice_anchor_world = function(self)
    if not self or not self.world_grid then
        return nil, nil
    end
    local min_x = nil
    local max_y = nil
    for _, cell in ipairs(self.world_grid) do
        if cell and cell.tileID and cell.tileID ~= hash("empty") then
            local cx = tonumber(cell.xCell or 0) or 0
            local cy = tonumber(cell.yCell or 0) or 0
            if cx > 0 and cy > 0 then
                if min_x == nil or cx < min_x then
                    min_x = cx
                end
                if max_y == nil or cy > max_y then
                    max_y = cy
                end
            end
        end
    end
    if min_x == nil or max_y == nil then
        return nil, nil
    end
    local anchor_x = min_x - BOARDGAME_BACKDROP_DICE_CELL_OFFSET_LEFT
    local anchor_y = max_y + BOARDGAME_BACKDROP_DICE_CELL_OFFSET_UP
    return coords_to_world_pos(anchor_x, anchor_y)
end

update_human_ap_debug_label = function(self)
    local unit = get_controlled_unit(self)
    if not unit then
        return
    end

    self.last_debug_ap_by_unit = self.last_debug_ap_by_unit or {}
    if self.last_debug_ap_by_unit[unit.id] ~= unit.current_ap then
        local ap_now = math.floor((tonumber(unit.current_ap or 0) or 0) + 0.0001)
        local ap_max = math.floor((tonumber(unit.max_ap or 0) or 0) + 0.0001)
        print(string.format("UI DEBUG | %s AP: %d/%d", unit.display_name, ap_now, ap_max))
        self.last_debug_ap_by_unit[unit.id] = unit.current_ap
    end
end

local function next_turn_reset_human_ap(self)
    score_record_turn_started(self)
    if self.mp_state then
        self.mp_state.pre_attack_sync_pending = false
    end
    if not self.squad_units then
        return
    end

    apply_start_of_turn_environment_damage(self)
    furnace_process_start_of_turn(self)
    if CLEANSE_RUNTIME and CLEANSE_RUNTIME.cleanse_on_new_turn_start then
        local cleanse_should_step = true
        if self.mp_state and self.mp_state.enabled then
            cleanse_should_step = (self.mp_state.local_player_id == self.mp_state.host_player_id)
        end
        if cleanse_should_step then
            CLEANSE_RUNTIME.cleanse_on_new_turn_start(self)
            if self.mp_state
                and self.mp_state.enabled
                and self.mp_state.local_player_id == self.mp_state.host_player_id
                and CLEANSE_RUNTIME.cleanse_build_sync_payload
            then
                multiplayer_transport_broadcast_event(self, "cleanse_state_sync", {
                    turn_id = self.mp_state.turn_id or 1,
                    cleanse = CLEANSE_RUNTIME.cleanse_build_sync_payload(self)
                })
            end
        end
    end
    refresh_cleanse_global_blocked_cells(self)

    for _, unit in pairs(self.squad_units) do
        -- Turn boundaries are authoritative movement boundaries:
        -- clear any stale in-progress motion state before restoring AP.
        unit.is_moving = false
        unit.mp_move_command_pending = nil
        unit.move_path = nil
        unit.move_path_index = 0
        unit.desired_destination_cell_id = nil
        unit.desired_destination_slot_index = nil
        unit.micro_target_x = nil
        unit.micro_target_y = nil
        unit.micro_move_kind = nil
        unit.vertical_prep_done_for_index = nil
        unit.entry_slot_for_index = nil
        unit.entry_slot_index = nil
        unit.last_completed_step_vertical = false
        unit.shadow_motion_offset = nil
        unit.counter_move_total_dist = nil
        if unit and (unit.current_health or 0) > 0 then
            unit.current_ap = get_human_new_turn_ap_refresh(unit)
        else
            unit.current_ap = 0
        end
        clear_counter_shadow_proxy(unit)
        unit.is_selected = false
    end

    -- Future hook: Sarge command points increase by 1/turn (max 10).
    local sarge = self.squad_units.sarge
    if sarge then
        sarge.command_points = math.min(sarge.max_command_points, (sarge.command_points or 0) + 1)
        print("UI DEBUG | Sarge Command Points: " .. sarge.command_points)
    end

    tick_turret_arming_timers(self)
    tick_dna_progress_for_new_human_turn(self)
    multiplayer_on_turn_advanced(self)
    if self.mp_state and self.mp_state.enabled then
        self.mp_state.debug_active_player_id = self.mp_state.local_player_id or self.mp_state.host_player_id
        multiplayer_enforce_controlled_unit(self, true)
        print(string.format("MP DEBUG | acting_as=%s", tostring(self.mp_state.debug_active_player_id or "p1")))
    end
    update_human_visual_state(self)
    update_human_ap_debug_label(self)
    print("Next turn: squad AP restored")
end

local function enforce_tutorial_infinite_ap(self)
    if not (self and tutorial_rules_locked and tutorial_rules_locked(self) and self.squad_units) then
        return
    end
    for _, unit in pairs(self.squad_units) do
        if unit then
            if (unit.current_health or 0) > 0 then
                unit.current_ap = get_human_ap_refresh_cap(unit)
            else
                unit.current_ap = 0
            end
        end
    end
end

local function enforce_realtime_ap_regen(self, dt)
    if not (self and self.squad_units) then
        return
    end
    if not realtime_mp_host_can_simulate(self) then
        return
    end
    if tutorial_rules_locked and tutorial_rules_locked(self) then
        return
    end
    if (self.game_flow_state or FLOW_STATE_GAME) ~= FLOW_STATE_GAME then
        return
    end
    local regen_rate = tonumber(self.realtime_ap_regen_per_second or 0) or 0
    if regen_rate <= 0 then
        return
    end
    for _, unit in pairs(self.squad_units) do
        if unit then
            if (unit.current_health or 0) > 0 then
                local cap = get_human_ap_refresh_cap(unit)
                local current_ap = tonumber(unit.current_ap or 0) or 0
                if current_ap < cap then
                    unit.realtime_ap_regen_accum = (tonumber(unit.realtime_ap_regen_accum or 0) or 0) + (dt * regen_rate)
                    local grant = math.floor(unit.realtime_ap_regen_accum)
                    if grant > 0 then
                        unit.current_ap = math.min(cap, current_ap + grant)
                        unit.realtime_ap_regen_accum = unit.realtime_ap_regen_accum - grant
                    end
                else
                    unit.realtime_ap_regen_accum = 0
                end
            else
                unit.current_ap = 0
                unit.realtime_ap_regen_accum = 0
            end
        end
    end
end

local function process_realtime_world_ticks(self, dt)
    if not self then
        return
    end
    if not realtime_mp_host_can_simulate(self) then
        return
    end
    if tutorial_rules_locked and tutorial_rules_locked(self) then
        return
    end
    if (self.game_flow_state or FLOW_STATE_GAME) ~= FLOW_STATE_GAME then
        return
    end
    self.realtime_alien_tick_accum = (tonumber(self.realtime_alien_tick_accum or 0) or 0) + dt
    self.realtime_civilian_tick_accum = (tonumber(self.realtime_civilian_tick_accum or 0) or 0) + dt
    self.realtime_blip_spawn_accum = (tonumber(self.realtime_blip_spawn_accum or 0) or 0) + dt
    local alien_hz = tonumber(self.realtime_alien_step_hz or 2.0) or 2.0
    local civilian_hz = tonumber(self.realtime_civilian_step_hz or 1.0) or 1.0
    local blip_spawn_interval_s = tonumber(self.realtime_blip_spawn_interval_s or 8.0) or 8.0
    if alien_hz <= 0 then
        alien_hz = 2.0
    end
    if civilian_hz <= 0 then
        civilian_hz = 1.0
    end
    if blip_spawn_interval_s <= 0 then
        blip_spawn_interval_s = 8.0
    end
    local alien_interval = 1.0 / alien_hz
    local civilian_interval = 1.0 / civilian_hz
    local sim_busy = self.alien_turn_active
        or self.pending_spitter_attack_phase
        or self.pending_melee_attack_phase
        or any_alien_is_moving(self)
        or any_civilian_is_moving(self)
    if not sim_busy and self.realtime_civilian_tick_accum >= civilian_interval then
        self.realtime_civilian_tick_accum = self.realtime_civilian_tick_accum - civilian_interval
        if LOOT_RUNTIME.process_factory_turn then
            LOOT_RUNTIME.process_factory_turn(self)
        end
        process_civilian_turn(self)
    end
    sim_busy = self.alien_turn_active
        or self.pending_spitter_attack_phase
        or self.pending_melee_attack_phase
        or any_alien_is_moving(self)
        or any_civilian_is_moving(self)
    if not sim_busy and self.realtime_blip_spawn_accum >= blip_spawn_interval_s then
        self.realtime_blip_spawn_accum = self.realtime_blip_spawn_accum - blip_spawn_interval_s
        spawn_blip_wave_for_pressure(self, "Realtime event")
    end
    sim_busy = self.alien_turn_active
        or self.pending_spitter_attack_phase
        or self.pending_melee_attack_phase
        or any_alien_is_moving(self)
        or any_civilian_is_moving(self)
    if not sim_busy and self.realtime_alien_tick_accum >= alien_interval then
        self.realtime_alien_tick_accum = self.realtime_alien_tick_accum - alien_interval
        process_alien_turn(self)
    end
end

local function log_realtime_tuning(self)
    print(string.format(
        "RT TUNE | spawn_interval=%.2fs blip_speed=%.2f alien_speed=%.2f alien_step_hz=%.2f",
        tonumber(self.realtime_blip_spawn_interval_s or 0) or 0,
        tonumber(self.realtime_blip_move_speed_multiplier or 0) or 0,
        tonumber(self.realtime_alien_move_speed_multiplier or 0) or 0,
        tonumber(self.realtime_alien_step_hz or 0) or 0
    ))
end

local function get_human_world_pos_for_cell(cell)
    local x, y = coords_to_world_pos(cell.xCell, cell.yCell)
    -- Keep feet near the floor: 10px above each cell's bottom boundary.
    y = y - (CELL_HEIGHT * 0.5) + HUMAN_FLOOR_OFFSET_FROM_CELL_BOTTOM
    return x, y
end

local function get_unit_world_pos_in_cell(self, unit, cell_id)
    local cell = self.world_grid[cell_id]
    local base_x, base_y = get_human_world_pos_for_cell(cell)
    local slot_index = ensure_cell_slot_assignment(self, unit, cell_id)
    local slot_offset = CELL_SLOT_OFFSETS_X[slot_index] or 0
    local x = base_x + (slot_offset * HUMAN_STACK_SPACING_X)
    x = clamp_world_x_to_cell(cell, x)
    return x, base_y
end

local function refresh_unit_positions_in_cell(self, cell_id, skip_moving_units)
    if not cell_id then
        return
    end
    local units_in_cell = get_units_on_cell(self, cell_id)
    sort_units_by_spawn_order(units_in_cell)
    for _, unit in ipairs(units_in_cell) do
        if unit.go_path and not (skip_moving_units and unit.is_moving == true) then
            local x, y = get_unit_world_pos_in_cell(self, unit, cell_id)
            go.set_position(vmath.vector3(x, y, 0.5), unit.go_path)
        end
    end
end

local function move_human_to_cell(self, unit, cell_id, assign_slot)
    if not unit then
        return
    end
    if assign_slot == nil then
        assign_slot = true
    end

    local old_cell_id = unit.cell_id
    clear_cell_slot_assignment(self, unit, old_cell_id)
    if old_cell_id and self.world_grid[old_cell_id] and not cell_has_any_unit_except(self, old_cell_id, unit.id) then
        self.world_grid[old_cell_id].isOccupied = hash("empty")
    end

    unit.cell_id = cell_id
    self.world_grid[cell_id].isOccupied = unit.occupancy_hash
    if assign_slot == true then
        ensure_cell_slot_assignment(self, unit, cell_id)
        if unit.forced_slot_index and self.cell_slot_assignments and self.cell_slot_assignments[cell_id] then
            self.cell_slot_assignments[cell_id][unit.id] = unit.forced_slot_index
            unit.forced_slot_index = nil
        end
    elseif self.cell_slot_assignments and self.cell_slot_assignments[cell_id] then
        self.cell_slot_assignments[cell_id][unit.id] = nil
    end

    refresh_unit_positions_in_cell(self, old_cell_id, true)
    refresh_unit_positions_in_cell(self, cell_id, true)
end

function spawn_human_unit(self)
    if not self.squad_units then
        print("No squad units available for spawn.")
        return
    end

    local spawn_cells = {}
    local selected_level = self.level_library and self.level_library[self.current_level_index or 1] or nil
    local level_loadouts = (type(selected_level) == "table") and rawget(selected_level, "unit_loadouts") or nil
    local function clone_string_list(src)
        local out = {}
        if type(src) ~= "table" then
            return out
        end
        for i = 1, #src do
            if type(src[i]) == "string" then
                out[#out + 1] = src[i]
            end
        end
        return out
    end
    local function normalize_equipment(loadout_entry)
        local equipment = create_empty_equipment()
        local equipped = loadout_entry and loadout_entry.starting_equipped_buffs
        if type(equipped) == "table" then
            for _, slot_name in ipairs(BUFF_SLOT_ORDER) do
                local item_type = equipped[slot_name]
                if type(item_type) == "string" then
                    equipment[slot_name] = item_type
                end
            end
        end
        return equipment
    end
    local leftmost_tile = nil
    local entry_tile = nil
    local configured_spawn_tile = (type(selected_level) == "table") and rawget(selected_level, "spawn_tile") or nil
    local configured_spawn_cell = tonumber((type(selected_level) == "table") and (rawget(selected_level, "spawn_cell") or rawget(selected_level, "spawn_local_cell")) or nil)
    local configured_spawn_tile_placement = nil
    if selected_level then
        for _, placement in ipairs(selected_level) do
            if (not entry_tile) and placement.tile == "entry" then
                entry_tile = placement
            end
            if (not configured_spawn_tile_placement)
                and configured_spawn_tile
                and placement.tile == configured_spawn_tile
            then
                configured_spawn_tile_placement = placement
            end
            if (not leftmost_tile)
                or placement.x < leftmost_tile.x
                or (placement.x == leftmost_tile.x and placement.y < leftmost_tile.y)
            then
                leftmost_tile = placement
            end
        end
    end

    local configured_spawn_cell_id = nil
    if configured_spawn_tile_placement and configured_spawn_cell and configured_spawn_cell >= 1 and configured_spawn_cell <= 9 then
        local local_x = (configured_spawn_cell - 1) % 3
        local local_y = math.floor((configured_spawn_cell - 1) / 3)
        local cell_x = configured_spawn_tile_placement.x - 1 + local_x
        local cell_y = configured_spawn_tile_placement.y - 1 + local_y
        configured_spawn_cell_id = coords_to_id(cell_x, cell_y)
    end
    local entry_spawn_cell_id = nil
    if entry_tile then
        entry_spawn_cell_id = coords_to_id(entry_tile.x + 1, entry_tile.y)
    end
    local leftmost_spawn_cell_id = nil
    if leftmost_tile then
        leftmost_spawn_cell_id = coords_to_id(leftmost_tile.x, leftmost_tile.y)
    end
    if configured_spawn_cell_id and is_enterable_cell(self.world_grid, configured_spawn_cell_id, false) then
        for i = 1, 4 do
            spawn_cells[i] = configured_spawn_cell_id
        end
    elseif entry_spawn_cell_id and is_enterable_cell(self.world_grid, entry_spawn_cell_id, false) then
        for i = 1, 4 do
            spawn_cells[i] = entry_spawn_cell_id
        end
    elseif leftmost_spawn_cell_id and is_enterable_cell(self.world_grid, leftmost_spawn_cell_id, false) then
        for i = 1, 4 do
            spawn_cells[i] = leftmost_spawn_cell_id
        end
    else
        for cell_id, _cell in ipairs(self.world_grid) do
            if is_enterable_cell(self.world_grid, cell_id, false) then
                table.insert(spawn_cells, cell_id)
            end
        end
        if #spawn_cells < 4 then
            print("Not enough walkable cells to spawn the full squad.")
            return
        end
    end

    self.cell_slot_assignments = {}

    local spawn_order = get_spawn_order_unit_id_list()
    for i, unit_id in ipairs(spawn_order) do
        local unit = self.squad_units[unit_id]
        if unit then
            unit.cell_id = nil
            unit.is_selected = false
            unit.is_moving = false
            unit.move_path = nil
            unit.move_path_index = 0
            unit.anim_phase = 0
            unit.shadow_motion_offset = nil
            unit.current_ap = unit.max_ap
            local unit_loadout = (type(level_loadouts) == "table") and level_loadouts[unit.id] or nil
            if type(unit_loadout) == "table" and unit_loadout.starting_backpack_items ~= nil then
                unit.backpack_items = clone_string_list(unit_loadout.starting_backpack_items)
                unit.backpack_used = #unit.backpack_items
            else
                if unit.class_id == UNIT_CLASS_TECHIE then
                    unit.backpack_items = { "power" }
                    unit.backpack_used = 1
                else
                    unit.backpack_items = {}
                    unit.backpack_used = 0
                end
            end
            unit.equipment = normalize_equipment(unit_loadout)
            unit.carrying_corpse_id = nil
            unit.death_drop_done = false

            move_human_to_cell(self, unit, spawn_cells[i])
            set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
            if unit.shadow_path then
                go.set(unit.shadow_path, "tint", vmath.vector4(1, 1, 1, 0.5))
            end
            print(unit.display_name .. " spawned on cell: " .. spawn_cells[i])
        end
    end

    local function any_unit_has_nightvision_equipped()
        for _, unit in pairs(self.squad_units or {}) do
            if unit_has_equipped_buff_kind(unit, "nightvision_goggles") then
                return true
            end
        end
        return false
    end

    if not any_unit_has_nightvision_equipped() then
        local sarge = self.squad_units and self.squad_units.sarge or nil
        if sarge then
            sarge.equipment = sarge.equipment or create_empty_equipment()
            local displaced = sarge.equipment.top
            sarge.equipment.top = "buff_night_vision"
            if displaced and displaced ~= "buff_night_vision" then
                sarge.backpack_items = sarge.backpack_items or {}
                local cap = tonumber(sarge.backpack_slots or 12) or 12
                if #sarge.backpack_items < cap then
                    table.insert(sarge.backpack_items, displaced)
                else
                    print(string.format("Nightvision fallback displaced '%s' from Sarge but backpack was full; item dropped.", tostring(displaced)))
                end
                sarge.backpack_used = #sarge.backpack_items
            end
            print("Nightvision fallback: equipped Sarge with buff_night_vision to avoid unpowered soft-lock.")
        end
    end

    update_human_visual_state(self)
    apply_human_aesthetic_animations(self)
    update_human_ap_debug_label(self)
end

local function begin_human_path_move(self, path, destination_cell_id, destination_slot_index)
    local unit = get_controlled_unit(self)
    if not unit then
        return
    end
    if not (unit and (unit.current_health or 0) > 0) then
        print(unit.display_name .. " is dead and cannot move.")
        return
    end

    if not path or #path < 2 then
        unit.is_moving = false
        unit.move_path = nil
        unit.move_path_index = 0
        unit.desired_destination_cell_id = nil
        unit.desired_destination_slot_index = nil
        return
    end

    unit.is_moving = true
    unit.move_path = path
    unit.move_path_index = 2 -- first element is current cell
    unit.anim_phase = 0
    unit.shadow_motion_offset = nil
    unit.micro_target_x = nil
    unit.micro_target_y = nil
    unit.micro_move_kind = nil
    unit.vertical_prep_done_for_index = nil
    unit.entry_slot_for_index = nil
    unit.entry_slot_index = nil
    unit.last_completed_step_vertical = false
    unit.counter_move_total_dist = nil
    unit.desired_destination_cell_id = destination_cell_id or path[#path]
    unit.desired_destination_slot_index = destination_slot_index
end

begin_human_path_move_for_unit = function(self, unit, path, destination_cell_id, destination_slot_index)
    if not unit then
        return
    end
    local previous_controlled = self.controlled_unit_id
    self.controlled_unit_id = unit.id
    begin_human_path_move(self, path, destination_cell_id, destination_slot_index)
    self.controlled_unit_id = previous_controlled
end

begin_settle_to_assigned_slot = function(self, unit)
    if not (self and unit and unit.go_path and unit.cell_id and self.world_grid and self.world_grid[unit.cell_id]) then
        return false
    end
    ensure_cell_slot_assignment(self, unit, unit.cell_id)
    local settle_x, settle_y = get_unit_world_pos_in_cell(self, unit, unit.cell_id)
    local pos = go.get_position(unit.go_path)
    local dx = settle_x - pos.x
    local dy = settle_y - pos.y
    if (dx * dx + dy * dy) <= 0.25 then
        return false
    end
    unit.micro_target_x = settle_x
    unit.micro_target_y = settle_y
    unit.micro_move_kind = "settle_end"
    unit.shadow_motion_offset = nil
    unit.counter_move_total_dist = nil
    return true
end

get_alien_turn_overlay_scale_multiplier = function()
    if not is_expanded_hud_layout_active() then
        return 1
    end
    local ok_size, win_w, win_h = pcall(window.get_size)
    if not ok_size or not win_w or not win_h then
        return 1.5
    end
    local sx = (tonumber(win_w or SCREEN_WIDTH) or SCREEN_WIDTH) / SCREEN_WIDTH
    local sy = (tonumber(win_h or SCREEN_HEIGHT) or SCREEN_HEIGHT) / SCREEN_HEIGHT
    return math.max(1, math.min(1.8, math.max(sx, sy) * 0.935))
end

local function update_single_unit_movement(self, unit, dt)
    if not unit or not unit.is_moving or not unit.move_path then
        if unit then
            update_vertical_move_sfx_for_unit(self, unit, false)
            update_horizontal_move_sfx_for_actor(self, unit.id, false)
        end
        return
    end
    if not (unit and (unit.current_health or 0) > 0) then
        update_vertical_move_sfx_for_unit(self, unit, false)
        update_horizontal_move_sfx_for_actor(self, unit.id, false)
        unit.is_moving = false
        unit.move_path = nil
        unit.move_path_index = 0
        unit.desired_destination_cell_id = nil
        unit.desired_destination_slot_index = nil
        unit.micro_target_x = nil
        unit.micro_target_y = nil
        unit.micro_move_kind = nil
        unit.vertical_prep_done_for_index = nil
        unit.entry_slot_for_index = nil
        unit.entry_slot_index = nil
        unit.last_completed_step_vertical = false
        unit.shadow_motion_offset = nil
        set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
        set_unit_rotation_degrees(unit, 0)
        return
    end

    if unit.micro_target_x and unit.micro_target_y then
        local current_pos = go.get_position(unit.go_path)
        local dx = unit.micro_target_x - current_pos.x
        local dy = unit.micro_target_y - current_pos.y
        local is_vertical_now = math.abs(dy) > math.abs(dx) and math.abs(dy) > 0.01
        local is_horizontal_now = math.abs(dx) >= math.abs(dy) and math.abs(dx) > 0.01
        update_vertical_move_sfx_for_unit(self, unit, is_vertical_now)
        update_horizontal_move_sfx_for_actor(self, unit.id, is_horizontal_now)
        local distance = math.sqrt(dx * dx + dy * dy)
        local step = HUMAN_MOVE_SPEED * dt
        unit.anim_phase = (unit.anim_phase or 0) + (dt * HUMAN_PINGPONG_SPEED * math.pi * 2)
        local ping = math.sin(unit.anim_phase)
        local scale_x = HUMAN_VISUAL_SCALE
        local scale_y = HUMAN_VISUAL_SCALE
        local profile = get_aesthetic_profile(self)
        local move_z = 0.5
        if profile and profile.counter_token_move_enabled == true then
            move_z = profile.counter_human_move_z or 0.64
        end
        if profile and profile.counter_token_move_enabled == true then
            if not unit.counter_move_total_dist or unit.counter_move_total_dist <= 0 then
                unit.counter_move_total_dist = math.max(distance, 1)
            end
            local progress = 1 - math.max(0, math.min(1, distance / unit.counter_move_total_dist))
            local lift = math.sin(progress * math.pi)
            local move_arc = 4 * progress * (1 - progress)
            local wobble = math.sin((unit.anim_phase or 0) * 2.0 + ((dx < 0) and 1.4 or 0))
            local lift_scale = profile.counter_lift_scale or 0.16
            local wobble_scale = profile.counter_wobble_scale or 0.04
            scale_x = HUMAN_VISUAL_SCALE * (1 + (lift * lift_scale) + (wobble * wobble_scale))
            scale_y = HUMAN_VISUAL_SCALE * (1 + (lift * lift_scale) - (wobble * wobble_scale * 0.6))
            unit.shadow_motion_offset = get_counter_shadow_offset(profile, move_arc)
        else
            unit.shadow_motion_offset = nil
            if math.abs(dx) >= math.abs(dy) then
                scale_x = HUMAN_VISUAL_SCALE * (1 + HUMAN_PINGPONG_AMPLITUDE * ping)
            else
                scale_y = HUMAN_VISUAL_SCALE * (1 + HUMAN_PINGPONG_AMPLITUDE * ping)
            end
        end
        set_unit_scale(unit, scale_x, scale_y)
        set_unit_rotation_degrees(unit, 0)
        if distance <= step then
            local snap_z = (unit.micro_move_kind == "settle_end") and 0.5 or move_z
            go.set_position(vmath.vector3(unit.micro_target_x, unit.micro_target_y, snap_z), unit.go_path)
            if unit.micro_move_kind == "settle_end" then
                update_vertical_move_sfx_for_unit(self, unit, false)
                update_horizontal_move_sfx_for_actor(self, unit.id, false)
                unit.is_moving = false
                unit.move_path = nil
                unit.move_path_index = 0
                unit.desired_destination_cell_id = nil
                unit.desired_destination_slot_index = nil
                unit.micro_target_x = nil
                unit.micro_target_y = nil
                unit.micro_move_kind = nil
                unit.shadow_motion_offset = nil
                unit.counter_move_total_dist = nil
                set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
                set_unit_rotation_degrees(unit, 0)
                print(unit.display_name .. " move complete on cell: " .. unit.cell_id)
                update_human_visual_state(self)
                return
            end
            unit.micro_target_x = nil
            unit.micro_target_y = nil
            unit.micro_move_kind = nil
            unit.counter_move_total_dist = nil
            update_vertical_move_sfx_for_unit(self, unit, false)
            update_horizontal_move_sfx_for_actor(self, unit.id, false)
            return
        end
        local nx = current_pos.x + (dx / distance) * step
        local ny = current_pos.y + (dy / distance) * step
        go.set_position(vmath.vector3(nx, ny, move_z), unit.go_path)
        return
    end

    local target_cell_id = unit.move_path[unit.move_path_index]
    if not target_cell_id then
        update_vertical_move_sfx_for_unit(self, unit, false)
        update_horizontal_move_sfx_for_actor(self, unit.id, false)
        unit.is_moving = false
        unit.move_path = nil
        unit.move_path_index = 0
        unit.desired_destination_cell_id = nil
        unit.desired_destination_slot_index = nil
        unit.vertical_prep_done_for_index = nil
        unit.entry_slot_for_index = nil
        unit.entry_slot_index = nil
        unit.last_completed_step_vertical = false
        unit.shadow_motion_offset = nil
        set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
        set_unit_rotation_degrees(unit, 0)
        return
    end

    local from_x, from_y = id_to_coords(unit.cell_id)
    local to_x, to_y = id_to_coords(target_cell_id)
    local is_vertical_step = (from_x == to_x) and (from_y ~= to_y)
    local move_profile = get_aesthetic_profile(self)
    local counter_move_enabled = move_profile and move_profile.counter_token_move_enabled == true
    local target_cell = self.world_grid[target_cell_id]
    local owner_cell, door_obj, door_closed = get_edge_door_context(self.world_grid, unit.cell_id, target_cell_id)
    if door_obj and door_closed then
        if not is_door_functional_runtime(self.world_grid, owner_cell, door_obj) then
            update_vertical_move_sfx_for_unit(self, unit, false)
            update_horizontal_move_sfx_for_actor(self, unit.id, false)
            local settled = begin_settle_to_assigned_slot and begin_settle_to_assigned_slot(self, unit)
            if settled then
                unit.desired_destination_cell_id = nil
                unit.desired_destination_slot_index = nil
                unit.vertical_prep_done_for_index = nil
                unit.entry_slot_for_index = nil
                unit.entry_slot_index = nil
                unit.last_completed_step_vertical = false
                set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
                set_unit_rotation_degrees(unit, 0)
                update_human_ap_debug_label(self)
                return
            end
            unit.is_moving = false
            unit.move_path = nil
            unit.move_path_index = 0
            unit.desired_destination_cell_id = nil
            unit.desired_destination_slot_index = nil
            unit.micro_target_x = nil
            unit.micro_target_y = nil
            unit.micro_move_kind = nil
            unit.vertical_prep_done_for_index = nil
            unit.entry_slot_for_index = nil
            unit.entry_slot_index = nil
            unit.last_completed_step_vertical = false
            unit.shadow_motion_offset = nil
            set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
            set_unit_rotation_degrees(unit, 0)
            print(unit.display_name .. " cannot pass: door is not functional.")
            update_human_visual_state(self)
            update_human_ap_debug_label(self)
            return
        end
        local door_ap_cost = get_ap_cost_value("door_toggle", 1)
        if unit.current_ap < door_ap_cost then
            update_vertical_move_sfx_for_unit(self, unit, false)
            update_horizontal_move_sfx_for_actor(self, unit.id, false)
            local settled = begin_settle_to_assigned_slot and begin_settle_to_assigned_slot(self, unit)
            if settled then
                unit.desired_destination_cell_id = nil
                unit.desired_destination_slot_index = nil
                unit.vertical_prep_done_for_index = nil
                unit.entry_slot_for_index = nil
                unit.entry_slot_index = nil
                unit.last_completed_step_vertical = false
                set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
                set_unit_rotation_degrees(unit, 0)
                update_human_ap_debug_label(self)
                return
            end
            unit.is_moving = false
            unit.move_path = nil
            unit.move_path_index = 0
            unit.desired_destination_cell_id = nil
            unit.desired_destination_slot_index = nil
            unit.micro_target_x = nil
            unit.micro_target_y = nil
            unit.micro_move_kind = nil
            unit.vertical_prep_done_for_index = nil
            unit.entry_slot_for_index = nil
            unit.entry_slot_index = nil
            unit.last_completed_step_vertical = false
            unit.shadow_motion_offset = nil
            set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
            set_unit_rotation_degrees(unit, 0)
            if LOOT_RUNTIME and LOOT_RUNTIME.emit_derple_feedback and unit.id then
                LOOT_RUNTIME.emit_derple_feedback(self, unit.id, "NOT_ENOUGH_AP")
            end
            show_advisory(self, ADVISORY_MSG_NO_AP)
            print(unit.display_name .. " cannot pass: no AP to open door.")
            update_human_visual_state(self)
            update_human_ap_debug_label(self)
            return
        end
        door_obj.isOpen = true
        unit.current_ap = math.max(0, unit.current_ap - door_ap_cost)
        if LOOT_RUNTIME and LOOT_RUNTIME.refresh_door_markers then
            LOOT_RUNTIME.refresh_door_markers(self)
        end
        local door_wx, door_wy = coords_to_world_pos(owner_cell.xCell, owner_cell.yCell)
        play_door_toggle_sfx(self, door_wx, door_wy)
    end
    local target_cost = get_step_move_cost(self.world_grid, unit.cell_id, target_cell_id)
    if target_cost > unit.current_ap then
        update_vertical_move_sfx_for_unit(self, unit, false)
        update_horizontal_move_sfx_for_actor(self, unit.id, false)
        local settled = begin_settle_to_assigned_slot and begin_settle_to_assigned_slot(self, unit)
        if settled then
            unit.desired_destination_cell_id = nil
            unit.desired_destination_slot_index = nil
            unit.vertical_prep_done_for_index = nil
            unit.entry_slot_for_index = nil
            unit.entry_slot_index = nil
            unit.last_completed_step_vertical = false
            set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
            set_unit_rotation_degrees(unit, 0)
            update_human_ap_debug_label(self)
            return
        end
        unit.is_moving = false
        unit.move_path = nil
        unit.move_path_index = 0
        unit.desired_destination_cell_id = nil
        unit.desired_destination_slot_index = nil
        unit.micro_target_x = nil
        unit.micro_target_y = nil
        unit.micro_move_kind = nil
        unit.vertical_prep_done_for_index = nil
        unit.entry_slot_for_index = nil
        unit.entry_slot_index = nil
        unit.last_completed_step_vertical = false
        unit.shadow_motion_offset = nil
        set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
        set_unit_rotation_degrees(unit, 0)
        if LOOT_RUNTIME and LOOT_RUNTIME.emit_derple_feedback and unit.id then
            LOOT_RUNTIME.emit_derple_feedback(self, unit.id, "NOT_ENOUGH_AP")
        end
        show_advisory(self, ADVISORY_MSG_NO_AP)
        print(unit.display_name .. " stopped before cell " .. target_cell_id .. " (cost " .. target_cost .. ", AP " .. unit.current_ap .. ")")
        update_human_visual_state(self)
        update_human_ap_debug_label(self)
        return
    end
    if is_vertical_step and (not counter_move_enabled) and unit.vertical_prep_done_for_index ~= unit.move_path_index then
        local current_cell = self.world_grid and self.world_grid[unit.cell_id] or nil
        if current_cell then
            local prep_x, prep_y = get_human_world_pos_for_cell(current_cell)
            local right_slot = #CELL_SLOT_OFFSETS_X
            prep_x = prep_x + ((CELL_SLOT_OFFSETS_X[right_slot] or 0) * HUMAN_STACK_SPACING_X)
            prep_x = clamp_world_x_to_cell(current_cell, prep_x)
            unit.micro_target_x = prep_x
            unit.micro_target_y = prep_y
            unit.micro_move_kind = "prep_vertical"
            unit.vertical_prep_done_for_index = unit.move_path_index
            return
        end
    end

    local target_x, target_y = get_human_world_pos_for_cell(target_cell)
    if is_vertical_step and (not counter_move_enabled) then
        local right_slot = #CELL_SLOT_OFFSETS_X
        target_x = target_x + ((CELL_SLOT_OFFSETS_X[right_slot] or 0) * HUMAN_STACK_SPACING_X)
    end
    target_x = clamp_world_x_to_cell(target_cell, target_x)

    local current_pos = go.get_position(unit.go_path)
    local dx = target_x - current_pos.x
    local dy = target_y - current_pos.y
    update_vertical_move_sfx_for_unit(self, unit, is_vertical_step)
    update_horizontal_move_sfx_for_actor(self, unit.id, not is_vertical_step)
    local distance = math.sqrt(dx * dx + dy * dy)
    local move_speed_mul = get_obstacle_move_speed_multiplier(target_cost)
    local step = (HUMAN_MOVE_SPEED * move_speed_mul) * dt

    unit.anim_phase = (unit.anim_phase or 0) + (dt * HUMAN_PINGPONG_SPEED * math.pi * 2)
    local ping = math.sin(unit.anim_phase)
    local scale_x = HUMAN_VISUAL_SCALE
    local scale_y = HUMAN_VISUAL_SCALE
    local profile = get_aesthetic_profile(self)
    local move_z = 0.5
    if profile and profile.counter_token_move_enabled == true then
        move_z = profile.counter_human_move_z or 0.64
    end
    if profile and profile.counter_token_move_enabled == true then
        if not unit.counter_move_total_dist or unit.counter_move_total_dist <= 0 then
            unit.counter_move_total_dist = math.max(distance, 1)
        end
        local progress = 1 - math.max(0, math.min(1, distance / unit.counter_move_total_dist))
        local lift = math.sin(progress * math.pi)
        local move_arc = 4 * progress * (1 - progress)
        local wobble = math.sin((unit.anim_phase or 0) * 2.0 + ((dx < 0) and 1.4 or 0))
        local lift_scale = profile.counter_lift_scale or 0.16
        local wobble_scale = profile.counter_wobble_scale or 0.04
        scale_x = HUMAN_VISUAL_SCALE * (1 + (lift * lift_scale) + (wobble * wobble_scale))
        scale_y = HUMAN_VISUAL_SCALE * (1 + (lift * lift_scale) - (wobble * wobble_scale * 0.6))
        unit.shadow_motion_offset = get_counter_shadow_offset(profile, move_arc)
    else
        unit.shadow_motion_offset = nil
        if math.abs(dx) >= math.abs(dy) then
            scale_x = HUMAN_VISUAL_SCALE * (1 + HUMAN_PINGPONG_AMPLITUDE * ping)
        else
            scale_y = HUMAN_VISUAL_SCALE * (1 + HUMAN_PINGPONG_AMPLITUDE * ping)
        end
    end
    set_unit_scale(unit, scale_x, scale_y)
    if is_vertical_step and self.aesthetic_mode == AESTHETIC_MODE_COMPUTER then
        local rock = math.sin((unit.anim_phase or 0) * 2.0)
        set_unit_rotation_degrees(unit, HUMAN_VERTICAL_ROCK_DEGREES * rock)
    else
        set_unit_rotation_degrees(unit, 0)
    end

    if distance <= step then
        go.set_position(vmath.vector3(target_x, target_y, 0.5), unit.go_path)
        set_unit_rotation_degrees(unit, 0)
        unit.current_ap = unit.current_ap - target_cost
        if tostring(self.locked_manual_target_unit_id or "") == tostring(unit.id or "") then
            clear_locked_manual_target(self)
        end
        local is_final_step = unit.move_path and (unit.move_path_index >= #unit.move_path)
        if is_final_step
            and unit.desired_destination_slot_index
            and (target_cell_id == unit.desired_destination_cell_id)
        then
            unit.forced_slot_index = math.max(1, math.min(#CELL_SLOT_OFFSETS_X, unit.desired_destination_slot_index))
        else
            unit.forced_slot_index = nil
        end
        local from_cell_id = unit.cell_id
        move_human_to_cell(self, unit, target_cell_id, is_final_step)
        trigger_obstacle_pass_nudge(self, target_cell_id, from_cell_id)
        trigger_unit_tile_bump_sfx(self, "human")
        local moved_cell = self.world_grid and self.world_grid[target_cell_id] or nil
        furnace_resolve_cell_entry(self, target_cell_id, "human_move_step")
        if unit.current_health <= 0 then
            update_human_visual_state(self)
            update_human_ap_debug_label(self)
            return
        end
        local has_fire, has_gas = get_cell_hazard_flags(moved_cell)
        local has_hazmat = unit_has_equipped_buff_kind(unit, "hazmat_suit")
        local step_hazard_damage = ((has_fire or has_gas) and not has_hazmat) and 1 or 0
        if step_hazard_damage > 0 then
            unit.current_health = math.max(0, (unit.current_health or 0) - step_hazard_damage)
            trigger_human_portrait_hit_feedback(self, unit, step_hazard_damage)
            if LOOT_RUNTIME and LOOT_RUNTIME.emit_derple_feedback and unit.id then
                local move_hazard_event = has_fire and "WARNING_HAZARD_FIRE_HP" or "WARNING_HAZARD_GAS_HP"
                LOOT_RUNTIME.emit_derple_feedback(self, unit.id, move_hazard_event)
            end
            print(string.format(
                "MOVE HAZARD | %s took %d damage on cell %d [fire=%s gas=%s] (HP=%d)",
                unit.display_name or tostring(unit.id),
                step_hazard_damage,
                target_cell_id or 0,
                has_fire and "y" or "n",
                has_gas and "y" or "n",
                unit.current_health or 0
            ))
            if unit.current_health <= 0 then
                update_vertical_move_sfx_for_unit(self, unit, false)
                update_horizontal_move_sfx_for_actor(self, unit.id, false)
                unit.is_moving = false
                unit.move_path = nil
                unit.move_path_index = 0
                unit.desired_destination_cell_id = nil
                unit.desired_destination_slot_index = nil
                unit.micro_target_x = nil
                unit.micro_target_y = nil
                unit.micro_move_kind = nil
                unit.vertical_prep_done_for_index = nil
                unit.entry_slot_for_index = nil
                unit.entry_slot_index = nil
                unit.last_completed_step_vertical = false
                unit.shadow_motion_offset = nil
                unit.counter_move_total_dist = nil
                set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
                set_unit_rotation_degrees(unit, 0)
                handle_human_death_loot_drop(self, unit, "environment_hazard")
                update_human_visual_state(self)
                update_human_ap_debug_label(self)
                return
            end
        end
        if is_rescue_entry_victory_cell(self, unit.cell_id) then
            spawn_orange_impact_ring_for_cell(self, unit.cell_id, 0.7)
        end
        unit.entry_slot_for_index = nil
        unit.entry_slot_index = nil
        unit.vertical_prep_done_for_index = nil
        unit.last_completed_step_vertical = (not counter_move_enabled) and is_vertical_step
        unit.counter_move_total_dist = nil
        update_human_ap_debug_label(self)
        unit.move_path_index = unit.move_path_index + 1

        if unit.move_path_index > #unit.move_path then
            unit.desired_destination_cell_id = nil
            unit.desired_destination_slot_index = nil
            local settled = begin_settle_to_assigned_slot and begin_settle_to_assigned_slot(self, unit)
            if settled then
                unit.vertical_prep_done_for_index = nil
                unit.entry_slot_for_index = nil
                unit.entry_slot_index = nil
                unit.last_completed_step_vertical = false
                set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
                set_unit_rotation_degrees(unit, 0)
                update_human_ap_debug_label(self)
                return
            end
            update_vertical_move_sfx_for_unit(self, unit, false)
            update_horizontal_move_sfx_for_actor(self, unit.id, false)
            unit.is_moving = false
            unit.move_path = nil
            unit.move_path_index = 0
            unit.last_completed_step_vertical = false
            unit.shadow_motion_offset = nil
            unit.counter_move_total_dist = nil
            set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
            set_unit_rotation_degrees(unit, 0)
            print(unit.display_name .. " move complete on cell: " .. unit.cell_id)
            update_human_visual_state(self)
        end
    else
        local nx = current_pos.x + (dx / distance) * step
        local ny = current_pos.y + (dy / distance) * step
        go.set_position(vmath.vector3(nx, ny, move_z), unit.go_path)
    end
end

local function update_human_movement(self, dt)
    if not self.squad_units then
        return
    end
    for _, unit in pairs(self.squad_units) do
        update_single_unit_movement(self, unit, dt)
    end
end

local function get_clicked_unit_in_cell(self, cell_id, world_x, world_y)
    local units_in_cell = get_units_on_cell(self, cell_id)
    if #units_in_cell == 0 then
        return nil
    end

    local best_unit = nil
    local best_dist = math.huge
    for _, unit in ipairs(units_in_cell) do
        if unit.go_path and (unit.current_health or 0) > 0 then
            local pos = go.get_position(unit.go_path)
            local dx = pos.x - world_x
            local dy = pos.y - world_y
            local dist = math.sqrt(dx * dx + dy * dy)
            if dist < best_dist then
                best_dist = dist
                best_unit = unit
            end
        end
    end

    if best_dist <= UNIT_CLICK_SELECT_RADIUS then
        return best_unit
    end
    return nil
end

local function get_clicked_alien_in_cell(self, cell_id, world_x, world_y)
    if not self.aliens then
        return nil
    end

    local best_alien = nil
    local best_score = math.huge
    for _, alien in ipairs(self.aliens) do
        if (not alien.is_dead) and alien.cell_id == cell_id then
            local ax = nil
            local ay = nil
            if alien.go_id then
                local pos = go.get_position(alien.go_id)
                if pos then
                    ax = pos.x
                    ay = pos.y
                end
            end
            if (not ax) or (not ay) then
                local cell = self.world_grid and self.world_grid[cell_id] or nil
                if cell then
                    local lane_bias_x = 0
                    local slot_name = tostring(alien.slot_name or "")
                    if slot_name == "left" then
                        lane_bias_x = -20
                    elseif slot_name == "right" then
                        lane_bias_x = 20
                    end
                    ax, ay = coords_to_world_pos(cell.xCell, cell.yCell)
                    ax = clamp_world_x_to_cell(cell, ax + (CELL_WIDTH * 0.25) + lane_bias_x)
                    local position_type = get_alien_effective_position_type(alien)
                    if position_type == ALIEN_TYPE_SPEEDY then
                        ay = ay + 50
                    elseif position_type == ALIEN_TYPE_SPITTER then
                        ay = ay - (CELL_HEIGHT * 0.5) + HUMAN_FLOOR_OFFSET_FROM_CELL_BOTTOM
                    elseif position_type == ALIEN_TYPE_CANNON then
                        ay = ay - (CELL_HEIGHT * 0.5) + HUMAN_FLOOR_OFFSET_FROM_CELL_BOTTOM - 25
                    elseif position_type == ALIEN_TYPE_BRUTE then
                        ay = ay - (CELL_HEIGHT * 0.5) + HUMAN_FLOOR_OFFSET_FROM_CELL_BOTTOM + 35
                    end
                end
            end
            if ax and ay then
                local dx = ax - world_x
                local dy = ay - world_y
                local position_type = get_alien_effective_position_type(alien)
                local click_radius = UNIT_CLICK_SELECT_RADIUS
                if position_type == ALIEN_TYPE_SPEEDY then
                    click_radius = math.max(click_radius, 64)
                elseif position_type == ALIEN_TYPE_SPITTER then
                    click_radius = math.max(click_radius, 60)
                elseif position_type == ALIEN_TYPE_CANNON then
                    click_radius = math.max(click_radius, 50)
                elseif position_type == ALIEN_TYPE_BRUTE then
                    click_radius = math.max(click_radius, 58)
                end
                local score_dy = dy
                if (position_type == ALIEN_TYPE_CANNON or position_type == ALIEN_TYPE_SPITTER or position_type == ALIEN_TYPE_BRUTE)
                    and world_y > ay
                then
                    -- Grounded aliens sit low in the cell; reduce accidental "air-click" selects above them.
                    score_dy = score_dy * 1.45
                end
                local dist = math.sqrt(dx * dx + score_dy * score_dy)
                local score = dist / math.max(1, click_radius)
                if score <= 1 and score < best_score then
                    best_score = score
                    best_alien = alien
                end
            elseif not best_alien then
                best_alien = alien
            end
        end
    end

    return best_alien
end

multiplayer_attempt_manual_shot_on_target = function(self, unit, alien, shot_outcome)
    if not unit then
        return false
    end
    if not (unit and (unit.current_health or 0) > 0) then
        print("Unable to fire: selected unit is dead.")
        return true
    end
    if not alien or alien.is_dead then
        return false
    end

    -- Turn-based boundary gate: in realtime mode we allow responsive human attacks during alien activity.
    local block_for_turn_boundary = self.realtime_rules_enabled ~= true
    if block_for_turn_boundary
        and (any_alien_is_moving(self) or self.pending_spitter_attack_phase or self.pending_melee_attack_phase)
        and (not self.alien_turn_waiting_for_advance)
    then
        print("Unable to fire: alien turn in progress.")
        return true
    end

    if MELEE_RUNTIME.try_manual_human_melee(self, unit, alien) then
        update_human_visual_state(self)
        update_human_ap_debug_label(self)
        return true
    end
    if (tonumber(unit.cell_id or 0) or 0) == (tonumber(alien.cell_id or 0) or 0) then
        -- Same-cell attacks must resolve as melee only; never fall through into ranged AP/ammo spend.
        return false
    end

    local alien_cell = self.world_grid[alien.cell_id]
    if not alien_cell or alien_cell.tileID == hash("empty") then
        print("Unable to fire: target is in VOID.")
        return false
    end

    if not has_unobstructed_human_ranged_los(self.world_grid, unit.cell_id, alien.cell_id) then
        print("Unable to fire: no line of sight.")
        return false
    end

    local shot_ap_cost = get_ap_cost_value("manual_ranged_shot", 1)
    try_realtime_auto_load_ammo_from_backpack(self, unit)
    if unit.current_ap < shot_ap_cost or unit.current_ammo <= 0 then
        print("unable to fire no ammo/ap")
        if (tonumber(unit.current_ammo or 0) or 0) <= 0 then
            show_advisory(self, ADVISORY_MSG_NO_AMMO)
        else
            show_advisory(self, ADVISORY_MSG_NO_AP)
        end
        return false
    end
    if not unit.go_path or not alien.go_id then
        print("Unable to fire: missing shooter/target visual.")
        return false
    end

    unit.current_ap = unit.current_ap - shot_ap_cost
    unit.current_ammo = unit.current_ammo - 1
    local active_light = (alien_cell.isPowered and math.max(0, math.min(3, alien_cell.lightValue or 0))) or 0
    local range_cells = manhattan_distance_by_id(unit.cell_id, alien.cell_id)
    local range_penalty = math.max(0, (range_cells - 1) * 10)
    local role = CLASS_ROLE_HOOKS[unit.class_id]
    local class_bonus = (role and role.ranged_hit_bonus) or 0
    local hit_chance = compute_manual_ranged_hit_chance(self, unit, alien) or 0
    if shot_outcome and shot_outcome.hit_chance ~= nil then
        hit_chance = tonumber(shot_outcome.hit_chance) or hit_chance
    end
    hit_chance = math.max(0, math.min(100, tonumber(hit_chance) or 0))
    print(string.format(
        "RANGED DEBUG | manual | shooter=%s targetAlien=%d range=%d penalty=%d light=%d classBonus=%d chance=%d",
        unit.display_name or "unit",
        alien.id or 0,
        range_cells or 0,
        range_penalty or 0,
        active_light or 0,
        class_bonus or 0,
        hit_chance or 0
    ))
    local roll = math.random(1, 100)
    if shot_outcome and shot_outcome.roll ~= nil then
        roll = math.max(1, math.min(100, tonumber(shot_outcome.roll) or roll))
    end
    local impact_hit = roll <= hit_chance
    if shot_outcome and shot_outcome.impact_hit ~= nil then
        impact_hit = (shot_outcome.impact_hit == true)
    end
    spawn_human_reaction_projectile(self, unit, alien, impact_hit, active_light, hit_chance, roll, "manual")
    clear_ranged_hit_preview(self)

    update_human_visual_state(self)
    update_human_ap_debug_label(self)
    return true
end

multiplayer_resolve_destination_slot = function(self, unit, destination_cell_id, requested_slot_index)
    local destination_cell = self.world_grid and self.world_grid[destination_cell_id] or nil
    if not destination_cell then
        return nil
    end
    local slot_count = #CELL_SLOT_OFFSETS_X
    local requested_slot = math.max(1, math.min(slot_count, math.floor(tonumber(requested_slot_index) or 1)))
    return requested_slot
end

multiplayer_apply_move_unit_event = function(self, payload)
    if not payload then
        return false
    end
    local unit = self.squad_units and self.squad_units[payload.unit_id] or nil
    if not unit then
        return false
    end
    unit.mp_move_command_pending = nil
    if (unit.current_health or 0) <= 0 then
        return false
    end
    local destination_cell_id = tonumber(payload.destination_cell_id)
    if not destination_cell_id then
        return false
    end
    local ap_before = tonumber(payload.ap_before)
    if ap_before then
        -- Host is authoritative for AP in multiplayer; do not clamp to local cap.
        unit.current_ap = math.max(0, math.floor(ap_before + 0.5))
    end
    if unit.is_moving then
        local desired_cell_id = tonumber(unit.desired_destination_cell_id or 0) or 0
        if desired_cell_id == destination_cell_id then
            -- Predicted move already in progress toward same target; treat as applied.
            return true
        end
        -- Authoritative host chose a different destination; clear local predicted path.
        unit.is_moving = false
        unit.move_path = nil
        unit.move_path_index = 0
        unit.desired_destination_cell_id = nil
        unit.desired_destination_slot_index = nil
    end
    local path = nil
    local total_cost = nil
    if type(payload.path) == "table" and #payload.path >= 2 then
        path = multiplayer_clone_simple_table(payload.path)
        if path and path[#path] ~= destination_cell_id then
            path = nil
        end
    end
    if not path and is_walkable_cell(self.world_grid, destination_cell_id) then
        path, total_cost = find_path(
            self.world_grid,
            unit.cell_id,
            destination_cell_id,
            nil,
            MOVEMENT_PROFILE_HUMAN,
            { allow_closed_doors = true }
        )
    end
    if not path then
        -- Last resort: trust host and force a minimal authoritative path.
        path = { unit.cell_id, destination_cell_id }
        total_cost = tonumber(payload.ap_cost) or 0
    end
    if path[1] ~= unit.cell_id then
        local coerced_path = { unit.cell_id }
        for i = 2, #path do
            coerced_path[#coerced_path + 1] = path[i]
        end
        path = coerced_path
    end
    if not total_cost then
        total_cost = tonumber(payload.ap_cost)
    end
    local resolved_slot = multiplayer_resolve_destination_slot(self, unit, destination_cell_id, payload.destination_slot_index)
    if unit.cell_id == destination_cell_id then
        if resolved_slot then
            self.cell_slot_assignments = self.cell_slot_assignments or {}
            self.cell_slot_assignments[destination_cell_id] = self.cell_slot_assignments[destination_cell_id] or {}
            self.cell_slot_assignments[destination_cell_id][unit.id] = resolved_slot
            if unit.go_path then
                local target_x, target_y = get_unit_world_pos_in_cell(self, unit, destination_cell_id)
                local current_pos = go.get_position(unit.go_path)
                local dx = target_x - current_pos.x
                local dy = target_y - current_pos.y
                local distance = math.sqrt(dx * dx + dy * dy)
                if distance > 0.5 then
                    local move_duration = math.max(0.06, distance / HUMAN_MOVE_SPEED)
                    go.cancel_animations(unit.go_path, "position")
                    go.animate(
                        unit.go_path,
                        "position",
                        go.PLAYBACK_ONCE_FORWARD,
                        vmath.vector3(target_x, target_y, 0.5),
                        go.EASING_INOUTSINE,
                        move_duration
                    )
                else
                    go.set_position(vmath.vector3(target_x, target_y, 0.5), unit.go_path)
                end
            end
        end
        local ap_after = tonumber(payload.ap_after)
        if ap_after then
            unit.current_ap = math.max(0, math.floor(ap_after + 0.5))
        end
        return true
    end
    print(unit.display_name .. " route selected (network event):")
    if total_cost then
        print_path_debug(path, total_cost)
    end
    highlight_path(self, path)
    begin_human_path_move_for_unit(self, unit, path, destination_cell_id, resolved_slot)
    return true
end

multiplayer_apply_manual_shot_event = function(self, payload)
    if not payload then
        return false
    end
    local unit = self.squad_units and self.squad_units[payload.unit_id] or nil
    if not unit then
        return false
    end
    local ap_before = tonumber(payload.ap_before)
    local ap_after = tonumber(payload.ap_after)
    local ammo_before = tonumber(payload.ammo_before)
    local ammo_after = tonumber(payload.ammo_after)
    if ap_before then
        unit.current_ap = math.max(0, math.floor(ap_before + 0.5))
    end
    if ammo_before then
        unit.current_ammo = math.max(0, math.floor(ammo_before + 0.5))
    end
    if ap_after then
        unit.current_ap = math.max(0, math.floor(ap_after + 0.5))
    end
    if ammo_after then
        unit.current_ammo = math.max(0, math.floor(ammo_after + 0.5))
    end
    local shot_is_ranged = tonumber(payload.shot_is_ranged or -1) or -1
    if shot_is_ranged == 1 then
        local alien = find_alien_by_id(self, tonumber(payload.alien_id))
        if alien then
            local ok = multiplayer_attempt_manual_shot_on_target(self, unit, alien, payload)
            -- Host payload is authoritative for AP/ammo; preserve it after local FX/sim path.
            if ap_after then
                unit.current_ap = math.max(0, math.floor(ap_after + 0.5))
            end
            if ammo_after then
                unit.current_ammo = math.max(0, math.floor(ammo_after + 0.5))
            end
            update_human_visual_state(self)
            update_human_ap_debug_label(self)
            return ok
        end
        update_human_visual_state(self)
        update_human_ap_debug_label(self)
        return true
    end
    local alien = find_alien_by_id(self, tonumber(payload.alien_id))
    if not alien then
        return false
    end
    local ok = multiplayer_attempt_manual_shot_on_target(self, unit, alien, payload)
    if ap_after then
        unit.current_ap = math.max(0, math.floor(ap_after + 0.5))
    end
    if ammo_after then
        unit.current_ammo = math.max(0, math.floor(ammo_after + 0.5))
    end
    update_human_visual_state(self)
    update_human_ap_debug_label(self)
    return ok
end

multiplayer_apply_comms_command_event = function(self, payload)
    if not payload then
        return false
    end
    local unit_id = payload.unit_id
    local event_type = payload.comms_event_type
    local unit = self.squad_units and self.squad_units[unit_id] or nil
    if not unit or (unit.current_health or 0) <= 0 then
        return false
    end
    if not is_valid_comms_event_type(event_type) then
        return false
    end
    if not (LOOT_RUNTIME and LOOT_RUNTIME.emit_derple_feedback) then
        return false
    end
    return LOOT_RUNTIME.emit_derple_feedback(self, unit_id, event_type) == true
end

multiplayer_clone_flat_table = function(src)
    local out = {}
    if type(src) ~= "table" then
        return out
    end
    for k, v in pairs(src) do
        if type(v) ~= "table" then
            out[k] = v
        else
            local nested = {}
            for nk, nv in pairs(v) do
                if type(nv) ~= "table" then
                    nested[nk] = nv
                end
            end
            out[k] = nested
        end
    end
    return out
end

multiplayer_clone_simple_table = function(src, depth)
    if type(src) ~= "table" then
        return nil
    end
    local max_depth = 5
    local level = depth or 1
    if level > max_depth then
        return {}
    end
    local out = {}
    for k, v in pairs(src) do
        local key_type = type(k)
        if key_type == "string" or key_type == "number" then
            local value_type = type(v)
            if value_type == "table" then
                out[k] = multiplayer_clone_simple_table(v, level + 1)
            elseif value_type == "string" or value_type == "number" or value_type == "boolean" then
                out[k] = v
            end
        end
    end
    return out
end

multiplayer_clone_with_string_keys = function(src, depth)
    if type(src) ~= "table" then
        return nil
    end
    local max_depth = 5
    local level = depth or 1
    if level > max_depth then
        return {}
    end
    local out = {}
    for k, v in pairs(src) do
        local out_key = (type(k) == "number") and tostring(k) or k
        local value_type = type(v)
        if value_type == "table" then
            out[out_key] = multiplayer_clone_with_string_keys(v, level + 1)
        elseif value_type == "string" or value_type == "number" or value_type == "boolean" then
            out[out_key] = v
        end
    end
    return out
end

multiplayer_restore_numeric_top_keys = function(src)
    if type(src) ~= "table" then
        return {}
    end
    local out = {}
    for k, v in pairs(src) do
        local numeric_key = tonumber(k)
        if numeric_key ~= nil then
            out[numeric_key] = v
        else
            out[k] = v
        end
    end
    return out
end

multiplayer_build_snapshot_state = function(self)
    local snapshot = {
        version = 1,
        level_index = self.current_level_index or 1,
        turn_id = (self.mp_state and self.mp_state.turn_id) or 1,
        player_count = (self.mp_state and self.mp_state.player_count) or 4,
        seat_assignments = multiplayer_clone_simple_table(self.mp_state and self.mp_state.seat_assignments or {}),
        required_ready_player_ids = multiplayer_clone_simple_table(self.mp_state and self.mp_state.required_ready_player_ids or {}),
        ready_by_player_id = multiplayer_clone_simple_table(self.mp_state and self.mp_state.ready_by_player_id or {}),
        controlled_unit_id = self.controlled_unit_id,
        cell_slot_assignments = multiplayer_clone_with_string_keys(self.cell_slot_assignments or {}),
        units = {},
        aliens = {},
        next_alien_id = self.next_alien_id or 0,
        civilians = multiplayer_clone_simple_table(self.civilians or {}),
        next_civilian_id = self.next_civilian_id or 0,
        world_cells = {},
        world_item_instances = multiplayer_clone_simple_table(self.world_item_instances or {}),
        next_world_item_id = self.next_world_item_id or 0,
        workshop_states = multiplayer_clone_with_string_keys(self.workshop_states or {}),
        medbay_states = multiplayer_clone_with_string_keys(self.medbay_states or {}),
        exit_objective_state = multiplayer_clone_with_string_keys(self.exit_objective_state or {}),
        dna_analysis_progress = tonumber(self.dna_analysis_progress or 0) or 0,
        dna_analysis_complete = self.dna_analysis_complete == true,
        dna_sample_spawned = self.dna_sample_spawned == true,
        dna_sample_returned = self.dna_sample_returned == true,
        purge_bomb_planted = self.purge_bomb_planted == true,
        purge_timer_started = self.purge_timer_started == true,
        purge_launch_pressed = self.purge_launch_pressed == true,
        purge_time_expired = self.purge_time_expired == true,
        purge_result_locked = self.purge_result_locked == true,
        purge_turns_remaining = tonumber(self.purge_turns_remaining or 0) or 0,
        purge_deadline_epoch_ms = tonumber(self.purge_deadline_epoch_ms or 0) or 0,
        holdout_configured_turns = tonumber(self.holdout_configured_turns or 0) or 0,
        holdout_turns_remaining = tonumber(self.holdout_turns_remaining or 0) or 0,
        holdout_timer_started = self.holdout_timer_started == true,
        holdout_survival_pending = self.holdout_survival_pending == true,
        holdout_result_locked = self.holdout_result_locked == true,
        end_result = tostring(self.end_result or ""),
        end_mission_type = tostring(self.end_mission_type or ""),
        end_outro_sequence_id = tostring(self.end_outro_sequence_id or ""),
        end_reason = tostring(self.end_reason or ""),
        end_session_origin = tostring(self.end_session_origin or ""),
        score_turn_counter = tonumber(self.score_turn_counter or 0) or 0,
        score_state = multiplayer_clone_with_string_keys(self.score_state or {})
    }
    for unit_id, unit in pairs(self.squad_units or {}) do
        local unit_world_x = nil
        local unit_world_y = nil
        if unit and unit.go_path then
            local unit_pos = go.get_position(unit.go_path)
            unit_world_x = unit_pos and unit_pos.x or nil
            unit_world_y = unit_pos and unit_pos.y or nil
        end
        snapshot.units[unit_id] = {
            id = unit.id,
            cell_id = unit.cell_id,
            current_ap = unit.current_ap,
            current_ammo = unit.current_ammo,
            current_health = unit.current_health,
            command_points = unit.command_points,
            backpack_items = multiplayer_clone_simple_table(unit.backpack_items or {}),
            backpack_used = unit.backpack_used,
            carrying_corpse_id = unit.carrying_corpse_id,
            equipment = multiplayer_clone_simple_table(unit.equipment or {}),
            world_x = unit_world_x,
            world_y = unit_world_y
        }
    end
    for _, alien in ipairs(self.aliens or {}) do
        if alien and (not alien.is_dead) then
            local alien_world_x = nil
            local alien_world_y = nil
            if alien.go_id then
                local alien_pos = go.get_position(alien.go_id)
                alien_world_x = alien_pos and alien_pos.x or nil
                alien_world_y = alien_pos and alien_pos.y or nil
            end
            table.insert(snapshot.aliens, {
                id = alien.id,
                type = alien.type,
                cell_id = alien.cell_id,
                slot_name = tostring(alien.slot_name or ensure_alien_slot_name(self, alien, alien.cell_id, false) or "center"),
                ap_max = alien.ap_max,
                turn_ap_remaining = alien.turn_ap_remaining,
                hp_max = alien.hp_max,
                hp_current = alien.hp_current,
                can_traverse_void = alien.can_traverse_void == true,
                has_ranged = alien.has_ranged == true,
                ranged_cells = alien.ranged_cells or 0,
                hidden_reveal_type = alien.hidden_reveal_type,
                world_x = alien_world_x,
                world_y = alien_world_y
            })
        end
    end
    for _, cell in ipairs(self.world_grid or {}) do
        if cell and cell.idNumber then
            local object_states = {}
            local objects = { cell.object1, cell.object2, cell.object3 }
            for slot_idx, obj in ipairs(objects) do
                object_states[tostring(slot_idx)] = {
                    has_object = (obj and obj.name and obj.name ~= hash("empty")) and true or false,
                    is_door = (obj and obj.name == hash("door")) and true or false,
                    object_id = tonumber(obj and obj.objectId or 0) or 0,
                    isOpen = (obj and obj.isOpen == true) and true or false,
                    isFixed = (obj and obj.isFixed == true) and true or false,
                    isWelded = (obj and obj.isWelded == true) and true or false,
                    door_hp = tonumber(obj and obj.door_hp or 0) or 0
                }
            end
            snapshot.world_cells[tostring(cell.idNumber)] = {
                isPowered = cell.isPowered == true,
                lightValue = tonumber(cell.lightValue or 0) or 0,
                has_barricade = cell.has_barricade == true,
                barricade_hp = tonumber(cell.barricade_hp or 0) or 0,
                barricade_anchor_x = tonumber(cell.barricade_anchor_x or 0) or 0,
                barricade_anchor_y = tonumber(cell.barricade_anchor_y or 0) or 0,
                barricade_slot_index = tonumber(cell.barricade_slot_index or 0) or 0,
                object_states = object_states
            }
        end
    end
    return snapshot
end

multiplayer_compute_realtime_snapshot_signature = function(snapshot)
    if type(snapshot) ~= "table" then
        return "0"
    end
    local parts = {}
    local function push(...)
        local n = select("#", ...)
        for i = 1, n do
            parts[#parts + 1] = tostring(select(i, ...))
        end
        parts[#parts + 1] = "|"
    end
    local function round_px(v)
        return math.floor((tonumber(v or 0) or 0) + 0.5)
    end

    push("t", tonumber(snapshot.turn_id or 0) or 0)
    push(
        "p",
        tonumber(snapshot.purge_turns_remaining or 0) or 0,
        snapshot.purge_timer_started == true and 1 or 0
    )
    push(
        "h",
        tonumber(snapshot.holdout_turns_remaining or 0) or 0,
        snapshot.holdout_timer_started == true and 1 or 0,
        snapshot.holdout_survival_pending == true and 1 or 0,
        snapshot.holdout_result_locked == true and 1 or 0
    )
    push("d", tonumber(snapshot.dna_analysis_progress or 0) or 0, snapshot.dna_sample_returned == true and 1 or 0)

    local unit_rows = {}
    for unit_id, unit in pairs(snapshot.units or {}) do
        unit_rows[#unit_rows + 1] = string.format(
            "%s|%d|%d|%d|%d|%d|%d",
            tostring(unit_id),
            tonumber(unit.cell_id or 0) or 0,
            tonumber(unit.current_ap or 0) or 0,
            tonumber(unit.current_health or 0) or 0,
            tonumber(unit.current_ammo or 0) or 0,
            round_px(unit.world_x),
            round_px(unit.world_y)
        )
    end
    table.sort(unit_rows)
    for _, row in ipairs(unit_rows) do
        push("u", row)
    end

    local alien_rows = {}
    for _, alien in ipairs(snapshot.aliens or {}) do
        alien_rows[#alien_rows + 1] = string.format(
            "%d|%s|%d|%s|%d|%d|%d",
            tonumber(alien.id or 0) or 0,
            tostring(alien.type or "_"),
            tonumber(alien.cell_id or 0) or 0,
            tostring(alien.slot_name or "_"),
            tonumber(alien.hp_current or 0) or 0,
            round_px(alien.world_x),
            round_px(alien.world_y)
        )
    end
    table.sort(alien_rows)
    for _, row in ipairs(alien_rows) do
        push("a", row)
    end

    local civilian_rows = {}
    for _, civilian in ipairs(snapshot.civilians or {}) do
        civilian_rows[#civilian_rows + 1] = string.format(
            "%d|%d|%d",
            tonumber(civilian.id or 0) or 0,
            tonumber(civilian.cell_id or 0) or 0,
            tonumber(civilian.current_health or 0) or 0
        )
    end
    table.sort(civilian_rows)
    for _, row in ipairs(civilian_rows) do
        push("c", row)
    end

    local item_rows = {}
    for item_id, item in pairs(snapshot.world_item_instances or {}) do
        item_rows[#item_rows + 1] = string.format(
            "%s|%s|%d|%d|%d",
            tostring(item_id),
            tostring(item and (item.item_type or item.type or "_") or "_"),
            tonumber(item and item.cell_id or 0) or 0,
            round_px(item and item.world_x or 0),
            round_px(item and item.world_y or 0)
        )
    end
    table.sort(item_rows)
    for _, row in ipairs(item_rows) do
        push("wi", row)
    end

    local serial = table.concat(parts)
    local h = 5381
    for i = 1, #serial do
        h = ((h * 33) + string.byte(serial, i)) % 2147483647
    end
    return tostring(h)
end

multiplayer_apply_realtime_snapshot_state = function(self, snapshot)
    if type(snapshot) ~= "table" then
        return false
    end
    if not (self.world_grid and self.squad_units and self.aliens) then
        return false
    end
    if self.mp_state then
        self.mp_state.turn_id = tonumber(snapshot.turn_id or self.mp_state.turn_id or 1) or 1
    end

    self.cell_slot_assignments = multiplayer_restore_numeric_top_keys(
        multiplayer_clone_simple_table(snapshot.cell_slot_assignments or self.cell_slot_assignments or {}) or {}
    )
    for _, cell in ipairs(self.world_grid) do
        if cell then
            cell.isOccupied = hash("empty")
        end
    end
    local decouple_motion = (REALTIME_MP_DECOUPLE_MOVEMENT_FROM_HOST == true)
        and self.mp_state
        and self.mp_state.enabled
        and self.mp_state.local_player_id ~= self.mp_state.host_player_id
        and self.realtime_rules_enabled == true
    for unit_id, unit in pairs(self.squad_units) do
        local unit_snapshot = snapshot.units and snapshot.units[unit_id] or nil
        local decouple_unit_motion = decouple_motion and multiplayer_can_control_unit(self, unit.id)
        if not decouple_unit_motion then
            unit.is_moving = false
            unit.move_path = nil
            unit.move_path_index = 0
            unit.desired_destination_cell_id = nil
            unit.desired_destination_slot_index = nil
            unit.micro_target_x = nil
            unit.micro_target_y = nil
            unit.micro_move_kind = nil
            unit.vertical_prep_done_for_index = nil
            unit.entry_slot_for_index = nil
            unit.entry_slot_index = nil
            unit.last_completed_step_vertical = false
            unit.shadow_motion_offset = nil
            unit.counter_move_total_dist = nil
            set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
            set_unit_rotation_degrees(unit, 0)
        elseif (unit.is_moving ~= true) then
            unit.micro_target_x = nil
            unit.micro_target_y = nil
            unit.micro_move_kind = nil
            unit.vertical_prep_done_for_index = nil
            unit.entry_slot_for_index = nil
            unit.entry_slot_index = nil
            unit.last_completed_step_vertical = false
            unit.shadow_motion_offset = nil
            unit.counter_move_total_dist = nil
            set_unit_scale(unit, HUMAN_VISUAL_SCALE, HUMAN_VISUAL_SCALE)
            set_unit_rotation_degrees(unit, 0)
        end
        if unit_snapshot then
            unit.current_ap = tonumber(unit_snapshot.current_ap or unit.current_ap or unit.max_ap) or unit.max_ap
            unit.current_ammo = tonumber(unit_snapshot.current_ammo or unit.current_ammo or unit.max_ammo) or unit.max_ammo
            unit.current_health = tonumber(unit_snapshot.current_health or unit.current_health or unit.max_health) or unit.max_health
            unit.command_points = tonumber(unit_snapshot.command_points or unit.command_points or 0) or 0
            unit.backpack_items = multiplayer_clone_simple_table(unit_snapshot.backpack_items or {}) or {}
            unit.backpack_used = tonumber(unit_snapshot.backpack_used or #unit.backpack_items) or #unit.backpack_items
            unit.carrying_corpse_id = unit_snapshot.carrying_corpse_id
            unit.equipment = create_empty_equipment()
            local snapshot_equipment = unit_snapshot.equipment or {}
            for _, slot_name in ipairs(BUFF_SLOT_ORDER) do
                local equipped_item = snapshot_equipment[slot_name]
                if type(equipped_item) == "string" then
                    unit.equipment[slot_name] = equipped_item
                end
            end
            unit.cell_id = tonumber(unit_snapshot.cell_id) or unit.cell_id
        end
        if unit.cell_id and self.world_grid[unit.cell_id] and (unit.current_health or 0) > 0 then
            self.world_grid[unit.cell_id].isOccupied = unit.occupancy_hash
            if unit.go_path then
                local tx = tonumber(unit_snapshot and unit_snapshot.world_x or nil)
                local ty = tonumber(unit_snapshot and unit_snapshot.world_y or nil)
                if not (tx and ty) then
                    tx, ty = get_unit_world_pos_in_cell(self, unit, unit.cell_id)
                end
                local pos = go.get_position(unit.go_path)
                local dx = tx - pos.x
                local dy = ty - pos.y
                local dist_sq = (dx * dx + dy * dy)
                local in_settle = (self.realtime_client_settle_timer or 0) > 0
                local decouple_unit_motion = (REALTIME_MP_DECOUPLE_MOVEMENT_FROM_HOST == true)
                    and self.mp_state
                    and self.mp_state.enabled
                    and self.mp_state.local_player_id ~= self.mp_state.host_player_id
                    and self.realtime_rules_enabled == true
                    and multiplayer_can_control_unit(self, unit.id)
                if decouple_unit_motion then
                    local needs_reconcile = (unit.is_moving ~= true) and (dist_sq > (CELL_WIDTH * CELL_WIDTH * 1.44))
                    if needs_reconcile then
                        multiplayer_telemetry_on_snapshot_correction(self, math.sqrt(dist_sq))
                        go.cancel_animations(unit.go_path, "position")
                        go.set_position(vmath.vector3(tx, ty, 0.5), unit.go_path)
                    end
                else
                    if in_settle and dist_sq > 0.25 then
                        multiplayer_telemetry_on_snapshot_correction(self, math.sqrt(dist_sq))
                        go.cancel_animations(unit.go_path, "position")
                        go.set_position(vmath.vector3(tx, ty, 0.5), unit.go_path)
                    elseif dist_sq > 0.25 then
                        go.cancel_animations(unit.go_path, "position")
                        go.animate(unit.go_path, "position", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(tx, ty, 0.5), go.EASING_LINEAR, 0.28)
                    end
                end
            end
        end
    end

    local snapshot_aliens_by_id = {}
    for _, alien_snapshot in ipairs(snapshot.aliens or {}) do
        local alien_id = tonumber(alien_snapshot.id or 0) or 0
        if alien_id > 0 then
            snapshot_aliens_by_id[alien_id] = alien_snapshot
            local alien = find_alien_by_id(self, alien_id)
            if not alien then
                local alien_type = alien_snapshot.type or ALIEN_TYPE_BLIP
                local cfg = ALIEN_TYPE_CONFIG[alien_type] or ALIEN_TYPE_CONFIG[ALIEN_TYPE_BLIP]
                local ap_max = tonumber(alien_snapshot.ap_max or cfg.ap_per_turn) or (cfg.ap_per_turn or 1)
                local hp_max = tonumber(alien_snapshot.hp_max or cfg.hp) or (cfg.hp or 1)
                alien = {
                    id = alien_id,
                    type = alien_type,
                    cell_id = tonumber(alien_snapshot.cell_id),
                    slot_name = tostring(alien_snapshot.slot_name or "center"),
                    ap_max = ap_max,
                    turn_ap_remaining = tonumber(alien_snapshot.turn_ap_remaining or ap_max) or ap_max,
                    hp_max = hp_max,
                    hp_current = tonumber(alien_snapshot.hp_current or hp_max) or hp_max,
                    can_traverse_void = (alien_snapshot.can_traverse_void == true) or (cfg.can_traverse_void == true),
                    has_ranged = (alien_snapshot.has_ranged == true) or (cfg.has_ranged == true),
                    ranged_cells = tonumber(alien_snapshot.ranged_cells or cfg.ranged_cells or 0) or 0,
                    go_id = nil,
                    is_moving = false,
                    move_path = nil,
                    move_path_index = 0,
                    spitter_anim_phase = math.random() * math.pi * 2,
                    spitter_flip = false,
                    hidden_reveal_type = alien_snapshot.hidden_reveal_type
                }
                table.insert(self.aliens, alien)
            else
                alien.type = alien_snapshot.type or alien.type
                alien.cell_id = tonumber(alien_snapshot.cell_id) or alien.cell_id
                local snapshot_slot_name = tostring(alien_snapshot.slot_name or "")
                if snapshot_slot_name == "left" or snapshot_slot_name == "center" or snapshot_slot_name == "right" then
                    alien.slot_name = snapshot_slot_name
                elseif alien.slot_name == nil then
                    alien.slot_name = ensure_alien_slot_name(self, alien, alien.cell_id, false)
                end
                alien.ap_max = tonumber(alien_snapshot.ap_max or alien.ap_max or 1) or 1
                alien.turn_ap_remaining = tonumber(alien_snapshot.turn_ap_remaining or alien.turn_ap_remaining or alien.ap_max) or alien.ap_max
                alien.hp_max = tonumber(alien_snapshot.hp_max or alien.hp_max or 1) or 1
                alien.hp_current = tonumber(alien_snapshot.hp_current or alien.hp_current or alien.hp_max) or alien.hp_max
                alien.can_traverse_void = alien_snapshot.can_traverse_void == true
                alien.has_ranged = alien_snapshot.has_ranged == true
                alien.ranged_cells = tonumber(alien_snapshot.ranged_cells or alien.ranged_cells or 0) or 0
                alien.hidden_reveal_type = alien_snapshot.hidden_reveal_type
                alien.is_moving = false
                alien.move_path = nil
                alien.move_path_index = 0
                alien.counter_move_total_dist = nil
                alien.counter_shadow_offset = nil
                alien.melee_shuffle_target_x = nil
                alien.melee_shuffle_target_y = nil
                if alien.type == ALIEN_TYPE_SPITTER then
                    alien.spitter_idle_anchor_x = nil
                    alien.spitter_idle_anchor_y = nil
                end
            end
            ensure_alien_visual(self, alien)
            local wanted_visual_kind = "marker"
            if alien.type == ALIEN_TYPE_BLIP then
                wanted_visual_kind = "blip"
            elseif alien.type == ALIEN_TYPE_CANNON then
                wanted_visual_kind = "cannon"
            elseif alien.type == ALIEN_TYPE_SPITTER then
                wanted_visual_kind = "spitter"
            elseif alien.type == ALIEN_TYPE_SPEEDY then
                wanted_visual_kind = "speedy"
            elseif alien.type == ALIEN_TYPE_BRUTE then
                wanted_visual_kind = "brute"
            end
            if alien.visual_kind ~= wanted_visual_kind then
                refresh_alien_visual(self, alien)
            end
            if alien.go_id then
                local ax = tonumber(alien_snapshot.world_x or nil)
                local ay = tonumber(alien_snapshot.world_y or nil)
                if ax and ay then
                    local apos = go.get_position(alien.go_id)
                    local adx = ax - apos.x
                    local ady = ay - apos.y
                    local dist_sq = (adx * adx + ady * ady)
                    local snap_dist = CELL_WIDTH * 0.8
                    local in_settle = (self.realtime_client_settle_timer or 0) > 0
                    local decouple_motion = (REALTIME_MP_DECOUPLE_MOVEMENT_FROM_HOST == true)
                        and self.mp_state
                        and self.mp_state.enabled
                        and self.mp_state.local_player_id ~= self.mp_state.host_player_id
                        and self.realtime_rules_enabled == true
                    if decouple_motion then
                        -- Hybrid alien sync in realtime MP:
                        -- keep host authority for decisions, but smooth medium position deltas
                        -- on clients so aliens do not appear frozen between snapshots.
                        if dist_sq > (snap_dist * snap_dist * 2.25) then
                            multiplayer_telemetry_on_snapshot_correction(self, math.sqrt(dist_sq))
                            go.cancel_animations(alien.go_id, "position")
                            go.set_position(vmath.vector3(ax, ay, 0.6), alien.go_id)
                        elseif dist_sq > 4.0 then
                            go.cancel_animations(alien.go_id, "position")
                            go.animate(alien.go_id, "position", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(ax, ay, 0.6), go.EASING_LINEAR, 0.22)
                        end
                    else
                        if in_settle and dist_sq > 0.25 then
                            multiplayer_telemetry_on_snapshot_correction(self, math.sqrt(dist_sq))
                            go.cancel_animations(alien.go_id, "position")
                            go.set_position(vmath.vector3(ax, ay, 0.6), alien.go_id)
                        elseif dist_sq > (snap_dist * snap_dist) then
                            multiplayer_telemetry_on_snapshot_correction(self, math.sqrt(dist_sq))
                            go.cancel_animations(alien.go_id, "position")
                            go.set_position(vmath.vector3(ax, ay, 0.6), alien.go_id)
                        elseif dist_sq > 0.25 then
                            go.cancel_animations(alien.go_id, "position")
                            go.animate(alien.go_id, "position", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(ax, ay, 0.6), go.EASING_LINEAR, 0.24)
                        end
                    end
                end
            end
        end
    end
    for i = #self.aliens, 1, -1 do
        local alien = self.aliens[i]
        if alien and (not snapshot_aliens_by_id[tonumber(alien.id or 0) or 0]) then
            if alien.go_id then
                pcall(go.delete, alien.go_id)
            end
            table.remove(self.aliens, i)
        end
    end
    self.next_alien_id = tonumber(snapshot.next_alien_id or self.next_alien_id or 0) or 0

    local old_civilians_by_id = {}
    for _, existing in ipairs(self.civilians or {}) do
        if existing and existing.id then
            old_civilians_by_id[tonumber(existing.id) or 0] = existing
        end
    end
    local next_civilians = multiplayer_clone_simple_table(snapshot.civilians or self.civilians or {}) or {}
    if decouple_motion then
        for _, civilian in ipairs(next_civilians) do
            local existing = old_civilians_by_id[tonumber(civilian and civilian.id or 0) or 0]
            if existing then
                civilian.is_moving = existing.is_moving
                civilian.move_path = existing.move_path
                civilian.move_path_index = existing.move_path_index
                civilian.micro_target_x = existing.micro_target_x
                civilian.micro_target_y = existing.micro_target_y
                civilian.micro_move_kind = existing.micro_move_kind
                civilian.vertical_prep_done_for_index = existing.vertical_prep_done_for_index
                civilian.entry_slot_for_index = existing.entry_slot_for_index
                civilian.entry_slot_index = existing.entry_slot_index
                civilian.shadow_motion_offset = existing.shadow_motion_offset
                civilian.counter_move_total_dist = existing.counter_move_total_dist
                civilian.anim_phase = existing.anim_phase
            end
        end
    end
    self.civilians = next_civilians
    self.next_civilian_id = tonumber(snapshot.next_civilian_id or self.next_civilian_id or 0) or 0
    self.world_item_instances = multiplayer_clone_simple_table(snapshot.world_item_instances or self.world_item_instances or {}) or {}
    self.next_world_item_id = tonumber(snapshot.next_world_item_id or self.next_world_item_id or 0) or 0
    self.dna_analysis_progress = tonumber(snapshot.dna_analysis_progress or self.dna_analysis_progress or 0) or 0
    self.dna_analysis_complete = snapshot.dna_analysis_complete == true
    self.dna_sample_spawned = snapshot.dna_sample_spawned == true
    self.dna_sample_returned = snapshot.dna_sample_returned == true
    self.purge_bomb_planted = snapshot.purge_bomb_planted == true
    self.purge_timer_started = snapshot.purge_timer_started == true
    self.purge_launch_pressed = snapshot.purge_launch_pressed == true
    self.purge_time_expired = snapshot.purge_time_expired == true
    self.purge_result_locked = snapshot.purge_result_locked == true
    self.purge_turns_remaining = tonumber(snapshot.purge_turns_remaining or self.purge_turns_remaining or 0) or 0
    self.purge_deadline_epoch_ms = tonumber(snapshot.purge_deadline_epoch_ms or self.purge_deadline_epoch_ms or 0) or 0
    self.holdout_configured_turns = tonumber(snapshot.holdout_configured_turns or self.holdout_configured_turns or 0) or 0
    self.holdout_turns_remaining = tonumber(snapshot.holdout_turns_remaining or self.holdout_turns_remaining or 0) or 0
    self.holdout_timer_started = snapshot.holdout_timer_started == true
    self.holdout_survival_pending = snapshot.holdout_survival_pending == true
    self.holdout_result_locked = snapshot.holdout_result_locked == true

    if not decouple_motion then
        multiplayer_enforce_controlled_unit(self, true)
    end
    refresh_civilian_visuals(self)
    update_human_visual_state(self)
    return true
end

multiplayer_apply_snapshot_state = function(self, snapshot)
    if type(snapshot) ~= "table" then
        return false
    end
    local target_level = tonumber(snapshot.level_index or self.current_level_index or 1) or 1
    if self.current_level_index ~= target_level then
        local ok = reset_and_load_level(self, target_level)
        if not ok then
            return false
        end
    end
    if not (self.world_grid and self.squad_units) then
        return false
    end

    if self.aliens then
        for _, alien in ipairs(self.aliens) do
            if alien and alien.go_id then
                pcall(go.delete, alien.go_id)
            end
        end
    end
    self.aliens = {}
    self.next_alien_id = 0

    for _, cell in ipairs(self.world_grid) do
        if cell then
            cell.isOccupied = hash("empty")
        end
    end

    for unit_id, unit in pairs(self.squad_units) do
        local unit_snapshot = snapshot.units and snapshot.units[unit_id] or nil
        unit.is_selected = false
        unit.is_moving = false
        unit.move_path = nil
        unit.move_path_index = 0
        if unit_snapshot then
            unit.current_ap = tonumber(unit_snapshot.current_ap or unit.current_ap or unit.max_ap) or unit.max_ap
            unit.current_ammo = tonumber(unit_snapshot.current_ammo or unit.current_ammo or unit.max_ammo) or unit.max_ammo
            unit.current_health = tonumber(unit_snapshot.current_health or unit.current_health or unit.max_health) or unit.max_health
            unit.command_points = tonumber(unit_snapshot.command_points or unit.command_points or 0) or 0
            unit.backpack_items = multiplayer_clone_simple_table(unit_snapshot.backpack_items or {}) or {}
            unit.backpack_used = tonumber(unit_snapshot.backpack_used or #unit.backpack_items) or #unit.backpack_items
            unit.carrying_corpse_id = unit_snapshot.carrying_corpse_id
            unit.equipment = create_empty_equipment()
            local snapshot_equipment = unit_snapshot.equipment or {}
            for _, slot_name in ipairs(BUFF_SLOT_ORDER) do
                local equipped_item = snapshot_equipment[slot_name]
                if type(equipped_item) == "string" then
                    unit.equipment[slot_name] = equipped_item
                end
            end
            unit.cell_id = tonumber(unit_snapshot.cell_id)
        end
    end

    self.cell_slot_assignments = multiplayer_restore_numeric_top_keys(
        multiplayer_clone_simple_table(snapshot.cell_slot_assignments or {}) or {}
    )
    for _, unit in pairs(self.squad_units) do
        if unit and unit.cell_id and self.world_grid[unit.cell_id] then
            self.world_grid[unit.cell_id].isOccupied = unit.occupancy_hash
            refresh_unit_positions_in_cell(self, unit.cell_id)
        end
    end

    local world_cells = snapshot.world_cells or {}
    for cell_id_key, cell_state in pairs(world_cells) do
        local cell_id = tonumber(cell_id_key)
        local cell = cell_id and self.world_grid[cell_id] or nil
        if cell and type(cell_state) == "table" then
            cell.isPowered = (cell_state.isPowered == true)
            cell.lightValue = tonumber(cell_state.lightValue or cell.lightValue or 0) or 0
            cell.has_barricade = (cell_state.has_barricade == true)
            cell.barricade_hp = tonumber(cell_state.barricade_hp or 0) or 0
            cell.barricade_anchor_x = tonumber(cell_state.barricade_anchor_x or 0) or 0
            cell.barricade_anchor_y = tonumber(cell_state.barricade_anchor_y or 0) or 0
            cell.barricade_slot_index = tonumber(cell_state.barricade_slot_index or 0) or 0
            local object_states = cell_state.object_states or {}
            local objects = { cell.object1, cell.object2, cell.object3 }
            for slot_idx, obj in ipairs(objects) do
                local obj_state = object_states[slot_idx] or object_states[tostring(slot_idx)]
                if type(obj_state) == "table" and obj then
                    local has_object = obj_state.has_object == true
                    local is_door = obj_state.is_door == true
                    if not has_object then
                        if obj.name and obj.name ~= hash("empty") then
                            reset_runtime_object_slot_to_empty(obj)
                        end
                    elseif is_door then
                        obj.name = hash("door")
                        obj.objectId = tonumber(obj_state.object_id or obj.objectId or 0) or 0
                        obj.isOpen = (obj_state.isOpen == true)
                        obj.isFixed = (obj_state.isFixed == true)
                        obj.isWelded = (obj_state.isWelded == true)
                        local door_hp = tonumber(obj_state.door_hp or 0) or 0
                        obj.door_hp = door_hp > 0 and door_hp or nil
                    elseif obj.name and obj.name ~= hash("empty") then
                        obj.isFixed = (obj_state.isFixed == true)
                        obj.isWelded = (obj_state.isWelded == true)
                        if obj.name == hash("door") then
                            reset_runtime_object_slot_to_empty(obj)
                        end
                    end
                end
            end
        end
    end

    local aliens_snapshot = snapshot.aliens or {}
    for _, alien_snapshot in ipairs(aliens_snapshot) do
        local alien_type = alien_snapshot.type or ALIEN_TYPE_BLIP
        local cfg = ALIEN_TYPE_CONFIG[alien_type] or ALIEN_TYPE_CONFIG[ALIEN_TYPE_BLIP]
        local ap_max = tonumber(alien_snapshot.ap_max or cfg.ap_per_turn) or (cfg.ap_per_turn or 1)
        local hp_max = tonumber(alien_snapshot.hp_max or cfg.hp) or (cfg.hp or 1)
        local ranged_cells = tonumber(alien_snapshot.ranged_cells or cfg.ranged_cells or 0) or 0
        local alien = {
            id = tonumber(alien_snapshot.id or 0) or 0,
            type = alien_type,
            cell_id = tonumber(alien_snapshot.cell_id),
            slot_name = tostring(alien_snapshot.slot_name or "center"),
            ap_max = ap_max,
            turn_ap_remaining = tonumber(alien_snapshot.turn_ap_remaining or ap_max) or ap_max,
            hp_max = hp_max,
            hp_current = tonumber(alien_snapshot.hp_current or hp_max) or hp_max,
            can_traverse_void = (alien_snapshot.can_traverse_void == true) or (cfg.can_traverse_void == true),
            has_ranged = (alien_snapshot.has_ranged == true) or (cfg.has_ranged == true),
            ranged_cells = ranged_cells,
            go_id = nil,
            is_moving = false,
            move_path = nil,
            move_path_index = 0,
            spitter_anim_phase = math.random() * math.pi * 2,
            spitter_flip = false,
            hidden_reveal_type = alien_snapshot.hidden_reveal_type
        }
        table.insert(self.aliens, alien)
        if alien.id > (self.next_alien_id or 0) then
            self.next_alien_id = alien.id
        end
        ensure_alien_visual(self, alien)
        refresh_alien_visual(self, alien)
    end
    self.next_alien_id = math.max(tonumber(snapshot.next_alien_id or 0) or 0, self.next_alien_id or 0)
    self.civilians = multiplayer_clone_simple_table(snapshot.civilians or {}) or {}
    self.next_civilian_id = tonumber(snapshot.next_civilian_id or 0) or 0

    self.world_item_instances = multiplayer_clone_simple_table(snapshot.world_item_instances or {}) or {}
    self.next_world_item_id = tonumber(snapshot.next_world_item_id or 0) or 0
    if self.dna_sample_spawned ~= true then
        self.dna_sample_spawned = has_world_item_type(self, DNA_SAMPLE_ITEM_TYPE)
    end
    self.workshop_states = multiplayer_restore_numeric_top_keys(
        multiplayer_clone_simple_table(snapshot.workshop_states or {}) or {}
    )
    self.medbay_states = multiplayer_restore_numeric_top_keys(
        multiplayer_clone_simple_table(snapshot.medbay_states or {}) or {}
    )
    self.exit_objective_state = multiplayer_restore_numeric_top_keys(
        multiplayer_clone_simple_table(snapshot.exit_objective_state or {}) or {}
    )
    self.dna_analysis_progress = tonumber(snapshot.dna_analysis_progress or self.dna_analysis_progress or 0) or 0
    self.dna_analysis_progress = math.max(0, math.min(DNA_PROGRESS_TARGET, self.dna_analysis_progress))
    self.dna_analysis_complete = snapshot.dna_analysis_complete == true
        or self.dna_analysis_progress >= DNA_PROGRESS_TARGET
    self.dna_sample_spawned = snapshot.dna_sample_spawned == true
    self.dna_sample_returned = snapshot.dna_sample_returned == true
    self.purge_bomb_planted = snapshot.purge_bomb_planted == true
    self.purge_timer_started = snapshot.purge_timer_started == true
    self.purge_launch_pressed = snapshot.purge_launch_pressed == true
    self.purge_time_expired = snapshot.purge_time_expired == true
    self.purge_result_locked = snapshot.purge_result_locked == true
    self.purge_turns_remaining = tonumber(snapshot.purge_turns_remaining or self.purge_turns_remaining or 0) or 0
    self.purge_deadline_epoch_ms = tonumber(snapshot.purge_deadline_epoch_ms or self.purge_deadline_epoch_ms or 0) or 0
    self.holdout_configured_turns = tonumber(snapshot.holdout_configured_turns or self.holdout_configured_turns or 0) or 0
    self.holdout_turns_remaining = tonumber(snapshot.holdout_turns_remaining or self.holdout_turns_remaining or 0) or 0
    self.holdout_timer_started = snapshot.holdout_timer_started == true
    self.holdout_survival_pending = snapshot.holdout_survival_pending == true
    self.holdout_result_locked = snapshot.holdout_result_locked == true
    self.end_result = tostring(snapshot.end_result or self.end_result or "")
    self.end_mission_type = tostring(snapshot.end_mission_type or self.end_mission_type or "")
    self.end_outro_sequence_id = tostring(snapshot.end_outro_sequence_id or self.end_outro_sequence_id or "")
    self.end_reason = tostring(snapshot.end_reason or self.end_reason or "")
    self.end_session_origin = tostring(snapshot.end_session_origin or self.end_session_origin or "")
    self.score_turn_counter = tonumber(snapshot.score_turn_counter or self.score_turn_counter or 0) or 0
    self.score_state = multiplayer_clone_simple_table(snapshot.score_state or self.score_state or {}) or {}
    ensure_score_state(self)

    if self.mp_state then
        self.mp_state.turn_id = tonumber(snapshot.turn_id or self.mp_state.turn_id or 1) or 1
        self.mp_state.player_count = tonumber(snapshot.player_count or self.mp_state.player_count or 4) or 4
        self.mp_state.seat_assignments = multiplayer_clone_simple_table(snapshot.seat_assignments or self.mp_state.seat_assignments or {}) or {}
        self.mp_state.required_ready_player_ids = multiplayer_clone_simple_table(snapshot.required_ready_player_ids or self.mp_state.required_ready_player_ids or {}) or {}
        self.mp_state.ready_by_player_id = multiplayer_clone_simple_table(snapshot.ready_by_player_id or self.mp_state.ready_by_player_id or {}) or {}
    end

    local snapshot_controlled_unit_id = snapshot.controlled_unit_id
    if self.mp_state and self.mp_state.enabled then
        if self.controlled_unit_id
            and multiplayer_can_control_unit(self, self.controlled_unit_id)
            and self.squad_units[self.controlled_unit_id]
            and (self.squad_units[self.controlled_unit_id].current_health or 0) > 0
        then
            -- Preserve client-owned local selection when valid.
        elseif snapshot_controlled_unit_id and multiplayer_can_control_unit(self, snapshot_controlled_unit_id) then
            self.controlled_unit_id = snapshot_controlled_unit_id
        else
            self.controlled_unit_id = nil
        end
    else
        self.controlled_unit_id = snapshot_controlled_unit_id or self.controlled_unit_id
    end
    deselect_all_units(self)
    if self.controlled_unit_id and self.squad_units[self.controlled_unit_id] and (self.squad_units[self.controlled_unit_id].current_health or 0) > 0 then
        self.squad_units[self.controlled_unit_id].is_selected = true
    else
        multiplayer_enforce_controlled_unit(self, true)
    end

    if LOOT_RUNTIME.refresh_world_item_visuals then LOOT_RUNTIME.refresh_world_item_visuals(self) end
    if LOOT_RUNTIME.refresh_loot_markers then LOOT_RUNTIME.refresh_loot_markers(self) end
    if LOOT_RUNTIME.refresh_hazard_fx then LOOT_RUNTIME.refresh_hazard_fx(self) end
    if LOOT_RUNTIME.refresh_machine_markers then LOOT_RUNTIME.refresh_machine_markers(self) end
    if LOOT_RUNTIME.refresh_turret_markers then LOOT_RUNTIME.refresh_turret_markers(self) end
    if LOOT_RUNTIME.refresh_fix_markers then LOOT_RUNTIME.refresh_fix_markers(self) end
    if LOOT_RUNTIME.refresh_power_node_markers then LOOT_RUNTIME.refresh_power_node_markers(self) end
    if LOOT_RUNTIME.refresh_door_markers then LOOT_RUNTIME.refresh_door_markers(self) end
    if LOOT_RUNTIME.refresh_wiregap_markers then LOOT_RUNTIME.refresh_wiregap_markers(self) end
    if LOOT_RUNTIME.refresh_vent_markers then LOOT_RUNTIME.refresh_vent_markers(self) end
    if LOOT_RUNTIME.refresh_light_value_markers then LOOT_RUNTIME.refresh_light_value_markers(self) end
    if LOOT_RUNTIME.refresh_factory_underlay_visuals then LOOT_RUNTIME.refresh_factory_underlay_visuals(self) end
    if LOOT_RUNTIME.refresh_workshop_underlay_visuals then LOOT_RUNTIME.refresh_workshop_underlay_visuals(self) end
    if LOOT_RUNTIME.refresh_exit_objective_state then LOOT_RUNTIME.refresh_exit_objective_state(self) end
    refresh_dna_marker_runtime(self)
    refresh_civilian_visuals(self)
    update_human_visual_state(self)
    update_score_hud(self, true)
    update_selected_unit_ui(self)
    return true
end

multiplayer_force_select_unit = function(self, unit_id)
    if not (self and self.squad_units and unit_id) then
        return false
    end
    local unit = self.squad_units[unit_id]
    if not unit then
        return false
    end
    if self.controlled_unit_id ~= unit_id then
        clear_locked_manual_target(self)
    end
    self.controlled_unit_id = unit_id
    deselect_all_units(self)
    unit.is_selected = true
    return true
end

multiplayer_apply_resource_drag_event = function(self, payload)
    if not payload or type(payload) ~= "table" then
        return false
    end
    if not (payload.drag and type(payload.drag) == "table") then
        return false
    end
    local source_unit_id = payload.drag.source_unit_id
    if not (source_unit_id and self.squad_units and self.squad_units[source_unit_id]) then
        return false
    end
    local drag = multiplayer_clone_flat_table(payload.drag)
    local ui_action = payload.ui_action
    drag.world_x = tonumber(payload.world_x)
    drag.world_y = tonumber(payload.world_y)
    drag.active = true
    self.drag_resource = drag
    local screen_x = tonumber(payload.screen_x)
    local screen_y = tonumber(payload.screen_y)
    if ui_action and type(ui_action) == "table" and LOOT_RUNTIME then
        local action_type = tostring(ui_action.action_type or "")
        if action_type == "use_on_own_bar" and LOOT_RUNTIME.get_bar_drop_screen_point then
            local resolved_x, resolved_y = LOOT_RUNTIME.get_bar_drop_screen_point(tostring(ui_action.bar_target or ""))
            if resolved_x and resolved_y then
                screen_x = resolved_x
                screen_y = resolved_y
            end
        elseif action_type == "equip_self_buff" and LOOT_RUNTIME.get_buff_slot_drop_screen_point then
            local resolved_x, resolved_y = LOOT_RUNTIME.get_buff_slot_drop_screen_point(tostring(ui_action.buff_slot or ""))
            if resolved_x and resolved_y then
                screen_x = resolved_x
                screen_y = resolved_y
            end
        end
    end
    if not (screen_x and screen_y) then
        self.drag_resource = { active = false }
        return false
    end
    return LOOT_RUNTIME.end_resource_drag(self, screen_x, screen_y) == true
end

multiplayer_apply_pickup_obstacle_event = function(self, payload)
    if not payload or type(payload) ~= "table" then
        return false
    end
    local unit_id = payload.unit_id
    local cell_id = tonumber(payload.cell_id)
    local world_x = tonumber(payload.world_x)
    local world_y = tonumber(payload.world_y)
    local obstacle_object_id = tonumber(payload.obstacle_object_id or 0) or 0
    local obstacle_slot_idx = tonumber(payload.obstacle_slot_idx or 0) or 0
    if not (unit_id and cell_id) then
        return false
    end
    self.mp_state.applying_remote_event = true
    local ok = LOOT_RUNTIME.try_pickup_obstacle_by_ids(
        self,
        unit_id,
        cell_id,
        world_x,
        world_y,
        obstacle_object_id,
        obstacle_slot_idx
    ) == true
    self.mp_state.applying_remote_event = false
    return ok
end


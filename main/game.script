        set_ui_square_transform(self, self.ui.flow_title_solo_button, DEMO_SELECT_LEVEL1_BUTTON_X, DEMO_SELECT_LEVEL1_BUTTON_Y, FLOW_UI_BUTTON_Z, vmath.vector4(0.2, 0.75, 0.3, 0), DEMO_BUTTON_W, DEMO_BUTTON_H)

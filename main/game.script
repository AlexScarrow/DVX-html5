        local applied_ok = true
        if should_apply_local then
            applied_ok = multiplayer_apply_workshop_cancel_event(self, payload)
        end
        if not applied_ok then
            print("MP COMMAND | workshop_cancel_applied ignored.")
        end
        local reconciled = false
        reconciled = multiplayer_apply_authoritative_unit_digest(self, payload.unit_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_world_digest(self, payload.world_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_item_digest(self, payload.item_digest) or reconciled
        if (not applied_ok) and (not reconciled) then
            return
        end
        return
    end
    if event.type == "workshop_pay_material_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        local payload = event.payload or {}
        local is_local_host = multiplayer_is_wire_dispatch_host(self)
        local should_apply_local = not (payload.host_applied == true and is_local_host)
        local applied_ok = true
        if should_apply_local then
            applied_ok = multiplayer_apply_workshop_pay_material_event(self, payload)
        end
        if not applied_ok then
            print("MP COMMAND | workshop_pay_material_applied ignored.")
        end
        local reconciled = false
        reconciled = multiplayer_apply_authoritative_unit_digest(self, payload.unit_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_world_digest(self, payload.world_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_item_digest(self, payload.item_digest) or reconciled
        if (not applied_ok) and (not reconciled) then
            return
        end
        return
    end
    if event.type == "supply_loader_interact_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        local payload = event.payload or {}
        local is_local_host = multiplayer_is_wire_dispatch_host(self)
        local should_apply_local = not (payload.host_applied == true and is_local_host)
        local applied_ok = true
        if should_apply_local then
            applied_ok = multiplayer_apply_supply_loader_interact_event(self, payload)
        end
        if not applied_ok then
            print("MP COMMAND | supply_loader_interact_applied ignored.")
        end
        local reconciled = false
        reconciled = multiplayer_apply_authoritative_unit_digest(self, payload.unit_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_world_digest(self, payload.world_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_item_digest(self, payload.item_digest) or reconciled
        if (not applied_ok) and (not reconciled) then
            return
        end
        return
    end
    if event.type == "nav_computer_interact_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        local payload = event.payload or {}
        local is_local_host = multiplayer_is_wire_dispatch_host(self)
        local should_apply_local = not (payload.host_applied == true and is_local_host)
        local applied_ok = true
        if should_apply_local then
            applied_ok = multiplayer_apply_nav_computer_interact_event(self, payload)
        end
        if not applied_ok then
            print("MP COMMAND | nav_computer_interact_applied ignored.")
        end
        local reconciled = false
        reconciled = multiplayer_apply_authoritative_unit_digest(self, payload.unit_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_world_digest(self, payload.world_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_item_digest(self, payload.item_digest) or reconciled
        if (not applied_ok) and (not reconciled) then
            return
        end
        return
    end
    if event.type == "retrieve_power_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        local payload = event.payload or {}
        local should_apply_local = (payload.host_applied ~= true) or (self.mp_state.local_player_id ~= self.mp_state.host_player_id)
        local applied_ok = true
        if should_apply_local then
            applied_ok = multiplayer_apply_retrieve_power_event(self, payload)
        end
        if not applied_ok then
            print("MP COMMAND | retrieve_power_applied ignored.")
        end
        local reconciled = false
        reconciled = multiplayer_apply_authoritative_unit_digest(self, payload.unit_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_world_digest(self, payload.world_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_item_digest(self, payload.item_digest) or reconciled
        if LOOT_RUNTIME and LOOT_RUNTIME.refresh_machine_markers then
            LOOT_RUNTIME.refresh_machine_markers(self)
        end
        if (not applied_ok) and (not reconciled) then
            return
        end
        return
    end
    if event.type == "retrieve_world_item_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        local payload = event.payload or {}
        local should_apply_local = payload.host_applied ~= true
        local applied_ok = true
        if should_apply_local then
            applied_ok = multiplayer_apply_retrieve_world_item_event(self, payload)
        end
        if not applied_ok then
            print("MP COMMAND | retrieve_world_item_applied ignored.")
        end
        local reconciled = false
        reconciled = multiplayer_apply_authoritative_unit_digest(self, payload.unit_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_world_digest(self, payload.world_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_item_digest(self, payload.item_digest) or reconciled
        if (not applied_ok) and (not reconciled) then
            return
        end
        return
    end
    if event.type == "toggle_door_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        multiplayer_sync_trace(self, "apply_event_begin", "type=toggle_door_applied")
        if not multiplayer_apply_toggle_door_event(self, event.payload or {}) then
            print("MP COMMAND | toggle_door_applied ignored.")
            multiplayer_sync_trace(self, "apply_event_end", "type=toggle_door_applied ok=false")
        else
            multiplayer_sync_trace(self, "apply_event_end", "type=toggle_door_applied ok=true")
        end
        return
    end
    if event.type == "scavenge_crate_applied" then
        if self.mp_state.awaiting_snapshot and self.mp_state.snapshot_blocking == true then
            multiplayer_queue_pending_event(self, event)
            return
        end
        multiplayer_sync_trace(self, "apply_event_begin", "type=scavenge_crate_applied")
        local payload = event.payload or {}
        local is_local_host = multiplayer_is_wire_dispatch_host(self)
        local should_apply_local = not (payload.host_applied == true and is_local_host)
        local applied_ok = true
        if should_apply_local then
            applied_ok = multiplayer_apply_scavenge_crate_event(self, payload)
        end
        if not applied_ok then
            print("MP COMMAND | scavenge_crate_applied ignored.")
            multiplayer_sync_trace(self, "apply_event_end", "type=scavenge_crate_applied ok=false")
        else
            multiplayer_sync_trace(self, "apply_event_end", "type=scavenge_crate_applied ok=true")
        end
        local reconciled = false
        reconciled = multiplayer_apply_authoritative_unit_digest(self, payload.unit_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_world_digest(self, payload.world_digest) or reconciled
        reconciled = multiplayer_apply_authoritative_item_digest(self, payload.item_digest) or reconciled
        if (not applied_ok) and (not reconciled) then
            return
        end
        multiplayer_broadcast_turn_state_heartbeat_now(self)
        return
    end
    if event.type == "command_rejected" then
        local reason = event.payload and event.payload.reason or "unknown"
        local cmd = event.payload and event.payload.command_type or "unknown"
        if cmd == "move_unit" and self.squad_units then
            for _, unit in pairs(self.squad_units) do
                if unit then
                    unit.mp_move_command_pending = nil
                end
            end
        end
        print(string.format("MP COMMAND | rejected | type=%s reason=%s", tostring(cmd), tostring(reason)))
        if cmd == "resource_drag_end"
            and self.mp_state
            and self.mp_state.enabled
            and self.mp_state.local_player_id ~= self.mp_state.host_player_id
        then
            show_advisory(self, ADVISORY_MSG_TRY_AGAIN, 1.2)
        end
        if (cmd == "pickup_turret" or cmd == "pickup_obstacle")
            and self.mp_state
            and self.mp_state.enabled
            and self.mp_state.local_player_id ~= self.mp_state.host_player_id
        then
            show_advisory(self, ADVISORY_MSG_TRY_AGAIN, 1.2)
            local current_turn_id = tonumber(self.mp_state.turn_id or 1) or 1
            if self.mp_state.last_pickup_reject_snapshot_turn_id ~= current_turn_id then
                self.mp_state.last_pickup_reject_snapshot_turn_id = current_turn_id
                multiplayer_transport_send_command(self, "request_snapshot", {
                    turn_id = current_turn_id,
                    reason = tostring(cmd) .. "_rejected",
                    expected_turn_id = current_turn_id
                }, self.mp_state.local_player_id)
                print(string.format("MP SNAPSHOT | requested_%s_rejected | turn_id=%d", tostring(cmd), current_turn_id))
            end
        end
        if cmd == "manual_shot"
            and reason == "invalid_target"
            and self.mp_state
            and self.mp_state.enabled
            and self.mp_state.local_player_id ~= self.mp_state.host_player_id
        then
            local current_turn_id = tonumber(self.mp_state.turn_id or 1) or 1
            if self.mp_state.last_invalid_target_snapshot_turn_id ~= current_turn_id then
                self.mp_state.last_invalid_target_snapshot_turn_id = current_turn_id
                multiplayer_transport_send_command(self, "request_snapshot", {
                    turn_id = current_turn_id,
                    reason = "manual_shot_invalid_target",
                    expected_turn_id = current_turn_id
                }, self.mp_state.local_player_id)
                print(string.format("MP SNAPSHOT | requested_manual_shot_invalid_target | turn_id=%d", current_turn_id))
            end
        end
        if cmd == "lobby_join_session" and self.mp_lobby and not multiplayer_lobby_is_host(self) then
            local reject_target = tostring(event.payload and event.payload.target_player_id or "")
            local local_id = tostring(self.mp_state and self.mp_state.local_player_id or "")
            if reject_target ~= "" and reject_target ~= local_id then
                return
            end
            local reject_session_id = tostring(self.mp_lobby.pin_target_session_id or self.mp_lobby.pending_join_session_id or "")
            if reason == "protocol_mismatch" or reason == "protocol_version_missing" then
                show_advisory(self, ADVISORY_MSG_PROTOCOL_MISMATCH, 1.8)
                multiplayer_lobby_clear_pin_join_state(self)
                self.mp_lobby.pin_feedback = "bad"
                self.mp_lobby.pin_feedback_timer = 0.75
            elseif reason == "session_full" then
                local reject_session_id = tostring(
                    event.payload and event.payload.session_id
                    or self.mp_lobby.pending_join_session_id
                    or self.mp_lobby.pin_target_session_id
                    or ""
                )
                show_mp_lobby_advisory(self, 2.2, "session_full")
                multiplayer_lobby_abort_guest_join(self)
                self.multiplayer_mode_active = true
                enter_flow_state(self, FLOW_STATE_MP_LOBBY)
                multiplayer_debug_log(self, string.format(
                    "MP LOBBY | join_rejected_session_full session=%s",
                    reject_session_id
                ))
            elseif reject_session_id ~= "" then
                multiplayer_lobby_restore_pin_join_after_reject(self, reject_session_id, reason)
            else
                self.mp_lobby.pending_join_session_id = ""
                self.mp_lobby.pin_feedback = "bad"
                self.mp_lobby.pin_feedback_timer = 0.45
            end
        end
        if cmd == "lobby_offer_join_response" and self.mp_lobby and not multiplayer_lobby_is_host(self) then
            self.mp_lobby.pending_join_session_id = ""
            self.mp_lobby.pin_feedback = "bad"
            self.mp_lobby.pin_feedback_timer = 0.45
        end
        if cmd == "lobby_leave_session" and self.mp_state and self.mp_state.enabled then
            -- offer-plane events keep lobby synchronized
        end
        return
    end
    if event.type == "joined_room" then
        self.mp_state.seen_command_ids = {}
        self.mp_state.seen_event_ids = {}
        self.mp_state.event_seq = 0
        self.mp_state.pending_turn_state_snapshot_turn_id = 0
        self.mp_state.last_turn_state_snapshot_broadcast_turn_id = 0
        local assigned_player_id = tostring(event.payload and event.payload.player_id or "")
        if assigned_player_id == "p1" or assigned_player_id == "p2" or assigned_player_id == "p3" or assigned_player_id == "p4" then
            local prev_local_player_id = tostring(self.mp_state.local_player_id or "p1")
            if assigned_player_id ~= prev_local_player_id then
                self.mp_state.local_player_id = assigned_player_id
                self.mp_state.debug_active_player_id = assigned_player_id
                if self.mp_transport and self.mp_transport.set_local_player_id then
                    self.mp_transport.set_local_player_id(assigned_player_id)
                end
                if tostring(self.mp_state.host_player_id or "") == prev_local_player_id then
                    self.mp_state.host_player_id = assigned_player_id
                end
                if self.mp_lobby then
                    local local_offer_id = tostring(self.mp_lobby.local_active_offer_id or "")
                    if local_offer_id ~= "" then
                        local local_offer = multiplayer_lobby_get_session_by_id(self, local_offer_id)
                        if local_offer and tostring(local_offer.owner_player_id or "") == prev_local_player_id then
                            local_offer.owner_player_id = assigned_player_id
                            if self.mp_lobby.offers_by_id then
                                self.mp_lobby.offers_by_id[local_offer_id] = local_offer
                            end
                            if self.mp_lobby.sessions then
                                for _, session in ipairs(self.mp_lobby.sessions) do
                                    if session and tostring(session.id or "") == local_offer_id then
                                        session.owner_player_id = assigned_player_id
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
                print(string.format("MP NET | relay_player_id_assigned | previous=%s assigned=%s", prev_local_player_id, assigned_player_id))
            end
        end
        multiplayer_lobby_ensure_runtime(self)
        if self.mp_lobby then
            self.mp_lobby.offer_removed_at_ms_by_id = {}
            self.mp_lobby.offers_by_id = {}
            self.mp_lobby.sessions = {}
        end
        self.mp_state.connected_players = {}
        self.mp_state.last_seen_by_network_id = {}
        local joined_now_s = (tonumber(get_wall_clock_ms() or 0) or 0) / 1000
        local players = event.payload and event.payload.players or {}
        for _, player_id in ipairs(players) do
            local normalized_player_id = mp_normalize_network_player_id(player_id)
            self.mp_state.connected_players[normalized_player_id] = true
            self.mp_state.last_seen_by_network_id[normalized_player_id] = joined_now_s
            local slot_player_id = multiplayer_get_slot_player_id_for_network(self, normalized_player_id)
            if slot_player_id and slot_player_id ~= "" then
                self.mp_state.connected_players[slot_player_id] = true
            end
        end
        local local_network_id = mp_normalize_network_player_id(self.mp_state.local_player_id or "p1")
        self.mp_state.connected_players[local_network_id] = true
        self.mp_state.last_seen_by_network_id[local_network_id] = joined_now_s
        local local_slot_id = multiplayer_get_slot_player_id_for_network(self, local_network_id)
        if local_slot_id and local_slot_id ~= "" then
            self.mp_state.connected_players[local_slot_id] = true
        end
        local count = 0
        for _, _ in pairs(self.mp_state.connected_players) do
            count = count + 1
        end
        print(string.format("MP NET | joined_room | room_id=%s connected_players=%d", tostring(event.payload and event.payload.room_id or "unknown"), count))
        local is_local_host = multiplayer_lobby_is_host(self)
        if is_local_host then
            local local_network_id = mp_normalize_network_player_id(self.mp_state.local_player_id or "p1")
            self.mp_state.host_player_id = local_network_id
        end
        if is_local_host then
            multiplayer_setup_push_state(self)
            if self.game_flow_state == FLOW_STATE_MP_LOBBY then
                multiplayer_lobby_push_state(self)
            end
        else
            multiplayer_transport_send_command(self, "request_setup_state", {}, self.mp_state.local_player_id)
            print("MP SETUP | requested_from_host")
        end
        if not is_local_host then
            self.mp_state.awaiting_snapshot = true
            self.mp_state.snapshot_blocking = true
            self.mp_state.expected_snapshot_turn_id = tonumber(self.mp_state.turn_id or 1) or 1
            multiplayer_transport_send_command(self, "request_snapshot", {
                turn_id = self.mp_state.turn_id or 1
            }, self.mp_state.local_player_id)
            print("MP SNAPSHOT | requested_from_host")
        end
        multiplayer_lobby_reannounce_active_offer(self, nil)
        return
    end
    if event.type == "player_joined" then
        local player_id = event.payload and event.payload.player_id or nil
        if player_id then
            local normalized_player_id = mp_normalize_network_player_id(player_id)
            self.mp_state.connected_players = self.mp_state.connected_players or {}
            self.mp_state.last_seen_by_network_id = self.mp_state.last_seen_by_network_id or {}
            self.mp_state.connected_players[normalized_player_id] = true
            self.mp_state.last_seen_by_network_id[normalized_player_id] = (tonumber(get_wall_clock_ms() or 0) or 0) / 1000
            local slot_player_id = multiplayer_get_slot_player_id_for_network(self, normalized_player_id)
            if slot_player_id and slot_player_id ~= "" then
                self.mp_state.connected_players[slot_player_id] = true
            end
            print(string.format("MP NET | player_joined | player_id=%s", tostring(normalized_player_id)))
            if self.mp_state.local_player_id == self.mp_state.host_player_id then
                multiplayer_setup_push_state(self)
            end
            multiplayer_lobby_reannounce_active_offer(self, player_id)
        end
        return
    end
    if event.type == "player_left" then
        local player_id = event.payload and event.payload.player_id or nil
        if player_id then
            local normalized_player_id = mp_normalize_network_player_id(player_id)
            local in_match = (self.game_flow_state or FLOW_STATE_GAME) == FLOW_STATE_GAME
            local is_local_host = multiplayer_lobby_is_host(self)
            local host_player_id = tostring(self.mp_state and self.mp_state.host_player_id or "")
            if in_match and tostring(normalized_player_id or "") ~= host_player_id then
                if multiplayer_apply_in_match_player_departure(self, normalized_player_id) then
                    if is_local_host then
                        multiplayer_transport_broadcast_event(self, "player_departed_in_match", {
                            session_id = tostring(self.mp_state and self.mp_state.session_id or ""),
                            departed_player_id = tostring(normalized_player_id or ""),
                            seat_assignments = multiplayer_clone_seat_assignments(self.mp_state.seat_assignments, self.mp_state.player_count or 4),
                            required_ready_player_ids = multiplayer_clone_simple_table(self.mp_state.required_ready_player_ids or {}),
                            ready_by_player_id = multiplayer_clone_simple_table(self.mp_state.ready_by_player_id or {})
                        })
                    end
                end
            elseif self.mp_state and self.mp_state.connected_players then
                self.mp_state.connected_players[normalized_player_id] = nil
                local slot_player_id = multiplayer_get_slot_player_id_for_network(self, normalized_player_id)
                if slot_player_id and slot_player_id ~= "" then
                    self.mp_state.connected_players[slot_player_id] = nil
                end
            end
            print(string.format("MP NET | player_left | player_id=%s", tostring(normalized_player_id)))
            if self.game_flow_state == FLOW_STATE_MP_LOBBY and not multiplayer_lobby_is_find_intent(self) then
                multiplayer_lobby_remove_offers_by_owner(self, normalized_player_id)
            end
        end
        return
    end
    if event.type == "hello" then
        print("MP NET | relay_hello received.")
        return
    end
    if event.type == "pong" then
        print("MP NET | relay_pong.")
        return
    end
    if event.type == "error" then
        local code = event.payload and event.payload.code or "unknown"
        local message = event.payload and event.payload.message or "unknown"
        print(string.format("MP NET | relay_error | code=%s message=%s", tostring(code), tostring(message)))
        return
    end
end

multiplayer_lag_sim_now_ms = function()
    local now = tonumber(get_wall_clock_ms and get_wall_clock_ms() or 0) or 0
    if now <= 0 then
        now = math.floor(((socket and socket.gettime and (socket.gettime() * 1000)) or (os.clock() * 1000)) + 0.5)
    end
    return now
end

multiplayer_lag_sim_get_profile = function(mode)
    local m = tostring(mode or MP_LAG_SIM_MODE_OFF)
    if m == MP_LAG_SIM_MODE_LOW then
        return {
            enabled = true,
            delay_ms = 80,
            jitter_ms = 15,
            drop_pct = 0.2
        }
    end
    if m == MP_LAG_SIM_MODE_HIGH then
        return {
            enabled = true,
            delay_ms = 180,
            jitter_ms = 40,
            drop_pct = 0.8
        }
    end
    return {
        enabled = false,
        delay_ms = 0,
        jitter_ms = 0,
        drop_pct = 0
    }
end

multiplayer_lag_sim_ensure_state = function(self)
    self.mp_lag_sim = self.mp_lag_sim or {}
    self.mp_lag_sim.mode = self.mp_lag_sim.mode or MP_LAG_SIM_MODE_OFF
    self.mp_lag_sim.outbound_queue = self.mp_lag_sim.outbound_queue or {}
    self.mp_lag_sim.seq = tonumber(self.mp_lag_sim.seq or 0) or 0
    self.mp_lag_sim.last_release_ms = tonumber(self.mp_lag_sim.last_release_ms or 0) or 0
    return self.mp_lag_sim
end

multiplayer_lag_sim_set_mode = function(self, mode)
    local state = multiplayer_lag_sim_ensure_state(self)
    local next_mode = tostring(mode or MP_LAG_SIM_MODE_OFF)
    if next_mode ~= MP_LAG_SIM_MODE_LOW and next_mode ~= MP_LAG_SIM_MODE_HIGH then
        next_mode = MP_LAG_SIM_MODE_OFF
    end
    state.mode = next_mode
    state.outbound_queue = {}
    state.last_release_ms = 0
    update_mp_lag_sim_button_visual(self)
end

multiplayer_lag_sim_queue_outbound = function(self, packet_kind, packet_payload)
    if not (self and packet_kind and packet_payload) then
        return false
    end
    local state = multiplayer_lag_sim_ensure_state(self)
    local profile = multiplayer_lag_sim_get_profile(state.mode)
    if profile.enabled ~= true then
        return false
    end
    local drop_roll = math.random() * 100
    if drop_roll < (tonumber(profile.drop_pct or 0) or 0) then
        return true
    end
    local now_ms = multiplayer_lag_sim_now_ms()
    local jitter = tonumber(profile.jitter_ms or 0) or 0
    local jitter_delta = 0
    if jitter > 0 then
        jitter_delta = math.random(-jitter, jitter)
    end
    local release_ms = now_ms + (tonumber(profile.delay_ms or 0) or 0) + jitter_delta
    if release_ms <= state.last_release_ms then
        release_ms = state.last_release_ms + 1
    end
    state.last_release_ms = release_ms
    state.seq = (tonumber(state.seq or 0) or 0) + 1
    state.outbound_queue[#state.outbound_queue + 1] = {
        kind = packet_kind,
        payload = packet_payload,
        release_ms = release_ms,
        seq = state.seq
    }
    return true
end

multiplayer_lag_sim_flush_outbound = function(self)
    if not (self and self.mp_transport and self.mp_lag_sim and self.mp_lag_sim.outbound_queue) then
        return
    end
    local queue = self.mp_lag_sim.outbound_queue
    if #queue <= 0 then
        return
    end
    local now_ms = multiplayer_lag_sim_now_ms()
    local kept = {}
    for i = 1, #queue do
        local item = queue[i]
        if item and (tonumber(item.release_ms or 0) or 0) <= now_ms then
            if item.kind == "command" and self.mp_transport.send_command then
                self.mp_transport.send_command(item.payload)
            elseif item.kind == "events" and self.mp_transport.send_events then
                self.mp_transport.send_events(item.payload)
            end
        else
            kept[#kept + 1] = item
        end
    end
    self.mp_lag_sim.outbound_queue = kept
end

multiplayer_steam_is_offer_plane_command = function(cmd_type)
    return cmd_type == "lobby_offer_upsert"
        or cmd_type == "lobby_offer_remove"
        or cmd_type == "lobby_offer_heartbeat"
        or cmd_type == "lobby_offer_join_response"
        or cmd_type == "lobby_request_offer_reannounce"
end

multiplayer_steam_should_host_dispatch_local = function(self, cmd_type)
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") ~= "steam" then
        return false
    end
    if multiplayer_steam_is_offer_plane_command(cmd_type) then
        return false
    end
    if cmd_type == "lobby_join_session" or cmd_type == "request_setup_state" then
        return false
    end
    if not multiplayer_is_wire_dispatch_host(self) then
        return false
    end
    return true
end

multiplayer_steam_host_dispatch_command_local = function(self, command_packet)
    if type(command_packet) ~= "table" then
        return false
    end
    self.mp_state.command_seq = (tonumber(self.mp_state.command_seq or 0) or 0) + 1
    if tostring(command_packet.message_id or "") == "" then
        command_packet.message_id = "cmd_" .. tostring(self.mp_state.command_seq)
    end
    local events = multiplayer_transport_handle_command(self, command_packet)
    if type(events) ~= "table" or #events <= 0 then
        multiplayer_debug_log(self, string.format(
            "MP STEAM GATEG | host_local_command type=%s event_count=0",
            tostring(command_packet.type or "")
        ))
        return true
    end
    for i = 1, #events do
        multiplayer_transport_on_event(self, events[i])
    end
    multiplayer_transport_broadcast_events(self, events)
    multiplayer_debug_log(self, string.format(
        "MP STEAM GATEG | host_local_command type=%s event_count=%d",
        tostring(command_packet.type or ""),
        #events
    ))
    return true
end

multiplayer_transport_send_command = function(self, cmd_type, payload, sender_player_id)
    if not (self.mp_state and self.mp_state.enabled and self.mp_transport) then
        multiplayer_debug_log(self, string.format(
            "MP NET | send_command_skipped type=%s enabled=%s has_transport=%s",
            tostring(cmd_type or ""),
            tostring(self and self.mp_state and self.mp_state.enabled == true),
            tostring(self and self.mp_transport ~= nil)
        ))
        return
    end
    local sender = sender_player_id
    if not sender then
        sender = self.mp_state.local_player_id or "p1"
    end
    multiplayer_sync_trace(
        self,
        "send_command",
        string.format(
            "type=%s sender=%s payload_turn=%s",
            tostring(cmd_type),
            tostring(sender),
            tostring(payload and payload.turn_id or "-")
        )
    )
    multiplayer_telemetry_on_send_command(self, cmd_type)
    local command_packet = {
        version = 1,
        session_id = self.mp_state.session_id or "local_session",
        sender_player_id = sender,
        type = cmd_type,
        payload = payload or {}
    }
    if multiplayer_lag_sim_queue_outbound(self, "command", command_packet) ~= true then
        if multiplayer_steam_should_host_dispatch_local(self, cmd_type) then
            multiplayer_steam_host_dispatch_command_local(self, command_packet)
        else
            self.mp_transport.send_command(command_packet)
        end
    end
end

multiplayer_transport_broadcast_events = function(self, events)
    if not (self.mp_state and self.mp_state.enabled and self.mp_transport and type(events) == "table" and #events > 0) then
        multiplayer_debug_log(self, string.format(
            "MP NET | broadcast_events_skipped enabled=%s has_transport=%s event_count=%s",
            tostring(self and self.mp_state and self.mp_state.enabled == true),
            tostring(self and self.mp_transport ~= nil),
            tostring(type(events) == "table" and #events or 0)
        ))
        return
    end
    if self.mp_telemetry and self.mp_telemetry.enabled then
        self.mp_telemetry.tx_event_count = (tonumber(self.mp_telemetry.tx_event_count or 0) or 0) + #events
    end
    if not self.mp_transport.send_events then
        print("MP NET | transport_missing_send_events | events_dropped")
        return
    end
    if multiplayer_lag_sim_queue_outbound(self, "events", events) ~= true then
        self.mp_transport.send_events(events)
    end
end

multiplayer_transport_broadcast_event = function(self, event_type, payload)
    if not (self.mp_state and self.mp_state.enabled) then
        return
    end
    local evt = multiplayer_transport_emit_event(self, event_type, payload or {})
    multiplayer_transport_broadcast_events(self, { evt })
end

multiplayer_transport_init = function(self)
    multiplayer_lag_sim_ensure_state(self)
    if self.mp_transport and self.mp_transport.shutdown then
        pcall(self.mp_transport.shutdown)
    end
    local steam_probe = nil
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") == "steam" then
        steam_probe = multiplayer_probe_steam_runtime(self)
        multiplayer_debug_log(self, "MP STEAM GATEA | init_probe_only=true")
        multiplayer_debug_log(self, "MP STEAM GATEB | bootstrap enabled=true")
        multiplayer_debug_log(self, "MP STEAM GATEC | bootstrap enabled=true")
        multiplayer_debug_log(self, "MP STEAM GATED | bootstrap enabled=true")
    end
    multiplayer_debug_log(self, string.format(
        "MP NET | transport_init mode=%s ws_url=%s room=%s local=%s host=%s steam_available=%s",
        tostring(MULTIPLAYER_TRANSPORT_MODE),
        tostring(MULTIPLAYER_TRANSPORT_WS_URL),
        tostring(MULTIPLAYER_TRANSPORT_ROOM_ID),
        tostring(self.mp_state and self.mp_state.local_player_id or ""),
        tostring(self.mp_state and self.mp_state.host_player_id or ""),
        tostring(steam_probe and steam_probe.available == true or false)
    ))
    self.mp_transport = MP_TRANSPORT.create({
        mode = MULTIPLAYER_TRANSPORT_MODE,
        ws_url = MULTIPLAYER_TRANSPORT_WS_URL,
        ws_room_id = MULTIPLAYER_TRANSPORT_ROOM_ID,
        ws_player_id = (self.mp_state and self.mp_state.local_player_id) or "p1",
        ws_host_player_id = (self.mp_state and self.mp_state.host_player_id) or "p1",
        ws_adapter = MP_WS_ADAPTER,
        steam_probe = steam_probe,
        steam_pairing_mode = multiplayer_lobby_get_pairing_intent(self),
        steam_log = function(message)
            multiplayer_debug_log(self, message)
        end,
        net_protocol_version = tonumber(NET_PROTOCOL_VERSION or 1) or 1,
        on_command = function(command)
            return multiplayer_transport_handle_command(self, command)
        end,
        on_event = function(event)
            multiplayer_transport_on_event(self, event)
        end,
        on_discovery_offer = function(offer, steam_lobby_id)
            if type(offer) ~= "table" then
                return
            end
            offer.steam_lobby_id = tostring(steam_lobby_id or offer.steam_lobby_id or "")
            multiplayer_lobby_ensure_runtime(self)
            local offer_id = tostring(offer.id or "")
            local existing = offer_id ~= "" and self.mp_lobby.offers_by_id[offer_id] or nil
            local changed = not existing
                or tostring(existing.status or "") ~= tostring(offer.status or "")
                or tonumber(existing.updated_at_ms or 0) ~= tonumber(offer.updated_at_ms or 0)
                or tostring(existing.host_name or "") ~= tostring(offer.host_name or "")
            if changed then
                multiplayer_debug_log(self, string.format(
                    "MP STEAM GATED | discovery_apply id=%s host=%s lobby=%s",
                    offer_id,
                    tostring(offer.host_name or ""),
                    tostring(offer.steam_lobby_id or "")
                ))
            end
            multiplayer_lobby_apply_offer_upsert(self, offer)
            if multiplayer_lobby_is_find_intent(self) then
                local offer_count = 0
                local distinct_host_steam = 0
                local seen_host_steam = {}
                for _, stored in pairs(self.mp_lobby.offers_by_id or {}) do
                    offer_count = offer_count + 1
                    local host_steam = tostring(stored and stored.host_steam_id or "")
                    if host_steam ~= "" and seen_host_steam[host_steam] ~= true then
                        seen_host_steam[host_steam] = true
                        distinct_host_steam = distinct_host_steam + 1
                    end
                end
                multiplayer_debug_log(self, string.format(
                    "MP STEAM GATED | discovery_merge offers=%d distinct_host_steam=%d",
                    offer_count,
                    distinct_host_steam
                ))
            end
        end,
        on_discovery_offer_cleared = function(steam_lobby_id)
            multiplayer_lobby_remove_offers_by_steam_lobby_id(self, steam_lobby_id)
        end,
        on_discovery_refresh = function(seen_lobby_ids, match_count)
            multiplayer_lobby_sync_discovery_from_steam_list(self, seen_lobby_ids, match_count)
        end,
        on_status = function(status, detail)
            if self.mp_state then
                self.mp_state.transport_status = status
                self.mp_state.transport_status_detail = detail or {}
            end
            if status == "gateb_ok" then
                if not multiplayer_lobby_is_host(self) and multiplayer_lobby_is_find_intent(self) then
                    local pending = tostring(self.mp_lobby and self.mp_lobby.pending_join_session_id or "")
                    local in_steam_lobby = false
                    if self.mp_transport and self.mp_transport.steam_get_lobby_id then
                        in_steam_lobby = tostring(self.mp_transport.steam_get_lobby_id() or "") ~= ""
                    end
                    if pending == "" and not in_steam_lobby then
                        multiplayer_debug_log(self, "MP LOBBY | gateb_ok_ignored reason=find_idle")
                        multiplayer_reset_steam_wire_handshake(self)
                        return
                    end
                end
                multiplayer_lobby_on_wire_ready(self)
                if self.mp_transport and self.mp_transport.flush_wire_queue then
                    pcall(self.mp_transport.flush_wire_queue)
                end
            elseif status == "lobby_join_entered" then
                if not multiplayer_lobby_is_host(self)
                    and tostring(self.mp_lobby and self.mp_lobby.pending_join_session_id or "") ~= ""
                then
                    if detail and detail.wire_ready == true then
                        multiplayer_lobby_on_wire_ready(self)
                    end
                    if self.mp_transport and self.mp_transport.flush_wire_queue then
                        pcall(self.mp_transport.flush_wire_queue)
                    end
                end
            elseif status == "discovery_browse" then
                multiplayer_lobby_on_discovery_browse(self, detail)
            elseif status == "host_lobby_created" then
                multiplayer_lobby_republish_steam_discovery_if_host(self)
            elseif status == "lobby_host_lost" then
                multiplayer_lobby_force_guest_disconnect(self, "host_lost", "chooser")
            elseif status == "gatec_ok" then
                multiplayer_lobby_on_wire_ready(self)
                multiplayer_lobby_prune_steam_disconnected_guests(self)
                multiplayer_lobby_deliver_pending_join_notifications(self)
                if self.mp_transport and self.mp_transport.flush_wire_queue then
                    self.mp_transport.flush_wire_queue()
                end
            elseif status == "lobby_alone" then
                multiplayer_lobby_prune_guests_on_host_alone(self)
            end
            multiplayer_debug_log(self, string.format("MP NET | transport_status=%s detail=%s", tostring(status), tostring(detail and detail.reason or detail and detail.mode or "")))
        end
    })
    if self.mp_transport and self.mp_transport.connect then
        self.mp_transport.connect()
    end
end

multiplayer_reset_ready_gate = function(self)
    if not (self.mp_state and self.mp_state.enabled) then
        return
    end
    self.mp_state.ready_by_player_id = {}
    for _, player_id in ipairs(self.mp_state.required_ready_player_ids or {}) do
        self.mp_state.ready_by_player_id[player_id] = false
    end
end

multiplayer_get_owned_unit_id_for_player = function(player_id)
    local defaults = multiplayer_get_default_seat_assignments(4)
    local units = defaults[player_id] or { "sarge" }
    return units[1] or "sarge"
end

multiplayer_get_runtime_local_player_id = function()
    local configured = MULTIPLAYER_LOCAL_PLAYER_ID or "p1"
    local config_override = sys.get_config and sys.get_config("multiplayer.local_player_id") or nil
    local has_explicit_override = false
    if config_override == "p1" or config_override == "p2" or config_override == "p3" or config_override == "p4" then
        configured = config_override
        has_explicit_override = true
    end
    local info = sys.get_sys_info and sys.get_sys_info() or nil
    local system_name = info and info.system_name or ""
    local is_html5_runtime = (system_name == "HTML5")
    -- Single-machine host+browser testing: if no explicit player override is set, browser defaults to p2.
    if is_html5_runtime and (not has_explicit_override) and configured == MULTIPLAYER_HOST_PLAYER_ID then
        return "p2"
    end
    return configured
end

multiplayer_get_active_player_id_for_commands = function(self)
    if not (self.mp_state and self.mp_state.enabled) then
        return "p1"
    end
    if self.mp_state.local_player_id ~= self.mp_state.host_player_id then
        return self.mp_state.local_player_id
    end
    return self.mp_state.debug_active_player_id or self.mp_state.host_player_id or "p1"
end

multiplayer_get_slot_player_id_for_network = function(self, network_player_id)
    local net_id = tostring(network_player_id or "")
    if net_id == "" then
        return "p1"
    end
    if not (self and self.mp_state and self.mp_state.enabled) then
        return net_id
    end
    local host_id = tostring(self.mp_state.host_player_id or "p1")
    if net_id == host_id then
        return "p1"
    end
    local ordered = {}
    ordered[1] = host_id
    for i = 1, 4 do
        local pid = "p" .. tostring(i)
        if pid ~= host_id then
            ordered[#ordered + 1] = pid
        end
    end
    for slot_index, pid in ipairs(ordered) do
        if pid == net_id then
            return "p" .. tostring(slot_index)
        end
    end
    return net_id
end

multiplayer_get_owned_unit_id_for_active_player = function(self)
    local network_player_id = multiplayer_get_active_player_id_for_commands(self)
    local slot_player_id = multiplayer_get_slot_player_id_for_network(self, network_player_id)
    if self.mp_state and self.mp_state.seat_assignments and self.mp_state.seat_assignments[slot_player_id] then
        local owned = self.mp_state.seat_assignments[slot_player_id]
        return owned[1] or multiplayer_get_owned_unit_id_for_player(slot_player_id)
    end
    return multiplayer_get_owned_unit_id_for_player(slot_player_id)
end

multiplayer_can_control_unit = function(self, unit_id)
    if not (self.mp_state and self.mp_state.enabled) then
        return true
    end
    local active_network_player = multiplayer_get_active_player_id_for_commands(self)
    local active_slot_player = multiplayer_get_slot_player_id_for_network(self, active_network_player)
    local owner = multiplayer_get_player_for_unit(self.mp_state.seat_assignments, self.mp_state.player_count or 4, unit_id)
    if not owner then
        return unit_id == multiplayer_get_owned_unit_id_for_active_player(self)
    end
    return owner == active_slot_player
end

multiplayer_player_owns_unit = function(self, player_id, unit_id)
    if not (self and self.mp_state and self.mp_state.seat_assignments) then
        return false
    end
    local slot_player_id = multiplayer_get_slot_player_id_for_network(self, player_id)
    local owner = multiplayer_get_player_for_unit(self.mp_state.seat_assignments, self.mp_state.player_count or 4, unit_id)
    return owner == slot_player_id
end

multiplayer_enforce_controlled_unit = function(self, force_select)
    if not self.squad_units then
        return
    end
    local active_network_player = multiplayer_get_active_player_id_for_commands(self)
    local active_slot_player = multiplayer_get_slot_player_id_for_network(self, active_network_player)
    local owned_units = (self.mp_state and self.mp_state.seat_assignments and self.mp_state.seat_assignments[active_slot_player]) or { multiplayer_get_owned_unit_id_for_active_player(self) }
    local chosen_unit_id = nil
    if self.controlled_unit_id then
        for _, unit_id in ipairs(owned_units) do
            if unit_id == self.controlled_unit_id then
                chosen_unit_id = unit_id
                break
            end
        end
    end
    if not chosen_unit_id then
        for _, unit_id in ipairs(owned_units) do
            local unit = self.squad_units[unit_id]
            if unit and (unit.current_health or 0) > 0 then
                chosen_unit_id = unit_id
                break
            end
        end
    end
    if not chosen_unit_id then
        chosen_unit_id = owned_units[1]
    end
    local owned_unit = chosen_unit_id and self.squad_units[chosen_unit_id] or nil
    if not (chosen_unit_id and owned_unit) then
        return
    end
    if self.controlled_unit_id ~= chosen_unit_id then
        clear_locked_manual_target(self)
    end
    self.controlled_unit_id = chosen_unit_id

    -- Keep selection deterministic when switching active multiplayer player:
    -- exactly one selected unit, and it must be the controlled owned unit.
    for _, unit in pairs(self.squad_units) do
        unit.is_selected = (unit.id == chosen_unit_id) and ((unit.current_health or 0) > 0) or false
    end
    self.comms_panel_open = false
    if force_select == true and (owned_unit.current_health or 0) <= 0 then
        owned_unit.is_selected = false
    end
end

init_multiplayer_runtime = function(self)
    local default_player_count = 4
    self.mp_state = {
        enabled = (MULTIPLAYER_ENABLED == true) and (self.multiplayer_mode_active == true),
        session_id = "local_session",
        host_player_id = MULTIPLAYER_HOST_PLAYER_ID,
        local_player_id = multiplayer_get_runtime_local_player_id(),
        mission_type = MISSION_TYPE_ESCAPE,
        turn_id = 1,
        player_count = default_player_count,
        required_ready_player_ids = multiplayer_get_required_ready_player_ids_for_count(default_player_count),
        seat_assignments = multiplayer_get_default_seat_assignments(default_player_count),
        ready_by_player_id = {},
        connected_players = {},
        transport_status = "idle",
        transport_status_detail = {},
        debug_active_player_id = nil,
        applying_remote_event = false,
        awaiting_snapshot = false,
        snapshot_blocking = false,
        awaiting_snapshot_timeout_s = 0,
        expected_snapshot_turn_id = 0,
        last_snapshot_retry_turn_id = 0,
        last_invalid_target_snapshot_turn_id = 0,
        pending_turn_state_snapshot_turn_id = 0,
        last_turn_state_snapshot_broadcast_turn_id = 0,
        realtime_snapshot_accum_s = 0,
        realtime_snapshot_seq = 0,
        realtime_last_applied_snapshot_seq = 0,
        realtime_snapshot_heartbeat_accum_s = 0,
        turn_based_snapshot_accum_s = 0,
        turn_based_heartbeat_mismatch_streak = 0,
        turn_based_heartbeat_last_request_turn_id = 0,
        turn_based_heartbeat_suspend_turn_id = 0,
        turn_based_last_unit_diff_signature = "",
        realtime_last_sent_signature = "",
        workshop_state_sync_accum_s = 0,
        workshop_state_sync_signature = "",
        factory_state_sync_accum_s = 0,
        factory_state_sync_signature = "",
        pending_events = {},
        post_turn_snapshot_delay_s = 0,
        event_seq = 0,
        seen_command_ids = {},
        seen_event_ids = {}
    }
    self.mp_telemetry = {
        enabled = MP_TELEMETRY_ENABLED == true,
        log_accum_s = 0,
        ping_accum_s = 0,
        rtt_last_ms = 0,
        rtt_samples_ms = {},
        tx_command_count = 0,
        tx_event_count = 0,
        rx_event_count = 0,
        rx_snapshot_count = 0,
        snapshot_apply_count = 0,
        snapshot_apply_failed_count = 0,
        state_correction_count = 0,
        max_position_error_px = 0,
        queued_event_count = 0,
        checksum_mismatch_count = 0,
        checksum_mismatch_units_count = 0,
        checksum_mismatch_actors_count = 0,
        checksum_mismatch_world_count = 0,
        checksum_mismatch_items_count = 0,
        turn_id_mismatch_count = 0,
        dt_spike_count = 0
    }
    self.mp_state.debug_active_player_id = self.mp_state.local_player_id
    if self.mp_state.enabled ~= true then
        self.mp_state.transport_status = "disabled"
        self.mp_state.transport_status_detail = { reason = "disabled_by_config_or_mode" }
    end
    print(string.format(
        "MP NET | identity | local=%s host=%s",
        tostring(self.mp_state.local_player_id),
        tostring(self.mp_state.host_player_id)
    ))
    print(string.format(
        "MP NET | build_version=%s build_digits=%s role=%s",
        tostring(MP_BUILD_VERSION_NUMBER or "0"),
        tostring(get_mp_build_version_digits(MP_BUILD_VERSION_NUMBER)),
        (self.mp_state.local_player_id == self.mp_state.host_player_id) and "host" or "client"
    ))
    multiplayer_reset_ready_gate(self)
    if self.mp_state.enabled == true then
        multiplayer_transport_init(self)
    else
        print("MP NET | transport_disabled_by_config_or_mode")
    end
end

workshop_state_signature = function(workshop_state)
    if type(workshop_state) ~= "table" then
        return ""
    end
    local tile_ids = {}
    for tile_instance_id, _ in pairs(workshop_state) do
        local tile_id = tonumber(tile_instance_id)
        if tile_id then
            table.insert(tile_ids, tile_id)
        end
    end
    table.sort(tile_ids)
    local parts = {}
    for _, tile_id in ipairs(tile_ids) do
        local state = workshop_state[tile_id] or workshop_state[tostring(tile_id)] or {}
        parts[#parts + 1] = string.format(
            "%d:%d:%d:%d:%d:%.3f:%.3f:%d:%d",
            tile_id,
            tonumber(state.selected_slot or 0) or 0,
            tonumber(state.paid_units or 0) or 0,
            state.transaction_locked == true and 1 or 0,
            state.payment_locked == true and 1 or 0,
            tonumber(state.production_time_left or 0) or 0,
            tonumber(state.payment_confirm_flash or 0) or 0,
            state.powered == true and 1 or 0,
            state.functional == true and 1 or 0
        )
    end
    return table.concat(parts, "|")
end

factory_state_signature = function(factory_state)
    if type(factory_state) ~= "table" then
        return ""
    end
    local tile_ids = {}
    for tile_instance_id, _ in pairs(factory_state) do
        local tile_id = tonumber(tile_instance_id)
        if tile_id then
            table.insert(tile_ids, tile_id)
        end
    end
    table.sort(tile_ids)
    local parts = {}
    for _, tile_id in ipairs(tile_ids) do
        local state = factory_state[tile_id] or factory_state[tostring(tile_id)] or {}
        parts[#parts + 1] = string.format(
            "%d:%d:%d:%d:%d",
            tile_id,
            state.powered == true and 1 or 0,
            state.functional == true and 1 or 0,
            tonumber(state.pending_tokens or 0) or 0,
            tonumber(state.stock_total or 0) or 0
        )
    end
    return table.concat(parts, "|")
end

multiplayer_get_civilian_by_id = function(self, civilian_id)
    if not (self and self.civilians and civilian_id) then
        return nil
    end
    local wanted_id = tonumber(civilian_id)
    if not wanted_id then
        return nil
    end
    for _, civilian in ipairs(self.civilians) do
        if civilian and tonumber(civilian.id or 0) == wanted_id then
            return civilian
        end
    end
    return nil
end

multiplayer_emit_combat_fx_event = function(self, payload)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return
    end
    if self.mp_state.local_player_id ~= self.mp_state.host_player_id then
        return
    end
    if self.mp_state.applying_remote_event == true then
        return
    end
    if type(payload) ~= "table" then
        return
    end
    multiplayer_transport_broadcast_event(self, "combat_fx", payload)
end

multiplayer_apply_combat_fx_event = function(self, payload)
    if type(payload) ~= "table" then
        return false
    end
    local fx_type = tostring(payload.fx_type or "")
    if fx_type == "alien_blood" then
        local alien = find_alien_by_id(self, tonumber(payload.alien_id or 0))
        if alien and (not alien.is_dead) and MELEE_RUNTIME and MELEE_RUNTIME.spawn_alien_blood_splatter_fx then
            MELEE_RUNTIME.spawn_alien_blood_splatter_fx(self, alien)
            return true
        end
        return false
    elseif fx_type == "human_blood" then
        local target_kind = tostring(payload.target_kind or "human")
        local target = nil
        if target_kind == "civilian" then
            target = multiplayer_get_civilian_by_id(self, payload.target_id)
            if target then
                target.target_kind = "civilian"
            end
        else
            target = self.squad_units and self.squad_units[payload.target_id] or nil
            if target then
                target.target_kind = "human"
            end
        end
        if target and MELEE_RUNTIME and MELEE_RUNTIME.spawn_human_blood_splatter_fx then
            MELEE_RUNTIME.spawn_human_blood_splatter_fx(self, target)
            return true
        end
        return false
    elseif fx_type == "alien_red_flash" then
        local alien = find_alien_by_id(self, tonumber(payload.alien_id or 0))
        if alien and (not alien.is_dead) and MELEE_RUNTIME and MELEE_RUNTIME.play_target_red_flash then
            MELEE_RUNTIME.play_target_red_flash(self, alien)
            return true
        end
        return false
    elseif fx_type == "alien_melee_swipe" then
        local target_kind = tostring(payload.target_kind or "human")
        local target = nil
        if target_kind == "civilian" then
            target = multiplayer_get_civilian_by_id(self, payload.target_id)
            if target then
                target.target_kind = "civilian"
            end
        else
            target = self.squad_units and self.squad_units[payload.target_id] or nil
            if target then
                target.target_kind = "human"
            end
        end
        if target and MELEE_RUNTIME and MELEE_RUNTIME.spawn_alien_melee_swipe_fx then
            MELEE_RUNTIME.spawn_alien_melee_swipe_fx(self, target)
            return true
        end
        return false
    elseif fx_type == "hazard_flash" then
        local target_kind = tostring(payload.target_kind or "human")
        local target = nil
        if target_kind == "civilian" then
            target = multiplayer_get_civilian_by_id(self, payload.target_id)
        else
            target = self.squad_units and self.squad_units[payload.target_id] or nil
        end
        if not target then
            return false
        end
        local tint = vmath.vector4(
            tonumber(payload.tint_r or 1) or 1,
            tonumber(payload.tint_g or 1) or 1,
            tonumber(payload.tint_b or 1) or 1,
            1
        )
        target.hazard_flash_tint = tint
        target.hazard_flash_active = true
        target.hazard_flash_token = (target.hazard_flash_token or 0) + 1
        local token = target.hazard_flash_token
        local duration_s = math.max(0.05, tonumber(payload.duration_s or 0.75) or 0.75)
        timer.delay(duration_s, false, function()
            if target and target.hazard_flash_token == token then
                target.hazard_flash_active = false
            end
        end)
        return true
    elseif fx_type == "human_damage_feedback" then
        local unit = self.squad_units and self.squad_units[payload.target_id] or nil
        if unit and (unit.current_health or 0) > 0 then
            trigger_human_portrait_hit_feedback(self, unit, tonumber(payload.damage or 1) or 1, true)
            return true
        end
        return false
    elseif fx_type == "brute_damage_flash" then
        local alien = find_alien_by_id(self, tonumber(payload.alien_id or 0))
        if alien and (not alien.is_dead) then
            alien.brute_damage_flash_timer = math.max(0.05, tonumber(payload.duration_s or 0.12) or 0.12)
            return true
        end
        return false
    elseif fx_type == "human_projectile" then
        local from_x = tonumber(payload.from_x or 0)
        local from_y = tonumber(payload.from_y or 0)
        local to_x = tonumber(payload.to_x or 0)
        local to_y = tonumber(payload.to_y or 0)
        local shooter_unit_id = payload.shooter_unit_id
        if shooter_unit_id and multiplayer_can_control_unit(self, shooter_unit_id) then
            return true
        end
        if not (from_x and from_y and to_x and to_y) then
            return false
        end
        local projectile_id = factory.create("/ui_factory#ui_factory", vmath.vector3(from_x, from_y, 0.75))
        if not projectile_id then
            return false
        end
        go.set_scale(vmath.vector3(SPITTER_PROJECTILE_SIZE * 0.2, SPITTER_PROJECTILE_SIZE * 0.2, 1), projectile_id)
        msg.post(msg.url(nil, projectile_id, "sprite"), "play_animation", { id = hash("human_projectile_1") })
        go.set(msg.url(nil, projectile_id, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
        local dir_x = to_x - from_x
        local dir_y = to_y - from_y
        if math.abs(dir_x) > 0.01 or math.abs(dir_y) > 0.01 then
            go.set_rotation(vmath.quat_rotation_z(math.atan2(dir_y, dir_x) + math.pi), projectile_id)
        end
        self.spitter_projectiles = self.spitter_projectiles or {}
        table.insert(self.spitter_projectiles, {
            kind = "human_remote",
            go_id = projectile_id,
            from = vmath.vector3(from_x, from_y, 0.75),
            to = vmath.vector3(to_x, to_y, 0.75),
            t = 0,
            speed = SPITTER_PROJECTILE_SPEED * 1.4
        })
        return true
    elseif fx_type == "brute_death_ring" then
        if not (LOOT_RUNTIME and LOOT_RUNTIME.spawn_impact_ring_at_world) then
            return false
        end
        local world_x = tonumber(payload.world_x or 0)
        local world_y = tonumber(payload.world_y or 0)
        if not (world_x and world_y) then
            return false
        end
        LOOT_RUNTIME.spawn_impact_ring_at_world(
            self,
            world_x,
            world_y,
            vmath.vector4(1.0, 0.55, 0.2, 1),
            math.max(0.05, tonumber(payload.duration_s or 0.7) or 0.7)
        )
        return true
    end
    return false
end

multiplayer_queue_pending_event = function(self, event)
    if not (self and self.mp_state and event and type(event) == "table") then
        return
    end
    self.mp_state.pending_events = self.mp_state.pending_events or {}
    table.insert(self.mp_state.pending_events, multiplayer_clone_simple_table(event) or {})
end

multiplayer_drain_pending_events = function(self)
    if not (self and self.mp_state) then
        return
    end
    local pending = self.mp_state.pending_events or {}
    self.mp_state.pending_events = {}
    for _, queued_event in ipairs(pending) do
        if queued_event and queued_event.type then
            multiplayer_transport_on_event(self, queued_event)
        end
    end
end

multiplayer_on_turn_advanced = function(self)
    if not (self.mp_state and self.mp_state.enabled) then
        return
    end
    self.mp_state.turn_id = (self.mp_state.turn_id or 1) + 1
    print(string.format("MP TURN | turn_advanced | turn_id=%d", self.mp_state.turn_id))
    print(string.format(
        "XXXXXX NEW TURN!!!! TURN IS %d | local=%s host=%s",
        self.mp_state.turn_id or 1,
        tostring(self.mp_state.local_player_id or "p1"),
        tostring(self.mp_state.host_player_id or "p1")
    ))
    multiplayer_reset_ready_gate(self)
end

can_advance_next_turn = function(self, emit_log)
    if not (self.mp_state and self.mp_state.enabled) then
        return true
    end
    if self.mp_state.local_player_id ~= self.mp_state.host_player_id then
        if emit_log then
            print("MP TURN | turn_advance_blocked | reason=not_host")
        end
        return false
    end
    local missing_ready = {}
    for _, player_id in ipairs(self.mp_state.required_ready_player_ids or {}) do
        if self.mp_state.ready_by_player_id[player_id] ~= true then
            missing_ready[#missing_ready + 1] = tostring(player_id)
        end
    end
    if emit_log and #missing_ready > 0 then
        print(string.format(
            "MP TURN | ready_gate_advisory_only | missing=%s",
            table.concat(missing_ready, ",")
        ))
    end
    return true
end

try_multiplayer_ready_buttons = function(self, screen_x, screen_y)
    if not (self.mp_state and self.mp_state.enabled) then
        return false
    end
    if self.alien_turn_active
        or self.pending_spitter_attack_phase
        or self.pending_melee_attack_phase
        or any_alien_is_moving(self)
        or any_civilian_is_moving(self)
    then
        return false
    end
    if self.mp_state.local_player_id == self.mp_state.host_player_id then
        return false
    end
    if not is_point_in_screen_rect(screen_x, screen_y, NEW_TURN_BUTTON_X, NEW_TURN_BUTTON_Y, NEW_TURN_BUTTON_W, NEW_TURN_BUTTON_H) then
        return false
    end
    local network_player_id = self.mp_state.local_player_id or multiplayer_get_active_player_id_for_commands(self)
    local player_id = network_player_id
    if multiplayer_get_slot_player_id_for_network then
        player_id = multiplayer_get_slot_player_id_for_network(self, network_player_id)
    end
    if not player_id then
        return false
    end
    local ready_on = not (
        self.mp_state.ready_by_player_id[player_id] == true
        or self.mp_state.ready_by_player_id[network_player_id] == true
    )
    multiplayer_transport_send_command(self, "set_ready", {
        player_id = player_id,
        ready = ready_on,
        turn_id = self.mp_state.turn_id or 1
    }, network_player_id)
    return true
end

try_multiplayer_debug_player_buttons = function(self, screen_x, screen_y)
    if not (self.mp_state and self.mp_state.enabled and self.ui and self.ui.mp_debug_player_buttons) then
        return false
    end
    if self.mp_state.local_player_id ~= self.mp_state.host_player_id then
        return false
    end
    for i, player_id in ipairs(self.mp_state.required_ready_player_ids or {}) do
        local remote_connected = (player_id ~= self.mp_state.host_player_id)
            and multiplayer_is_match_player_connected(self, player_id)
        local by = MULTIPLAYER_DEBUG_BUTTON_START_Y - ((i - 1) * MULTIPLAYER_DEBUG_BUTTON_Y_GAP)
        if is_point_in_screen_rect(
            screen_x,
            screen_y,
            MULTIPLAYER_DEBUG_BUTTON_X,
            by,
            MULTIPLAYER_DEBUG_BUTTON_HIT_SIZE,
            MULTIPLAYER_DEBUG_BUTTON_HIT_SIZE
        ) then
            if remote_connected then
                print(string.format("MP DEBUG | blocked | real player connected for %s", tostring(player_id)))
                return true
            end
            self.mp_state.debug_active_player_id = player_id
            multiplayer_enforce_controlled_unit(self, true)
            update_human_visual_state(self)
            update_selected_unit_ui(self)
            print(string.format("MP DEBUG | acting_as=%s", tostring(player_id)))
            return true
        end
    end
    return false
end

function try_launch_button(self, screen_x, screen_y)
    if (self.game_flow_state or FLOW_STATE_GAME) ~= FLOW_STATE_GAME then
        return false
    end
    local half_w = LAUNCH_BUTTON_W * 0.5
    local half_h = LAUNCH_BUTTON_H * 0.5
    if screen_x >= (LAUNCH_BUTTON_X - half_w)
        and screen_x <= (LAUNCH_BUTTON_X + half_w)
        and screen_y >= (LAUNCH_BUTTON_Y - half_h)
        and screen_y <= (LAUNCH_BUTTON_Y + half_h) then
        if self.mp_state and self.mp_state.enabled and self.mp_state.local_player_id ~= self.mp_state.host_player_id then
            print("Launch is host-only in multiplayer.")
            return true
        end
        if holdout_confirm_survival_if_ready(self) then
            return true
        end
        if LOOT_RUNTIME.try_launch_escape_pod then
            local launched = LOOT_RUNTIME.try_launch_escape_pod(self)
            if launched then
                enter_outro_flow_from_launch(self)
            end
        end
        return true
    end
    return false
end

function try_exit_game_button(self, screen_x, screen_y)
    if (self.game_flow_state or FLOW_STATE_GAME) ~= FLOW_STATE_GAME then
        return false
    end
    local half_w = EXIT_BUTTON_W * 0.5
    local half_h = EXIT_BUTTON_H * 0.5
    if screen_x >= (EXIT_BUTTON_X - half_w)
        and screen_x <= (EXIT_BUTTON_X + half_w)
        and screen_y >= (EXIT_BUTTON_Y - half_h)
        and screen_y <= (EXIT_BUTTON_Y + half_h) then
        if CLEANSE_RUNTIME and CLEANSE_RUNTIME.cleanse_clear_state then
            CLEANSE_RUNTIME.cleanse_clear_state(self)
        end
        if self.mp_state and self.mp_state.enabled then
            local local_player_id = tostring(self.mp_state.local_player_id or "p1")
            local host_player_id = tostring(self.mp_state.host_player_id or "p1")
            local session_id = tostring(self.mp_state.session_id or "local_session")
            if local_player_id == host_player_id then
                multiplayer_transport_broadcast_event(self, "match_aborted_to_lobby", {
                    session_id = session_id,
                    reason = "host_exit_button"
                })
                multiplayer_lobby_cancel_session(self, session_id)
                multiplayer_leave_in_progress_match_to_lobby(self, "host_exit_button")
            else
                local command_sender = multiplayer_get_active_player_id_for_commands(self)
                multiplayer_transport_send_command(self, "lobby_leave_session", {
                    session_id = session_id
                }, command_sender)
                multiplayer_transport_send_command(self, "leave_match_request", {
                    session_id = session_id,
                    reason = "client_exit_button"
                }, command_sender)
                if self.mp_transport and self.mp_transport.flush_wire_queue then
                    pcall(self.mp_transport.flush_wire_queue)
                end
                multiplayer_leave_in_progress_match_to_lobby(self, "client_exit_button")
            end
            return true
        end
        local selected_slot = tonumber(self.solo_active_mission_slot or (self.solo_setup and self.solo_setup.selected_mission_slot) or 1) or 1
        selected_slot = math.max(1, math.min(SOLO_SETUP_MISSION_COUNT, selected_slot))
        self.multiplayer_mode_active = false
        self.tutorial_mode = false
        if self.mp_state then
            self.mp_state.enabled = false
        end
        solo_setup_init_runtime(self)
        solo_setup_set_selected_slot(self, selected_slot)
        enter_flow_state(self, FLOW_STATE_SOLO_SETUP)
        return true
    end
    return false
end

try_toggle_mp_lag_sim_button = function(self, screen_x, screen_y)
    if MP_LAG_SIM_UI_ENABLED ~= true then
        return false
    end
    if (self.game_flow_state or FLOW_STATE_GAME) ~= FLOW_STATE_GAME then
        return false
    end
    local half_w = MP_LAG_SIM_BUTTON_W * 0.5
    local half_h = MP_LAG_SIM_BUTTON_H * 0.5
    if screen_x < (MP_LAG_SIM_BUTTON_X - half_w)
        or screen_x > (MP_LAG_SIM_BUTTON_X + half_w)
        or screen_y < (MP_LAG_SIM_BUTTON_Y - half_h)
        or screen_y > (MP_LAG_SIM_BUTTON_Y + half_h)
    then
        return false
    end
    local state = multiplayer_lag_sim_ensure_state(self)
    local current = tostring(state.mode or MP_LAG_SIM_MODE_OFF)
    local next_mode = MP_LAG_SIM_MODE_OFF
    if current == MP_LAG_SIM_MODE_OFF then
        next_mode = MP_LAG_SIM_MODE_LOW
    elseif current == MP_LAG_SIM_MODE_LOW then
        next_mode = MP_LAG_SIM_MODE_HIGH
    end
    multiplayer_lag_sim_set_mode(self, next_mode)
    show_advisory(self, string.format("MP LAG SIM: %s", string.upper(next_mode)), 1.0)
    if not (self.mp_state and self.mp_state.enabled) then
        show_advisory(self, "lag sim will apply in multiplayer", 1.0)
    end
    print(string.format("MP LAG SIM | mode=%s", tostring(next_mode)))
    return true
end

local function try_toggle_realtime_button(self, screen_x, screen_y)
    if (self.game_flow_state or FLOW_STATE_GAME) ~= FLOW_STATE_GAME then
        return false
    end
    local half_w = REALTIME_TOGGLE_BUTTON_W * 0.5
    local half_h = REALTIME_TOGGLE_BUTTON_H * 0.5
    if screen_x >= (REALTIME_TOGGLE_BUTTON_X - half_w)
        and screen_x <= (REALTIME_TOGGLE_BUTTON_X + half_w)
        and screen_y >= (REALTIME_TOGGLE_BUTTON_Y - half_h)
        and screen_y <= (REALTIME_TOGGLE_BUTTON_Y + half_h) then
        if REALTIME_TOGGLE_BUTTON_DISABLED == true then
            print("Realtime/Turn-based toggle is temporarily disabled.")
            return true
        end
        if self.mp_state and self.mp_state.enabled then
            if self.realtime_mp_enabled ~= true then
                print("Realtime multiplayer is disabled in config.")
                return true
            end
            if self.mp_state.local_player_id ~= self.mp_state.host_player_id then
                print("Realtime toggle is host-only in multiplayer.")
                return true
            end
        end
        if self.realtime_mode_locked == true and self.realtime_rules_enabled == true then
            print("Realtime mode is locked ON for this mission.")
            return true
        end
        self.realtime_rules_enabled = not (self.realtime_rules_enabled == true)
        update_realtime_toggle_button_visual(self)
        self.realtime_alien_tick_accum = 0
        self.realtime_civilian_tick_accum = 0
        self.realtime_blip_spawn_accum = 0
        if self.mp_state and self.mp_state.enabled and self.mp_state.local_player_id == self.mp_state.host_player_id then
            multiplayer_transport_broadcast_event(self, "realtime_mode_changed", {
                enabled = self.realtime_rules_enabled == true,
                turn_id = self.mp_state.turn_id or 1,
                unit_digest = multiplayer_build_unit_state_digest(self)
            })
        end
        print(string.format("Realtime rules: %s", self.realtime_rules_enabled and "ON" or "OFF"))
        return true
    end
    return false
end

local function try_toggle_objective_button(self, screen_x, screen_y)
    if (self.game_flow_state or FLOW_STATE_GAME) ~= FLOW_STATE_GAME then
        return false
    end
    if is_point_in_screen_rect(screen_x, screen_y, OBJECTIVE_BUTTON_X, OBJECTIVE_BUTTON_Y, OBJECTIVE_BUTTON_W, OBJECTIVE_BUTTON_H) then
        self.objective_reminder_visible = not (self.objective_reminder_visible == true)
        return true
    end
    return false
end

realtime_mp_host_can_simulate = function(self)
    if not (self and self.realtime_rules_enabled == true) then
        return false
    end
    if not self.mp_state or self.mp_state.enabled ~= true then
        return true
    end
    if self.realtime_mp_enabled ~= true then
        return false
    end
    return self.mp_state.local_player_id == self.mp_state.host_player_id
end

function try_toggle_aesthetic_ui_button(self, screen_x, screen_y)
    local half_w = AESTHETIC_BUTTON_W * 0.5
    local half_h = AESTHETIC_BUTTON_H * 0.5
    if screen_x >= (AESTHETIC_BUTTON_X - half_w)
        and screen_x <= (AESTHETIC_BUTTON_X + half_w)
        and screen_y >= (AESTHETIC_BUTTON_Y - half_h)
        and screen_y <= (AESTHETIC_BUTTON_Y + half_h) then
        toggle_aesthetic_mode(self)
        return true
    end
    return false
end

function try_zoom_in_button(self, screen_x, screen_y)
    if ZOOM_SLIDER_ENABLED == true then
        return false
    end
    local half_w = ZOOM_IN_BUTTON_W * 0.5
    local half_h = ZOOM_IN_BUTTON_H * 0.5
    if screen_x >= (ZOOM_IN_BUTTON_X - half_w)
        and screen_x <= (ZOOM_IN_BUTTON_X + half_w)
        and screen_y >= (ZOOM_IN_BUTTON_Y - half_h)
        and screen_y <= (ZOOM_IN_BUTTON_Y + half_h) then
        request_zoom_delta(self, 0.12, screen_x, screen_y)
        return true
    end
    return false
end

function try_zoom_out_button(self, screen_x, screen_y)
    if ZOOM_SLIDER_ENABLED == true then
        return false
    end
    local half_w = ZOOM_OUT_BUTTON_W * 0.5
    local half_h = ZOOM_OUT_BUTTON_H * 0.5
    if screen_x >= (ZOOM_OUT_BUTTON_X - half_w)
        and screen_x <= (ZOOM_OUT_BUTTON_X + half_w)
        and screen_y >= (ZOOM_OUT_BUTTON_Y - half_h)
        and screen_y <= (ZOOM_OUT_BUTTON_Y + half_h) then
        request_zoom_delta(self, -0.12, screen_x, screen_y)
        return true
    end
    return false
end

LOOT_RUNTIME = require("main.loot_runtime_markers").extend(LOOT_RUNTIME, {
    LOOT_UI = LOOT_UI,
    COMPONENT_UI = COMPONENT_UI,
    CELL_WIDTH = CELL_WIDTH,
    CELL_HEIGHT = CELL_HEIGHT,
    coords_to_id = coords_to_id,
    coords_to_world_pos = coords_to_world_pos,
    screen_to_world = screen_to_world,
    get_current_mission_type = get_current_mission_type,
    get_dna_mission_status = get_dna_mission_status,
    get_loot_objects = function() return loot_objects end,
    get_machine_objects = function() return machine_objects end,
    get_turret_tripod_objects = function(self_ref)
        self_ref.turret_tripod_objects = self_ref.turret_tripod_objects or {}
        return self_ref.turret_tripod_objects
    end,
    get_turret_gun_objects = function(self_ref)
        self_ref.turret_gun_objects = self_ref.turret_gun_objects or {}
        return self_ref.turret_gun_objects
    end,
    play_break_barricade_sfx = function(self_ref, world_x, world_y)
        play_break_barricade_sfx(self_ref, world_x, world_y)
    end,
    mp_is_local_host = function(self_ref)
        return self_ref
            and self_ref.mp_state
            and self_ref.mp_state.enabled
            and self_ref.mp_state.local_player_id == self_ref.mp_state.host_player_id
    end
})
LOOT_RUNTIME = require("main.loot_runtime_actions").extend(LOOT_RUNTIME, {
    LOOT_UI = LOOT_UI,
    COMMAND_UI = COMMAND_UI,
    COMPONENT_UI = COMPONENT_UI,
    CELL_WIDTH = CELL_WIDTH,
    CELL_HEIGHT = CELL_HEIGHT,
    HUMAN_FLOOR_OFFSET_FROM_CELL_BOTTOM = HUMAN_FLOOR_OFFSET_FROM_CELL_BOTTOM,
    UI_BACKPACK_COLS = UI_BACKPACK_COLS,
    UI_BACKPACK_ROWS = UI_BACKPACK_ROWS,

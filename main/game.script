        set_ui_square_transform(self, self.ui.flow_demo_select_back_art, DEMO_SELECT_BACK_BUTTON_X, DEMO_SELECT_BACK_BUTTON_Y, FLOW_UI_BUTTON_Z + 0.001, vmath.vector4(1, 1, 1, 1), 1, 1)
        set_ui_square_transform(self, self.ui.flow_demo_result_win_art, -9999, -9999, DEMO_RESULT_PANEL_Z, hidden, DEMO_RESULT_PANEL_SCALE, DEMO_RESULT_PANEL_SCALE)
        set_ui_square_transform(self, self.ui.flow_demo_result_lose_art, -9999, -9999, DEMO_RESULT_PANEL_Z, hidden, DEMO_RESULT_PANEL_SCALE, DEMO_RESULT_PANEL_SCALE)

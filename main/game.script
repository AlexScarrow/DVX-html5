multiplayer_get_debug_file_path = function()
    local override_path = tostring((sys.get_config and sys.get_config("dvx.mp_debug_path")) or "")
    if override_path ~= "" then
        return override_path
    end
    if sys.get_save_file then
        return tostring(sys.get_save_file("DVX", MULTIPLAYER_DEBUG_FILE_NAME or "dvx_mp_debug.txt") or "")
    end
    return tostring(MULTIPLAYER_DEBUG_FILE_NAME or "dvx_mp_debug.txt")
end

multiplayer_debug_file_reset = function(self)
    if MULTIPLAYER_DEBUG_FILE_ENABLED ~= true then
        return
    end
    local path = multiplayer_get_debug_file_path()
    if self then
        self.mp_debug_file_path = path
    end
    if path == "" then
        print("MP DEBUG | file path unavailable.")
        return
    end
    local ok_reset, err_reset = pcall(function()
        local handle = io.open(path, "w")
        if handle then
            handle:write("DVX MP DEBUG LOG\n")
            handle:write("================\n")
            handle:close()
        end
    end)
    if not ok_reset then
        print("MP DEBUG | file reset failed: " .. tostring(err_reset))
        return
    end
    print("MP DEBUG | file reset: " .. tostring(path))
end

multiplayer_debug_log = function(self, message)
    local line = string.format(
        "%s | %s",
        tostring(os.date and os.date("%Y-%m-%d %H:%M:%S") or "time_unknown"),
        tostring(message or "")
    )
    print(line)
    if MULTIPLAYER_DEBUG_FILE_ENABLED ~= true then
        return
    end
    local path = tostring(self and self.mp_debug_file_path or multiplayer_get_debug_file_path() or "")
    if path == "" then
        return
    end
    local ok_append, err_append = pcall(function()
        local handle = io.open(path, "a")
        if handle then
            handle:write(line .. "\n")
            handle:close()
        end
    end)
    if not ok_append then
        print("MP DEBUG | file append failed: " .. tostring(err_append))
    end
end

multiplayer_probe_steam_runtime = function(self)
    local probe = {
        available = false,
        backend_source = "none",
        has_send_message_to_user = false,
        has_receive_messages_on_channel = false,
        has_accept_session_with_user = false,
        has_matchmaking_create_lobby = false,
        has_matchmaking_request_lobby_list = false,
        has_callback_pump = false
    }
    local backend = nil
    if STEAM_RUNTIME and type(STEAM_RUNTIME.get_backend) == "function" then
        local ok_backend, backend_or_err = pcall(STEAM_RUNTIME.get_backend)
        if ok_backend and type(backend_or_err) == "table" then
            backend = backend_or_err
            probe.backend_source = "steam_runtime"
        else
            multiplayer_debug_log(self, "MP STEAM PROBE | runtime_get_backend_failed=" .. tostring(backend_or_err))
        end
    end
    if type(backend) ~= "table" then
        local steam_global = rawget(_G, "steam")
        if type(steam_global) == "table" then
            backend = steam_global
            probe.backend_source = "steam_global"
        end
    end
    if type(backend) == "table" then
        probe.available = true
        probe.has_send_message_to_user = type(backend.networking_send_message_to_user) == "function"
        probe.has_receive_messages_on_channel = type(backend.networking_receive_messages_on_channel) == "function"
        probe.has_accept_session_with_user = type(backend.networking_accept_session_with_user) == "function"
        probe.has_matchmaking_create_lobby = type(backend.matchmaking_create_lobby) == "function"
        probe.has_matchmaking_request_lobby_list = type(backend.matchmaking_request_lobby_list) == "function"
    end
    local steam_global = rawget(_G, "steam")
    probe.has_callback_pump =
        (STEAM_RUNTIME and type(STEAM_RUNTIME.update) == "function")
        or (type(steam_global) == "table" and (type(steam_global.update) == "function" or type(steam_global.run_callbacks) == "function"))
        or false
    multiplayer_debug_log(self, string.format(
        "MP STEAM PROBE | source=%s available=%s send=%s recv=%s accept=%s mm_create=%s mm_list=%s callbacks=%s",
        tostring(probe.backend_source),
        tostring(probe.available),
        tostring(probe.has_send_message_to_user),
        tostring(probe.has_receive_messages_on_channel),
        tostring(probe.has_accept_session_with_user),
        tostring(probe.has_matchmaking_create_lobby),
        tostring(probe.has_matchmaking_request_lobby_list),
        tostring(probe.has_callback_pump)
    ))
    return probe
end


play_human_alien_alert_sfx = function(self, unit)
    local wx = nil
    local wy = nil
    if unit and unit.go_path then
        local pos = go.get_position(unit.go_path)
        if pos then
            wx = pos.x
            wy = pos.y
        end
    end
    if (wx == nil or wy == nil) and unit and unit.cell_id and self and self.world_grid and self.world_grid[unit.cell_id] then
        local cell = self.world_grid[unit.cell_id]
        wx, wy = coords_to_world_pos(cell.xCell, cell.yCell)
    end
    local class_id = tostring(unit and unit.class_id or "")
    local sfx_key = nil
    if class_id == UNIT_CLASS_SARGE then
        sfx_key = "sarge_alien_alert"
    elseif class_id == UNIT_CLASS_TECHIE then
        sfx_key = "techie_alien_alert"
    elseif class_id == UNIT_CLASS_MEDIC then
        sfx_key = "medic_alien_alert"
    elseif class_id == UNIT_CLASS_GUNNER then
        sfx_key = "gunner_alien_alert"
    end
    if not sfx_key then
        return
    end
    if wx ~= nil and wy ~= nil then
        local played = play_sfx_one_shot_spatial(
            self,
            sfx_key,
            wx,
            wy,
            tonumber(HUMAN_ALERT_SPATIAL_MIN_DIST or (CELL_WIDTH * 0.8)) or (CELL_WIDTH * 0.8),
            tonumber(HUMAN_ALERT_SPATIAL_MAX_DIST or (CELL_WIDTH * 5.0)) or (CELL_WIDTH * 5.0)
        )
        if played then
            return
        end
    end
    play_sfx_one_shot(self, sfx_key)
end


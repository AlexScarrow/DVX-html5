[project]
title = Derples vs Xenos
version = 1.1
developer = Grrr Games
dependencies#0 = https://github.com/defold/extension-websocket/archive/master.zip
dependencies#1 = https://github.com/defold/extension-steam/archive/refs/tags/1.14.0.zip

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 1280
height = 720
high_dpi = 0
resizable = 1

[render]
clear_color_red = 0.0
clear_color_green = 0.0
clear_color_blue = 0.0
clear_color_alpha = 1

[physics]
scale = 0.02
debug = 0

[script]
shared_state = 1

[sprite]
max_count = 5000

[sound]
max_component_count = 128

[collection]
max_instances = 4096

[particle_fx]
max_count = 512

[html5]
htmlfile = /web/index.html

[windows]
app_icon = /assets/icons/DVX_icon.ico

[multiplayer]
sync_trace = 0

[debug]
outro_preview = 0
outro_preview_sequence = title
outro_preview_result = win

[dvx]
env_name = LOCAL
net_protocol_version = 1
transport_mode = steam
transport_ws_url = ws://90.199.227.250:8080/ws
transport_room_id = dvx_remote_friend_20260509
disable_multiplayer = 0
lock_fixed_window = 0
start_maximized = 1

[leaderboard]
supabase_enabled = 1
supabase_url = https://fvgdbkyfxqhfitijmbul.supabase.co
supabase_anon_key = sb_publishable_PY27WC504R0SYduTgsw8Nw_yZt3LzEO
supabase_submit_function = submit-leaderboard-score
supabase_read_limit = 100


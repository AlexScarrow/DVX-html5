HUD_LAYOUT_BASE_MP_BUILD_HUD_RIGHT_X = MP_NET_STATUS_DOT_X - 14
HUD_LAYOUT_BASE_MP_BUILD_HUD_Y = MP_NET_STATUS_DOT_Y

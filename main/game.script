        return
    end
    if wx ~= nil and wy ~= nil then
        local played = play_sfx_one_shot_spatial(
            self,
            sfx_key,
            wx,
            wy,
            tonumber(HUMAN_ITEM_RECIEVE_SPATIAL_MIN_DIST or (CELL_WIDTH * 0.8)) or (CELL_WIDTH * 0.8),

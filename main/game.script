    if id and anim_id then
        msg.post(msg.url(nil, id, "sprite"), "play_animation", { id = anim_id })
    end
    return id
end

create_pin_panel_sprite = function(z)
    local id = factory.create("/pin_panel_factory#pin_panel_factory", vmath.vector3(-9999, -9999, z or SOLO_SETUP_UI_Z + 0.001))
    if id then
        pcall(go.set, msg.url(nil, id, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
    end

multiplayer_is_mp_status_advisory = function(anim_id)
    return anim_id == ADVISORY_ANIM_MP_CREATING_SESSION
        or anim_id == ADVISORY_ANIM_MP_FINDING_PLAYERS
        or anim_id == ADVISORY_ANIM_MP_JOINING_GAME
        or anim_id == ADVISORY_ANIM_MP_JOINED_GAME
        or anim_id == ADVISORY_ANIM_MP_UPDATE_NOT_ALLOWED
        or anim_id == ADVISORY_ANIM_MP_WAITING_GUEST_SYNC
        or anim_id == ADVISORY_ANIM_MP_SESSION_FULL
        or anim_id == ADVISORY_ANIM_TRY_AGAIN
end

show_mp_lobby_advisory = function(self, duration_s, advisory_kind)
    if not self then
        return
    end
    local kind = tostring(advisory_kind or "host")
    local anim_id = ADVISORY_ANIM_MP_CREATING_SESSION
    if kind == "find" then
        anim_id = ADVISORY_ANIM_MP_FINDING_PLAYERS
    elseif kind == "joining" then
        anim_id = ADVISORY_ANIM_MP_JOINING_GAME
    elseif kind == "joined" then
        anim_id = ADVISORY_ANIM_MP_JOINED_GAME
    elseif kind == "update_not_allowed" then
        anim_id = ADVISORY_ANIM_MP_UPDATE_NOT_ALLOWED
    elseif kind == "waiting_guest_sync" then
        anim_id = ADVISORY_ANIM_MP_WAITING_GUEST_SYNC
    elseif kind == "session_full" then
        anim_id = ADVISORY_ANIM_MP_SESSION_FULL
    elseif kind == "try_again" then
        anim_id = ADVISORY_ANIM_TRY_AGAIN
    end
    self.advisory_anim_id = anim_id
    self.advisory_timer_s = tonumber(duration_s or ADVISORY_DEFAULT_DURATION) or ADVISORY_DEFAULT_DURATION
end

show_advisory = function(self, text, duration_s)
    if not self then
        return
    end
    local anim_id = nil
    if text == ADVISORY_MSG_NO_AMMO then
        anim_id = ADVISORY_ANIM_NO_AMMO
    elseif text == ADVISORY_MSG_TECHIE_ONLY then
        anim_id = ADVISORY_ANIM_TECHIE_ONLY
    elseif text == ADVISORY_MSG_NO_AP then
        anim_id = ADVISORY_ANIM_NO_AP
    elseif text == ADVISORY_MSG_HAZARD_O2 then
        anim_id = ADVISORY_ANIM_HAZARD_O2
    elseif text == ADVISORY_MSG_HAZARD_GAS then
        anim_id = ADVISORY_ANIM_HAZARD_GAS
    elseif text == ADVISORY_MSG_HAZARD_FIRE then
        anim_id = ADVISORY_ANIM_HAZARD_FIRE
    elseif text == ADVISORY_MSG_FIX_WIRE_FIRST then
        anim_id = ADVISORY_ANIM_FIX_WIRE_FIRST
    elseif text == ADVISORY_MSG_VENDING_NEEDS_POWER_FUSE then
        anim_id = ADVISORY_ANIM_VENDING_NEEDS_POWER_FUSE
    elseif text == ADVISORY_MSG_PROTOCOL_MISMATCH then
        anim_id = ADVISORY_ANIM_PROTOCOL_MISMATCH
    elseif text == ADVISORY_MSG_NO_CLEAR_SHOT then
        anim_id = ADVISORY_ANIM_NO_CLEAR_SHOT
    elseif text == ADVISORY_MSG_ONLY_SARGE_FAB then
        anim_id = ADVISORY_ANIM_ONLY_SARGE_FAB
    elseif text == ADVISORY_MSG_BACKPACK_FULL then
        anim_id = ADVISORY_ANIM_BACKPACK_FULL
    elseif text == ADVISORY_MSG_MOVE_UNIT_CLOSER then
        anim_id = ADVISORY_ANIM_MOVE_UNIT_CLOSER
    elseif text == ADVISORY_MSG_TRY_AGAIN then
        anim_id = ADVISORY_ANIM_TRY_AGAIN
    elseif text == ADVISORY_MSG_DEPLOY_POD_ITEMS_FIRST then
        anim_id = ADVISORY_ANIM_DEPLOY_POD_ITEMS_FIRST
    elseif text == ADVISORY_MSG_NO_SPACE_GUN_TURRET then
        anim_id = ADVISORY_ANIM_NO_SPACE_GUN_TURRET
    end
    if not anim_id then
        self.advisory_anim_id = nil
        self.advisory_timer_s = 0
        return
    end
    self.advisory_anim_id = anim_id
    self.advisory_timer_s = tonumber(duration_s or ADVISORY_DEFAULT_DURATION) or ADVISORY_DEFAULT_DURATION
end

update_advisory_ui = function(self, dt)
    if not (self and self.ui and self.ui.advisory_sprite) then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    local flow_state = (self.game_flow_state or FLOW_STATE_GAME)
    local pending_join = flow_state == FLOW_STATE_MP_LOBBY
        and self.mp_lobby
        and tostring(self.mp_lobby.pending_join_session_id or "") ~= ""
    if pending_join then
        self.advisory_anim_id = ADVISORY_ANIM_MP_JOINING_GAME
    else
        self.advisory_timer_s = math.max(0, (tonumber(self.advisory_timer_s or 0) or 0) - (tonumber(dt or 0) or 0))
    end
    local mp_status_advisory = multiplayer_is_mp_status_advisory(self.advisory_anim_id)
    local can_show_for_flow = (flow_state == FLOW_STATE_GAME)
        or (flow_state == FLOW_STATE_MP_LOBBY and (
            self.advisory_anim_id == ADVISORY_ANIM_PROTOCOL_MISMATCH
            or mp_status_advisory
        ))
        or (flow_state == FLOW_STATE_MP_SETUP and mp_status_advisory)
    local advisory_z = ADVISORY_TEXT_Z
    if flow_state == FLOW_STATE_MP_LOBBY or flow_state == FLOW_STATE_MP_SETUP then
        advisory_z = FLOW_UI_BUTTON_Z + 0.02
    end
    local should_show = can_show_for_flow
        and (pending_join or self.advisory_timer_s > 0)
        and self.advisory_anim_id ~= nil
    if not should_show then
        set_ui_square_transform(self, self.ui.advisory_sprite, -9999, -9999, advisory_z, hidden, ADVISORY_TEXT_SCALE, ADVISORY_TEXT_SCALE)
        return
    end
    if self.advisory_anim_active ~= self.advisory_anim_id then
        msg.post(msg.url(nil, self.ui.advisory_sprite, "sprite"), "play_animation", { id = self.advisory_anim_id })
        self.advisory_anim_active = self.advisory_anim_id
    end
    local advisory_y = tonumber(NEW_TURN_BUTTON_Y or ADVISORY_TEXT_Y) or ADVISORY_TEXT_Y
    set_ui_square_transform(
        self,
        self.ui.advisory_sprite,
        SCREEN_WIDTH * 0.5,
        advisory_y,
        advisory_z,
        vmath.vector4(1, 1, 1, 1),
        ADVISORY_TEXT_SCALE,
        ADVISORY_TEXT_SCALE
    )
end

function is_point_in_screen_rect(screen_x, screen_y, cx, cy, w, h)
    local half_w = w * 0.5
    local half_h = h * 0.5
    return screen_x >= (cx - half_w)
        and screen_x <= (cx + half_w)
        and screen_y >= (cy - half_h)
        and screen_y <= (cy + half_h)
end

function ensure_score_state(self)
    local mission_type = get_current_mission_type(self)
    local score_profile_id = "escape_pod"
    if mission_type == MISSION_TYPE_RESCUE then
        score_profile_id = "escort"
    elseif mission_type == MISSION_TYPE_PURGE then
        score_profile_id = "purge_and_power"
    elseif mission_type == MISSION_TYPE_CLEANSE then
        score_profile_id = "purge_and_power"
    elseif mission_type == MISSION_TYPE_DNA_SAMPLE then
        score_profile_id = "holdout"
    elseif mission_type == MISSION_TYPE_HOLDOUT then
        score_profile_id = "holdout"
    end
    if not self.score_state then
        self.score_state = SCORE_RUNTIME.create_state(score_profile_id)
    else
        self.score_state = SCORE_RUNTIME.set_mission_type(self.score_state, score_profile_id)
    end
    return self.score_state
end

function get_current_score_total(self)
    local state = ensure_score_state(self)
    if self and self.game_won ~= true
        and get_current_mission_type(self) ~= MISSION_TYPE_HOLDOUT
        and LOOT_RUNTIME
        and LOOT_RUNTIME.get_launch_status
    then
        local launch_status = LOOT_RUNTIME.get_launch_status(self) or {}
        local preview_saved = math.max(0, tonumber(launch_status.seated_humans or 0) or 0)
        state.metrics = state.metrics or {}
        state.metrics.humans_escaped_on_launch = preview_saved
    end
    local result = SCORE_RUNTIME.compute_score(state)
    local total = math.max(0, math.floor((result and result.total) or 0))
    self.score_display_total = total
    return self.score_display_total
end

function update_score_hud(self, visible)
    if not self.ui or not self.ui.score_digit_icons then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    if visible ~= true then
        for _, digit_id in ipairs(self.ui.score_digit_icons) do
            set_ui_square_transform(self, digit_id, -9999, -9999, SCORE_HUD_Z, hidden, SCORE_HUD_DIGIT_DRAW_W * 0.021, SCORE_HUD_DIGIT_DRAW_H * 0.021)
        end
        update_ranged_hit_preview_hud(self, false)
        update_flamer_confirm_hud(self, false)
        return
    end

    local score_text = tostring(get_current_score_total(self))
    if #score_text > SCORE_HUD_MAX_DIGITS then
        score_text = string.sub(score_text, #score_text - SCORE_HUD_MAX_DIGITS + 1)
    end
    local count = #score_text
    local start_x = SCORE_HUD_CENTER_X - ((count - 1) * SCORE_HUD_DIGIT_SPACING_PX * 0.5)
    for idx, digit_id in ipairs(self.ui.score_digit_icons) do
        if idx <= count then
            local ch = string.sub(score_text, idx, idx)
            msg.post(msg.url(nil, digit_id, "sprite"), "play_animation", { id = hash("score_" .. ch) })
            local dx = start_x + ((idx - 1) * SCORE_HUD_DIGIT_SPACING_PX)
            set_ui_square_transform(
                self,
                digit_id,
                dx,
                SCORE_HUD_Y,
                SCORE_HUD_Z,
                vmath.vector4(1, 1, 1, 1),
                SCORE_HUD_DIGIT_DRAW_W * 0.021,
                SCORE_HUD_DIGIT_DRAW_H * 0.021
            )
        else
            set_ui_square_transform(self, digit_id, -9999, -9999, SCORE_HUD_Z, hidden, SCORE_HUD_DIGIT_DRAW_W * 0.021, SCORE_HUD_DIGIT_DRAW_H * 0.021)
        end
    end
    update_ranged_hit_preview_hud(self, true)
    update_flamer_confirm_hud(self, true)
end

update_score_flow_digits = function(self, visible)
    if not self.ui or not self.ui.score_digit_icons then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    local draw_w = SCORE_HUD_DIGIT_DRAW_W * 0.021 * SCORE_FLOW_DIGIT_SCALE
    local draw_h = SCORE_HUD_DIGIT_DRAW_H * 0.021 * SCORE_FLOW_DIGIT_SCALE
    if visible ~= true then
        for _, digit_id in ipairs(self.ui.score_digit_icons) do
            set_ui_square_transform(self, digit_id, -9999, -9999, FLOW_UI_PANEL_Z + 0.005, hidden, draw_w, draw_h)
        end
        return
    end

    local breakdown = self.flow_score_breakdown or { total = 0 }
    local score_text = tostring(math.max(0, math.floor(tonumber(breakdown.total or 0) or 0)))
    if #score_text > SCORE_HUD_MAX_DIGITS then
        score_text = string.sub(score_text, #score_text - SCORE_HUD_MAX_DIGITS + 1)
    end
    local count = #score_text
    local center_x = SCORE_FLOW_DIGIT_CENTER_X
    local draw_y = SCORE_FLOW_DIGIT_Y
    if LEADERBOARD_DEBUG_LAYOUT_ENABLED then
        center_x = LEADERBOARD_DEBUG_SCORE_X
        draw_y = LEADERBOARD_DEBUG_ROW_Y
    end
    local start_x = center_x - ((count - 1) * SCORE_FLOW_DIGIT_SPACING_PX * 0.5)
    for idx, digit_id in ipairs(self.ui.score_digit_icons) do
        if idx <= count then
            local ch = string.sub(score_text, idx, idx)
            msg.post(msg.url(nil, digit_id, "sprite"), "play_animation", { id = hash("score_" .. ch) })
            local dx = start_x + ((idx - 1) * SCORE_FLOW_DIGIT_SPACING_PX)
            set_ui_square_transform(self, digit_id, dx, draw_y, FLOW_UI_PANEL_Z + 0.005, vmath.vector4(1, 1, 1, 1), draw_w, draw_h)
        else
            set_ui_square_transform(self, digit_id, -9999, -9999, FLOW_UI_PANEL_Z + 0.005, hidden, draw_w, draw_h)
        end
    end
end

update_score_flow_team_names = function(self, visible)
    if not self.ui or not self.ui.flow_score_team_name_letters then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    for _, letter_id in ipairs(self.ui.flow_score_team_name_letters) do
        set_ui_square_transform(self, letter_id, -9999, -9999, FLOW_UI_PANEL_Z + 0.006, hidden, 1, 1)
    end
    if visible ~= true then
        return
    end
    local score_state = self.game_flow_state or FLOW_STATE_GAME
    if score_state ~= FLOW_STATE_SCORE_SOLO and score_state ~= FLOW_STATE_SCORE_MP then
        return
    end
    local names = nil
    if self.flow_score_team_display_names and type(self.flow_score_team_display_names) == "table" then
        names = self.flow_score_team_display_names
    elseif self.flow_score_last_publish_payload and type(self.flow_score_last_publish_payload.team_display_names) == "table" then
        names = self.flow_score_last_publish_payload.team_display_names
    end
    if score_state == FLOW_STATE_SCORE_SOLO and (type(names) ~= "table" or #names <= 0) then
        local solo_id = tostring((self.mp_state and self.mp_state.local_player_id) or "p1")
        names = { mp_alpha_label_from_network_id(solo_id) }
    end
    if type(names) ~= "table" then
        return
    end
    local tokens = {}
    for _, name in ipairs(names) do
        local clean = mp_lobby_sanitize_name(name)
        if clean ~= "" then
            tokens[#tokens + 1] = clean
        end
    end
    if #tokens <= 0 then
        return
    end
    local name_draw_y = SCORE_FLOW_TEAM_Y
    local name_start_x_override = nil
    if LEADERBOARD_DEBUG_LAYOUT_ENABLED then
        name_draw_y = LEADERBOARD_DEBUG_ROW_Y
        name_start_x_override = LEADERBOARD_DEBUG_NAME_X
    end
    local spans = {}
    local total_span = 0
    for i, token in ipairs(tokens) do
        local token_span = math.max(1, #token) * SCORE_FLOW_TEAM_LETTER_SPACING
        spans[i] = token_span
        total_span = total_span + token_span
        if i < #tokens then
            total_span = total_span + SCORE_FLOW_TEAM_TOKEN_GAP
        end
    end
    local cursor_x = SCORE_FLOW_DIGIT_CENTER_X - (total_span * 0.5)
    if name_start_x_override then
        cursor_x = name_start_x_override
    end
    local letter_cursor = 1
    for token_index, token in ipairs(tokens) do
        for ci = 1, #token do
            local glyph_id = self.ui.flow_score_team_name_letters[letter_cursor]
            if not glyph_id then
                return
            end
            local ch = string.sub(token, ci, ci)
            msg.post(msg.url(nil, glyph_id, "sprite"), "play_animation", { id = mp_lobby_name_glyph_anim_id(ch) })
            set_ui_square_transform(
                self,
                glyph_id,
                cursor_x + ((ci - 1) * SCORE_FLOW_TEAM_LETTER_SPACING),
                name_draw_y,
                FLOW_UI_PANEL_Z + 0.006,
                vmath.vector4(1, 1, 1, 0.98),
                SCORE_FLOW_TEAM_LETTER_SCALE,
                SCORE_FLOW_TEAM_LETTER_SCALE
            )
            letter_cursor = letter_cursor + 1
        end
        cursor_x = cursor_x + spans[token_index]
        if token_index < #tokens then
            cursor_x = cursor_x + SCORE_FLOW_TEAM_TOKEN_GAP
        end
    end
end

leaderboard_get_rows_for_score_state = function(self, score_state)
    local entries = nil
    if score_state == FLOW_STATE_SCORE_MP then
        entries = self.leaderboard_entries_mp or {}
    else
        entries = self.leaderboard_entries_solo or {}
    end
    local rows = {}
    for _, entry in ipairs(entries) do
        local names = type(entry.team_display_names) == "table" and entry.team_display_names or {}
        local name_text = ""
        if #names > 0 then
            for i, nm in ipairs(names) do
                local clean = leaderboard_sanitize_name(nm, LEADERBOARD_DEBUG_NAME_MAX_CHARS_PER_ROW_MP)
                if clean ~= "" then
                    if name_text == "" then
                        name_text = clean
                    else
                        name_text = name_text .. " " .. clean
                    end
                end
                if i >= 4 then
                    break
                end
            end
        end
        if name_text == "" then
            name_text = leaderboard_sanitize_name(mp_alpha_label_from_network_id("p1"), LEADERBOARD_DEBUG_NAME_MAX_CHARS_PER_ROW_MP)
        end
        rows[#rows + 1] = {
            score = math.max(0, tonumber(entry.score_total or 0) or 0),
            name = name_text
        }
    end
    return rows
end

leaderboard_render_rows = function(self)
    if not self.ui then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    if self.ui.flow_leaderboard_dummy_name_letters then
        for _, letter_id in ipairs(self.ui.flow_leaderboard_dummy_name_letters) do
            set_ui_square_transform(self, letter_id, -9999, -9999, FLOW_UI_PANEL_Z + 0.006, hidden, 1, 1)
        end
    end
    if self.ui.flow_leaderboard_dummy_score_digits then
        for _, digit_id in ipairs(self.ui.flow_leaderboard_dummy_score_digits) do
            set_ui_square_transform(self, digit_id, -9999, -9999, FLOW_UI_PANEL_Z + 0.006, hidden, 1, 1)
        end
    end
    local score_state = self.game_flow_state or FLOW_STATE_GAME
    if score_state ~= FLOW_STATE_SCORE_SOLO and score_state ~= FLOW_STATE_SCORE_MP then
        return
    end
    local rows = leaderboard_get_rows_for_score_state(self, score_state)
    local total_pages = math.max(1, math.ceil(#rows / LEADERBOARD_DEBUG_ROWS_PER_PAGE))
    self.leaderboard_debug_page = math.max(1, math.min(total_pages, tonumber(self.leaderboard_debug_page or 1) or 1))
    local start_index = ((self.leaderboard_debug_page - 1) * LEADERBOARD_DEBUG_ROWS_PER_PAGE) + 1
    local end_index = math.min(#rows, start_index + LEADERBOARD_DEBUG_ROWS_PER_PAGE - 1)
    local letter_cursor = 1
    local digit_cursor = 1
    for idx = start_index, end_index do
        local row = rows[idx]
        local row_slot = idx - start_index
        local row_y = LEADERBOARD_DEBUG_ROW_Y - (row_slot * LEADERBOARD_DEBUG_ROW_GAP)
        local score_text = string.format("%0" .. tostring(LEADERBOARD_DEBUG_SCORE_DIGITS_PER_ROW) .. "d", math.max(0, tonumber(row.score or 0) or 0))
        for di = 1, #score_text do
            local digit_id = self.ui.flow_leaderboard_dummy_score_digits[digit_cursor]
            if not digit_id then
                break
            end
            local ch = string.sub(score_text, di, di)
            msg.post(msg.url(nil, digit_id, "sprite"), "play_animation", { id = hash("score_" .. ch) })
            set_ui_square_transform(
                self,
                digit_id,
                LEADERBOARD_DEBUG_SCORE_X + ((di - 1) * LEADERBOARD_DEBUG_SCORE_DIGIT_SPACING),
                row_y,
                FLOW_UI_PANEL_Z + 0.006,
                vmath.vector4(1, 1, 1, 1),
                SCORE_HUD_DIGIT_DRAW_W * 0.021 * LEADERBOARD_DEBUG_SCORE_DIGIT_SCALE,
                SCORE_HUD_DIGIT_DRAW_H * 0.021 * LEADERBOARD_DEBUG_SCORE_DIGIT_SCALE
            )
            digit_cursor = digit_cursor + 1
        end
        local name_limit = (score_state == FLOW_STATE_SCORE_MP) and LEADERBOARD_DEBUG_NAME_MAX_CHARS_PER_ROW_MP or LEADERBOARD_DEBUG_NAME_MAX_CHARS_PER_ROW_SOLO
        local tokens = {}
        local raw_name_text = tostring(row.name or "")
        for token in string.gmatch(raw_name_text, "%S+") do
            local clean = leaderboard_sanitize_name(token, LEADERBOARD_DEBUG_NAME_MAX_CHARS_PER_PLAYER)
            if clean ~= "" then
                tokens[#tokens + 1] = clean
            end
        end
        if #tokens <= 0 then
            tokens[1] = leaderboard_sanitize_name(raw_name_text, LEADERBOARD_DEBUG_NAME_MAX_CHARS_PER_PLAYER)
        end
        local remaining_chars = name_limit
        local cursor_x = LEADERBOARD_DEBUG_NAME_X
        for token_index, token_text in ipairs(tokens) do
            if remaining_chars <= 0 then
                break
            end
            local draw_token = token_text
            if #draw_token > remaining_chars then
                draw_token = string.sub(draw_token, 1, remaining_chars)
            end
            for ci = 1, #draw_token do
                local glyph_id = self.ui.flow_leaderboard_dummy_name_letters[letter_cursor]
                if not glyph_id then
                    break
                end
                local ch = string.sub(draw_token, ci, ci)
                msg.post(msg.url(nil, glyph_id, "sprite"), "play_animation", { id = mp_lobby_name_glyph_anim_id(ch) })
                set_ui_square_transform(
                    self,
                    glyph_id,
                    cursor_x + ((ci - 1) * LEADERBOARD_DEBUG_NAME_LETTER_SPACING),
                    row_y,
                    FLOW_UI_PANEL_Z + 0.006,
                    vmath.vector4(1, 1, 1, 0.98),
                    LEADERBOARD_DEBUG_NAME_LETTER_SCALE,
                    LEADERBOARD_DEBUG_NAME_LETTER_SCALE
                )
                letter_cursor = letter_cursor + 1
            end
            cursor_x = cursor_x + (#draw_token * LEADERBOARD_DEBUG_NAME_LETTER_SPACING)
            remaining_chars = remaining_chars - #draw_token
            if token_index < #tokens and remaining_chars > 0 then
                cursor_x = cursor_x + LEADERBOARD_DEBUG_NAME_TOKEN_GAP_PX
            end
        end
    end
end

update_mp_build_hud = function(self, visible)
    if not self.ui or not self.ui.mp_version_digit_icons then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    if visible ~= true then
        for _, digit_id in ipairs(self.ui.mp_version_digit_icons) do
            set_ui_square_transform(self, digit_id, -9999, -9999, MP_BUILD_HUD_Z, hidden, MP_BUILD_DIGIT_DRAW_W * 0.021, MP_BUILD_DIGIT_DRAW_H * 0.021)
        end
        return
    end
    local version_text = get_mp_build_version_digits(MP_BUILD_VERSION_NUMBER)
    if #version_text > MP_BUILD_DIGIT_MAX then
        version_text = string.sub(version_text, #version_text - MP_BUILD_DIGIT_MAX + 1)
    end
    local count = #version_text
    local start_x = MP_BUILD_HUD_RIGHT_X - ((count - 1) * MP_BUILD_DIGIT_SPACING_PX)
    for idx, digit_id in ipairs(self.ui.mp_version_digit_icons) do
        if idx <= count then
            local ch = string.sub(version_text, idx, idx)
            local anim_id = nil
            if ch == "." then
                anim_id = hash("score_period")
            else
                anim_id = hash("score_" .. ch)
            end
            msg.post(msg.url(nil, digit_id, "sprite"), "play_animation", { id = anim_id })
            local dx = start_x + ((idx - 1) * MP_BUILD_DIGIT_SPACING_PX)
            set_ui_square_transform(
                self,
                digit_id,
                dx,
                MP_BUILD_HUD_Y,
                MP_BUILD_HUD_Z,
                vmath.vector4(1, 1, 1, 0.9),
                MP_BUILD_DIGIT_DRAW_W * 0.021,
                MP_BUILD_DIGIT_DRAW_H * 0.021
            )
        else
            set_ui_square_transform(self, digit_id, -9999, -9999, MP_BUILD_HUD_Z, hidden, MP_BUILD_DIGIT_DRAW_W * 0.021, MP_BUILD_DIGIT_DRAW_H * 0.021)
        end
    end
end

local function get_purge_timer_display_text(self)
    if holdout_is_active_mission and holdout_is_active_mission(self) then
        local status = holdout_get_mission_status(self)
        local turns_remaining = math.max(0, tonumber(status.remaining_turns or status.configured_turns or HOLDOUT_DEFAULT_TURNS) or 0)
        return string.format("%04d", turns_remaining)
    end
    local status = get_purge_mission_status(self)
    if status.timer_started ~= true then
        return string.format("%04d", PURGE_COUNTDOWN_TURNS)
    end
    local turns_remaining = math.max(0, tonumber(status.remaining_turns or 0) or 0)
    return string.format("%04d", turns_remaining)
end

local function get_purge_timer_clock_s()
    if socket and socket.gettime then
        return tonumber(socket.gettime()) or 0
    end
    return tonumber(os.clock()) or 0
end

local function update_purge_timer_hud(self, visible)
    if not self.ui or not self.ui.purge_timer_digit_icons then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    local holdout_active = holdout_is_active_mission and holdout_is_active_mission(self)
    local purge_active = purge_is_active_mission(self)
    local status = holdout_active and holdout_get_mission_status(self) or get_purge_mission_status(self)
    if visible ~= true or (not purge_active and not holdout_active) or status.timer_started ~= true then
        self.purge_timer_hud_next_ring_s = nil
        self.purge_timer_hud_ring_end_s = nil
        self.purge_timer_hud_ring_visible = false
        self.purge_timer_hud_last_text = nil
        for _, digit_id in ipairs(self.ui.purge_timer_digit_icons) do
            set_ui_square_transform(
                self,
                digit_id,
                -9999,
                -9999,
                PURGE_TIMER_HUD_Z,
                hidden,
                PURGE_TIMER_HUD_DIGIT_DRAW_W * 0.021 * PURGE_TIMER_HUD_SCALE,
                PURGE_TIMER_HUD_DIGIT_DRAW_H * 0.021 * PURGE_TIMER_HUD_SCALE
            )
        end
        set_ui_square_transform(self, self.ui.purge_timer_ring, -9999, -9999, PURGE_TIMER_HUD_Z - 0.001, hidden, PURGE_TIMER_HUD_RING_SCALE, PURGE_TIMER_HUD_RING_SCALE)
        return
    end
    local now_s = get_purge_timer_clock_s()
    local text = get_purge_timer_display_text(self)
    local text_changed = self.purge_timer_hud_last_text ~= text
    local pulse = 1.0
    if not holdout_active then
        pulse = 1.0 + (PURGE_TIMER_HUD_PULSE_AMPLITUDE * math.sin(now_s * PURGE_TIMER_HUD_PULSE_SPEED))
    end
    local draw_scale_x = PURGE_TIMER_HUD_DIGIT_DRAW_W * 0.021 * PURGE_TIMER_HUD_SCALE * pulse
    local draw_scale_y = PURGE_TIMER_HUD_DIGIT_DRAW_H * 0.021 * PURGE_TIMER_HUD_SCALE * pulse
    if holdout_active then
        self.purge_timer_hud_next_ring_s = nil
        if text_changed and self.purge_timer_hud_last_text ~= nil then
            self.purge_timer_hud_ring_end_s = now_s + PURGE_TIMER_HUD_RING_DURATION_S
            self.purge_timer_hud_ring_visible = true
            if self.ui.purge_timer_ring then
                msg.post(msg.url(nil, self.ui.purge_timer_ring, "sprite"), "play_animation", { id = hash("impactRing") })
            end
        end
    elseif not self.purge_timer_hud_next_ring_s then
        self.purge_timer_hud_next_ring_s = now_s
    elseif now_s >= self.purge_timer_hud_next_ring_s then
        self.purge_timer_hud_ring_end_s = now_s + PURGE_TIMER_HUD_RING_DURATION_S
        self.purge_timer_hud_ring_visible = true
        if self.ui.purge_timer_ring then
            msg.post(msg.url(nil, self.ui.purge_timer_ring, "sprite"), "play_animation", { id = hash("impactRing") })
        end
        play_sfx_one_shot(self, "klaxxon")
        self.purge_timer_hud_next_ring_s = now_s + PURGE_TIMER_HUD_RING_REPEAT_S
    end
    if self.ui.purge_timer_ring then
        local ring_end_s = tonumber(self.purge_timer_hud_ring_end_s or 0) or 0
        if ring_end_s > now_s then
            local p = 1.0 - ((ring_end_s - now_s) / PURGE_TIMER_HUD_RING_DURATION_S)
            p = math.max(0, math.min(1, p))
            local ring_scale = PURGE_TIMER_HUD_RING_START_SCALE + ((PURGE_TIMER_HUD_RING_SCALE - PURGE_TIMER_HUD_RING_START_SCALE) * p)
            local ring_alpha = 1.0 - p
            set_ui_square_transform(
                self,
                self.ui.purge_timer_ring,
                PURGE_TIMER_HUD_CENTER_X,
                PURGE_TIMER_HUD_Y,
                PURGE_TIMER_HUD_Z - 0.001,
                vmath.vector4(PURGE_TIMER_HUD_RING_TINT.x, PURGE_TIMER_HUD_RING_TINT.y, PURGE_TIMER_HUD_RING_TINT.z, ring_alpha),
                ring_scale,
                ring_scale
            )
            self.purge_timer_hud_ring_visible = true
        elseif self.purge_timer_hud_ring_visible == true then
            set_ui_square_transform(self, self.ui.purge_timer_ring, -9999, -9999, PURGE_TIMER_HUD_Z - 0.001, hidden, PURGE_TIMER_HUD_RING_SCALE, PURGE_TIMER_HUD_RING_SCALE)
            self.purge_timer_hud_ring_visible = false
        end
    end
    local count = #text
    local spacing = PURGE_TIMER_HUD_DIGIT_SPACING_PX * PURGE_TIMER_HUD_SCALE
    local start_x = PURGE_TIMER_HUD_CENTER_X - ((count - 1) * spacing * 0.5)
    local tint = vmath.vector4(1.0, 0.25, 0.25, 1)
    for i, digit_id in ipairs(self.ui.purge_timer_digit_icons) do
        local ch = string.sub(text, i, i)
        if text_changed then
            msg.post(msg.url(nil, digit_id, "sprite"), "play_animation", { id = hash("score_" .. ch) })
        end
        local dx = start_x + ((i - 1) * spacing)
        set_ui_square_transform(
            self,
            digit_id,
            dx,
            PURGE_TIMER_HUD_Y,
            PURGE_TIMER_HUD_Z,
            tint,
            draw_scale_x,
            draw_scale_y
        )
    end
    self.purge_timer_hud_last_text = text
end

update_input_map_cursor_debug = function(self)
    if not self or not self.ui or not self.ui.input_map_debug_digits then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    if INPUT_MAP_CURSOR_DEBUG_VISIBLE ~= true then
        for _, digit_id in ipairs(self.ui.input_map_debug_digits) do
            set_ui_square_transform(self, digit_id, -9999, -9999, INPUT_MAP_CURSOR_DEBUG_Z, hidden, SCORE_HUD_DIGIT_DRAW_W * 0.021 * 0.5, SCORE_HUD_DIGIT_DRAW_H * 0.021 * 0.5)
        end
        return
    end
    local dbg = self.input_map_cursor_debug
    if not dbg or not dbg.raw_x or not dbg.raw_y then
        for _, digit_id in ipairs(self.ui.input_map_debug_digits) do
            set_ui_square_transform(self, digit_id, -9999, -9999, INPUT_MAP_CURSOR_DEBUG_Z, hidden, SCORE_HUD_DIGIT_DRAW_W * 0.021 * 0.5, SCORE_HUD_DIGIT_DRAW_H * 0.021 * 0.5)
        end
        return
    end

    local base_x = math.max(40, math.min(SCREEN_WIDTH - 180, (tonumber(dbg.raw_x or 0) or 0) + 28))
    local base_y = math.max(80, math.min(SCREEN_HEIGHT - 20, (tonumber(dbg.raw_y or 0) or 0) - 22))
    local values = {
        math.max(0, math.min(9999, math.floor((tonumber(dbg.raw_x or 0) or 0) + 0.5))),
        math.max(0, math.min(9999, math.floor((tonumber(dbg.raw_y or 0) or 0) + 0.5))),
        math.max(0, math.min(9999, math.floor((tonumber(dbg.mapped_x or 0) or 0) + 0.5))),
        math.max(0, math.min(9999, math.floor((tonumber(dbg.mapped_y or 0) or 0) + 0.5)))
    }
    local row_tints = {
        vmath.vector4(1.0, 0.86, 0.2, 1),
        vmath.vector4(1.0, 0.86, 0.2, 1),
        vmath.vector4(0.2, 1.0, 0.95, 1),
        vmath.vector4(0.2, 1.0, 0.95, 1)
    }
    local icon_i = 1
    for row_i = 1, 4 do
        local row_text = string.format("%04d", values[row_i])
        local row_y = base_y - ((row_i - 1) * 16)
        for col_i = 1, 4 do
            local digit_id = self.ui.input_map_debug_digits[icon_i]
            if digit_id then
                local ch = row_text:sub(col_i, col_i)
                msg.post(msg.url(nil, digit_id, "sprite"), "play_animation", { id = hash("score_" .. ch) })
                set_ui_square_transform(
                    self,
                    digit_id,
                    base_x + ((col_i - 1) * 12),
                    row_y,
                    INPUT_MAP_CURSOR_DEBUG_Z,
                    row_tints[row_i],
                    SCORE_HUD_DIGIT_DRAW_W * 0.021 * 0.5,
                    SCORE_HUD_DIGIT_DRAW_H * 0.021 * 0.5
                )
            end
            icon_i = icon_i + 1
        end
    end
    while icon_i <= #self.ui.input_map_debug_digits do
        local digit_id = self.ui.input_map_debug_digits[icon_i]
        if digit_id then
            set_ui_square_transform(self, digit_id, -9999, -9999, INPUT_MAP_CURSOR_DEBUG_Z, hidden, SCORE_HUD_DIGIT_DRAW_W * 0.021 * 0.5, SCORE_HUD_DIGIT_DRAW_H * 0.021 * 0.5)
        end
        icon_i = icon_i + 1
    end
end

local function get_objective_reminder_anim_id(self)
    local mission_type = multiplayer_normalize_mission_type(get_current_mission_type(self))
    if mission_type == MISSION_TYPE_RESCUE then
        return hash("objective_rescue")
    elseif mission_type == MISSION_TYPE_PURGE then
        return hash("objective_purge")
    elseif mission_type == MISSION_TYPE_CLEANSE then
        return hash("objective_purge")
    elseif mission_type == MISSION_TYPE_DNA_SAMPLE then
        return hash("objective_dna")
    end
    return hash("objective_escape")
end

local function update_objective_ui(self, visible)
    if not self.ui then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    if visible ~= true then
        set_ui_square_transform(self, self.ui.objective_button, -9999, -9999, OBJECTIVE_BUTTON_Z, hidden, 1, 1)
        set_ui_square_transform(self, self.ui.objective_reminder, -9999, -9999, OBJECTIVE_REMINDER_Z, hidden, 1, 1)
        return
    end
    set_ui_square_transform(
        self,
        self.ui.objective_button,
        OBJECTIVE_BUTTON_X,
        OBJECTIVE_BUTTON_Y,
        OBJECTIVE_BUTTON_Z,
        vmath.vector4(1, 1, 1, 1),
        1,
        1
    )
    if self.objective_reminder_visible == true then
        msg.post(msg.url(nil, self.ui.objective_reminder, "sprite"), "play_animation", { id = get_objective_reminder_anim_id(self) })
        set_ui_square_transform(
            self,
            self.ui.objective_reminder,
            OBJECTIVE_REMINDER_X,
            OBJECTIVE_REMINDER_Y,
            OBJECTIVE_REMINDER_Z,
            vmath.vector4(1, 1, 1, 1),
            1,
            1
        )
    else
        set_ui_square_transform(self, self.ui.objective_reminder, -9999, -9999, OBJECTIVE_REMINDER_Z, hidden, 1, 1)
    end
end

function score_log_snapshot(self, label)
    local state = ensure_score_state(self)
    local result = SCORE_RUNTIME.compute_score(state)
    local b = result.breakdown or {}
    local m = result.metrics or {}
    print(string.format(
        "SCORE TRACE [%s] total=%d | kills=%d tiles=%d escaped=%d turns=%d eff=%d win=%d",
        tostring(label or "event"),
        result.total or 0,
        b.aliens_killed_points or 0,
        b.tiles_powered_points or 0,
        b.humans_escaped_points or 0,
        m.turns_elapsed or 0,
        b.efficiency_points or 0,
        b.win_bonus_points or 0
    ))
    print(string.format(
        "UI DEBUG | SCORE [%s] total=%d turns=%d kills=%d tiles=%d escaped=%d",
        tostring(label or "event"),
        result.total or 0,
        m.turns_elapsed or 0,
        m.aliens_killed_total or 0,
        m.tiles_powered_first_time or 0,
        m.humans_escaped_on_launch or 0
    ))
end

function score_record_turn_started(self)
    self.score_turn_counter = (self.score_turn_counter or 0) + 1
    SCORE_RUNTIME.record_turn_started(ensure_score_state(self), self.score_turn_counter)
    score_log_snapshot(self, "turn_started")
end

function score_record_alien_kill(self, alien_type)
    SCORE_RUNTIME.record_alien_killed(ensure_score_state(self), alien_type)
    score_log_snapshot(self, "alien_killed")
end

function score_record_tile_powered_first_time(self, tile_instance_id)
    SCORE_RUNTIME.record_tile_powered(ensure_score_state(self), tile_instance_id)
    score_log_snapshot(self, "tile_powered")
end

function score_record_launch_success(self, escaped_humans_alive_count)
    local state = ensure_score_state(self)
    SCORE_RUNTIME.record_launch_success(state, escaped_humans_alive_count or 0)
    local alive = 0
    if self.squad_units then
        for _, unit in pairs(self.squad_units) do
            if unit and (unit.current_health or 0) > 0 then
                alive = alive + 1
            end
        end
    end
    SCORE_RUNTIME.record_humans_alive_at_end(state, alive)
    SCORE_RUNTIME.record_mission_complete(state)
    score_log_snapshot(self, "launch_success")
end

function score_record_holdout_success(self, alive_humans_count)
    local state = ensure_score_state(self)
    SCORE_RUNTIME.record_humans_alive_at_end(state, alive_humans_count or 0)
    SCORE_RUNTIME.record_mission_complete(state)
    score_log_snapshot(self, "holdout_success")
end

function score_record_civilian_escorted(self, civilian_id)
    local state = ensure_score_state(self)
    SCORE_RUNTIME.record_civilian_escorted(state, civilian_id)
    score_log_snapshot(self, "civilian_escorted")
end

function score_record_purge_portal_bonus_deployments(self, deployment_count)
    local count = math.max(0, tonumber(deployment_count or 0) or 0)
    if count <= 0 then
        return
    end
    local state = ensure_score_state(self)
    SCORE_RUNTIME.record_purge_portal_deployments(state, count)
    score_log_snapshot(self, "purge_portal_bonus_deploy")
end

local function update_escape_pod_ready_sfx(self)
    if not self then
        return
    end
    local launch_status = LOOT_RUNTIME.get_launch_status and LOOT_RUNTIME.get_launch_status(self) or nil
    local is_ready = launch_status and launch_status.can_launch == true
    local was_ready = self.escape_pod_ready_prev_state == true
    if is_ready and (not was_ready) then
        play_escape_pod_ready_sfx(self)
    end
    self.escape_pod_ready_prev_state = is_ready == true
end

function compute_placeholder_score_breakdown(self)
    local state = ensure_score_state(self)
    local result = SCORE_RUNTIME.compute_score(state)
    local m = result.metrics or {}
    local b = result.breakdown or {}
    local status = (LOOT_RUNTIME.get_launch_status and LOOT_RUNTIME.get_launch_status(self)) or {}
    local total_units = 0
    if self.squad_units then
        for _, _ in pairs(self.squad_units) do
            total_units = total_units + 1
        end
    end
    local objectives = 0
    if status.nav_ready then
        objectives = objectives + 1
    end
    if status.supplies_ready then
        objectives = objectives + 1
    end
    local seated = m.humans_escaped_on_launch or 0
    local survivors = math.max(seated, m.humans_alive_at_end or 0)
    local dead = math.max(0, total_units - (m.humans_alive_at_end or 0))
    return {
        survivors = survivors,
        seated = seated,
        dead = dead,
        power_units = status.power_loaded or 0,
        objectives = objectives,
        total = result.total or 0,
        score_breakdown = b,
        score_metrics = m
    }
end

function enter_flow_state(self, next_state)
    local previous_state = self.game_flow_state or FLOW_STATE_GAME
    local target_state = next_state or FLOW_STATE_GAME
    if demo_is_build_enabled(self) then
        if target_state == FLOW_STATE_MP_SETUP
            or target_state == FLOW_STATE_MP_LOBBY
            or target_state == FLOW_STATE_MP_CHOOSER
            or target_state == FLOW_STATE_LEVEL_EDITOR
            or target_state == FLOW_STATE_SOLO_SETUP
            or target_state == FLOW_STATE_SCORE_SOLO
            or target_state == FLOW_STATE_SCORE_MP
        then
            target_state = FLOW_STATE_DEMO_SELECT
        end
    end
    if previous_state == FLOW_STATE_GAME and target_state ~= FLOW_STATE_GAME then
        if stop_level_fx_before_outro then
            stop_level_fx_before_outro(self)
        end
    end
    self.game_flow_state = target_state
    self.flow_overlay_phase = 0
    self.flow_submit_done = false
    if self.game_flow_state == FLOW_STATE_TITLE then
        self.title_space_scroll_x = 0
        self.title_space_scroll_y = 0
        self.title_grid_scroll_x = 0
        self.title_grid_scroll_y = 0
    end
end

set_sound_loop_state = function(self, key, should_play)
    if not self or not self.sfx_state then
        return
    end
    if self.sfx_state.loops ~= true then
        return
    end
    if self.sfx_state.enabled_by_key and self.sfx_state.enabled_by_key[key] ~= true then
        return
    end
    local entry = self.sfx_state[key]
    if not entry or not entry.url then
        return
    end
    local is_music_stem = tostring(key or ""):sub(1, 6) == "music_"
    if (not should_play) and is_music_stem and self.sfx_state.music_allow_runtime_stop ~= true then
        return
    end
    if should_play and not entry.playing then
        entry.playing = true
        pcall(msg.post, entry.url, "play_sound")
        if sound and sound.play then
            pcall(sound.play, entry.url)
        end
    elseif (not should_play) and entry.playing then
        entry.playing = false
        pcall(msg.post, entry.url, "stop_sound")
        if sound and sound.stop then
            pcall(sound.stop, entry.url)
        end
    end
end

get_spatial_listener_world_xy = function(self)
    local cam = self and self.camera_pos or nil
    if cam then
        return tonumber(cam.x or 0) or 0, tonumber(cam.y or 0) or 0
    end
    return 0, 0
end

get_spatial_zoom_gain = function(self, mode_tag)
    if not self then
        return 1
    end
    local min_zoom = tonumber(self.camera_min_zoom or 0.25) or 0.25
    local max_zoom = tonumber(self.camera_max_zoom or 1.5) or 1.5
    if max_zoom <= min_zoom then
        return 1
    end
    local z = tonumber(self.camera_zoom or min_zoom) or min_zoom
    local t = clamp((z - min_zoom) / (max_zoom - min_zoom), 0, 1)
    local zoom_out_gain = tonumber(SPATIAL_SFX_ZOOM_OUT_GAIN or 0.65) or 0.65
    if tostring(mode_tag or "") == "loop" then
        zoom_out_gain = tonumber(SPATIAL_SFX_ZOOM_OUT_GAIN_LOOP or 0.0) or 0.0
    end
    local zoom_in_gain = tonumber(SPATIAL_SFX_ZOOM_IN_GAIN or 1.0) or 1.0
    return zoom_out_gain + ((zoom_in_gain - zoom_out_gain) * t)
end

get_spatial_distance_gain = function(distance, min_dist, max_dist)
    local near_d = math.max(0, tonumber(min_dist or 0) or 0)
    local far_d = math.max(near_d + 1, tonumber(max_dist or (near_d + 1)) or (near_d + 1))
    local d = math.max(0, tonumber(distance or 0) or 0)
    if d <= near_d then
        return 1
    end
    if d >= far_d then
        return 0
    end
    local t = clamp((d - near_d) / (far_d - near_d), 0, 1)
    local smooth = t * t * (3 - (2 * t))
    return 1 - smooth
end

get_spatial_gain_for_world = function(self, world_x, world_y, min_dist, max_dist, mode_tag)
    local listener_x, listener_y = get_spatial_listener_world_xy(self)
    local dx = (tonumber(world_x or 0) or 0) - listener_x
    local dy = (tonumber(world_y or 0) or 0) - listener_y
    local distance = math.sqrt((dx * dx) + (dy * dy))
    local distance_gain = clamp(get_spatial_distance_gain(distance, min_dist, max_dist), 0, 1)
    local zoom_gain = clamp(get_spatial_zoom_gain(self, mode_tag), 0, 1)
    local distance_weight = math.max(0.01, tonumber(SPATIAL_DISTANCE_WEIGHT or 1.6) or 1.6)
    local zoom_weight = math.max(0.01, tonumber(SPATIAL_ZOOM_WEIGHT or 0.55) or 0.55)
    local raw_gain = (distance_gain ^ distance_weight) * (zoom_gain ^ zoom_weight)
    local min_gain = clamp(tonumber(SPATIAL_SFX_MIN_GAIN or 0.05) or 0.05, 0, 1)
    return min_gain + ((1 - min_gain) * raw_gain)
end

play_sfx_one_shot_spatial = function(self, key, world_x, world_y, min_dist, max_dist)
    if not self or not self.sfx_state then
        return false
    end
    if self.sfx_state.loops ~= true then
        return false
    end
    if self.sfx_state.enabled_by_key and self.sfx_state.enabled_by_key[key] ~= true then
        return false
    end
    local entry = self.sfx_state[key]
    if not entry or not entry.url then
        return false
    end
    local gain = clamp(get_spatial_gain_for_world(self, world_x, world_y, min_dist, max_dist, "oneshot"), 0, 1)
    if sound and sound.set_gain then
        pcall(sound.set_gain, entry.url, gain)
    end
    pcall(msg.post, entry.url, "play_sound")
    return true
end

update_furnace_fire_loop_sfx = function(self, dt)
    if not (self and self.sfx_state and self.sfx_state.loops == true) then
        return
    end
    local entry = self.sfx_state.furnace_fire
    if not (entry and entry.url) then
        return
    end
    local enabled = (self.sfx_state.enabled_by_key and self.sfx_state.enabled_by_key.furnace_fire == true)
    local active = false
    if enabled and (self.game_flow_state or FLOW_STATE_GAME) == FLOW_STATE_GAME then
        local cells = self.furnace_active_cells or nil
        if cells then
            active = next(cells) ~= nil
        end
    end
    local state = self.sfx_state.furnace_fire_state or {
        gain = 0,
        target = 0
    }
    local spatial_mul = 0
    if active then
        local listener_x, listener_y = get_spatial_listener_world_xy(self)
        local nearest_distance = nil
        for cell_key, _ in pairs(self.furnace_active_cells or {}) do
            local cell_id = tonumber(cell_key)
            local cell = cell_id and self.world_grid and self.world_grid[cell_id] or nil
            if cell then
                local wx, wy = coords_to_world_pos(cell.xCell, cell.yCell)
                local dx = wx - listener_x
                local dy = wy - listener_y
                local d = math.sqrt((dx * dx) + (dy * dy))
                if nearest_distance == nil or d < nearest_distance then
                    nearest_distance = d
                end
            end
        end
        if nearest_distance ~= nil then
            spatial_mul = get_spatial_distance_gain(
                nearest_distance,
                tonumber(FURNACE_FIRE_SPATIAL_MIN_DIST or (CELL_WIDTH * 1.1)) or (CELL_WIDTH * 1.1),
                tonumber(FURNACE_FIRE_SPATIAL_MAX_DIST or (CELL_WIDTH * 4.8)) or (CELL_WIDTH * 4.8)
            ) * get_spatial_zoom_gain(self, "loop")
        else
            spatial_mul = get_spatial_zoom_gain(self, "loop")
        end
    end
    local target = active and ((tonumber(FURNACE_FIRE_LOOP_GAIN or 0.6) or 0.6) * clamp(spatial_mul, 0, 1)) or 0
    state.target = target
    if target > 0 and entry.playing ~= true then
        entry.playing = true
        pcall(msg.post, entry.url, "play_sound")
        if sound and sound.play then
            pcall(sound.play, entry.url)
        end
        state.gain = 0
        if sound and sound.set_gain then
            pcall(sound.set_gain, entry.url, 0)
        end
    end
    local now_gain = tonumber(state.gain or 0) or 0
    if target > now_gain then
        local fade_in_s = math.max(0.01, tonumber(FURNACE_FIRE_FADE_IN_S or 0.2) or 0.2)
        now_gain = math.min(target, now_gain + ((tonumber(dt or 0) or 0) * (target / fade_in_s)))
    elseif target < now_gain then
        local fade_out_s = math.max(0.01, tonumber(FURNACE_FIRE_FADE_OUT_S or 0.25) or 0.25)
        now_gain = math.max(target, now_gain - ((tonumber(dt or 0) or 0) * ((tonumber(FURNACE_FIRE_LOOP_GAIN or 0.6) or 0.6) / fade_out_s)))
    end
    state.gain = now_gain
    if entry.playing == true and sound and sound.set_gain then
        pcall(sound.set_gain, entry.url, now_gain)
    end
    if target <= 0 and entry.playing == true and now_gain <= 0.001 then
        entry.playing = false
        pcall(msg.post, entry.url, "stop_sound")
        if sound and sound.stop then
            pcall(sound.stop, entry.url)
        end
    end
    self.sfx_state.furnace_fire_state = state
end

update_demo_win_music_loop_sfx = function(self, dt)
    if not (self and self.sfx_state and self.sfx_state.loops == true) then
        return
    end
    local entry = self.sfx_state.demo_win_music
    if not (entry and entry.url) then
        return
    end
    local active = (self.game_flow_state == FLOW_STATE_DEMO_RESULT) and (tostring(self.demo_result or "") == "win")
    local state = self.sfx_state.demo_win_music_state or { gain = 0, target = 0 }
    local target = active and 1 or 0
    if target > 0 and entry.playing ~= true then
        entry.playing = true
        pcall(msg.post, entry.url, "play_sound")
        if sound and sound.play then
            pcall(sound.play, entry.url)
        end
        state.gain = 0
        if sound and sound.set_gain then
            pcall(sound.set_gain, entry.url, 0)
        end
    end
    local now_gain = tonumber(state.gain or 0) or 0
    if target >= now_gain then
        now_gain = math.min(target, now_gain + ((tonumber(dt or 0) or 0) * 5))
    else
        local fade_out_s = math.max(0.05, tonumber(DEMO_WIN_MUSIC_FADE_OUT_S or 5.0) or 5.0)
        now_gain = math.max(target, now_gain - ((tonumber(dt or 0) or 0) * (1 / fade_out_s)))
    end
    state.gain = now_gain
    state.target = target
    if entry.playing == true and sound and sound.set_gain then
        pcall(sound.set_gain, entry.url, now_gain)
    end
    if target <= 0 and entry.playing == true and now_gain <= 0.001 then
        entry.playing = false
        pcall(msg.post, entry.url, "stop_sound")
        if sound and sound.stop then
            pcall(sound.stop, entry.url)
        end
    end
    self.sfx_state.demo_win_music_state = state
end

update_demo_lose_music_loop_sfx = function(self, dt)
    if not (self and self.sfx_state and self.sfx_state.loops == true) then
        return
    end
    local entry = self.sfx_state.demo_lose_music

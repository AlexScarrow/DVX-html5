        self.ui.flow_mp_mission_buttons[i] = create_ui_marker_sprite(multiplayer_get_mission_anim_id(mission_type), MP_SETUP_UI_Z)
        self.ui.flow_debug_mp_mission_hitboxes[i] = create_ui_square_alpha(0, 0, MP_SETUP_UI_Z + 0.02, vmath.vector4(0, 0, 0, 0), MP_SETUP_MISSION_BTN_W, MP_SETUP_MISSION_BTN_H)
    end
    self.ui.flow_mp_count_active_ring = create_ui_marker_sprite(hash("mp_btn_count_active_ring"), MP_SETUP_UI_Z)
    self.ui.flow_mp_count_buttons[1] = create_ui_marker_sprite(hash("mp_btn_2p"), MP_SETUP_UI_Z)
    self.ui.flow_mp_count_buttons[2] = create_ui_marker_sprite(hash("mp_btn_3p"), MP_SETUP_UI_Z)
    self.ui.flow_mp_count_buttons[3] = create_ui_marker_sprite(hash("mp_btn_4p"), MP_SETUP_UI_Z)
    self.ui.flow_mp_back_button = create_ui_marker_sprite(hash("mp_btn_back"), MP_SETUP_UI_Z)
    self.ui.flow_debug_solo_back_hitbox = create_ui_square_alpha(0, 0, MP_SETUP_UI_Z + 0.03, vmath.vector4(0, 0, 0, 0), MP_SETUP_ACTION_BTN_W, MP_SETUP_ACTION_BTN_H)
    self.ui.flow_debug_solo_launch_hitbox = create_ui_square_alpha(0, 0, MP_SETUP_UI_Z + 0.03, vmath.vector4(0, 0, 0, 0), MP_SETUP_ACTION_BTN_W, MP_SETUP_ACTION_BTN_H)
    for i = 1, SOLO_SETUP_MISSION_COUNT do
        self.ui.solo_progress_mission_hitboxes[i] = create_ui_square_alpha(0, 0, SOLO_SETUP_UI_Z + 0.03, vmath.vector4(0, 0, 0, 0), SOLO_SETUP_MISSION_BOX_W, SOLO_SETUP_MISSION_BOX_H)
    end
    self.ui.flow_mp_start_button = create_ui_marker_sprite(hash("launch_button"), MP_SETUP_UI_Z)
    if self.ui.flow_mp_start_button then
        pcall(go.set, msg.url(nil, self.ui.flow_mp_start_button, "sprite"), "blend_mode", (render and render.BLEND_ALPHA) or 0)
    end
    self.ui.flow_mp_start_disabled_overlay = create_ui_marker_sprite(hash("mp_btn_start_disabled_overlay"), MP_SETUP_UI_Z + 0.001)
    self.ui.flow_mp_start_enabled_glow = create_ui_marker_sprite(hash("mp_btn_start_enabled_glow"), MP_SETUP_UI_Z - 0.001)
    for i, unit_id in ipairs(MP_SETUP_UNIT_IDS) do
        self.ui.flow_mp_unit_buttons[i] = create_ui_marker_sprite(multiplayer_get_unit_anim_id(unit_id), MP_SETUP_UI_Z)
    end
    for _, player_id in ipairs(MP_SETUP_PLAYER_IDS) do
        self.ui.flow_mp_slot_icons[player_id] = {}
        local slot_total = player_id == "p1" and 4 or 2
        for slot_index = 1, slot_total do
            self.ui.flow_mp_slot_icons[player_id][slot_index] = create_ui_marker_sprite(multiplayer_get_unit_anim_id("sarge"), MP_SETUP_UI_Z + 0.002)
        end
    end
    for i = 1, 4 do
        self.ui.flow_score_rows[i] = create_ui_square(0, 0, FLOW_UI_PANEL_Z, vmath.vector4(0, 0, 0, 0), 300, 28)
    end
    for i = 1, 64 do
        self.ui.flow_score_team_name_letters[i] = create_ui_marker_sprite(hash("letter_a"), FLOW_UI_PANEL_Z + 0.006)
    end
    local max_name_chars_alloc = math.max(LEADERBOARD_DEBUG_NAME_MAX_CHARS_PER_ROW_SOLO, LEADERBOARD_DEBUG_NAME_MAX_CHARS_PER_ROW_MP)
    for i = 1, (LEADERBOARD_DEBUG_ROWS_PER_PAGE * max_name_chars_alloc) do
        self.ui.flow_leaderboard_dummy_name_letters[i] = create_ui_marker_sprite(hash("letter_a"), FLOW_UI_PANEL_Z + 0.006)
    end
    for i = 1, (LEADERBOARD_DEBUG_ROWS_PER_PAGE * LEADERBOARD_DEBUG_SCORE_DIGITS_PER_ROW) do
        self.ui.flow_leaderboard_dummy_score_digits[i] = create_ui_marker_sprite(hash("score_0"), FLOW_UI_PANEL_Z + 0.006)
    end
    for i = 1, 8 do
        self.ui.flow_mp_lobby_cards[i] = create_ui_square(0, 0, MP_SETUP_UI_Z + 0.002, vmath.vector4(0, 0, 0, 0), MP_LOBBY_CARD_W, MP_LOBBY_CARD_H)
        self.ui.flow_mp_lobby_status_strips[i] = create_ui_square(0, 0, MP_SETUP_UI_Z + 0.003, vmath.vector4(0, 0, 0, 0), MP_LOBBY_CARD_W - 34, 56)
    end
    self.ui.flow_mp_lobby_backpanel = create_ui_marker_sprite(hash("lobby_backpanel"), FLOW_UI_PANEL_Z + 0.005)
    self.ui.flow_mp_lobby_host_public_art = create_ui_marker_sprite(hash("mp_lobby_host_public"), MP_LOBBY_HOST_ACTION_ART_Z)
    self.ui.flow_mp_lobby_host_private_art = create_ui_marker_sprite(hash("mp_lobby_host_private"), MP_LOBBY_HOST_ACTION_ART_Z)
    for _, lobby_host_art_id in ipairs({
        self.ui.flow_mp_lobby_host_public_art,
        self.ui.flow_mp_lobby_host_private_art,
    }) do
        if lobby_host_art_id then
            pcall(go.set, msg.url(nil, lobby_host_art_id, "sprite"), "blend_mode", (render and render.BLEND_ALPHA) or 0)
        end
    end
    self.ui.flow_mp_lobby_back_button = create_ui_marker_sprite(hash("back_button"), MP_SETUP_UI_Z + 0.004)
    if self.ui.flow_mp_lobby_back_button then
        pcall(go.set, msg.url(nil, self.ui.flow_mp_lobby_back_button, "sprite"), "blend_mode", (render and render.BLEND_ALPHA) or 0)
    end
    for i = 1, (MP_LOBBY_SLOTS_PER_PAGE * MP_LOBBY_NAME_MAX_CHARS) do
        self.ui.flow_mp_lobby_name_letters[i] = create_ui_marker_sprite(hash("letter_a"), MP_SETUP_UI_Z + 0.004)
    end
    for i = 1, 7 do
        self.ui.flow_mp_lobby_refresh_letters[i] = create_ui_marker_sprite(hash("letter_a"), MP_SETUP_UI_Z + 0.004)
    end
    for i = 1, (MP_LOBBY_SLOTS_PER_PAGE * MP_LOBBY_COUNT_MAX_CHARS) do
        self.ui.flow_mp_lobby_count_digits[i] = create_ui_marker_sprite(hash("score_0"), MP_SETUP_UI_Z + 0.004)
    end
    for i = 1, (#MP_SETUP_PLAYER_IDS * MP_SETUP_NAME_MAX_CHARS) do
        self.ui.flow_mp_setup_name_letters[i] = create_ui_marker_sprite(hash("letter_a"), MP_SETUP_UI_Z + 0.004)
    end
    self.ui.advisory_sprite = create_ui_marker_sprite(ADVISORY_ANIM_NO_AMMO, ADVISORY_TEXT_Z)
    if self.ui.advisory_sprite then
        pcall(go.set, msg.url(nil, self.ui.advisory_sprite, "sprite"), "blend_mode", (render and render.BLEND_ALPHA) or 0)
    end
    for i = 1, 8 do
        self.ui.flow_mp_lobby_boxes[i] = create_ui_square(0, 0, MP_SETUP_UI_Z, vmath.vector4(0, 0, 0, 0), 1, 1)
    end
    self.ui.flow_mp_lobby_pin_modal_bg = create_pin_panel_sprite(MP_LOBBY_PIN_MODAL_Z)
    if self.ui.flow_mp_lobby_pin_modal_bg then
        pcall(go.set, msg.url(nil, self.ui.flow_mp_lobby_pin_modal_bg, "sprite"), "blend_mode", (render and render.BLEND_ALPHA) or 0)
    end
    self.ui.flow_mp_lobby_pin_display = create_ui_square(0, 0, SOLO_SETUP_UI_Z + 0.002, vmath.vector4(0, 0, 0, 0), MP_LOBBY_PIN_DISPLAY_W, MP_LOBBY_PIN_DISPLAY_H)
    self.ui.flow_mp_lobby_pin_enter = nil
    for i = 1, 9 do
        self.ui.flow_mp_lobby_pin_keys[i] = create_ui_marker_sprite(MP_LOBBY_PIN_ANIM_IDS_BY_INDEX[i] or hash("pin_1"), MP_LOBBY_PIN_KEYS_Z)
        if self.ui.flow_mp_lobby_pin_keys[i] then
            pcall(go.set, msg.url(nil, self.ui.flow_mp_lobby_pin_keys[i], "sprite"), "blend_mode", (render and render.BLEND_ALPHA) or 0)
        end
    end

    print(string.format(
        "UI panel pixels: panel=%dx%d, portrait=%dx%d, footer=%dx%d, pip=%dx%d (max %d), backpack slots=%d (%dx%d each, %dx%d grid)",
        UI_PANEL_W, UI_PANEL_H, UI_PORTRAIT_W, UI_PORTRAIT_H, UI_FOOTER_W, UI_FOOTER_H,
        UI_BAR_PIP_SIZE, UI_BAR_PIP_SIZE, UI_MAX_PIPS, UI_BACKPACK_COLS * UI_BACKPACK_ROWS,
        UI_BACKPACK_SLOT_SIZE, UI_BACKPACK_SLOT_SIZE, UI_BACKPACK_COLS, UI_BACKPACK_ROWS
    ))
end

local function set_ui_hidden(self)
    if not self.ui then
        return
    end

    local hidden = vmath.vector4(0, 0, 0, 0)
    set_ui_panel_transform(self, self.ui.panel_art, -9999, -9999, 0.8, UI_PANEL_W, UI_PANEL_H, vmath.vector4(1, 1, 1, 1))
    set_ui_panel_transform(self, self.ui.panel_shadow, -9999, -9999, 0.79, UI_PANEL_W, UI_PANEL_H, vmath.vector4(0, 0, 0, 0))
    for i = 1, UI_MAX_PIPS do
        set_ui_square_transform(self, self.ui.ap_pips[i], -9999, -9999, HUMAN_UI_BASE_Z, hidden, UI_BAR_PIP_SIZE, UI_BAR_PIP_SIZE)
        set_ui_square_transform(self, self.ui.hp_pips[i], -9999, -9999, HUMAN_UI_BASE_Z, hidden, UI_BAR_PIP_SIZE, UI_BAR_PIP_SIZE)
        set_ui_square_transform(self, self.ui.ammo_pips[i], -9999, -9999, HUMAN_UI_BASE_Z, hidden, UI_BAR_PIP_SIZE, UI_BAR_PIP_SIZE)
    end
    for i = 1, COMMAND_UI.max_pips do
        set_ui_square_transform(self, self.ui.command_pips[i], -9999, -9999, HUMAN_UI_BASE_Z, hidden, COMMAND_UI.pip_size, COMMAND_UI.pip_size)
        set_ui_square_transform(self, self.ui.command_pip_icons[i], -9999, -9999, HUMAN_UI_COMMAND_ICON_Z, hidden, COMMAND_UI.pip_size * 0.021 * 0.75, COMMAND_UI.pip_size * 0.021 * 0.75)
    end
    for i = 1, (UI_BACKPACK_COLS * UI_BACKPACK_ROWS) do
        set_ui_square_transform(self, self.ui.backpack_slots[i], -9999, -9999, HUMAN_UI_BASE_Z, hidden, UI_BACKPACK_SLOT_SIZE, UI_BACKPACK_SLOT_SIZE)
        set_ui_square_transform(self, self.ui.backpack_item_icons[i], -9999, -9999, HUMAN_UI_BACKPACK_ICON_Z, hidden, UI_BACKPACK_SLOT_SIZE * 0.021, UI_BACKPACK_SLOT_SIZE * 0.021)
    end
    for i = 1, #BUFF_SLOT_ORDER do
        set_ui_square_transform(self, self.ui.buff_slots[i], -9999, -9999, HUMAN_UI_BUFF_SLOT_Z, hidden, BUFF_SLOT_FRAME_SIZE, BUFF_SLOT_FRAME_SIZE)
        set_ui_square_transform(self, self.ui.buff_item_icons[i], -9999, -9999, HUMAN_UI_BUFF_ICON_Z, hidden, 1, 1)
    end
    set_ui_square_transform(self, self.ui.component_button, -9999, -9999, 0.82, hidden, COMPONENT_UI.button_size, COMPONENT_UI.button_size)
    set_ui_square_transform(self, self.ui.fix_button, -9999, -9999, 0.82, hidden, COMPONENT_UI.fix_button_size, COMPONENT_UI.fix_button_size)
    set_ui_square_transform(self, self.ui.loot_button, -9999, -9999, 0.82, hidden, LOOT_UI.button_size, LOOT_UI.button_size)
    set_ui_square_transform(self, self.ui.retrieve_button, -9999, -9999, 0.82, hidden, LOOT_UI.retrieve_button_size, LOOT_UI.retrieve_button_size)
    set_ui_square_transform(self, self.ui.comms_toggle_button, -9999, -9999, COMMS_TOGGLE_BTN_Z, hidden, COMMS_TOGGLE_BTN_DRAW, COMMS_TOGGLE_BTN_DRAW)
    set_ui_panel_transform(self, self.ui.comms_panel, -9999, -9999, COMMS_PANEL_Z, COMMS_PANEL_W, COMMS_PANEL_H, hidden)
    set_ui_square_transform(self, self.ui.close_button, -9999, -9999, 0.83, hidden, 28, 28)
    set_ui_square_transform(self, self.ui.not_enough_ap_icon, -9999, -9999, 0.835, hidden, 0.81, 0.81)
    if self.ui.level_buttons then
        for i, btn in ipairs(self.ui.level_buttons) do
            if btn then
                set_ui_square_transform(self, btn, -9999, -9999, LEVEL_BUTTON_Z, hidden, LEVEL_BUTTON_W, LEVEL_BUTTON_H)
            end
        end
    end
    if self.ui.score_digit_icons then
        for _, digit_id in ipairs(self.ui.score_digit_icons) do
            set_ui_square_transform(self, digit_id, -9999, -9999, SCORE_HUD_Z, hidden, SCORE_HUD_DIGIT_DRAW_W * 0.021, SCORE_HUD_DIGIT_DRAW_H * 0.021)
        end
    end
    if self.ui.mp_version_digit_icons then
        for _, digit_id in ipairs(self.ui.mp_version_digit_icons) do
            set_ui_square_transform(self, digit_id, -9999, -9999, MP_BUILD_HUD_Z, hidden, MP_BUILD_DIGIT_DRAW_W * 0.021, MP_BUILD_DIGIT_DRAW_H * 0.021)
        end
    end
    if self.ui.ranged_hit_preview_digits then
        for _, digit_id in ipairs(self.ui.ranged_hit_preview_digits) do
            set_ui_square_transform(
                self,
                digit_id,
                -9999,
                -9999,
                RANGED_HIT_PREVIEW_Z,
                hidden,
                RANGED_HIT_PREVIEW_DIGIT_DRAW_W * 0.021,
                RANGED_HIT_PREVIEW_DIGIT_DRAW_H * 0.021
            )
        end
    end
    if self.ui.ranged_hit_preview_percent then
        set_ui_square_transform(
            self,
            self.ui.ranged_hit_preview_percent,
            -9999,
            -9999,
            RANGED_HIT_PREVIEW_Z,
            hidden,
            RANGED_HIT_PREVIEW_PERCENT_DRAW_W * 0.021,
            RANGED_HIT_PREVIEW_PERCENT_DRAW_H * 0.021
        )
    end
    if self.ui.flamer_confirm_marker then
        set_ui_square_transform(
            self,
            self.ui.flamer_confirm_marker,
            -9999,
            -9999,
            RANGED_HIT_PREVIEW_Z,
            hidden,
            70 * 0.021,
            70 * 0.021
        )
    end
    if self.ui.flamer_ammo_icons then
        for _, icon_id in ipairs(self.ui.flamer_ammo_icons) do
            set_ui_square_transform(self, icon_id, -9999, -9999, HUMAN_UI_COMMAND_ICON_Z, hidden, (70 * 0.021) * 0.5, (70 * 0.021) * 0.5)
        end
    end
    set_ui_square_transform(self, self.ui.objective_button, -9999, -9999, OBJECTIVE_BUTTON_Z, hidden, 1, 1)
    set_ui_square_transform(self, self.ui.objective_reminder, -9999, -9999, OBJECTIVE_REMINDER_Z, hidden, 1, 1)
    if self.ui.purge_timer_digit_icons then
        for _, digit_id in ipairs(self.ui.purge_timer_digit_icons) do
            set_ui_square_transform(self, digit_id, -9999, -9999, PURGE_TIMER_HUD_Z, hidden, PURGE_TIMER_HUD_DIGIT_DRAW_W * 0.021, PURGE_TIMER_HUD_DIGIT_DRAW_H * 0.021)
        end
    end
    set_ui_square_transform(self, self.ui.purge_timer_ring, -9999, -9999, PURGE_TIMER_HUD_Z - 0.001, hidden, PURGE_TIMER_HUD_RING_SCALE, PURGE_TIMER_HUD_RING_SCALE)
    set_ui_square_transform(self, self.ui.new_turn_button, -9999, -9999, NEW_TURN_BUTTON_Z, hidden, NEW_TURN_BUTTON_W, NEW_TURN_BUTTON_H)
    if self.ui.ready_buttons then
        for _, btn in ipairs(self.ui.ready_buttons) do
            set_ui_square_transform(self, btn, -9999, -9999, MULTIPLAYER_READY_BUTTON_Z, hidden, MULTIPLAYER_READY_ICON_DRAW_SIZE * 0.021, MULTIPLAYER_READY_ICON_DRAW_SIZE * 0.021)
        end
    end
    if self.ui.mp_debug_player_buttons then
        for _, btn in ipairs(self.ui.mp_debug_player_buttons) do
            set_ui_square_transform(self, btn, -9999, -9999, MULTIPLAYER_DEBUG_BUTTON_Z, hidden, MULTIPLAYER_DEBUG_BUTTON_DRAW_SIZE * 0.021, MULTIPLAYER_DEBUG_BUTTON_DRAW_SIZE * 0.021)
        end
    end
    if self.ui.human_portrait_icons then
        for _, icon in ipairs(self.ui.human_portrait_icons) do
            set_ui_square_transform(self, icon, -9999, -9999, HUMAN_PORTRAIT_Z, hidden, HUMAN_PORTRAIT_DRAW_W * 0.021, HUMAN_PORTRAIT_DRAW_H * 0.021)
        end
    end
    if self.ui.human_portrait_selected_overlays then
        for _, overlay in ipairs(self.ui.human_portrait_selected_overlays) do
            set_ui_square_transform(self, overlay, -9999, -9999, HUMAN_PORTRAIT_SELECTED_Z, hidden, HUMAN_PORTRAIT_DRAW_W * 0.021, HUMAN_PORTRAIT_DRAW_H * 0.021)
        end
    end
    if self.ui.human_portrait_ap_blips then
        for _, slot_blips in ipairs(self.ui.human_portrait_ap_blips) do
            if slot_blips then
                for _, pip in ipairs(slot_blips) do
                    set_ui_square_transform(self, pip, -9999, -9999, HUMAN_PORTRAIT_SELECTED_Z + 0.001, hidden, HUMAN_PORTRAIT_BAR_BLIP_W, HUMAN_PORTRAIT_BAR_BLIP_H)
                end
            end
        end
    end
    if self.ui.human_portrait_hp_blips then
        for _, slot_blips in ipairs(self.ui.human_portrait_hp_blips) do
            if slot_blips then
                for _, pip in ipairs(slot_blips) do
                    set_ui_square_transform(self, pip, -9999, -9999, HUMAN_PORTRAIT_SELECTED_Z + 0.001, hidden, HUMAN_PORTRAIT_BAR_BLIP_W, HUMAN_PORTRAIT_BAR_BLIP_H)
                end
            end
        end
    end
    if self.ui.human_portrait_hitbox_debug then
        for _, hitbox in ipairs(self.ui.human_portrait_hitbox_debug) do
            set_ui_square_transform(self, hitbox, -9999, -9999, HUMAN_PORTRAIT_HITBOX_DEBUG_Z, hidden, HUMAN_PORTRAIT_HIT_W, HUMAN_PORTRAIT_HIT_H)

                command_type = "pickup_turret",
                reason = "invalid_payload"
            }))
            return events
        end
        local pre_turret_slots = {}
        do
            local objects = { cell.object1, cell.object2, cell.object3 }
            for slot_idx, obj in ipairs(objects) do
                if obj and obj.name == hash("gun_turret") then
                    pre_turret_slots[slot_idx] = {
                        had_turret = true,
                        object_id = tonumber(obj.objectId or 0) or 0
                    }
                else
                    pre_turret_slots[slot_idx] = {
                        had_turret = false,
                        object_id = 0
                    }
                end
            end
        end
        if not multiplayer_apply_pickup_turret_event(self, {
            unit_id = unit_id,
            cell_id = cell_id,
            world_x = tonumber(payload.world_x),
            world_y = tonumber(payload.world_y)
        }) then
            table.insert(events, multiplayer_transport_emit_event(self, "command_rejected", {
                command_type = "pickup_turret",
                reason = "apply_failed_on_host"
            }))
            return events
        end
        local turret_slot_idx = nil
        local turret_object_id = nil
        do
            local objects = { cell.object1, cell.object2, cell.object3 }
            for slot_idx, obj in ipairs(objects) do
                local pre = pre_turret_slots[slot_idx] or {}
                local still_turret = (obj and obj.name == hash("gun_turret")) or false
                if pre.had_turret == true and not still_turret then
                    turret_slot_idx = slot_idx
                    turret_object_id = tonumber(pre.object_id or 0) or 0
                    break
                end
            end
        end
        table.insert(events, multiplayer_transport_emit_event(self, "pickup_turret_applied", {
            unit_id = unit_id,
            cell_id = cell_id,
            world_x = tonumber(payload.world_x),
            world_y = tonumber(payload.world_y),
            turret_slot_idx = turret_slot_idx,
            turret_object_id = turret_object_id,
            host_applied = true,
            unit_digest = multiplayer_build_unit_state_digest(self),
            world_digest = multiplayer_build_world_state_digest(self),
            item_digest = multiplayer_build_item_state_digest(self)
        }))
        table.insert(events, multiplayer_transport_emit_event(self, "turret_removed_fx", {

update_spatial_move_loop_gains = function(self)
    if not (self and self.sfx_state and self.world_grid) then
        return
    end
    local vertical_entry = self.sfx_state.human_vertical
    local horizontal_entry = self.sfx_state.human_horizontal
    local vertical_gain = 0
    local horizontal_gain = 0
    if (self.sfx_state.vertical_active_count or 0) > 0 then
        local best_vertical = 0
        for _, unit in pairs(self.squad_units or {}) do
            if unit and unit.is_moving == true then
                local path = unit.move_path
                local idx = tonumber(unit.move_path_index or 0) or 0
                local prev_id = path and path[idx - 1] or nil
                local next_id = path and path[idx] or nil
                if prev_id and next_id then
                    local fx, fy = id_to_coords(prev_id)
                    local tx, ty = id_to_coords(next_id)
                    if fx == tx and fy ~= ty then
                        local ux, uy = coords_to_world_pos(fx, fy)
                        local gain_here = get_spatial_gain_for_world(
                            self,
                            ux,
                            uy,
                            tonumber(HUMAN_MOVE_LOOP_SPATIAL_MIN_DIST or (CELL_WIDTH * 0.7)) or (CELL_WIDTH * 0.7),
                            tonumber(HUMAN_MOVE_LOOP_SPATIAL_MAX_DIST or (CELL_WIDTH * 5.0)) or (CELL_WIDTH * 5.0),
                            "loop"
                        )
                        if gain_here > best_vertical then
                            best_vertical = gain_here
                        end
                    end
                end
            end
        end
        for _, civilian in ipairs(self.civilians or {}) do
            if civilian and civilian.is_dead ~= true and civilian.is_moving == true then
                local sampled = false
                local path = civilian.move_path
                local idx = tonumber(civilian.move_path_index or 0) or 0
                local prev_id = path and path[idx - 1] or nil
                local next_id = path and path[idx] or nil
                if prev_id and next_id then
                    local fx, fy = id_to_coords(prev_id)
                    local tx, ty = id_to_coords(next_id)
                    if fx == tx and fy ~= ty then
                        local ux, uy = coords_to_world_pos(fx, fy)
                        local gain_here = get_spatial_gain_for_world(
                            self,
                            ux,
                            uy,
                            tonumber(HUMAN_MOVE_LOOP_SPATIAL_MIN_DIST or (CELL_WIDTH * 0.7)) or (CELL_WIDTH * 0.7),
                            tonumber(HUMAN_MOVE_LOOP_SPATIAL_MAX_DIST or (CELL_WIDTH * 5.0)) or (CELL_WIDTH * 5.0),
                            "loop"
                        )
                        if gain_here > best_vertical then
                            best_vertical = gain_here
                        end
                        sampled = true
                    end
                end
                if not sampled and civilian.micro_target_x and civilian.micro_target_y then
                    local civ_pos = get_civilian_world_pos_from_entity(self, civilian)
                    if civ_pos then
                        local dx = civilian.micro_target_x - civ_pos.x
                        local dy = civilian.micro_target_y - civ_pos.y
                        if math.abs(dy) > math.abs(dx) and math.abs(dy) > 0.01 then
                            local gain_here = get_spatial_gain_for_world(
                                self,
                                civ_pos.x,
                                civ_pos.y,
                                tonumber(HUMAN_MOVE_LOOP_SPATIAL_MIN_DIST or (CELL_WIDTH * 0.7)) or (CELL_WIDTH * 0.7),
                                tonumber(HUMAN_MOVE_LOOP_SPATIAL_MAX_DIST or (CELL_WIDTH * 5.0)) or (CELL_WIDTH * 5.0),
                                "loop"
                            )
                            if gain_here > best_vertical then
                                best_vertical = gain_here
                            end
                        end
                    end
                end
            end
        end
        vertical_gain = best_vertical
    end
    if (self.sfx_state.horizontal_active_count or 0) > 0 then
        local best_horizontal = 0
        for _, unit in pairs(self.squad_units or {}) do
            if unit and unit.is_moving == true then
                local path = unit.move_path
                local idx = tonumber(unit.move_path_index or 0) or 0
                local prev_id = path and path[idx - 1] or nil
                local next_id = path and path[idx] or nil
                if prev_id and next_id then
                    local fx, fy = id_to_coords(prev_id)
                    local tx, ty = id_to_coords(next_id)
                    if fx ~= tx then
                        local ux, uy = coords_to_world_pos(fx, fy)
                        local gain_here = get_spatial_gain_for_world(
                            self,
                            ux,
                            uy,
                            tonumber(HUMAN_MOVE_LOOP_SPATIAL_MIN_DIST or (CELL_WIDTH * 0.7)) or (CELL_WIDTH * 0.7),
                            tonumber(HUMAN_MOVE_LOOP_SPATIAL_MAX_DIST or (CELL_WIDTH * 5.0)) or (CELL_WIDTH * 5.0),
                            "loop"
                        )
                        if gain_here > best_horizontal then
                            best_horizontal = gain_here
                        end
                    end
                end
            end
        end
        for _, civilian in ipairs(self.civilians or {}) do
            if civilian and civilian.is_dead ~= true and civilian.is_moving == true then
                local sampled = false
                local path = civilian.move_path
                local idx = tonumber(civilian.move_path_index or 0) or 0
                local prev_id = path and path[idx - 1] or nil
                local next_id = path and path[idx] or nil
                if prev_id and next_id then
                    local fx, fy = id_to_coords(prev_id)
                    local tx, ty = id_to_coords(next_id)
                    if fx ~= tx then
                        local ux, uy = coords_to_world_pos(fx, fy)
                        local gain_here = get_spatial_gain_for_world(
                            self,
                            ux,
                            uy,
                            tonumber(HUMAN_MOVE_LOOP_SPATIAL_MIN_DIST or (CELL_WIDTH * 0.7)) or (CELL_WIDTH * 0.7),
                            tonumber(HUMAN_MOVE_LOOP_SPATIAL_MAX_DIST or (CELL_WIDTH * 5.0)) or (CELL_WIDTH * 5.0),
                            "loop"
                        )
                        if gain_here > best_horizontal then
                            best_horizontal = gain_here
                        end
                        sampled = true
                    end
                end
                if not sampled and civilian.micro_target_x and civilian.micro_target_y then
                    local civ_pos = get_civilian_world_pos_from_entity(self, civilian)
                    if civ_pos then
                        local dx = civilian.micro_target_x - civ_pos.x
                        local dy = civilian.micro_target_y - civ_pos.y
                        if math.abs(dx) >= math.abs(dy) and math.abs(dx) > 0.01 then
                            local gain_here = get_spatial_gain_for_world(
                                self,
                                civ_pos.x,
                                civ_pos.y,
                                tonumber(HUMAN_MOVE_LOOP_SPATIAL_MIN_DIST or (CELL_WIDTH * 0.7)) or (CELL_WIDTH * 0.7),
                                tonumber(HUMAN_MOVE_LOOP_SPATIAL_MAX_DIST or (CELL_WIDTH * 5.0)) or (CELL_WIDTH * 5.0),
                                "loop"
                            )
                            if gain_here > best_horizontal then
                                best_horizontal = gain_here
                            end
                        end
                    end
                end
            end
        end
        horizontal_gain = best_horizontal
    end
    if vertical_entry and vertical_entry.playing == true and sound and sound.set_gain then
        pcall(sound.set_gain, vertical_entry.url, clamp(vertical_gain, 0, 1))
    end
    if horizontal_entry and horizontal_entry.playing == true and sound and sound.set_gain then
        pcall(sound.set_gain, horizontal_entry.url, clamp(horizontal_gain, 0, 1))
    end
end

reconcile_horizontal_move_sfx_state = function(self)
    if not (self and self.sfx_state and self.sfx_state.horizontal_active_by_actor) then
        return
    end
    local by_actor = self.sfx_state.horizontal_active_by_actor
    local moving_lookup = {}
    for _, unit in pairs(self.squad_units or {}) do
        if unit and unit.id and unit.is_moving == true then
            moving_lookup[tostring(unit.id)] = true
        end
    end
    for _, civilian in ipairs(self.civilians or {}) do
        if civilian and civilian.is_dead ~= true and civilian.is_moving == true then
            moving_lookup["civ_" .. tostring(civilian.id or 0)] = true
        end
    end
    local active_count = 0
    for actor_key, is_active in pairs(by_actor) do
        if is_active == true and moving_lookup[actor_key] == true then
            active_count = active_count + 1
        else
            by_actor[actor_key] = nil
        end
    end
    self.sfx_state.horizontal_active_count = active_count
    set_sound_loop_state(self, "human_horizontal", active_count > 0)
end

stop_speedy_move_sfx = function(self)
    if not (self and self.sfx_state and self.sfx_state.speedy_playing_by_voice and self.sfx_state.speedy_voice_urls) then
        return
    end
    for i = 1, #self.sfx_state.speedy_playing_by_voice do
        if self.sfx_state.speedy_playing_by_voice[i] == true then
            self.sfx_state.speedy_playing_by_voice[i] = false
            pcall(msg.post, self.sfx_state.speedy_voice_urls[i], "stop_sound")
        end
    end
end

update_speedy_move_sfx = function(self)
    if not (self and self.sfx_state and self.aliens) then
        if self and self.sfx_state then
            self.sfx_state.speedy_active_count = 0
            stop_speedy_move_sfx(self)
        end
        return
    end
    if not is_directional_move_sfx_allowed(self) then
        self.sfx_state.speedy_active_count = 0
        stop_speedy_move_sfx(self)
        return
    end
    local moving_speedy_count = 0
    for _, alien in ipairs(self.aliens) do
        if alien
            and alien.is_dead ~= true
            and alien.type == ALIEN_TYPE_SPEEDY
            and alien.is_moving == true
            and alien.go_id
        then
            moving_speedy_count = moving_speedy_count + 1
        end
    end
    self.sfx_state.speedy_active_count = moving_speedy_count
    local max_voices = math.max(1, tonumber(SFX_SPEEDY_MOVE_MAX_STACK_VOICES or 4) or 4)
    local target_voices = math.min(max_voices, moving_speedy_count)
    local playing = self.sfx_state.speedy_playing_by_voice or {}
    local urls = self.sfx_state.speedy_voice_urls or {}
    for i = 1, max_voices do
        local should_play = i <= target_voices
        if should_play and playing[i] ~= true then
            playing[i] = true
            pcall(msg.post, urls[i], "play_sound")
        elseif (not should_play) and playing[i] == true then
            playing[i] = false
            pcall(msg.post, urls[i], "stop_sound")
        end
    end
    self.sfx_state.speedy_playing_by_voice = playing
    local best_gain = 0
    for _, alien in ipairs(self.aliens or {}) do
        if alien and alien.is_dead ~= true and alien.type == ALIEN_TYPE_SPEEDY and alien.is_moving == true then
            local wx = nil
            local wy = nil
            if alien.go_id then
                local pos = go.get_position(alien.go_id)
                if pos then
                    wx = pos.x
                    wy = pos.y
                end
            end
            if wx == nil and alien.cell_id and self.world_grid and self.world_grid[alien.cell_id] then
                local cell = self.world_grid[alien.cell_id]
                wx, wy = coords_to_world_pos(cell.xCell, cell.yCell)
            end
            if wx ~= nil and wy ~= nil then
                local gain_here = get_spatial_gain_for_world(
                    self,
                    wx,
                    wy,
                    tonumber(SPEEDY_MOVE_LOOP_SPATIAL_MIN_DIST or (CELL_WIDTH * 0.9)) or (CELL_WIDTH * 0.9),
                    tonumber(SPEEDY_MOVE_LOOP_SPATIAL_MAX_DIST or (CELL_WIDTH * 5.5)) or (CELL_WIDTH * 5.5),
                    "loop"
                )
                if gain_here > best_gain then
                    best_gain = gain_here
                end
            end
        end
    end
    if sound and sound.set_gain then
        local gain = clamp(best_gain, 0, 1)
        for i = 1, max_voices do
            if playing[i] == true and urls[i] then
                pcall(sound.set_gain, urls[i], gain)
            end
        end
    end
end

local function spawn_exit_test_stash(self)
    if EXIT_TEST_STASH_ENABLED ~= true then
        return
    end
    if not (self.world_grid and self.level_library and self.current_level_index and LOOT_RUNTIME and LOOT_RUNTIME.create_world_item_instance) then
        return
    end
    local selected_level = self.level_library[self.current_level_index]
    if not selected_level then
        return
    end
    local cell5_id = nil
    for _, placement in ipairs(selected_level) do
        if placement and placement.tile == "exit" then
            cell5_id = coords_to_id(placement.x, placement.y)
            break
        end
    end
    if not (cell5_id and self.world_grid[cell5_id] and self.world_grid[cell5_id].tileID ~= hash("empty")) then
        return
    end
    -- for _ = 1, 9 do
    --     LOOT_RUNTIME.create_world_item_instance(self, "power", cell5_id, nil, { test_stash = true })
    -- end
    if LOOT_RUNTIME.refresh_world_item_visuals then
        LOOT_RUNTIME.refresh_world_item_visuals(self)
    end
    print("TEST STASH | Spawned exit cell-5 items (9x power).")
end

solo_progress_get_level_count = function(self)
    if not (self and type(self.level_library) == "table") then
        return 1
    end
    local c = 0
    for i, level_def in ipairs(self.level_library) do
        if type(level_def) == "table" then
            c = i
        end
    end
    return math.max(1, c)
end

solo_progress_map_mission_to_level_index = function(self, mission_slot)
    local level_count = solo_progress_get_level_count(self)
    local slot = math.max(1, math.min(SOLO_SETUP_MISSION_COUNT, tonumber(mission_slot or 1) or 1))
    local mapped = tonumber(SOLO_SETUP_MISSION_LEVEL_MAP and SOLO_SETUP_MISSION_LEVEL_MAP[slot] or slot) or slot
    mapped = math.max(1, math.floor(mapped))
    if mapped <= level_count then
        return mapped
    end
    return level_count
end

solo_progress_load_state = function()
    local ok, data = pcall(sys.load, SOLO_PROGRESS_LOCAL_SAVE_KEY)
    if not ok or type(data) ~= "table" then
        return { mission = {} }
    end
    local mission = type(data.mission) == "table" and data.mission or {}
    return { mission = mission }
end

solo_progress_save_state = function(self)
    if not self then
        return
    end
    local state = self.solo_progress_state or { mission = {} }
    self.solo_progress_state = state
    pcall(sys.save, SOLO_PROGRESS_LOCAL_SAVE_KEY, state)
end

solo_progress_ensure_runtime = function(self)
    if not self then
        return { mission = {} }
    end
    if type(self.solo_progress_state) ~= "table" then
        self.solo_progress_state = solo_progress_load_state()
    end
    if type(self.solo_progress_state.mission) ~= "table" then
        self.solo_progress_state.mission = {}
    end
    return self.solo_progress_state
end

solo_progress_get_mission_entry = function(self, mission_slot)
    local state = solo_progress_ensure_runtime(self)
    local slot_key = tostring(math.max(1, math.min(SOLO_SETUP_MISSION_COUNT, tonumber(mission_slot or 1) or 1)))
    local entry = state.mission[slot_key]
    if type(entry) ~= "table" then
        entry = { score = 0, result = "unplayed", score_details = {} }
        state.mission[slot_key] = entry
    end
    entry.score = math.max(0, tonumber(entry.score or 0) or 0)
    entry.result = tostring(entry.result or "unplayed")
    local details = type(entry.score_details) == "table" and entry.score_details or {}
    details.squad_survived_points = math.max(0, tonumber(details.squad_survived_points or 0) or 0)
    details.aliens_killed_points = math.max(0, tonumber(details.aliens_killed_points or 0) or 0)
    details.alien_portals_destroyed_points = math.max(0, tonumber(details.alien_portals_destroyed_points or 0) or 0)
    details.civilians_rescued_points = math.max(0, tonumber(details.civilians_rescued_points or 0) or 0)
    details.dna_retrieved_points = math.max(0, tonumber(details.dna_retrieved_points or 0) or 0)
    details.boss_destroyed_points = math.max(0, tonumber(details.boss_destroyed_points or 0) or 0)
    entry.score_details = details
    return entry
end

solo_progress_get_row_summary = function(self, row_index)
    local row = math.max(1, math.min(SOLO_SETUP_MISSION_ROWS, tonumber(row_index or 1) or 1))
    local start_slot = ((row - 1) * SOLO_SETUP_MISSION_COLS) + 1
    local total = 0
    local all_won = true
    for i = 0, SOLO_SETUP_MISSION_COLS - 1 do
        local entry = solo_progress_get_mission_entry(self, start_slot + i)
        total = total + math.max(0, tonumber(entry.score or 0) or 0)
        if tostring(entry.result or "") ~= "win" then
            all_won = false
        end
    end
    return {
        total = total,
        all_won = all_won
    }
end

solo_progress_get_global_total = function(self)
    local total = 0
    for slot = 1, SOLO_SETUP_MISSION_COUNT do
        local entry = solo_progress_get_mission_entry(self, slot)
        total = total + math.max(0, tonumber(entry.score or 0) or 0)
    end
    return total
end

solo_progress_is_row_unlocked = function(self, row_index)
    local row = math.max(1, math.min(SOLO_SETUP_MISSION_ROWS, tonumber(row_index or 1) or 1))
    if SOLO_SETUP_DEBUG_UNLOCK_ALL_MISSIONS == true then
        return true
    end
    if row <= 1 then
        return true
    end
    local prev_row = row - 1
    local threshold = tonumber(SOLO_SETUP_TIER_THRESHOLDS[prev_row] or 0) or 0
    local summary = solo_progress_get_row_summary(self, prev_row)
    local global_total = solo_progress_get_global_total(self)
    return summary.all_won == true and global_total >= threshold
end

solo_progress_is_mission_unlocked = function(self, mission_slot)
    local slot = math.max(1, math.min(SOLO_SETUP_MISSION_COUNT, tonumber(mission_slot or 1) or 1))
    local row = math.floor((slot - 1) / SOLO_SETUP_MISSION_COLS) + 1
    return solo_progress_is_row_unlocked(self, row)
end

solo_progress_get_default_selected_slot = function(self)
    for slot = 1, SOLO_SETUP_MISSION_COUNT do
        if solo_progress_is_mission_unlocked(self, slot) then
            return slot
        end
    end
    return 1
end

solo_progress_make_score_details = function(score_breakdown)
    local b = type(score_breakdown) == "table" and score_breakdown or {}
    local spawn_points = math.max(0, tonumber(b.spawn_points_points or 0) or 0)
    local purge_portals = math.max(0, tonumber(b.purge_portal_deploy_points or 0) or 0)
    return {
        squad_survived_points = math.max(0, tonumber(b.humans_escaped_points or 0) or 0),
        aliens_killed_points = math.max(0, tonumber(b.aliens_killed_points or 0) or 0),
        -- Purge missions score portal objective via purge_portal_deploy_points.
        -- Keep spawn_points_points as fallback for modes that use spawn-point destruction.
        alien_portals_destroyed_points = math.max(spawn_points, purge_portals),
        civilians_rescued_points = math.max(0, tonumber(b.civilian_escorted_points or 0) or 0),
        dna_retrieved_points = math.max(0, tonumber(b.dna_retrieved_points or 0) or 0),
        boss_destroyed_points = math.max(0, tonumber(b.boss_destroyed_points or 0) or 0)
    }
end

solo_progress_record_result = function(self, mission_slot, result, score_total, score_breakdown)
    if not self then
        return
    end
    local slot = math.max(1, math.min(SOLO_SETUP_MISSION_COUNT, tonumber(mission_slot or 1) or 1))
    local entry = solo_progress_get_mission_entry(self, slot)
    local final_result = tostring(result or "lose")
    if final_result ~= "win" then
        final_result = "lose"
    end
    entry.result = final_result
    entry.score = (final_result == "win") and math.max(0, tonumber(score_total or 0) or 0) or 0
    entry.score_details = solo_progress_make_score_details((final_result == "win") and score_breakdown or nil)
    solo_progress_save_state(self)
end

solo_setup_get_mission_box_center = function(slot)
    local idx = math.max(1, math.min(SOLO_SETUP_MISSION_COUNT, tonumber(slot or 1) or 1)) - 1
    local row = math.floor(idx / SOLO_SETUP_MISSION_COLS)
    local col = idx % SOLO_SETUP_MISSION_COLS
    local left_x = SOLO_SETUP_MISSION_BASE_X + (col * SOLO_SETUP_MISSION_STEP_X)
    local top_y = SOLO_SETUP_MISSION_BASE_Y + (row * SOLO_SETUP_MISSION_STEP_Y)
    local center_x = left_x + (SOLO_SETUP_MISSION_BOX_W * 0.5)
    local center_y = SCREEN_HEIGHT - (top_y + (SOLO_SETUP_MISSION_BOX_H * 0.5))
    return center_x, center_y
end

solo_setup_set_selected_slot = function(self, slot)
    if not self then
        return
    end
    solo_setup_init_runtime(self)
    local selected_slot = math.max(1, math.min(SOLO_SETUP_MISSION_COUNT, tonumber(slot or 1) or 1))
    self.solo_setup.selected_mission_slot = selected_slot
    local level_index = solo_progress_map_mission_to_level_index(self, selected_slot)
    local level_def = self.level_library and self.level_library[level_index] or nil
    self.solo_setup.mission_type = multiplayer_normalize_mission_type(get_level_mission_type(level_def))
end

solo_progress_get_mission_type_label = function(self, mission_slot)
    local level_index = solo_progress_map_mission_to_level_index(self, mission_slot)
    local level_def = self.level_library and self.level_library[level_index] or nil
    local mission_type = multiplayer_normalize_mission_type(get_level_mission_type(level_def))
    local label = "escape"
    if mission_type == MISSION_TYPE_RESCUE then
        label = "rescue"
    elseif mission_type == MISSION_TYPE_PURGE then
        label = "purge"
    elseif mission_type == MISSION_TYPE_CLEANSE then
        label = "cleanse"
    elseif mission_type == MISSION_TYPE_DNA_SAMPLE then
        label = "dna"
    elseif mission_type == MISSION_TYPE_HOLDOUT then
        label = "holdout"
    end
    label = string.lower(tostring(label or "escape"))
    label = string.gsub(label, "[^a-z]", "")
    if label == "" then
        label = "escape"
    end
    if #label > SOLO_SETUP_MISSION_TYPE_MAX_CHARS then
        label = string.sub(label, 1, SOLO_SETUP_MISSION_TYPE_MAX_CHARS)
    end
    return label
end

solo_progress_get_row_required_score = function(row_index)
    local row = math.max(1, math.min(SOLO_SETUP_MISSION_ROWS, tonumber(row_index or 1) or 1))
    if row <= #SOLO_SETUP_TIER_THRESHOLDS then
        return math.max(0, tonumber(SOLO_SETUP_TIER_THRESHOLDS[row] or 0) or 0)
    end
    return math.max(0, tonumber(SOLO_SETUP_TIER_THRESHOLDS[#SOLO_SETUP_TIER_THRESHOLDS] or 0) or 0)
end

solo_progress_get_row_progress_score = function(self, row_index, row_summary, global_total_override)
    local row = math.max(1, math.min(SOLO_SETUP_MISSION_ROWS, tonumber(row_index or 1) or 1))
    if row >= 2 then
        if global_total_override ~= nil then
            return math.max(0, tonumber(global_total_override or 0) or 0)
        end
        return math.max(0, tonumber(solo_progress_get_global_total(self) or 0) or 0)
    end
    local summary = row_summary or solo_progress_get_row_summary(self, row)
    return math.max(0, tonumber(summary and summary.total or 0) or 0)
end

solo_progress_format_meta_value = function(value)
    local numeric = math.max(0, math.floor(tonumber(value or 0) or 0))
    local text = tostring(numeric)
    if #text > SOLO_SETUP_MISSION_META_VALUE_MAX_DIGITS then
        text = string.sub(text, #text - SOLO_SETUP_MISSION_META_VALUE_MAX_DIGITS + 1)
    end
    return text
end

solo_progress_draw_letter_nodes = function(self, nodes, text, center_x, center_y, spacing, scale, tint)
    local hidden = vmath.vector4(0, 0, 0, 0)
    if not nodes then
        return
    end
    for i = 1, #nodes do
        set_ui_square_transform(self, nodes[i], -9999, -9999, SOLO_SETUP_TEXT_Z, hidden, scale, scale)
    end
    local normalized = string.lower(tostring(text or ""))
    normalized = string.gsub(normalized, "[^a-z]", "")
    if normalized == "" then
        return
    end
    local count = math.min(#normalized, #nodes)
    local start_x = (tonumber(center_x or 0) or 0) - (((count - 1) * spacing) * 0.5)
    for i = 1, count do
        local glyph_id = nodes[i]
        local ch = string.sub(normalized, i, i)
        msg.post(msg.url(nil, glyph_id, "sprite"), "play_animation", { id = hash("letter_" .. ch) })
        set_ui_square_transform(self, glyph_id, start_x + ((i - 1) * spacing), center_y, SOLO_SETUP_TEXT_Z, tint, scale, scale)
    end
end

solo_progress_draw_meta_nodes = function(self, nodes, text, center_x, center_y, spacing, scale, tint, highlight_leading_zero_red)
    local hidden = vmath.vector4(0, 0, 0, 0)
    if not nodes then
        return
    end
    for i = 1, #nodes do
        set_ui_square_transform(self, nodes[i], -9999, -9999, SOLO_SETUP_TEXT_Z, hidden, scale, scale)
    end
    local normalized = tostring(text or "")
    normalized = string.gsub(normalized, "[^%d/]", "")
    if normalized == "" then
        return
    end
    if #normalized > #nodes then
        normalized = string.sub(normalized, #normalized - #nodes + 1)
    end
    local count = #normalized
    local start_x = (tonumber(center_x or 0) or 0) - (((count - 1) * spacing) * 0.5)
    for i = 1, count do
        local glyph_id = nodes[i]
        local ch = string.sub(normalized, i, i)
        local anim_id = (ch == "/") and hash("score_slash") or hash("score_" .. ch)
        local glyph_tint = tint
        if highlight_leading_zero_red == true and i == 1 and ch == "0" then
            glyph_tint = vmath.vector4(0.96, 0.2, 0.2, 1.0)
        end
        msg.post(msg.url(nil, glyph_id, "sprite"), "play_animation", { id = anim_id })
        set_ui_square_transform(self, glyph_id, start_x + ((i - 1) * spacing), center_y, SOLO_SETUP_TEXT_Z, glyph_tint, SCORE_HUD_DIGIT_DRAW_W * 0.021 * scale, SCORE_HUD_DIGIT_DRAW_H * 0.021 * scale)
    end
end

solo_progress_draw_letter_nodes_left = function(self, nodes, text, left_x, center_y, spacing, scale, tint)
    local hidden = vmath.vector4(0, 0, 0, 0)
    if not nodes then
        return
    end
    for i = 1, #nodes do
        set_ui_square_transform(self, nodes[i], -9999, -9999, SOLO_SCORE_BREAKDOWN_TEXT_Z, hidden, scale, scale)
    end
    local normalized = string.lower(tostring(text or ""))
    normalized = string.gsub(normalized, "[^a-z]", "")
    if normalized == "" then
        return
    end
    local count = math.min(#normalized, #nodes)
    local start_x = tonumber(left_x or 0) or 0
    for i = 1, count do
        local glyph_id = nodes[i]
        local ch = string.sub(normalized, i, i)
        msg.post(msg.url(nil, glyph_id, "sprite"), "play_animation", { id = hash("letter_" .. ch) })
        set_ui_square_transform(self, glyph_id, start_x + ((i - 1) * spacing), center_y, SOLO_SCORE_BREAKDOWN_TEXT_Z, tint, scale, scale)
    end
end

solo_progress_render_mission_text = function(self, mission_slot, center_x, center_y)
    if not (self and self.ui and self.ui.solo_progress_mission_type_letters and self.ui.solo_progress_mission_meta_digits) then
        return
    end
    local slot = math.max(1, math.min(SOLO_SETUP_MISSION_COUNT, tonumber(mission_slot or 1) or 1))
    local row = math.floor((slot - 1) / SOLO_SETUP_MISSION_COLS) + 1
    local mission_entry = solo_progress_get_mission_entry(self, slot)
    local global_total = solo_progress_get_global_total(self)
    local type_label = solo_progress_get_mission_type_label(self, slot)
    local meta_text = ""
    if tostring(mission_entry.result or "unplayed") ~= "unplayed" then
        meta_text = solo_progress_format_meta_value(mission_entry.score) .. "/" .. solo_progress_format_meta_value(global_total)
    end
    local unlocked = solo_progress_is_mission_unlocked(self, slot)
    local text_tint = unlocked and SOLO_SETUP_TEXT_TINT_UNLOCKED or SOLO_SETUP_TEXT_TINT_LOCKED
    local letters = self.ui.solo_progress_mission_type_letters[slot]
    local digits = self.ui.solo_progress_mission_meta_digits[slot]
    solo_progress_draw_letter_nodes(
        self,
        letters,
        type_label,
        center_x + SOLO_SETUP_MISSION_TYPE_OFFSET_X,
        center_y + SOLO_SETUP_MISSION_TYPE_OFFSET_Y,
        SOLO_SETUP_MISSION_TYPE_SPACING,
        SOLO_SETUP_MISSION_TYPE_SCALE,
        text_tint
    )
    solo_progress_draw_meta_nodes(
        self,
        digits,
        meta_text,
        center_x,
        center_y + SOLO_SETUP_MISSION_META_OFFSET_Y,
        SOLO_SETUP_MISSION_META_SPACING,
        SOLO_SETUP_MISSION_META_SCALE,
        text_tint,
        (tonumber(mission_entry.score or 0) or 0) <= 0
    )
end

solo_progress_render_score_breakdown_panel = function(self, mission_slot)
    if not (self and self.ui) then
        return
    end
    local hidden = vmath.vector4(0, 0, 0, 0)
    local slot = math.max(1, math.min(SOLO_SETUP_MISSION_COUNT, tonumber(mission_slot or 1) or 1))
    local mission_entry = solo_progress_get_mission_entry(self, slot)
    local has_result = tostring(mission_entry.result or "unplayed") ~= "unplayed"
    if not has_result then
        set_ui_square_transform(self, self.ui.solo_score_breakdown_panel, -9999, -9999, SOLO_SCORE_BREAKDOWN_PANEL_Z, hidden, 1, 1)
        for row = 1, SOLO_SCORE_BREAKDOWN_ROW_COUNT do
            solo_progress_draw_letter_nodes(
                self,
                self.ui.solo_score_breakdown_label_letters and self.ui.solo_score_breakdown_label_letters[row] or nil,
                "",
                -9999,
                -9999,
                SOLO_SCORE_BREAKDOWN_LABEL_SPACING,
                SOLO_SCORE_BREAKDOWN_LABEL_SCALE,
                hidden
            )
            solo_progress_draw_meta_nodes(
                self,
                self.ui.solo_score_breakdown_value_digits and self.ui.solo_score_breakdown_value_digits[row] or nil,
                "",
                -9999,
                -9999,
                SOLO_SCORE_BREAKDOWN_VALUE_SPACING,
                SOLO_SCORE_BREAKDOWN_VALUE_SCALE,
                hidden,
                false
            )
        end
        return
    end
    set_ui_square_transform(
        self,
        self.ui.solo_score_breakdown_panel,
        SOLO_SCORE_BREAKDOWN_PANEL_X,
        SOLO_SCORE_BREAKDOWN_PANEL_Y,
        SOLO_SCORE_BREAKDOWN_PANEL_Z,
        vmath.vector4(1, 1, 1, 1),
        SOLO_SCORE_BREAKDOWN_PANEL_SCALE,
        SOLO_SCORE_BREAKDOWN_PANEL_SCALE
    )
    local text_tint = vmath.vector4(0.95, 1.0, 0.96, 1.0)
    local details = mission_entry.score_details or {}
    local values = {
        math.max(0, tonumber(mission_entry.score or 0) or 0),
        math.max(0, tonumber(details.squad_survived_points or 0) or 0),
        math.max(0, tonumber(details.aliens_killed_points or 0) or 0),
        math.max(0, tonumber(details.alien_portals_destroyed_points or 0) or 0),
        math.max(0, tonumber(details.civilians_rescued_points or 0) or 0),
        math.max(0, tonumber(details.dna_retrieved_points or 0) or 0)
    }
    for row = 1, SOLO_SCORE_BREAKDOWN_ROW_COUNT do
        local row_y = SOLO_SCORE_BREAKDOWN_PANEL_Y + SOLO_SCORE_BREAKDOWN_FIRST_ROW_OFFSET_Y - ((row - 1) * SOLO_SCORE_BREAKDOWN_ROW_SPACING)
        local value_tint = (row == 1) and vmath.vector4(0.22, 0.96, 0.3, 1.0) or text_tint
        solo_progress_draw_letter_nodes_left(
            self,
            self.ui.solo_score_breakdown_label_letters and self.ui.solo_score_breakdown_label_letters[row] or nil,
            "",
            SOLO_SCORE_BREAKDOWN_PANEL_X + SOLO_SCORE_BREAKDOWN_LABEL_X_OFFSET,
            row_y,
            SOLO_SCORE_BREAKDOWN_LABEL_SPACING,
            SOLO_SCORE_BREAKDOWN_LABEL_SCALE,
            text_tint
        )
        solo_progress_draw_meta_nodes(
            self,
            self.ui.solo_score_breakdown_value_digits and self.ui.solo_score_breakdown_value_digits[row] or nil,
            tostring(math.floor((values[row] or 0) + 0.5)),
            SOLO_SCORE_BREAKDOWN_PANEL_X + SOLO_SCORE_BREAKDOWN_VALUE_X_OFFSET,
            row_y,
            SOLO_SCORE_BREAKDOWN_VALUE_SPACING,
            SOLO_SCORE_BREAKDOWN_VALUE_SCALE,
            value_tint,
            false
        )
    end
end

solo_progress_ui_ensure_nodes = function(self)
    if not (self and self.ui) then
        return
    end
    self.ui.solo_progress_row_fill = self.ui.solo_progress_row_fill or {}
    self.ui.solo_progress_row_lock = self.ui.solo_progress_row_lock or {}
    self.ui.solo_progress_locked_masks = self.ui.solo_progress_locked_masks or {}
    self.ui.solo_progress_mission_hitboxes = self.ui.solo_progress_mission_hitboxes or {}
    self.ui.solo_progress_mission_type_letters = self.ui.solo_progress_mission_type_letters or {}
    self.ui.solo_progress_mission_meta_digits = self.ui.solo_progress_mission_meta_digits or {}
    self.ui.solo_progress_row_total_digits = self.ui.solo_progress_row_total_digits or {}
    if not self.ui.solo_progress_selected_box then
        self.ui.solo_progress_selected_box = create_ui_square(0, 0, SOLO_SETUP_UI_Z + 0.003, vmath.vector4(0, 0, 0, 0), SOLO_SETUP_MISSION_BOX_W, SOLO_SETUP_MISSION_BOX_H)
    end
    for i = 1, 3 do
        if not self.ui.solo_progress_row_fill[i] then
            self.ui.solo_progress_row_fill[i] = create_ui_square(0, 0, SOLO_SETUP_UI_Z + 0.002, vmath.vector4(0, 0, 0, 0), SOLO_SETUP_FILL_BAR_W, SOLO_SETUP_FILL_BAR_H)
        end
        if not self.ui.solo_progress_row_lock[i] then
            self.ui.solo_progress_row_lock[i] = create_ui_marker_sprite(hash("solo_screen_unlock"), SOLO_SETUP_UI_Z + 0.003)
        end
        self.ui.solo_progress_row_total_digits[i] = self.ui.solo_progress_row_total_digits[i] or {}
        for ci = 1, SOLO_SETUP_ROW_TOTAL_MAX_CHARS do
            if not self.ui.solo_progress_row_total_digits[i][ci] then
                self.ui.solo_progress_row_total_digits[i][ci] = create_ui_marker_sprite(hash("score_0"), SOLO_SETUP_TEXT_Z)
            end
        end
    end
    for i = 1, SOLO_SETUP_MISSION_COUNT do
        if not self.ui.solo_progress_locked_masks[i] then
            self.ui.solo_progress_locked_masks[i] = create_ui_square(0, 0, SOLO_SETUP_UI_Z + 0.002, vmath.vector4(0, 0, 0, 0), SOLO_SETUP_MISSION_BOX_W, SOLO_SETUP_MISSION_BOX_H)
        end
        if not self.ui.solo_progress_mission_hitboxes[i] then
            self.ui.solo_progress_mission_hitboxes[i] = create_ui_square_alpha(0, 0, SOLO_SETUP_UI_Z + 0.03, vmath.vector4(0, 0, 0, 0), SOLO_SETUP_MISSION_BOX_W, SOLO_SETUP_MISSION_BOX_H)
        end
        self.ui.solo_progress_mission_type_letters[i] = self.ui.solo_progress_mission_type_letters[i] or {}
        self.ui.solo_progress_mission_meta_digits[i] = self.ui.solo_progress_mission_meta_digits[i] or {}
        for ci = 1, SOLO_SETUP_MISSION_TYPE_MAX_CHARS do
            if not self.ui.solo_progress_mission_type_letters[i][ci] then
                self.ui.solo_progress_mission_type_letters[i][ci] = create_ui_marker_sprite(hash("letter_a"), SOLO_SETUP_TEXT_Z)
            end
        end
        for ci = 1, SOLO_SETUP_MISSION_META_MAX_CHARS do
            if not self.ui.solo_progress_mission_meta_digits[i][ci] then
                self.ui.solo_progress_mission_meta_digits[i][ci] = create_ui_marker_sprite(hash("score_0"), SOLO_SETUP_TEXT_Z)
            end
        end
    end
end

solo_progress_ui_hide_nodes = function(self, hidden_tint)
    if not (self and self.ui) then
        return
    end
    if self.ui.solo_progress_selected_box then
        set_ui_square_transform(self, self.ui.solo_progress_selected_box, -9999, -9999, SOLO_SETUP_UI_Z + 0.003, hidden_tint, SOLO_SETUP_MISSION_BOX_W, SOLO_SETUP_MISSION_BOX_H)
    end
    if self.ui.solo_progress_row_fill then
        for i = 1, #self.ui.solo_progress_row_fill do
            set_ui_square_transform(self, self.ui.solo_progress_row_fill[i], -9999, -9999, SOLO_SETUP_UI_Z + 0.002, hidden_tint, SOLO_SETUP_FILL_BAR_W, SOLO_SETUP_FILL_BAR_H)
        end
    end
    if self.ui.solo_progress_row_lock then
        for i = 1, #self.ui.solo_progress_row_lock do
            set_ui_square_transform(self, self.ui.solo_progress_row_lock[i], -9999, -9999, SOLO_SETUP_UI_Z + 0.003, hidden_tint, 1, 1)
        end
    end
    if self.ui.solo_progress_locked_masks then
        for i = 1, #self.ui.solo_progress_locked_masks do
            set_ui_square_transform(self, self.ui.solo_progress_locked_masks[i], -9999, -9999, SOLO_SETUP_UI_Z + 0.002, hidden_tint, SOLO_SETUP_MISSION_BOX_W, SOLO_SETUP_MISSION_BOX_H)
        end
    end
    if self.ui.solo_progress_mission_hitboxes then
        for i = 1, #self.ui.solo_progress_mission_hitboxes do
            set_ui_square_transform(self, self.ui.solo_progress_mission_hitboxes[i], -9999, -9999, SOLO_SETUP_UI_Z + 0.03, hidden_tint, SOLO_SETUP_MISSION_BOX_W, SOLO_SETUP_MISSION_BOX_H)
        end
    end
    if self.ui.solo_progress_mission_type_letters then
        for i = 1, #self.ui.solo_progress_mission_type_letters do
            local slot_letters = self.ui.solo_progress_mission_type_letters[i]
            if slot_letters then
                for ci = 1, #slot_letters do
                    set_ui_square_transform(self, slot_letters[ci], -9999, -9999, SOLO_SETUP_TEXT_Z, hidden_tint, SOLO_SETUP_MISSION_TYPE_SCALE, SOLO_SETUP_MISSION_TYPE_SCALE)
                end
            end
        end
    end
    if self.ui.solo_progress_mission_meta_digits then
        for i = 1, #self.ui.solo_progress_mission_meta_digits do
            local slot_digits = self.ui.solo_progress_mission_meta_digits[i]
            if slot_digits then
                for ci = 1, #slot_digits do
                    set_ui_square_transform(
                        self,
                        slot_digits[ci],
                        -9999,
                        -9999,
                        SOLO_SETUP_TEXT_Z,
                        hidden_tint,
                        SCORE_HUD_DIGIT_DRAW_W * 0.021 * SOLO_SETUP_MISSION_META_SCALE,
                        SCORE_HUD_DIGIT_DRAW_H * 0.021 * SOLO_SETUP_MISSION_META_SCALE
                    )
                end
            end
        end
    end
    if self.ui.solo_progress_row_total_digits then
        for i = 1, #self.ui.solo_progress_row_total_digits do
            local row_digits = self.ui.solo_progress_row_total_digits[i]
            if row_digits then
                for ci = 1, #row_digits do
                    set_ui_square_transform(
                        self,
                        row_digits[ci],
                        -9999,
                        -9999,
                        SOLO_SETUP_TEXT_Z,
                        hidden_tint,
                        SCORE_HUD_DIGIT_DRAW_W * 0.021 * SOLO_SETUP_ROW_TOTAL_SCALE,
                        SCORE_HUD_DIGIT_DRAW_H * 0.021 * SOLO_SETUP_ROW_TOTAL_SCALE
                    )
                end
            end
        end
    end
end

function start_solo_game_flow(self)
    self.multiplayer_mode_active = false
    self.tutorial_mode = false
    if self.mp_state then
        self.mp_state.enabled = false
    end
    solo_setup_init_runtime(self)
    local mission_slot = math.max(1, math.min(SOLO_SETUP_MISSION_COUNT, tonumber(self.solo_setup and self.solo_setup.selected_mission_slot or 1) or 1))
    if not solo_progress_is_mission_unlocked(self, mission_slot) then
        show_advisory(self, "mission locked", 1.1)
        return
    end
    local level_index = solo_progress_map_mission_to_level_index(self, mission_slot)
    local level_def = self.level_library and self.level_library[level_index] or nil
    self.selected_mission_type = multiplayer_normalize_mission_type(get_level_mission_type(level_def))
    self.solo_active_mission_slot = mission_slot
    self.controlled_unit_id = "sarge"
    reset_and_load_level(self, level_index, false)
    reset_derple_feedback_runtime(self)
    apply_aesthetic_mode(self)
    enter_flow_state(self, FLOW_STATE_GAME)
    self.game_won = false
end

local function start_tutorial_game_flow(self)
    self.multiplayer_mode_active = false
    self.tutorial_mode = true
    self.solo_active_mission_slot = nil
    if self.mp_state then
        self.mp_state.enabled = false
    end
    self.selected_mission_type = MISSION_TYPE_TUTORIAL
    self.controlled_unit_id = "sarge"
    reset_and_load_level(self, 5, false)
    self.tutorial_mode = true
    self.tutorial_completed = false
    local step1 = TUTORIAL_STEP_DEFS[1]
    local wx, wy = get_tutorial_step_world_center(self, step1)
    if wx and wy then
        self.camera_pos.x = wx
        self.camera_pos.y = wy
        apply_camera_transform(self)
    end
    tutorial_set_current_step(self, 1)
    reset_derple_feedback_runtime(self)
    apply_aesthetic_mode(self)
    enter_flow_state(self, FLOW_STATE_GAME)
    self.game_won = false
end

solo_setup_init_runtime = function(self)
    self.solo_setup = self.solo_setup or {}
    solo_progress_ensure_runtime(self)
    local selected_slot = tonumber(self.solo_setup.selected_mission_slot or 0) or 0
    if selected_slot < 1 or selected_slot > SOLO_SETUP_MISSION_COUNT then
        selected_slot = solo_progress_get_default_selected_slot(self)
    end
    if not solo_progress_is_mission_unlocked(self, selected_slot) then
        selected_slot = solo_progress_get_default_selected_slot(self)
    end
    self.solo_setup.selected_mission_slot = selected_slot
    local level_index = solo_progress_map_mission_to_level_index(self, selected_slot)
    local level_def = self.level_library and self.level_library[level_index] or nil
    self.solo_setup.mission_type = multiplayer_normalize_mission_type(get_level_mission_type(level_def))
end

function start_multiplayer_game_flow(self, session_config)
    if demo_is_build_enabled(self) then
        enter_demo_select_flow(self)
        return
    end
    self.multiplayer_mode_active = true
    self.tutorial_mode = false
    self.solo_active_mission_slot = nil
    self.selected_mission_type = multiplayer_normalize_mission_type(session_config and session_config.mission_type or self.selected_mission_type or MISSION_TYPE_ESCAPE)
    if self.mp_state then
        self.mp_state.enabled = true
        self.mp_state.match_end_dispatched = false
        self.mp_state.match_end_last_event_id = ""
        self.mp_state.lobby_ticket_id = ""
        self.mp_state.session_id = "local_session_" .. tostring(os.time())
        self.mp_state.mission_type = self.selected_mission_type
        local session_player_count = session_config and session_config.player_count or self.mp_state.player_count or 4
        self.mp_state.player_count = math.max(2, math.min(4, session_player_count))
        if session_config and session_config.seat_assignments then
            self.mp_state.seat_assignments = multiplayer_clone_seat_assignments(session_config.seat_assignments, self.mp_state.player_count)
        elseif not self.mp_state.seat_assignments then
            self.mp_state.seat_assignments = multiplayer_get_default_seat_assignments(self.mp_state.player_count)
        end
        self.mp_state.required_ready_player_ids = multiplayer_get_required_ready_player_ids_for_count(self.mp_state.player_count)
        self.mp_state.workshop_state_sync_accum_s = 0
        self.mp_state.workshop_state_sync_signature = ""
        self.mp_state.factory_state_sync_accum_s = 0
        self.mp_state.factory_state_sync_signature = ""
        self.mp_state.turn_based_snapshot_accum_s = 0
        self.mp_state.turn_based_heartbeat_mismatch_streak = 0
        self.mp_state.turn_based_heartbeat_last_request_turn_id = 0
        self.mp_state.civilian_seed = tonumber(session_config and session_config.civilian_seed or 0) or 0
        multiplayer_apply_wire_dispatch_player_id(self, session_config)
        if self.mp_state.local_player_id == self.mp_state.host_player_id then
            multiplayer_seed_match_connected_players(self)
        end
    end
    multiplayer_reset_ready_gate(self)
    if self.mp_state then
        self.mp_state.debug_active_player_id = self.mp_state.local_player_id or self.mp_state.host_player_id
    end
    local level_index = tonumber(session_config and session_config.level_index or 0) or 0
    if level_index < 1 or not (self.level_library and self.level_library[level_index]) then
        level_index = select_level_index_for_mission(self, self.selected_mission_type)
    end
    reset_and_load_level(self, level_index, false)
    multiplayer_enforce_controlled_unit(self, true)
    reset_derple_feedback_runtime(self)
    apply_aesthetic_mode(self)
    enter_flow_state(self, FLOW_STATE_GAME)
    self.game_won = false
end

multiplayer_setup_clamp_player_count = function(player_count)
    return math.max(1, math.min(4, tonumber(player_count or 1) or 1))
end

multiplayer_lobby_lifecycle_log = function(self, message)
    multiplayer_debug_log(self, message)
end

multiplayer_lobby_lifecycle_guest = function(self, new_state, detail)
    if not (self and self.mp_lobby) then
        return false
    end
    MP_LOBBY_LIFECYCLE.ensure(self.mp_lobby)
    return MP_LOBBY_LIFECYCLE.guest_transition(
        self.mp_lobby,
        new_state,
        detail,
        function(message) multiplayer_lobby_lifecycle_log(self, message) end
    )
end

multiplayer_lobby_lifecycle_host = function(self, new_state, detail)
    if not (self and self.mp_lobby) then
        return false
    end
    MP_LOBBY_LIFECYCLE.ensure(self.mp_lobby)
    return MP_LOBBY_LIFECYCLE.host_transition(
        self.mp_lobby,
        new_state,
        detail,
        function(message) multiplayer_lobby_lifecycle_log(self, message) end
    )
end

multiplayer_lobby_lifecycle_refresh_host = function(self, session)
    if not (self and self.mp_lobby and multiplayer_lobby_is_local_offer_owner(self)) then
        return
    end
    session = session or multiplayer_lobby_get_active_session(self)
    MP_LOBBY_LIFECYCLE.ensure(self.mp_lobby)
    if self.mp_lobby.lifecycle_host_state == MP_LOBBY_LIFECYCLE.HOST_LAUNCHED then
        return
    end
    local guest_count = multiplayer_lobby_count_session_guests(self, session)
    local guests_synced = multiplayer_lobby_joined_guests_setup_synced(self, session)
    MP_LOBBY_LIFECYCLE.refresh_host_derived(
        self.mp_lobby,
        guest_count,
        guests_synced,
        function(message) multiplayer_lobby_lifecycle_log(self, message) end
    )
end

multiplayer_setup_roster_player_count = function(self, session)
    session = session or (self and multiplayer_lobby_get_active_session(self))
    if type(session) ~= "table" then
        return 1
    end
    if type(session.joined_player_ids) == "table" and #session.joined_player_ids > 0 then
        return multiplayer_setup_clamp_player_count(#session.joined_player_ids)
    end
    local players = tonumber(session.players or 0) or 0
    if players > 0 then
        return multiplayer_setup_clamp_player_count(players)
    end
    return 1
end

multiplayer_setup_sync_player_count_from_roster = function(self, session)
    if not (self and self.mp_setup) then
        return false
    end
    local roster_n = multiplayer_setup_roster_player_count(self, session)
    if tonumber(self.mp_setup.player_count or 0) == roster_n then
        return false
    end
    multiplayer_setup_set_player_count(self, roster_n)
    return true
end

multiplayer_lobby_collect_launch_guest_ids = function(self, session)
    local guest_ids = {}
    if type(session) ~= "table" then
        return guest_ids
    end
    local host_id = mp_normalize_network_player_id(
        self and self.mp_state and (self.mp_state.host_player_id or self.mp_state.local_player_id or "p1") or "p1"
    )
    for _, joined_id in ipairs(session.joined_player_ids or {}) do
        local guest_id = mp_normalize_network_player_id(joined_id)
        if guest_id ~= "" and guest_id ~= host_id then
            guest_ids[#guest_ids + 1] = guest_id
        end
    end
    return guest_ids
end

multiplayer_setup_refresh_player_count_dirty = function(_self)
    return false
end

multiplayer_setup_is_player_count_dirty = function(_self)
    return false
end

multiplayer_setup_init_runtime = function(self)
    self.mp_setup = self.mp_setup or {}
    self.mp_setup.player_count = multiplayer_setup_clamp_player_count(self.mp_setup.player_count or 1)
    self.mp_setup.mission_type = multiplayer_normalize_mission_type(self.mp_setup.mission_type or MISSION_TYPE_ESCAPE)
    self.mp_setup.selected_unit_id = self.mp_setup.selected_unit_id or "techie"
    self.mp_setup.seat_slots = self.mp_setup.seat_slots or {}
    local defaults = multiplayer_get_default_seat_assignments(self.mp_setup.player_count)
    for _, player_id in ipairs(MP_SETUP_PLAYER_IDS) do
        local slot_count = multiplayer_get_slot_count_for_player(self.mp_setup.player_count, player_id)
        self.mp_setup.seat_slots[player_id] = {}
        for slot_index = 1, slot_count do
            self.mp_setup.seat_slots[player_id][slot_index] = false
        end
    end
    for player_id, units in pairs(defaults) do
        if self.mp_setup.seat_slots[player_id] then
            for slot_index, unit_id in ipairs(units) do
                if self.mp_setup.seat_slots[player_id][slot_index] ~= nil then
                    self.mp_setup.seat_slots[player_id][slot_index] = unit_id
                end
            end
        end
    end
end

multiplayer_setup_set_player_count = function(self, player_count)
    self.mp_setup = self.mp_setup or {}
    local selected_unit_before = self.mp_setup.selected_unit_id
    local new_count = multiplayer_setup_clamp_player_count(player_count)
    self.mp_setup.player_count = new_count
    self.mp_setup.mission_type = multiplayer_normalize_mission_type(self.mp_setup.mission_type or MISSION_TYPE_ESCAPE)
    self.mp_setup.selected_unit_id = selected_unit_before or "techie"
    self.mp_setup.seat_slots = {}
    local defaults = multiplayer_get_default_seat_assignments(self.mp_setup.player_count)
    for _, player_id in ipairs(MP_SETUP_PLAYER_IDS) do
        local slot_count = multiplayer_get_slot_count_for_player(self.mp_setup.player_count, player_id)
        self.mp_setup.seat_slots[player_id] = {}
        for slot_index = 1, slot_count do
            self.mp_setup.seat_slots[player_id][slot_index] = false
        end
    end
    for player_id, units in pairs(defaults) do
        for slot_index, unit_id in ipairs(units) do
            if self.mp_setup.seat_slots[player_id] and self.mp_setup.seat_slots[player_id][slot_index] ~= nil then
                self.mp_setup.seat_slots[player_id][slot_index] = unit_id
            end
        end
    end
end

multiplayer_setup_remove_unit_from_slots = function(self, unit_id)
    if not (self.mp_setup and self.mp_setup.seat_slots) then
        return
    end
    for _, player_id in ipairs(MP_SETUP_PLAYER_IDS) do
        local slots = self.mp_setup.seat_slots[player_id]
        if slots then
            for slot_index = 1, #slots do
                if slots[slot_index] == unit_id then
                    slots[slot_index] = false
                end
            end
        end
    end
end

multiplayer_setup_unit_assigned = function(self, unit_id)
    if not (self.mp_setup and self.mp_setup.seat_slots) then
        return false
    end
    for _, player_id in ipairs(MP_SETUP_PLAYER_IDS) do
        local slots = self.mp_setup.seat_slots[player_id]
        if slots then
            for slot_index = 1, #slots do
                if slots[slot_index] == unit_id then
                    return true
                end
            end
        end
    end
    return false
end

multiplayer_setup_is_valid = function(self)
    if not (self.mp_setup and self.mp_setup.seat_slots) then
        return false
    end
    local session_joined_count = nil
    if self.mp_state and self.mp_state.enabled then
        local active_session_id = tostring(self.mp_state.session_id or "")
        if active_session_id ~= "" then
            multiplayer_lobby_ensure_runtime(self)
            local active_offer = multiplayer_lobby_get_session_by_id(self, active_session_id)
            if active_offer then
                if type(active_offer.joined_player_ids) == "table" and #active_offer.joined_player_ids > 0 then
                    session_joined_count = #active_offer.joined_player_ids
                else
                    local offer_players = tonumber(active_offer.players or 0) or 0
                    if offer_players > 0 then
                        session_joined_count = offer_players
                    end
                end
            end
        end
    end
    local used = {}
    local total_assigned = 0
    local assigned_per_player = {}
    local count = self.mp_setup.player_count or 2
    if session_joined_count and session_joined_count > 0 and count > session_joined_count then
        return false
    end
    for i = 1, count do
        local player_id = "p" .. tostring(i)
        local slot_count = multiplayer_get_slot_count_for_player(count, player_id)
        local slots = self.mp_setup.seat_slots[player_id] or {}
        local player_assigned = 0
        for slot_index = 1, slot_count do
            local unit_id = slots[slot_index]
            if unit_id and unit_id ~= false then
                if used[unit_id] then
                    return false
                end
                used[unit_id] = true
                total_assigned = total_assigned + 1
                player_assigned = player_assigned + 1
            end
        end
        assigned_per_player[player_id] = player_assigned
    end
    if total_assigned ~= #MP_SETUP_UNIT_IDS then
        return false
    end
    if multiplayer_get_player_for_unit(self.mp_setup.seat_slots, count, "sarge") ~= "p1" then
        return false
    end
    if count == 1 or count == 2 then
        if assigned_per_player.p1 ~= 2 or assigned_per_player.p2 ~= 2 then
            return false
        end
    elseif count == 3 then
        if (assigned_per_player.p1 or 0) ~= 2
            or (assigned_per_player.p2 or 0) ~= 1
            or (assigned_per_player.p3 or 0) ~= 1 then
            return false
        end
    elseif count == 4 then
        if (assigned_per_player.p1 or 0) ~= 1
            or (assigned_per_player.p2 or 0) ~= 1
            or (assigned_per_player.p3 or 0) ~= 1
            or (assigned_per_player.p4 or 0) ~= 1 then
            return false
        end
    end
    return true
end

multiplayer_setup_build_session_config = function(self, override_player_count)
    local count = multiplayer_setup_clamp_player_count(
        override_player_count or (self.mp_setup and self.mp_setup.player_count or 2)
    )
    local mission_type = multiplayer_normalize_mission_type(self.mp_setup and self.mp_setup.mission_type or MISSION_TYPE_ESCAPE)
    local compact = {}
    for i = 1, count do
        local player_id = "p" .. tostring(i)
        compact[player_id] = {}
        local slots = self.mp_setup and self.mp_setup.seat_slots and self.mp_setup.seat_slots[player_id] or {}
        local slot_count = multiplayer_get_slot_count_for_player(count, player_id)
        for slot_index = 1, slot_count do
            local unit_id = slots and slots[slot_index] or nil
            if unit_id and unit_id ~= false then
                table.insert(compact[player_id], unit_id)
            end
        end
    end
    local wire_dispatch_player_id = multiplayer_resolve_wire_dispatch_player_id(self)
    if wire_dispatch_player_id == "" then
        wire_dispatch_player_id = tostring(self.mp_state and self.mp_state.local_player_id or "p1")
    end
    return {
        player_count = count,
        seat_assignments = compact,
        mission_type = mission_type,
        civilian_seed = math.random(1, 2147483646),
        wire_dispatch_player_id = wire_dispatch_player_id
    }
end

multiplayer_setup_build_guest_wire_config = function(self, session)
    local roster_n = multiplayer_setup_roster_player_count(self, session)
    local config = multiplayer_setup_build_session_config(self, roster_n)
    config.player_count = roster_n
    return config
end

multiplayer_setup_apply_session_config = function(self, session_config)
    if type(session_config) ~= "table" then
        return
    end
    local selected_unit_before = self.mp_setup and self.mp_setup.selected_unit_id or nil
    local player_count = multiplayer_setup_clamp_player_count(session_config.player_count or 1)
    multiplayer_setup_set_player_count(self, player_count)
    if selected_unit_before and selected_unit_before ~= false then
        self.mp_setup.selected_unit_id = selected_unit_before
    end
    self.mp_setup.mission_type = multiplayer_normalize_mission_type(session_config.mission_type or self.mp_setup.mission_type or MISSION_TYPE_ESCAPE)
    if session_config.wire_dispatch_player_id ~= nil then
        multiplayer_apply_wire_dispatch_player_id(self, session_config)
    end
    local assignments = multiplayer_clone_seat_assignments(session_config.seat_assignments or {}, player_count)
    for _, player_id in ipairs(MP_SETUP_PLAYER_IDS) do
        local slot_count = multiplayer_get_slot_count_for_player(player_count, player_id)
        self.mp_setup.seat_slots[player_id] = self.mp_setup.seat_slots[player_id] or {}
        for slot_index = 1, slot_count do
            self.mp_setup.seat_slots[player_id][slot_index] = false
        end
        local units = assignments[player_id] or {}
        for slot_index = 1, math.min(slot_count, #units) do
            self.mp_setup.seat_slots[player_id][slot_index] = units[slot_index]
        end
    end
end

multiplayer_host_start_match_from_setup = function(self)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return false
    end
    if not multiplayer_lobby_can_host_launch(self) then
        multiplayer_debug_log(self, "MP STEAM GATEF | start_match_blocked reason=not_session_host")
        return false
    end
    if not multiplayer_setup_is_valid(self) then
        multiplayer_debug_log(self, "MP STEAM GATEF | start_match_blocked reason=invalid_setup")
        return false
    end
    if not multiplayer_lobby_joined_guests_setup_synced(self) then
        multiplayer_debug_log(self, "MP STEAM GATEF | start_match_blocked reason=guest_setup_not_synced")
        return false
    end
    local session = multiplayer_lobby_get_active_session(self)
    multiplayer_setup_sync_player_count_from_roster(self, session)
    local launch_count = multiplayer_setup_roster_player_count(self, session)
    local launch_guest_ids = multiplayer_lobby_collect_launch_guest_ids(self, session)
    local config = multiplayer_setup_build_session_config(self, launch_count)
    config.player_count = launch_count
    config.level_index = select_level_index_for_mission(self, config.mission_type or MISSION_TYPE_ESCAPE)
    if self.mp_state then
        self.mp_state.player_count = launch_count
    end
    multiplayer_lobby_ensure_runtime(self)
    multiplayer_lobby_lifecycle_host(self, MP_LOBBY_LIFECYCLE.HOST_LAUNCHED, {
        players = launch_count,
        guests = #launch_guest_ids
    })
    local active_offer_id = tostring(self.mp_lobby and self.mp_lobby.local_active_offer_id or "")
    if active_offer_id ~= "" then
        local active_session = multiplayer_lobby_get_session_by_id(self, active_offer_id)
        if active_session then
            MP_SESSION_TICKET.mark_launched(active_session)
            active_session.status = "launched"
            active_session.lobby_status = MP_SESSION_TICKET.LOBBY_STATUS_LAUNCHED
        end
        multiplayer_lobby_note_offer_removed(self, active_offer_id, get_wall_clock_ms())
        multiplayer_lobby_apply_offer_remove(self, active_offer_id)
        multiplayer_transport_broadcast_event(self, "lobby_offer_remove", {
            offer_id = active_offer_id,
            owner_player_id = tostring(self.mp_state.host_player_id or self.mp_state.local_player_id or "p1"),
            reason = "launched",
            lobby_status = MP_SESSION_TICKET.LOBBY_STATUS_LAUNCHED,
            removed_at_ms = get_wall_clock_ms()
        })
        multiplayer_lobby_clear_steam_discovery_if_host(self)
    end
    if session then
        for _, joined_id in ipairs(session.joined_player_ids or {}) do
            multiplayer_mark_remote_player_alive(self, joined_id)
        end
    end
    local host_evt = multiplayer_transport_emit_event(self, "match_started", {
        session_config = config
    })
    multiplayer_transport_on_event(self, host_evt)
    local guest_events = {}
    local host_id = mp_normalize_network_player_id(self.mp_state.host_player_id or self.mp_state.local_player_id or "p1")
    for _, guest_id in ipairs(launch_guest_ids) do
        if guest_id ~= "" and guest_id ~= host_id then
            guest_events[#guest_events + 1] = multiplayer_transport_emit_event(self, "match_started", {
                target_player_id = guest_id,
                session_config = config
            })
        end
    end
    if #guest_events > 0 then
        multiplayer_transport_broadcast_events(self, guest_events)
    end
    multiplayer_debug_log(self, string.format(
        "MP STEAM GATEF | start_match host_local players=%d roster_guests=%d",
        tonumber(config.player_count or 0) or 0,
        #launch_guest_ids
    ))
    return true
end

multiplayer_setup_push_state = function(self)
    if not (self.mp_state and self.mp_state.enabled) then
        return
    end
    if not multiplayer_lobby_is_local_offer_owner(self) then
        return
    end
    local session = multiplayer_lobby_get_active_session(self)
    multiplayer_setup_sync_player_count_from_roster(self, session)
    local roster_n = multiplayer_setup_roster_player_count(self, session)
    local config = multiplayer_setup_build_session_config(self, roster_n)
    config.player_count = roster_n
    -- Primary path: direct host event broadcast keeps setup UI synced even if command handling drops.
    multiplayer_transport_broadcast_event(self, "setup_state_updated", {
        session_config = config
    })
    -- Compatibility path: keep the command route so existing trace/debug flow still exercises it.
    multiplayer_transport_send_command(self, "push_setup_state", {
        session_config = config
    }, self.mp_state.local_player_id)
end

multiplayer_lobby_is_host = function(self)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return true
    end
    local local_offer_id = tostring(self.mp_lobby and self.mp_lobby.local_active_offer_id or "")
    local active_ticket_id = multiplayer_lobby_get_lobby_ticket_id(self)
    if local_offer_id ~= "" and active_ticket_id ~= "" and local_offer_id == active_ticket_id then
        return true
    end
    if multiplayer_lobby_is_session_host(self) then
        return true
    end
    return self.mp_state.local_player_id == self.mp_state.host_player_id
end

multiplayer_apply_in_match_player_departure = function(self, departed_network_player_id)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return false
    end
    local departed_network_id = mp_normalize_network_player_id(departed_network_player_id)
    if departed_network_id == "" then
        return false
    end
    local host_network_id = tostring(self.mp_state.host_player_id or self.mp_state.local_player_id or "p1")
    local local_network_id = tostring(self.mp_state.local_player_id or "")
    local local_is_host = multiplayer_lobby_is_host(self)
    if host_network_id == "" then
        host_network_id = local_network_id ~= "" and local_network_id or "p1"
    end
    if departed_network_id == host_network_id and local_network_id ~= "" and local_network_id ~= departed_network_id then
        host_network_id = local_network_id
    elseif departed_network_id == host_network_id then
        return false
    end
    local departed_slot_id = multiplayer_get_slot_player_id_for_network(self, departed_network_id)
    local host_slot_id = multiplayer_get_slot_player_id_for_network(self, host_network_id)
    if local_is_host and local_network_id ~= "" then
        host_network_id = local_network_id
        host_slot_id = multiplayer_get_slot_player_id_for_network(self, local_network_id)
        self.mp_state.host_player_id = local_network_id
    end
    local changed = false
    self.mp_state.connected_players = self.mp_state.connected_players or {}
    local departed_network_slot_id = multiplayer_get_slot_player_id_for_network(self, departed_network_id)
    if self.mp_state.connected_players[departed_network_id] ~= nil then
        self.mp_state.connected_players[departed_network_id] = nil
        changed = true
    end
    if departed_network_slot_id ~= "" and self.mp_state.connected_players[departed_network_slot_id] ~= nil then
        self.mp_state.connected_players[departed_network_slot_id] = nil
        changed = true
    end
    self.mp_state.ready_by_player_id = self.mp_state.ready_by_player_id or {}
    if self.mp_state.ready_by_player_id[departed_network_id] ~= nil then
        self.mp_state.ready_by_player_id[departed_network_id] = nil
        changed = true
    end
    if self.mp_state.ready_by_player_id[departed_slot_id] ~= nil then
        self.mp_state.ready_by_player_id[departed_slot_id] = nil
        changed = true
    end
    if self.mp_state.required_ready_player_ids then
        for i = #self.mp_state.required_ready_player_ids, 1, -1 do
            local required_id = tostring(self.mp_state.required_ready_player_ids[i] or "")
            if required_id == departed_network_id or required_id == departed_slot_id then
                table.remove(self.mp_state.required_ready_player_ids, i)
                changed = true
            end
        end
    end
    self.mp_state.seat_assignments = self.mp_state.seat_assignments or multiplayer_get_default_seat_assignments(self.mp_state.player_count or 4)
    self.mp_state.seat_assignments[host_slot_id] = self.mp_state.seat_assignments[host_slot_id] or {}
    self.mp_state.seat_assignments[departed_slot_id] = self.mp_state.seat_assignments[departed_slot_id] or {}
    local host_units = self.mp_state.seat_assignments[host_slot_id]
    local departed_units = self.mp_state.seat_assignments[departed_slot_id]
    local ownership_changed = false
    for _, unit_id in ipairs(departed_units) do
        local exists = false
        for _, host_unit_id in ipairs(host_units) do
            if host_unit_id == unit_id then
                exists = true
                break
            end
        end
        if not exists then
            host_units[#host_units + 1] = unit_id
        end
        ownership_changed = true
    end
    if ownership_changed then
        self.mp_state.seat_assignments[departed_slot_id] = {}
        changed = true
    end
    -- Also reclaim any seat whose mapped network player is no longer connected.
    self.mp_state.connected_players[host_network_id] = true
    local connected_count = 0
    for _, is_connected in pairs(self.mp_state.connected_players or {}) do
        if is_connected == true then
            connected_count = connected_count + 1
        end
    end
    local occupied_non_host_slots = 0
    local max_non_host_units_in_single_slot = 0
    for i = 1, 4 do
        local slot_id = "p" .. tostring(i)
        if slot_id ~= host_slot_id then
            local slot_units = self.mp_state.seat_assignments[slot_id] or {}
            if #slot_units > 0 then
                occupied_non_host_slots = occupied_non_host_slots + 1
                if #slot_units > max_non_host_units_in_single_slot then
                    max_non_host_units_in_single_slot = #slot_units
                end
            end
        end
    end
    local force_reclaim_all_non_host = connected_count <= 1
        or (tonumber(self.mp_state.player_count or 2) or 2) <= 2
        or (occupied_non_host_slots <= 1 and max_non_host_units_in_single_slot >= 2)
    if force_reclaim_all_non_host then
        for i = 1, 4 do
            local slot_id = "p" .. tostring(i)
            if slot_id ~= host_slot_id then
                local slot_units = self.mp_state.seat_assignments[slot_id] or {}
                local moved_any = false
                for _, unit_id in ipairs(slot_units) do
                    local exists = false
                    for _, host_unit_id in ipairs(host_units) do
                        if host_unit_id == unit_id then
                            exists = true
                            break
                        end
                    end
                    if not exists then
                        host_units[#host_units + 1] = unit_id
                    end
                    moved_any = true
                end
                if moved_any then
                    self.mp_state.seat_assignments[slot_id] = {}
                    changed = true
                end
                if self.mp_state.ready_by_player_id[slot_id] ~= nil then
                    self.mp_state.ready_by_player_id[slot_id] = nil
                    changed = true
                end
            end
        end
    end
    if local_is_host and force_reclaim_all_non_host then
        local all_units = {}
        local unit_order = get_spawn_order_unit_id_list()
        for _, unit_id in ipairs(unit_order or {}) do
            if self.squad_units and self.squad_units[unit_id] then
                all_units[#all_units + 1] = unit_id
            end
        end
        self.mp_state.seat_assignments[host_slot_id] = all_units
        for i = 1, 4 do
            local slot_id = "p" .. tostring(i)
            if slot_id ~= host_slot_id and self.mp_state.seat_assignments[slot_id] and #self.mp_state.seat_assignments[slot_id] > 0 then
                self.mp_state.seat_assignments[slot_id] = {}
                changed = true
            end
        end
        changed = true
    end
    for i = 1, 4 do
        local slot_id = "p" .. tostring(i)
        if slot_id ~= host_slot_id then
            local mapped_network_id = tostring(mp_network_id_for_slot(self, slot_id) or "")
            local slot_connected = multiplayer_is_match_player_connected(self, slot_id)
            if (not force_reclaim_all_non_host) and (not slot_connected) then
                local slot_units = self.mp_state.seat_assignments[slot_id] or {}
                local moved_any = false
                for _, unit_id in ipairs(slot_units) do
                    local exists = false
                    for _, host_unit_id in ipairs(host_units) do
                        if host_unit_id == unit_id then
                            exists = true
                            break
                        end
                    end
                    if not exists then
                        host_units[#host_units + 1] = unit_id
                    end
                    moved_any = true
                end
                if moved_any then
                    self.mp_state.seat_assignments[slot_id] = {}
                    changed = true
                end
                if self.mp_state.ready_by_player_id[slot_id] ~= nil then
                    self.mp_state.ready_by_player_id[slot_id] = nil
                    changed = true
                end
                if mapped_network_id ~= "" and self.mp_state.ready_by_player_id[mapped_network_id] ~= nil then
                    self.mp_state.ready_by_player_id[mapped_network_id] = nil
                    changed = true
                end
            end
        end
    end
    local active_debug_id = tostring(self.mp_state.debug_active_player_id or "")
    if active_debug_id == departed_network_id or active_debug_id == departed_slot_id then
        self.mp_state.debug_active_player_id = host_network_id
        changed = true
    end
    if changed then
        multiplayer_enforce_controlled_unit(self, true)
        update_human_visual_state(self)
        update_selected_unit_ui(self)
    end
    return changed
end

multiplayer_reconcile_departed_ownership_on_turn_boundary = function(self)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return false
    end
    if not multiplayer_lobby_is_host(self) then
        return false
    end
    if (self.game_flow_state or FLOW_STATE_GAME) ~= FLOW_STATE_GAME then
        return false
    end
    local host_network_id = mp_normalize_network_player_id(self.mp_state.local_player_id or self.mp_state.host_player_id or "p1")
    self.mp_state.host_player_id = host_network_id
    local host_slot_id = multiplayer_get_slot_player_id_for_network(self, host_network_id)
    self.mp_state.seat_assignments = self.mp_state.seat_assignments or multiplayer_get_default_seat_assignments(self.mp_state.player_count or 4)
    self.mp_state.seat_assignments[host_slot_id] = self.mp_state.seat_assignments[host_slot_id] or {}
    local host_units = self.mp_state.seat_assignments[host_slot_id]
    local connected_lookup = self.mp_state.connected_players or {}
    local now_s = (tonumber(get_wall_clock_ms() or 0) or 0) / 1000
    local last_seen_lookup = self.mp_state.last_seen_by_network_id or {}
    local changed = false
    for i = 1, 4 do
        local slot_id = "p" .. tostring(i)
        if slot_id ~= host_slot_id then
            local slot_units = self.mp_state.seat_assignments[slot_id] or {}
            if #slot_units > 0 then
                local mapped_network_id = mp_normalize_network_player_id(mp_network_id_for_slot(self, slot_id) or "")
                local slot_connected = multiplayer_is_match_player_connected(self, slot_id)
                local last_seen_s = tonumber(last_seen_lookup[mapped_network_id] or 0) or 0
                local age_s = (last_seen_s > 0) and (now_s - last_seen_s) or -1
                if slot_connected and mapped_network_id ~= "" then
                    if last_seen_s <= 0 or (now_s - last_seen_s) > MP_CLIENT_LIVENESS_TIMEOUT_S then
                        slot_connected = false
                    end
                end
                multiplayer_debug_log(self, string.format(
                    "MP RECLAIM | slot=%s mapped=%s units=%d connected=%s age=%.2f",
                    tostring(slot_id),
                    tostring(mapped_network_id),
                    #slot_units,
                    tostring(slot_connected),
                    age_s
                ))
                if not slot_connected then
                    for _, unit_id in ipairs(slot_units) do
                        local exists = false
                        for _, host_unit_id in ipairs(host_units) do
                            if host_unit_id == unit_id then
                                exists = true
                                break
                            end
                        end
                        if not exists then
                            host_units[#host_units + 1] = unit_id
                        end
                    end
                    self.mp_state.seat_assignments[slot_id] = {}
                    changed = true
                    multiplayer_debug_log(self, string.format(
                        "MP RECLAIM | moved_slot=%s -> host=%s",
                        tostring(slot_id),
                        tostring(host_slot_id)
                    ))
                end
            end
        end
    end
    if changed then
        multiplayer_enforce_controlled_unit(self, true)
        update_human_visual_state(self)
        update_selected_unit_ui(self)
        multiplayer_debug_log(self, "MP RECLAIM | applied")
    end
    return changed
end

multiplayer_leave_in_progress_match_to_lobby = function(self, reason)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return false
    end
    multiplayer_lobby_ensure_runtime(self)
    multiplayer_lobby_reset_setup_sync_runtime(self)
    multiplayer_lobby_purge_tombstoned_offers(self)
    self.mp_state.lobby_ticket_id = ""
    self.mp_state.session_id = "local_session"
    multiplayer_apply_steam_lobby_wire_defaults(self)
    self.mp_state.debug_active_player_id = self.mp_state.local_player_id or self.mp_state.host_player_id
    self.mp_state.transport_status = "idle"
    self.mp_state.transport_status_detail = {}
    self.mp_state.seen_command_ids = {}
    self.mp_state.seen_event_ids = {}
    if self.mp_lobby then
        self.mp_lobby.pending_steam_lobby_id = ""
        self.mp_lobby.pending_join_session_id = ""
        self.mp_lobby.pending_join_wire_sent = false
        self.mp_lobby.pending_join_wire_session_id = ""
    end
    if self.mp_transport and self.mp_transport.shutdown then
        pcall(self.mp_transport.shutdown)
    end
    self.mp_transport = nil
    self.advisory_anim_id = nil
    self.advisory_timer_s = 0
    self.multiplayer_mode_active = true
    enter_flow_state(self, FLOW_STATE_MP_CHOOSER)
    print(string.format("MP MATCH | return_to_chooser | reason=%s", tostring(reason or "unknown")))
    return true
end

multiplayer_steam_ensure_session_roster_maps = function(session)
    if type(session) ~= "table" then
        return
    end
    session.steam_id_by_wire_id = session.steam_id_by_wire_id or {}
    session.wire_id_by_steam_id = session.wire_id_by_steam_id or {}
end

multiplayer_steam_assign_wire_id_for_guest = function(self, session, guest_steam_id)
    guest_steam_id = tostring(guest_steam_id or "")
    if guest_steam_id == "" or type(session) ~= "table" then
        return ""
    end
    multiplayer_steam_ensure_session_roster_maps(session)
    local existing = session.wire_id_by_steam_id[guest_steam_id]
    if existing and tostring(existing) ~= "" then
        return tostring(existing)
    end
    local max_players = math.max(2, math.min(4, tonumber(session.max_players or 4) or 4))
    for slot = 2, max_players do
        local wire_id = "p" .. tostring(slot)
        local occupied = tostring(session.steam_id_by_wire_id[wire_id] or "")
        if occupied == "" then
            session.steam_id_by_wire_id[wire_id] = guest_steam_id
            session.wire_id_by_steam_id[guest_steam_id] = wire_id
            multiplayer_debug_log(self, string.format(
                "MP STEAM GATEE | steam_seat_assign steam=%s wire=%s session=%s",
                guest_steam_id,
                wire_id,
                tostring(session.id or "")
            ))
            return wire_id
        end
    end
    return ""
end

multiplayer_steam_release_guest_wire_seat = function(session, wire_player_id)
    if type(session) ~= "table" then
        return false
    end
    local wire_id = mp_normalize_network_player_id(wire_player_id)
    if wire_id == "" or wire_id == "p1" then
        return false
    end
    multiplayer_steam_ensure_session_roster_maps(session)
    local steam_id = tostring(session.steam_id_by_wire_id[wire_id] or "")
    if steam_id == "" then
        return false
    end
    session.steam_id_by_wire_id[wire_id] = nil
    session.wire_id_by_steam_id[steam_id] = nil
    return true
end

multiplayer_steam_sync_transport_peer_map = function(self, session)
    if not (self and self.mp_transport and self.mp_transport.steam_sync_peer_map) then
        return
    end
    if type(session) ~= "table" then
        return
    end
    multiplayer_steam_ensure_session_roster_maps(session)
    self.mp_transport.steam_sync_peer_map(session.steam_id_by_wire_id)
end

multiplayer_steam_resolve_guest_wire_id = function(self, session, command)
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") ~= "steam" then
        return mp_normalize_network_player_id(command and command.sender_player_id or "")
    end
    local guest_steam_id = tostring(command and command.guest_steam_id or "")
    if guest_steam_id ~= "" and type(session) == "table" then
        local wire_id = multiplayer_steam_assign_wire_id_for_guest(self, session, guest_steam_id)
        if wire_id ~= "" then
            multiplayer_steam_sync_transport_peer_map(self, session)
            return wire_id
        end
        return ""
    end
    return mp_normalize_network_player_id(command and command.sender_player_id or "")
end

multiplayer_lobby_session_host_wire_id = function(session)
    return mp_normalize_network_player_id(
        session and (session.host_wire_player_id or session.owner_player_id or MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID or "p1")
            or "p1"
    )
end

multiplayer_lobby_committed_player_count = function(self, session)
    return multiplayer_setup_roster_player_count(self, session)
end

multiplayer_lobby_is_player_count_update_blocked = function(_self, _pending_count, _session)
    return false
end

multiplayer_lobby_commit_player_count_settings = function(self)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return false
    end
    return multiplayer_lobby_is_local_offer_owner(self)
end

multiplayer_lobby_count_session_guests = function(self, session)
    local host_id = multiplayer_lobby_session_host_wire_id(session)
    local count = 0
    for _, joined_id in ipairs(session and session.joined_player_ids or {}) do
        local jid = mp_normalize_network_player_id(joined_id)
        if jid ~= "" and jid ~= host_id then
            count = count + 1
        end
    end
    return count
end

multiplayer_lobby_wire_id_in_roster = function(session, wire_id)
    wire_id = mp_normalize_network_player_id(wire_id or "")
    if wire_id == "" or type(session) ~= "table" then
        return false
    end
    for _, joined_id in ipairs(session.joined_player_ids or {}) do
        if mp_normalize_network_player_id(joined_id) == wire_id then
            return true
        end
    end
    return false
end

multiplayer_lobby_reset_setup_sync_runtime = function(self, session)
    if not self then
        return
    end
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    lobby.setup_sync_player_ids = {}
    lobby.guest_join_resend_pending = {}
    lobby.last_setup_roster_revision_acked = 0
    lobby.last_setup_roster_revision_acked_session_id = ""
    lobby.last_launch_block_key = ""
    if type(session) == "table" then
        session.setup_roster_revision = 0
    end
end

multiplayer_lobby_host_waiting_for_guest_sync = function(self)
    if not multiplayer_lobby_is_local_offer_owner(self) then
        return false
    end
    local session = multiplayer_lobby_get_active_session(self)
    if not session then
        return false
    end
    if multiplayer_lobby_count_session_guests(self, session) == 0 then
        return false
    end
    return not multiplayer_lobby_joined_guests_setup_synced(self, session)
end

multiplayer_lobby_append_roster_setup_sync_events = function(self, events, session, setup_config, skip_player_id)
    if type(events) ~= "table" or type(session) ~= "table" or type(setup_config) ~= "table" then
        return
    end
    session.setup_roster_revision = (tonumber(session.setup_roster_revision or 0) or 0) + 1
    local roster_revision = session.setup_roster_revision
    local host_id = multiplayer_lobby_session_host_wire_id(session)
    skip_player_id = mp_normalize_network_player_id(skip_player_id or "")
    for _, joined_id in ipairs(session.joined_player_ids or {}) do
        local jid = mp_normalize_network_player_id(joined_id)
        if jid ~= "" and jid ~= host_id and jid ~= skip_player_id then
            table.insert(events, multiplayer_transport_emit_event(self, "setup_state_updated", {
                target_player_id = jid,
                session_id = tostring(session.id or ""),
                session_config = setup_config,
                require_setup_ack = true,
                roster_revision = roster_revision
            }))
            if self.mp_lobby and self.mp_lobby.setup_sync_player_ids then
                self.mp_lobby.setup_sync_player_ids[jid] = nil
            end
            multiplayer_debug_log(self, string.format(
                "MP LOBBY | roster_setup_sync fanout guest=%s session=%s rev=%d skip=%s",
                jid,
                tostring(session.id or ""),
                roster_revision,
                skip_player_id
            ))
        end
    end
end

multiplayer_apply_steam_transport_seat_ids = function(self)
    if not (self and self.mp_state and self.mp_transport) then
        return
    end
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") ~= "steam" then
        return
    end
    local is_steam_host = self.mp_transport.steam_is_host and self.mp_transport.steam_is_host() == true
    if is_steam_host then
        self.mp_state.local_player_id = "p1"
        self.mp_state.host_player_id = "p1"
    else
        local host_id = tostring(self.mp_state.host_player_id or "p1")
        local adopted = ""
        local local_steam = ""
        if self.mp_transport.steam_get_local_steam_id then
            local_steam = tostring(self.mp_transport.steam_get_local_steam_id() or "")
        end
        if local_steam ~= "" then
            multiplayer_lobby_ensure_runtime(self)
            local session_id = tostring(self.mp_lobby.pending_join_session_id or multiplayer_lobby_get_lobby_ticket_id(self) or "")
            if session_id ~= "" and session_id ~= "local_session" then
                local session = multiplayer_lobby_get_session_by_id(self, session_id)
                if session and type(session.wire_id_by_steam_id) == "table" then
                    adopted = tostring(session.wire_id_by_steam_id[local_steam] or "")
                end
            end
        end
        if adopted ~= "" and adopted ~= host_id then
            self.mp_state.local_player_id = adopted
        elseif tostring(self.mp_state.local_player_id or "") == ""
            or tostring(self.mp_state.local_player_id or "") == host_id
        then
            self.mp_state.local_player_id = "p2"
        end
    end
    if tostring(self.mp_state.lobby_ticket_id or "") == "" then
        multiplayer_apply_steam_lobby_wire_defaults(self)
    end
    if self.mp_transport.set_local_player_id then
        self.mp_transport.set_local_player_id(self.mp_state.local_player_id)
    end
    self.mp_state.debug_active_player_id = self.mp_state.local_player_id
    multiplayer_debug_log(self, string.format(
        "MP STEAM GATEE | seat_assign local=%s host=%s steam_host=%s",
        tostring(self.mp_state.local_player_id or ""),
        tostring(self.mp_state.host_player_id or ""),
        tostring(is_steam_host)
    ))
end

multiplayer_mark_remote_player_alive = function(self, network_player_id)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return
    end
    if not multiplayer_is_wire_dispatch_host(self) then
        return
    end
    local network_id = mp_normalize_network_player_id(network_player_id or "")
    local host_id = mp_normalize_network_player_id(self.mp_state.host_player_id or "")
    if network_id == "" or network_id == host_id then
        return
    end
    self.mp_state.connected_players = self.mp_state.connected_players or {}
    self.mp_state.last_seen_by_network_id = self.mp_state.last_seen_by_network_id or {}
    self.mp_state.connected_players[network_id] = true
    local slot_id = multiplayer_get_slot_player_id_for_network(self, network_id)
    if slot_id and slot_id ~= "" then
        self.mp_state.connected_players[slot_id] = true
    end
    self.mp_state.last_seen_by_network_id[network_id] = (tonumber(get_wall_clock_ms() or 0) or 0) / 1000
end

multiplayer_is_match_player_connected = function(self, player_slot_id)
    if not (self and self.mp_state) then
        return false
    end
    local lookup = self.mp_state.connected_players or {}
    local slot_id = mp_normalize_network_player_id(player_slot_id or "")
    if slot_id == "" then
        return false
    end
    if lookup[slot_id] == true then
        return true
    end
    local network_id = mp_normalize_network_player_id(mp_network_id_for_slot(self, slot_id) or "")
    return network_id ~= "" and lookup[network_id] == true
end

multiplayer_seed_match_connected_players = function(self)
    if not multiplayer_is_wire_dispatch_host(self) then
        return
    end
    self.mp_state.connected_players = self.mp_state.connected_players or {}
    self.mp_state.last_seen_by_network_id = self.mp_state.last_seen_by_network_id or {}
    local host_network_id = mp_normalize_network_player_id(self.mp_state.host_player_id or "p1")
    local host_slot_id = multiplayer_get_slot_player_id_for_network(self, host_network_id)
    self.mp_state.connected_players[host_network_id] = true
    if host_slot_id ~= "" then
        self.mp_state.connected_players[host_slot_id] = true
    end
    local session = multiplayer_lobby_get_active_session(self)
    if session and tostring(MULTIPLAYER_TRANSPORT_MODE or "") == "steam" then
        multiplayer_steam_sync_transport_peer_map(self, session)
    end
    local roster_ids = {}
    if session and type(session.joined_player_ids) == "table" then
        for _, joined_id in ipairs(session.joined_player_ids) do
            local network_id = mp_normalize_network_player_id(joined_id)
            if network_id ~= "" and network_id ~= host_network_id then
                roster_ids[#roster_ids + 1] = network_id
            end
        end
    end
    if #roster_ids == 0 then
        local player_count = math.max(2, math.min(4, tonumber(self.mp_state.player_count or 2) or 2))
        for i = 1, player_count do
            local slot_id = "p" .. tostring(i)
            if slot_id ~= host_slot_id then
                local network_id = mp_normalize_network_player_id(mp_network_id_for_slot(self, slot_id) or slot_id)
                if network_id ~= "" and network_id ~= host_network_id then
                    roster_ids[#roster_ids + 1] = network_id
                end
            end
        end
    end
    for _, network_id in ipairs(roster_ids) do
        multiplayer_mark_remote_player_alive(self, network_id)
    end
    multiplayer_debug_log(self, string.format(
        "MP MATCH | connected_players_seeded roster=%d",
        #roster_ids
    ))
end

multiplayer_guest_sync_runtime_from_session_config = function(self, session_config)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return
    end
    if self.mp_state.local_player_id == self.mp_state.host_player_id then
        return
    end
    if type(session_config) ~= "table" then
        return
    end
    local pc = math.max(2, math.min(4, tonumber(session_config.player_count or self.mp_state.player_count or 2) or 2))
    self.mp_state.player_count = pc
    if type(session_config.seat_assignments) == "table" then
        self.mp_state.seat_assignments = multiplayer_clone_seat_assignments(session_config.seat_assignments, pc)
    end
end

multiplayer_lobby_adopt_incoming_target_wire_id = function(self, target_player_id, session_id)
    if not (self and self.mp_state) then
        return false
    end
    local target = mp_normalize_network_player_id(target_player_id or "")
    if target == "" or (target ~= "p1" and target ~= "p2" and target ~= "p3" and target ~= "p4") then
        return false
    end
    local local_id = mp_normalize_network_player_id(self.mp_state.local_player_id or "p1")
    if target == local_id then
        return false
    end
    multiplayer_lobby_ensure_runtime(self)
    local accepted_session_id = tostring(session_id or self.mp_lobby.pending_join_session_id or self.mp_state.lobby_ticket_id or "")
    if accepted_session_id == "" or accepted_session_id == "local_session" then
        accepted_session_id = tostring(self.mp_lobby.pending_join_session_id or "")
    end
    local session = accepted_session_id ~= "" and multiplayer_lobby_get_session_by_id(self, accepted_session_id) or nil
    if session and multiplayer_lobby_is_session_host(self, session) then
        return false
    end
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") == "steam" then
        multiplayer_apply_steam_transport_seat_ids(self)
        local_id = mp_normalize_network_player_id(self.mp_state.local_player_id or local_id)
        if target == local_id then
            return false
        end
        local host_id = mp_normalize_network_player_id(self.mp_state.host_player_id or "p1")
        if local_id ~= host_id and target ~= host_id then
            self.mp_state.local_player_id = target
            self.mp_state.debug_active_player_id = target
            if self.mp_transport and self.mp_transport.set_local_player_id then
                self.mp_transport.set_local_player_id(target)
            end
            multiplayer_debug_log(self, string.format(
                "MP LOBBY | adopt_target_wire_id target=%s session=%s",
                target,
                accepted_session_id
            ))
            return true
        end
    end
    return false
end

multiplayer_lobby_should_apply_join_accepted = function(self, target_player_id, session_id)
    if not (self and self.mp_state) then
        return false
    end
    local local_id = mp_normalize_network_player_id(self.mp_state.local_player_id or "p1")
    local target = mp_normalize_network_player_id(target_player_id or "")
    if target == "" or target == local_id then
        return true
    end
    if target ~= "p1" and target ~= "p2" and target ~= "p3" and target ~= "p4" then
        return false
    end
    local accepted_session_id = tostring(session_id or "")
    local session = accepted_session_id ~= "" and multiplayer_lobby_get_session_by_id(self, accepted_session_id) or nil
    if session and multiplayer_lobby_is_session_host(self, session) then
        return false
    end
    multiplayer_lobby_adopt_incoming_target_wire_id(self, target, session_id)
    local_id = mp_normalize_network_player_id(self.mp_state.local_player_id or local_id)
    if target == local_id then
        return true
    end
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") == "steam" then
        local host_id = mp_normalize_network_player_id(self.mp_state.host_player_id or "p1")
        if local_id ~= host_id and target ~= host_id then
            return true
        end
    end
    local host_id = tostring(self.mp_state.host_player_id or "p1")
    local pending_join = tostring(self.mp_lobby and self.mp_lobby.pending_join_session_id or "")
    if target ~= host_id
        and pending_join ~= ""
        and accepted_session_id ~= ""
        and pending_join == accepted_session_id
        and local_id == host_id
    then
        local local_offer_id = tostring(self.mp_lobby and self.mp_lobby.local_active_offer_id or "")
        if local_offer_id ~= accepted_session_id then
            self.mp_state.local_player_id = target
            self.mp_state.debug_active_player_id = target
            if self.mp_transport and self.mp_transport.set_local_player_id then
                self.mp_transport.set_local_player_id(target)
            end
            return true
        end
    end
    local flow = tostring(self.game_flow_state or FLOW_STATE_GAME)
    if multiplayer_lobby_is_find_intent(self)
        and (flow == FLOW_STATE_MP_LOBBY or flow == FLOW_STATE_MP_SETUP)
        and target ~= host_id
    then
        self.mp_state.local_player_id = target
        self.mp_state.debug_active_player_id = target
        if self.mp_transport and self.mp_transport.set_local_player_id then
            self.mp_transport.set_local_player_id(target)
        end
        return true
    end
    return false
end

multiplayer_lobby_try_complete_pending_join_from_offer = function(self, offer)
    if not (self and self.mp_lobby and type(offer) == "table") then
        return false
    end
    local lobby = self.mp_lobby
    local pending_id = tostring(lobby.pending_join_session_id or "")
    if pending_id == "" then
        return false
    end
    if lobby.pin_mode == "join_locked"
        or tostring(lobby.pending_join_pin or "") ~= ""
        or (lobby.pending_join_wire_sent == true and pending_id ~= "")
    then
        return false
    end
    local pin_target = tostring(lobby.pin_target_session_id or "")
    local offer_id = tostring(offer.id or offer.session_key or "")
    if pin_target ~= "" and pin_target == offer_id then
        return false
    end
    if offer_id == "" or offer_id ~= pending_id then
        return false
    end
    local flow = tostring(self.game_flow_state or "")
    if flow == FLOW_STATE_MP_SETUP then
        local local_id = mp_normalize_network_player_id(self.mp_state and self.mp_state.local_player_id or "")
        if local_id ~= "" and multiplayer_lobby_wire_id_in_roster(offer, local_id) then
            self.mp_lobby.pending_join_session_id = ""
            self.mp_lobby.pending_steam_lobby_id = ""
            self.mp_lobby.pending_join_wire_sent = false
            self.mp_lobby.pending_join_wire_session_id = ""
            return true
        end
        return false
    end
    if flow ~= FLOW_STATE_MP_LOBBY then
        multiplayer_debug_log(self, string.format(
            "MP LOBBY | pending_join_blocked flow=%s session=%s",
            flow,
            offer_id
        ))
        return false
    end
    if not multiplayer_lobby_is_find_intent(self) then
        return false
    end
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") == "steam" then
        multiplayer_apply_steam_transport_seat_ids(self)
    end
    local local_id = tostring(self.mp_state and self.mp_state.local_player_id or "p2")
    local in_joined = false
    for _, joined_id in ipairs(offer.joined_player_ids or {}) do
        if tostring(joined_id or "") == local_id then
            in_joined = true
            break
        end
    end
    if not in_joined then
        multiplayer_debug_log(self, string.format(
            "MP LOBBY | pending_join_incomplete session=%s local=%s reason=not_in_roster players=%d joined=%d",
            offer_id,
            local_id,
            tonumber(offer.players or 0) or 0,
            type(offer.joined_player_ids) == "table" and #offer.joined_player_ids or 0
        ))
        return false
    end
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") == "steam" then
        local wire_ready = self.mp_transport
            and self.mp_transport.steam_is_wire_ready
            and self.mp_transport.steam_is_wire_ready() == true
        if wire_ready ~= true then
            multiplayer_debug_log(self, string.format(
                "MP LOBBY | pending_join_deferred session=%s local=%s reason=wire_not_ready",
                offer_id,
                local_id
            ))
            return false
        end
    end
    local session = multiplayer_lobby_get_session_by_id(self, offer_id) or offer
    multiplayer_debug_log(self, string.format(
        "MP LOBBY | pending_join_complete_from_offer session=%s local=%s",
        offer_id,
        local_id
    ))
    multiplayer_lobby_enter_mp_setup_from_session(self, session)
    self.mp_lobby.pending_join_session_id = ""
    self.mp_lobby.pending_steam_lobby_id = ""
    self.mp_lobby.pending_join_wire_sent = false
    self.mp_lobby.pending_join_wire_session_id = ""
    show_mp_lobby_advisory(self, 1.8, "joined")
    print("MP LOBBY | Joined game -> setup")
    print("MP LOBBY | pending join completed from offer upsert")
    return true
end

multiplayer_lobby_prune_guest_sync_maps = function(self, session)
    if not (self and self.mp_lobby) then
        return
    end
    session = session or multiplayer_lobby_get_active_session(self)
    if not session then
        return
    end
    local joined_lookup = {}
    for _, joined_id in ipairs(session.joined_player_ids or {}) do
        local jid = tostring(joined_id or "")
        if jid ~= "" then
            joined_lookup[jid] = true
        end
    end
    for pid, _ in pairs(self.mp_lobby.guest_join_resend_pending or {}) do
        if not joined_lookup[tostring(pid or "")] then
            self.mp_lobby.guest_join_resend_pending[pid] = nil
        end
    end
    for pid, _ in pairs(self.mp_lobby.setup_sync_player_ids or {}) do
        if not joined_lookup[tostring(pid or "")] then
            self.mp_lobby.setup_sync_player_ids[pid] = nil
        end
    end
end

multiplayer_lobby_note_launch_block = function(self, guest_id, reason)
    if not self.mp_lobby then
        return
    end
    local key = tostring(guest_id or "") .. "|" .. tostring(reason or "")
    if self.mp_lobby.last_launch_block_key == key then
        return
    end
    self.mp_lobby.last_launch_block_key = key
    if reason == "ok" then
        multiplayer_debug_log(self, "MP LOBBY | launch_ready guests_synced=true")
    else
        multiplayer_debug_log(self, string.format(
            "MP LOBBY | launch_blocked guest=%s reason=%s",
            tostring(guest_id or ""),
            tostring(reason or "")
        ))
    end
end

multiplayer_lobby_joined_guests_setup_synced = function(self, session)
    session = session or multiplayer_lobby_get_active_session(self)
    if not session then
        return true
    end
    multiplayer_lobby_ensure_runtime(self)
    multiplayer_lobby_prune_guest_sync_maps(self, session)
    local sync = self.mp_lobby.setup_sync_player_ids or {}
    local pending_notify = self.mp_lobby.guest_join_resend_pending or {}
    local host_id = multiplayer_lobby_session_host_wire_id(session)
    local guest_count = 0
    for _, joined_id in ipairs(session.joined_player_ids or {}) do
        local jid = mp_normalize_network_player_id(joined_id)
        if jid ~= "" and jid ~= host_id then
            guest_count = guest_count + 1
            if pending_notify[jid] == true then
                multiplayer_lobby_note_launch_block(self, jid, "pending_notify")
                return false
            end
            if sync[jid] ~= true then
                multiplayer_lobby_note_launch_block(self, jid, "not_synced")
                return false
            end
        end
    end
    if guest_count == 0 then
        multiplayer_lobby_note_launch_block(self, "", "no_guests")
        return false
    end
    multiplayer_lobby_note_launch_block(self, "", "ok")
    return true
end

multiplayer_lobby_guest_bump_setup_sync_epoch = function(self)
    if not (self and self.mp_lobby) then
        return 0
    end
    local epoch = (tonumber(self.mp_lobby.guest_setup_sync_epoch or 0) or 0) + 1
    self.mp_lobby.guest_setup_sync_epoch = epoch
    self.mp_lobby.guest_setup_sync_last_requested_epoch = 0
    return epoch
end

multiplayer_lobby_guest_request_setup_sync = function(self)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return false
    end
    if tostring(self.mp_state.local_player_id or "") == tostring(self.mp_state.host_player_id or "") then
        return false
    end
    multiplayer_lobby_ensure_runtime(self)
    local epoch = tonumber(self.mp_lobby.guest_setup_sync_epoch or 0) or 0
    if epoch <= 0 then
        return false
    end
    if tonumber(self.mp_lobby.guest_setup_sync_last_requested_epoch or 0) == epoch then
        return false
    end
    self.mp_lobby.guest_setup_sync_last_requested_epoch = epoch
    multiplayer_apply_steam_transport_seat_ids(self)
    local sync_wire_id = mp_normalize_network_player_id(self.mp_state.local_player_id or "")
    if sync_wire_id == "" then
        return false
    end
    multiplayer_transport_send_command(self, "request_setup_state", {}, sync_wire_id)
    multiplayer_debug_log(self, string.format(
        "MP LOBBY | setup_sync_request guest=%s epoch=%d",
        sync_wire_id,
        epoch
    ))
    return true
end

multiplayer_lobby_prune_steam_disconnected_guests = function(self)
    if not multiplayer_lobby_is_host(self) then
        return false
    end
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") ~= "steam" then
        return false
    end
    local session = multiplayer_lobby_get_active_session(self)
    if not session then
        return false
    end
    if not (self.mp_transport and self.mp_transport.steam_get_lobby_guest_steam_ids) then
        return false
    end
    local present = {}
    for _, steam_id in ipairs(self.mp_transport.steam_get_lobby_guest_steam_ids() or {}) do
        local sid = tostring(steam_id or "")
        if sid ~= "" then
            present[sid] = true
        end
    end
    multiplayer_steam_ensure_session_roster_maps(session)
    local host_id = multiplayer_lobby_session_host_wire_id(session)
    local removed_ids = {}
    for _, joined_id in ipairs(session.joined_player_ids or {}) do
        local jid = mp_normalize_network_player_id(joined_id)
        if jid ~= "" and jid ~= host_id then
            local guest_steam_id = tostring(session.steam_id_by_wire_id[jid] or "")
            if guest_steam_id ~= "" and not present[guest_steam_id] then
                removed_ids[#removed_ids + 1] = jid
            end
        end
    end
    if #removed_ids == 0 then
        return false
    end
    local session_id = tostring(session.id or "")
    for _, jid in ipairs(removed_ids) do
        multiplayer_lobby_remove_player_from_session(self, session_id, jid)
    end
    multiplayer_debug_log(self, string.format(
        "MP LOBBY | steam_disconnect_prune session=%s removed=%s",
        session_id,
        table.concat(removed_ids, ",")
    ))
    return true
end

multiplayer_lobby_prune_guests_on_host_alone = function(self)
    if not multiplayer_lobby_is_host(self) then
        return false
    end
    multiplayer_lobby_ensure_runtime(self)
    local session = multiplayer_lobby_get_active_session(self)
    if not session then
        return false
    end
    local host_id = multiplayer_lobby_session_host_wire_id(session)
    session.joined_player_ids = session.joined_player_ids or {}
    local removed_ids = {}
    for i = #session.joined_player_ids, 1, -1 do
        local jid = tostring(session.joined_player_ids[i] or "")
        if jid ~= "" and jid ~= host_id then
            table.remove(session.joined_player_ids, i)
            removed_ids[#removed_ids + 1] = jid
        end
    end
    if #removed_ids == 0 then
        return false
    end
    self.mp_lobby.guest_join_resend_pending = self.mp_lobby.guest_join_resend_pending or {}
    for _, jid in ipairs(removed_ids) do
        self.mp_lobby.guest_join_resend_pending[jid] = nil
        if self.mp_lobby.setup_sync_player_ids then
            self.mp_lobby.setup_sync_player_ids[jid] = nil
        end
        multiplayer_steam_release_guest_wire_seat(session, jid)
    end
    session.updated_at_ms = get_wall_clock_ms()
    session.players = math.max(1, math.min(tonumber(session.max_players or 4) or 4, #session.joined_player_ids))
    self.mp_lobby.offers_by_id[tostring(session.id or "")] = session
    multiplayer_lobby_sync_sessions_from_offers(self)
    multiplayer_lobby_prune_guest_sync_maps(self, session)
    multiplayer_lobby_emit_offer_upsert(self, session)
    multiplayer_debug_log(self, string.format(
        "MP LOBBY | lobby_alone_prune session=%s removed=%s players=%d",
        tostring(session.id or ""),
        table.concat(removed_ids, ","),
        tonumber(session.players or 1) or 1
    ))
    return true
end

multiplayer_lobby_mark_guest_setup_synced = function(self, player_id)
    if not (self and self.mp_lobby) then
        return
    end
    local pid = tostring(player_id or "")
    if pid == "" then
        return
    end
    self.mp_lobby.setup_sync_player_ids = self.mp_lobby.setup_sync_player_ids or {}
    self.mp_lobby.guest_join_resend_pending = self.mp_lobby.guest_join_resend_pending or {}
    self.mp_lobby.setup_sync_player_ids[pid] = true
    self.mp_lobby.guest_join_resend_pending[pid] = nil
    if not multiplayer_lobby_is_host(self) then
        local local_id = mp_normalize_network_player_id(self.mp_state and self.mp_state.local_player_id or "")
        if local_id ~= "" and local_id == pid then
            multiplayer_lobby_lifecycle_guest(self, MP_LOBBY_LIFECYCLE.GUEST_SETUP_SYNCED, {
                guest = pid
            })
        end
    end
end

multiplayer_lobby_deliver_pending_join_notifications = function(self)
    if not multiplayer_lobby_is_host(self) then
        return
    end
    multiplayer_lobby_ensure_runtime(self)
    local pending_notify = self.mp_lobby.guest_join_resend_pending or {}
    if next(pending_notify) == nil then
        return
    end
    local session = multiplayer_lobby_get_active_session(self)
    if not session then
        return
    end
    local host_id = tostring(
        session.host_wire_player_id
            or session.owner_player_id
            or MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID
            or "p1"
    )
    multiplayer_lobby_prune_guest_sync_maps(self, session)
    local sync = self.mp_lobby.setup_sync_player_ids or {}
    local setup_config = multiplayer_setup_build_guest_wire_config(self, session)
    local events = {}
    for _, joined_id in ipairs(session.joined_player_ids or {}) do
        local jid = tostring(joined_id or "")
        if jid ~= "" and jid ~= host_id and pending_notify[jid] == true then
            if sync[jid] == true then
                pending_notify[jid] = nil
            else
                table.insert(events, multiplayer_transport_emit_event(self, "lobby_join_accepted", {
                    target_player_id = jid,
                    session_id = tostring(session.id or ""),
                    session_max_players = math.max(2, tonumber(session.max_players or 2) or 2),
                    session_config = setup_config
                }))
                table.insert(events, multiplayer_transport_emit_event(self, "setup_state_updated", {
                    target_player_id = jid,
                    session_config = setup_config
                }))
                pending_notify[jid] = nil
                multiplayer_debug_log(self, string.format(
                    "MP LOBBY | join_notify_resend guest=%s session=%s",
                    jid,
                    tostring(session.id or "")
                ))
            end
        end
    end
    if #events > 0 then
        multiplayer_transport_broadcast_events(self, events)
    end
end

multiplayer_lobby_ensure_runtime = function(self)
    self.mp_lobby = self.mp_lobby or {}
    local lobby = self.mp_lobby
    lobby.page_index = tonumber(lobby.page_index or 1) or 1
    if lobby.page_index < 1 then
        lobby.page_index = 1
    end
    lobby.pin_buffer = tostring(lobby.pin_buffer or "")
    lobby.pin_feedback = tostring(lobby.pin_feedback or "")
    lobby.pin_feedback_timer = tonumber(lobby.pin_feedback_timer or 0) or 0
    lobby.pin_key_flash_timers = lobby.pin_key_flash_timers or {}
    lobby.pin_mode = tostring(lobby.pin_mode or "")
    lobby.pin_target_session_id = tostring(lobby.pin_target_session_id or "")
    lobby.pending_join_session_id = tostring(lobby.pending_join_session_id or "")
    lobby.pending_steam_lobby_id = tostring(lobby.pending_steam_lobby_id or "")
    lobby.pending_join_wire_sent = lobby.pending_join_wire_sent == true
    lobby.pending_join_wire_session_id = tostring(lobby.pending_join_wire_session_id or "")
    lobby.pending_join_pin = tostring(lobby.pending_join_pin or "")
    lobby.pin_join_wire_timeout_timer = tonumber(lobby.pin_join_wire_timeout_timer or 0) or 0
    lobby.setup_sync_player_ids = lobby.setup_sync_player_ids or {}
    lobby.guest_join_resend_pending = lobby.guest_join_resend_pending or {}
    lobby.last_setup_roster_revision_acked = tonumber(lobby.last_setup_roster_revision_acked or 0) or 0
    lobby.last_setup_roster_revision_acked_session_id = tostring(lobby.last_setup_roster_revision_acked_session_id or "")
    lobby.pairing_intent = tostring(lobby.pairing_intent or "host")
    MP_LOBBY_LIFECYCLE.ensure(lobby)
    lobby.discovery_browse_count = tonumber(lobby.discovery_browse_count or 0) or 0
    lobby.discovery_session_count = tonumber(lobby.discovery_session_count or -1) or -1
    lobby.local_active_offer_id = tostring(lobby.local_active_offer_id or "")
    lobby.offer_heartbeat_timer = tonumber(lobby.offer_heartbeat_timer or 0) or 0
    lobby.offer_prune_timer = tonumber(lobby.offer_prune_timer or 0) or 0
    lobby.offer_removed_at_ms_by_id = lobby.offer_removed_at_ms_by_id or {}
    lobby.offers_bootstrap_done = lobby.offers_bootstrap_done == true
    lobby.session_counter = tonumber(lobby.session_counter or 6) or 6
    lobby.host_draft_session_id = tostring(lobby.host_draft_session_id or "")
    if tostring(lobby.local_username or "") == "" then
        local local_network_id = tostring(self.mp_state and self.mp_state.local_player_id or "p1")
        local local_slot_id = local_network_id
        if multiplayer_get_slot_player_id_for_network then
            local_slot_id = tostring(multiplayer_get_slot_player_id_for_network(self, local_network_id) or local_network_id)
        end
        lobby.local_username = mp_alpha_label_from_network_id(local_slot_id)
    end
    if self.mp_transport and self.mp_transport.steam_get_local_persona_name then
        multiplayer_steam_refresh_local_username(self)
    end
    lobby.pending_cancel_confirm = lobby.pending_cancel_confirm == true
    lobby.protocol_mismatch_hint_active = lobby.protocol_mismatch_hint_active == true
    if type(lobby.sessions) ~= "table" then
        lobby.sessions = {}
    end
    lobby.offers_by_id = lobby.offers_by_id or {}
    if (not lobby.offers_bootstrap_done) and next(lobby.offers_by_id) == nil and #lobby.sessions > 0 then
        for _, session in ipairs(lobby.sessions) do
            if session and session.id then
                session.last_seen_local_ms = tonumber(session.last_seen_local_ms or get_wall_clock_ms()) or get_wall_clock_ms()
                lobby.offers_by_id[tostring(session.id)] = session
            end
        end
        lobby.offers_bootstrap_done = true
    end
end

multiplayer_lobby_get_pairing_intent = function(self)
    multiplayer_lobby_ensure_runtime(self)
    local intent = tostring(self.mp_lobby.pairing_intent or "host")
    if intent ~= "find" then
        return "host"
    end
    return "find"
end

multiplayer_lobby_is_find_intent = function(self)
    return multiplayer_lobby_get_pairing_intent(self) == "find"
end

multiplayer_lobby_on_discovery_browse = function(self, detail)
    if not multiplayer_lobby_is_find_intent(self) then
        return
    end
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    lobby.discovery_browse_count = tonumber(detail and detail.match_count or 0) or 0
    local _, compatible_total = multiplayer_lobby_count_compatible_published_sessions(self)
    local prev = tonumber(lobby.discovery_session_count or -1) or -1
    lobby.discovery_session_count = compatible_total
    if compatible_total ~= prev then
        if compatible_total > 0 then
            show_mp_lobby_advisory(self, 2.2, "find")
        elseif prev < 0 then
            show_mp_lobby_advisory(self, 2.2, "find")
        end
    end
end

multiplayer_lobby_guest_prune_local_offer_membership = function(self, session_id)
    if not (self and self.mp_lobby and self.mp_state) then
        return false
    end
    session_id = tostring(session_id or "")
    if session_id == "" then
        return false
    end
    local session = self.mp_lobby.offers_by_id[session_id]
    if type(session) ~= "table" then
        return false
    end
    local local_id = mp_normalize_network_player_id(self.mp_state.local_player_id or "")
    if local_id == "" then
        return false
    end
    session.joined_player_ids = session.joined_player_ids or {}
    local changed = false
    for i = #session.joined_player_ids, 1, -1 do
        if mp_normalize_network_player_id(session.joined_player_ids[i]) == local_id then
            table.remove(session.joined_player_ids, i)
            changed = true
        end
    end
    if changed then
        session.players = math.max(1, #session.joined_player_ids)
        session.updated_at_ms = get_wall_clock_ms()
        multiplayer_lobby_sync_sessions_from_offers(self)
        multiplayer_debug_log(self, string.format(
            "MP LOBBY | guest_prune_local_offer session=%s local=%s players=%d",
            session_id,
            local_id,
            tonumber(session.players or 1) or 1
        ))
    end
    return changed
end

multiplayer_lobby_on_wire_ready = function(self)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return false
    end
    multiplayer_apply_steam_transport_seat_ids(self)
    return multiplayer_lobby_complete_pending_steam_join(self) == true
end

multiplayer_lobby_guest_handle_roster_eviction = function(self, session_id)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return false
    end
    if multiplayer_lobby_is_host(self) then
        return false
    end
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    session_id = tostring(session_id or lobby.pending_join_session_id or self.mp_state.lobby_ticket_id or "")
    lobby.pending_join_wire_sent = false
    lobby.pending_join_wire_session_id = ""
    lobby.pending_join_session_id = ""
    lobby.pending_steam_lobby_id = ""
    if self.mp_lobby.setup_sync_player_ids then
        local local_id = mp_normalize_network_player_id(self.mp_state.local_player_id or "")
        if local_id ~= "" then
            self.mp_lobby.setup_sync_player_ids[local_id] = nil
        end
    end
    self.mp_state.lobby_ticket_id = ""
    self.mp_state.session_id = "local_session"
    multiplayer_lobby_lifecycle_guest(self, MP_LOBBY_LIFECYCLE.GUEST_DISCONNECTED, {
        session = session_id,
        reason = "roster_evicted"
    })
    multiplayer_debug_log(self, string.format(
        "MP LOBBY | guest_roster_evicted session=%s local=%s",
        session_id,
        tostring(self.mp_state.local_player_id or "")
    ))
    return true
end

multiplayer_lobby_guest_leave_setup_to_find = function(self)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return false
    end
    if multiplayer_lobby_is_session_host(self) then
        return false
    end
    local session_id = multiplayer_lobby_get_lobby_ticket_id(self)
    local session = multiplayer_lobby_get_session_by_id(self, session_id)
    local host_steam_id = tostring(session and session.host_steam_id or "")
    multiplayer_transport_send_command(self, "lobby_leave_session", {
        session_id = session_id
    }, self.mp_state.local_player_id)
    if self.mp_transport and self.mp_transport.flush_wire_queue then
        pcall(self.mp_transport.flush_wire_queue)
    end
    multiplayer_lobby_ensure_runtime(self)
    self.mp_lobby.pending_join_session_id = ""
    self.mp_lobby.pending_steam_lobby_id = ""
    self.mp_lobby.pending_join_wire_sent = false
    self.mp_lobby.pending_join_wire_session_id = ""
    self.mp_lobby.guest_setup_sync_epoch = 0
    self.mp_lobby.guest_setup_sync_last_requested_epoch = 0
    multiplayer_lobby_clear_pin_join_state(self)
    self.mp_lobby.pairing_intent = "find"
    self.mp_state.lobby_ticket_id = ""
    self.mp_state.session_id = "local_session"
    multiplayer_lobby_guest_prune_local_offer_membership(self, session_id)
    multiplayer_apply_steam_lobby_wire_defaults(self)
    if host_steam_id ~= "" and self.mp_transport and self.mp_transport.steam_forget_peer then
        pcall(self.mp_transport.steam_forget_peer, host_steam_id)
    end
    if self.mp_transport and self.mp_transport.steam_leave_lobby then
        pcall(self.mp_transport.steam_leave_lobby)
    end
    multiplayer_reset_steam_wire_handshake(self)
    multiplayer_lobby_lifecycle_guest(self, MP_LOBBY_LIFECYCLE.GUEST_DISCONNECTED, {
        reason = "leave_setup_to_find"
    })
    self.multiplayer_mode_active = true
    enter_flow_state(self, FLOW_STATE_MP_LOBBY)
    show_mp_lobby_advisory(self, 2.2, "find")
    multiplayer_debug_log(self, string.format(
        "MP LOBBY | guest_leave_setup_to_find session=%s",
        tostring(session_id or "")
    ))
    return true
end

multiplayer_reset_steam_wire_handshake = function(self)
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") ~= "steam" then
        return false
    end
    if self.mp_transport and self.mp_transport.steam_reset_gateb_handshake then
        return self.mp_transport.steam_reset_gateb_handshake() == true
    end
    return false
end

multiplayer_lobby_request_steam_lobby_for_join = function(self, session_id, steam_lobby_id)
    if not (self and self.mp_lobby) then
        return false
    end
    local lobby = self.mp_lobby
    local sid = tostring(session_id or "")
    local lobby_id = tostring(steam_lobby_id or "")
    lobby.pending_steam_lobby_id = lobby_id
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") ~= "steam" or lobby_id == "" then
        return false
    end
    local current_lobby = ""
    if self.mp_transport and self.mp_transport.steam_get_lobby_id then
        current_lobby = tostring(self.mp_transport.steam_get_lobby_id() or "")
    end
    if current_lobby == lobby_id then
        multiplayer_apply_steam_transport_seat_ids(self)
        local wire_ready = self.mp_transport
            and self.mp_transport.steam_is_wire_ready
            and self.mp_transport.steam_is_wire_ready() == true
        if wire_ready == true then
            return true
        end
        if self.mp_transport and self.mp_transport.steam_rejoin_lobby then
            multiplayer_debug_log(self, string.format(
                "MP LOBBY | join_session_steam_rejoin session=%s lobby=%s",
                sid,
                lobby_id
            ))
            self.mp_transport.steam_rejoin_lobby(lobby_id)
        elseif self.mp_transport and self.mp_transport.steam_reset_gateb_handshake then
            multiplayer_debug_log(self, string.format(
                "MP LOBBY | join_session_steam_handshake_reset session=%s lobby=%s",
                sid,
                lobby_id
            ))
            self.mp_transport.steam_reset_gateb_handshake()
        end
        return true
    end
    if self.mp_transport and self.mp_transport.steam_rejoin_lobby then
        multiplayer_debug_log(self, string.format(
            "MP LOBBY | join_session_steam_rejoin session=%s lobby=%s",
            sid,
            lobby_id
        ))
        self.mp_transport.steam_rejoin_lobby(lobby_id)
        return true
    end
    if self.mp_transport and self.mp_transport.steam_join_lobby then
        multiplayer_debug_log(self, string.format(
            "MP LOBBY | join_session_steam_lobby session=%s lobby=%s",
            sid,
            lobby_id
        ))
        self.mp_transport.steam_join_lobby(lobby_id)
        return true
    end
    return false
end

multiplayer_lobby_complete_pending_steam_join = function(self)
    if not (self and self.mp_state and self.mp_state.enabled and self.mp_lobby) then
        return false
    end
    local lobby = self.mp_lobby
    local pending_id = tostring(lobby.pending_join_session_id or "")
    if pending_id == "" then
        return false
    end
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") == "steam" then
        multiplayer_apply_steam_transport_seat_ids(self)
        local wire_ready = self.mp_transport
            and self.mp_transport.steam_is_wire_ready
            and self.mp_transport.steam_is_wire_ready() == true
        if wire_ready ~= true then
            local steam_lobby_id = tostring(lobby.pending_steam_lobby_id or "")
            local current_lobby = ""
            if steam_lobby_id ~= "" and self.mp_transport.steam_get_lobby_id then
                current_lobby = tostring(self.mp_transport.steam_get_lobby_id() or "")
            end
            if steam_lobby_id ~= "" and current_lobby == steam_lobby_id then
                multiplayer_reset_steam_wire_handshake(self)
            elseif steam_lobby_id ~= "" and self.mp_transport.steam_rejoin_lobby then
                self.mp_transport.steam_rejoin_lobby(steam_lobby_id)
            elseif steam_lobby_id ~= "" and self.mp_transport.steam_join_lobby then
                self.mp_transport.steam_join_lobby(steam_lobby_id)
            end
            return false
        end
    end
    if tostring(lobby.pending_join_wire_session_id or "") == pending_id
        and lobby.pending_join_wire_sent == true
    then
        local session = multiplayer_lobby_get_session_by_id(self, pending_id)
        local local_id = mp_normalize_network_player_id(self.mp_state.local_player_id or "")
        if multiplayer_lobby_wire_id_in_roster(session, local_id) then
            return false
        end
        lobby.pending_join_wire_sent = false
        lobby.pending_join_wire_session_id = ""
        multiplayer_debug_log(self, string.format(
            "MP LOBBY | join_session_wire_retry session=%s local=%s reason=not_in_roster",
            pending_id,
            local_id
        ))
    end
    local join_pin = tostring(lobby.pending_join_pin or "")
    if join_pin == "" and lobby.pin_mode == "join_locked" then
        join_pin = tostring(lobby.pin_buffer or "")
    end
    local join_payload = multiplayer_lobby_join_wire_payload(
        self,
        pending_id,
        join_pin ~= "" and { pin = join_pin } or nil
    )
    multiplayer_transport_send_command(self, "lobby_join_session", join_payload, self.mp_state.local_player_id or "p1")
    lobby.pending_join_wire_sent = true
    lobby.pending_join_wire_session_id = pending_id
    if (tonumber(lobby.pin_join_wire_timeout_timer or 0) or 0) <= 0 then
        lobby.pin_join_wire_timeout_timer = MP_LOBBY_PIN_JOIN_WIRE_TIMEOUT_S
    end
    multiplayer_lobby_lifecycle_guest(self, MP_LOBBY_LIFECYCLE.GUEST_JOIN_WIRE_PENDING, {
        session = pending_id
    })
    multiplayer_debug_log(self, string.format(
        "MP LOBBY | join_session_wire session=%s pin_len=%d",
        pending_id,
        #join_pin
    ))
    return true
end

multiplayer_lobby_request_join_session = function(self, session)
    if not (self and self.mp_state and self.mp_state.enabled and session) then
        return false
    end
    multiplayer_lobby_ensure_runtime(self)
    local blocked_reason = multiplayer_lobby_session_join_blocked_reason(self, session)
    if blocked_reason == "session_full" then
        show_mp_lobby_advisory(self, 2.2, "session_full")
        multiplayer_debug_log(self, string.format(
            "MP LOBBY | join_blocked_preflight session=%s reason=%s players=%d max=%d",
            tostring(session.id or ""),
            blocked_reason,
            tonumber(session.players or 0) or 0,
            tonumber(session.max_players or 0) or 0
        ))
        return false
    elseif blocked_reason ~= nil then
        return false
    end
    local lobby = self.mp_lobby
    local session_id = tostring(session.id or "")
    if session_id == "" then
        return false
    end
    if session.is_locked == true then
        lobby.pin_mode = "join_locked"
        lobby.pin_target_session_id = session_id
        lobby.pin_buffer = ""
        lobby.pin_feedback = ""
        lobby.pin_feedback_timer = 0
        lobby.pending_join_pin = ""
        lobby.pending_join_wire_sent = false
        lobby.pending_join_wire_session_id = ""
        lobby.pin_join_wire_timeout_timer = 0
        multiplayer_lobby_request_steam_lobby_for_join(self, session_id, session.steam_lobby_id)
        return true
    end
    lobby.pending_join_session_id = session_id
    lobby.pending_join_wire_sent = false
    lobby.pending_join_wire_session_id = ""
    lobby.pin_join_wire_timeout_timer = MP_LOBBY_PIN_JOIN_WIRE_TIMEOUT_S
    multiplayer_lobby_lifecycle_guest(self, MP_LOBBY_LIFECYCLE.GUEST_STEAM_JOINING, {
        session = session_id
    })
    if multiplayer_lobby_request_steam_lobby_for_join(self, session_id, session.steam_lobby_id) then
        show_mp_lobby_advisory(self, 2.0, "joining")
        print("MP LOBBY | Joining host...")
        if tostring(lobby.pending_steam_lobby_id or "") ~= "" then
            local current_lobby = ""
            if self.mp_transport and self.mp_transport.steam_get_lobby_id then
                current_lobby = tostring(self.mp_transport.steam_get_lobby_id() or "")
            end
            if current_lobby == lobby.pending_steam_lobby_id then
                return multiplayer_lobby_complete_pending_steam_join(self)
            end
            return true
        end
    end
    multiplayer_transport_send_command(
        self,
        "lobby_join_session",
        multiplayer_lobby_join_wire_payload(self, session_id),
        self.mp_state.local_player_id or "p1"
    )
    lobby.pending_join_wire_sent = true
    lobby.pending_join_wire_session_id = session_id
    return true
end

multiplayer_lobby_enter_with_pairing_intent = function(self, intent)
    self.multiplayer_mode_active = true
    multiplayer_lobby_ensure_runtime(self)
    multiplayer_lobby_reset_setup_sync_runtime(self)
    local normalized = tostring(intent or "host")
    if normalized ~= "find" then
        normalized = "host"
    end
    self.mp_lobby.pairing_intent = normalized
    self.mp_lobby.pending_steam_lobby_id = ""
    self.mp_lobby.pending_join_session_id = ""
    self.mp_lobby.pending_join_wire_sent = false
    self.mp_lobby.pending_join_wire_session_id = ""
    self.mp_lobby.discovery_browse_count = 0
    self.mp_lobby.discovery_session_count = -1
    if self.mp_state then
        self.mp_state.enabled = true
        if tostring(MULTIPLAYER_TRANSPORT_MODE or "") == "steam" then
            local host_network_id = tostring(MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID or "p1")
            self.mp_state.local_player_id = host_network_id
            self.mp_state.host_player_id = host_network_id
        end
        self.mp_state.debug_active_player_id = self.mp_state.local_player_id
        self.mp_state.transport_status = "idle"
        self.mp_state.transport_status_detail = {}
        self.mp_state.seen_command_ids = {}
        self.mp_state.seen_event_ids = {}
        self.mp_state.command_seq = 0
    end
    if self.mp_transport and self.mp_transport.shutdown then
        pcall(self.mp_transport.shutdown)
    end
    self.mp_transport = nil
    multiplayer_transport_init(self)
    if self.mp_transport and self.mp_transport.connect then
        self.mp_transport.connect()
    end
    enter_flow_state(self, FLOW_STATE_MP_LOBBY)
    if normalized == "find" then
        show_mp_lobby_advisory(self, 2.5, "find")
        lobby.offer_removed_at_ms_by_id = {}
    else
        show_mp_lobby_advisory(self, 2.5, "host")
    end
    multiplayer_debug_log(self, string.format("MP FLOW | pairing_intent=%s", normalized))
end

multiplayer_lobby_switch_to_host_intent = function(self)
    multiplayer_lobby_enter_with_pairing_intent(self, "host")
end

multiplayer_lobby_chooser_render_ui = function(self, dt, hidden)
    update_flow_title_space_grid_background(self, dt)
    set_ui_square_transform(self, self.ui.flow_title_planet, SCREEN_WIDTH * 0.5, SCREEN_HEIGHT * 0.5, FLOW_UI_PANEL_Z + 0.002, vmath.vector4(1, 1, 1, 1), 1, 1)
    set_ui_square_transform(self, self.ui.flow_title_xenos_word, (SCREEN_WIDTH * 0.5) - 40, (SCREEN_HEIGHT * 0.5) + 160, FLOW_UI_PANEL_Z + 0.003, vmath.vector4(1, 1, 1, 0.5), 0.75, 0.75)
    set_ui_square_transform(self, self.ui.flow_title_derples_word, SCREEN_WIDTH * 0.5, (SCREEN_HEIGHT * 0.5) + 180, FLOW_UI_PANEL_Z + 0.004, vmath.vector4(1, 1, 1, 1), 0.5, 0.5)
    set_ui_square_transform(self, self.ui.flow_title_buttons_art, -9999, -9999, FLOW_UI_BUTTON_Z + 0.001, hidden, 1, 1)
    set_ui_square_transform(self, self.ui.flow_title_debug_button, -9999, -9999, FLOW_UI_BUTTON_Z, hidden, TITLE_DEBUG_BUTTON_W, TITLE_DEBUG_BUTTON_H)
    set_ui_square_transform(self, self.ui.flow_solo_setup_panel, -9999, -9999, SOLO_SETUP_PANEL_Z, hidden, SOLO_SETUP_PANEL_SCALE, SOLO_SETUP_PANEL_SCALE)
    set_ui_square_transform(self, self.ui.flow_mp_setup_panel, -9999, -9999, MP_SETUP_PANEL_Z, hidden, MP_SETUP_PANEL_W * 0.021, MP_SETUP_PANEL_H * 0.021)
    if self.ui.flow_mp_lobby_backpanel then
        set_ui_square_transform(self, self.ui.flow_mp_lobby_backpanel, -9999, -9999, FLOW_UI_PANEL_Z + 0.003, hidden, 1, 1)
    end
    local hitbox_hidden = vmath.vector4(0, 0, 0, 0)
    local art_tint = vmath.vector4(1, 1, 1, 1)
    set_ui_square_transform(self, self.ui.flow_title_tutorial_button, MP_CHOOSER_BACK_BTN_X, MP_CHOOSER_BACK_BTN_Y, FLOW_UI_BUTTON_Z, hitbox_hidden, MP_CHOOSER_BTN_W, MP_CHOOSER_BTN_H)
    set_ui_square_transform(self, self.ui.flow_title_solo_button, MP_CHOOSER_HOST_BTN_X, MP_CHOOSER_HOST_BTN_Y, FLOW_UI_BUTTON_Z, hitbox_hidden, MP_CHOOSER_BTN_W, MP_CHOOSER_BTN_H)
    set_ui_square_transform(self, self.ui.flow_title_multiplayer_button, MP_CHOOSER_FIND_BTN_X, MP_CHOOSER_FIND_BTN_Y, FLOW_UI_BUTTON_Z, hitbox_hidden, MP_CHOOSER_BTN_W, MP_CHOOSER_BTN_H)
    set_ui_square_transform(self, self.ui.flow_mp_chooser_back_art, MP_CHOOSER_BACK_BTN_X, MP_CHOOSER_BACK_BTN_Y, FLOW_UI_BUTTON_Z + 0.001, art_tint, 1, 1)
    set_ui_square_transform(self, self.ui.flow_mp_chooser_host_art, MP_CHOOSER_HOST_BTN_X, MP_CHOOSER_HOST_BTN_Y, FLOW_UI_BUTTON_Z + 0.001, art_tint, 1, 1)
    set_ui_square_transform(self, self.ui.flow_mp_chooser_find_art, MP_CHOOSER_FIND_BTN_X, MP_CHOOSER_FIND_BTN_Y, FLOW_UI_BUTTON_Z + 0.001, art_tint, 1, 1)
    if self.ui.flow_mp_lobby_back_button then
        set_ui_square_transform(self, self.ui.flow_mp_lobby_back_button, -9999, -9999, FLOW_UI_BUTTON_Z + 0.004, hidden, 1, 1)
    end
    if self.ui.flow_mp_setup_name_letters then
        for _, letter_id in ipairs(self.ui.flow_mp_setup_name_letters) do
            set_ui_square_transform(self, letter_id, -9999, -9999, MP_SETUP_UI_Z + 0.004, hidden, 1, 1)
        end
    end
    if self.ui.flow_mp_lobby_name_letters then
        for _, letter_id in ipairs(self.ui.flow_mp_lobby_name_letters) do
            set_ui_square_transform(self, letter_id, -9999, -9999, MP_SETUP_UI_Z + 0.004, hidden, 1, 1)
        end
    end
    if self.ui.flow_mp_lobby_refresh_letters then
        for _, letter_id in ipairs(self.ui.flow_mp_lobby_refresh_letters) do
            set_ui_square_transform(self, letter_id, -9999, -9999, MP_SETUP_UI_Z + 0.004, hidden, 1, 1)
        end
    end
end

multiplayer_lobby_chooser_handle_touch = function(self, input_x, input_y)
    if is_point_in_screen_rect(input_x, input_y, MP_CHOOSER_BACK_BTN_X, MP_CHOOSER_BACK_BTN_Y, MP_CHOOSER_BTN_W, MP_CHOOSER_BTN_H) then
        if self.mp_state then
            self.mp_state.enabled = false
        end
        self.multiplayer_mode_active = false
        enter_flow_state(self, FLOW_STATE_TITLE)
        return true
    end
    if is_point_in_screen_rect(input_x, input_y, MP_CHOOSER_HOST_BTN_X, MP_CHOOSER_HOST_BTN_Y, MP_CHOOSER_BTN_W, MP_CHOOSER_BTN_H) then
        multiplayer_lobby_enter_with_pairing_intent(self, "host")
        return true
    end
    if is_point_in_screen_rect(input_x, input_y, MP_CHOOSER_FIND_BTN_X, MP_CHOOSER_FIND_BTN_Y, MP_CHOOSER_BTN_W, MP_CHOOSER_BTN_H) then
        multiplayer_lobby_enter_with_pairing_intent(self, "find")
        return true
    end
    return true
end

multiplayer_lobby_note_offer_removed = function(self, offer_id, removed_at_ms)
    multiplayer_lobby_ensure_runtime(self)
    local oid = tostring(offer_id or "")
    if oid == "" then
        return
    end
    local lobby = self.mp_lobby
    local removed_ms = tonumber(removed_at_ms or get_wall_clock_ms()) or get_wall_clock_ms()
    local existing = tonumber(lobby.offer_removed_at_ms_by_id[oid] or 0) or 0
    if removed_ms > existing then
        lobby.offer_removed_at_ms_by_id[oid] = removed_ms
    end
end

multiplayer_lobby_republish_steam_discovery_if_host = function(self)
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") ~= "steam" then
        return false
    end
    if not multiplayer_lobby_is_host(self) then
        return false
    end
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    local offer_id = tostring(lobby.local_active_offer_id or "")
    if offer_id == "" then
        return false
    end
    local session = multiplayer_lobby_get_session_by_id(self, offer_id)
    if not session then
        return false
    end
    local status = tostring(session.status or session.publish_status or "")
    if status ~= "published_open" and status ~= "published_private" then
        return false
    end
    local steam_lobby_id = ""
    if self.mp_transport and self.mp_transport.steam_get_lobby_id then
        steam_lobby_id = tostring(self.mp_transport.steam_get_lobby_id() or "")
        session.steam_lobby_id = steam_lobby_id
    end
    if steam_lobby_id == "" then
        if self.mp_transport and self.mp_transport.steam_request_create_lobby then
            self.mp_transport.steam_request_create_lobby()
        end
        return false
    end
    if self.mp_transport and self.mp_transport.steam_publish_session then
        return self.mp_transport.steam_publish_session(session) == true
    end
    return false
end

multiplayer_lobby_clear_steam_discovery_if_host = function(self)
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") ~= "steam" then
        return
    end
    if self.mp_transport and self.mp_transport.steam_is_host and self.mp_transport.steam_is_host()
        and self.mp_transport.steam_clear_session then
        self.mp_transport.steam_clear_session()
    end
end

multiplayer_lobby_purge_tombstoned_offers = function(self)
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    local changed = false
    for offer_id, _ in pairs(lobby.offer_removed_at_ms_by_id or {}) do
        if lobby.offers_by_id[offer_id] then
            lobby.offers_by_id[offer_id] = nil
            changed = true
        end
    end
    if changed then
        multiplayer_lobby_sync_sessions_from_offers(self)
    end
end

multiplayer_lobby_remove_offers_by_owner = function(self, owner_player_id)
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    local owner_id = tostring(owner_player_id or "")
    if owner_id == "" then
        return false
    end
    local local_offer_id = tostring(lobby.local_active_offer_id or "")
    if local_offer_id == "" then
        return false
    end
    local offer = lobby.offers_by_id[local_offer_id]
    if type(offer) ~= "table" then
        return false
    end
    if tostring(offer.owner_player_id or "") ~= owner_id then
        return false
    end
    if not multiplayer_lobby_is_local_offer_owner(self, offer) then
        return false
    end
    lobby.offers_by_id[local_offer_id] = nil
    multiplayer_lobby_note_offer_removed(self, local_offer_id, get_wall_clock_ms())
    lobby.local_active_offer_id = ""
    multiplayer_lobby_sync_sessions_from_offers(self)
    return true
end

multiplayer_lobby_remove_offers_by_steam_lobby_id = function(self, steam_lobby_id)
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    local target_lobby_id = tostring(steam_lobby_id or "")
    if target_lobby_id == "" then
        return false
    end
    local changed = false
    for offer_id, offer in pairs(lobby.offers_by_id or {}) do
        if tostring(offer and offer.steam_lobby_id or "") == target_lobby_id
            or tostring(offer_id or "") == ("sl:" .. target_lobby_id) then
            lobby.offers_by_id[offer_id] = nil
            changed = true
        end
    end
    if changed then
        multiplayer_lobby_sync_sessions_from_offers(self)
    end
    return changed
end

multiplayer_lobby_session_join_blocked_reason = function(self, session)
    if type(session) ~= "table" then
        return "not_found"
    end
    local session_id = tostring(session.id or "")
    if session_id ~= "" and self.mp_lobby then
        local tombstone_ms = tonumber(self.mp_lobby.offer_removed_at_ms_by_id and self.mp_lobby.offer_removed_at_ms_by_id[session_id] or 0) or 0
        local offer_updated_ms = tonumber(session.updated_at_ms or 0) or 0
        if tombstone_ms > 0 and (offer_updated_ms <= 0 or offer_updated_ms <= tombstone_ms) then
            return "session_full"
        end
    end
    if not multiplayer_lobby_session_is_browse_visible(session) then
        return "session_full"
    end
    local players = math.max(1, tonumber(session.players or 1) or 1)
    local max_players = math.max(2, tonumber(session.max_players or 2) or 2)
    if players >= max_players then
        return "session_full"
    end
    return nil
end

multiplayer_lobby_get_lobby_ticket_id = function(self)
    if not (self and self.mp_state) then
        return ""
    end
    local ticket_id = tostring(self.mp_state.lobby_ticket_id or "")
    if ticket_id ~= "" then
        return ticket_id
    end
    return tostring(self.mp_state.session_id or "")
end

multiplayer_lobby_get_active_session = function(self)
    multiplayer_lobby_ensure_runtime(self)
    local session_id = multiplayer_lobby_get_lobby_ticket_id(self)
    if session_id == "" or session_id == "local_session" or string.sub(session_id, 1, 14) == "local_session_" then
        return nil
    end
    return multiplayer_lobby_get_session_by_id(self, session_id)
end

multiplayer_lobby_session_host_wire_id = function(session)
    if type(session) ~= "table" then
        return ""
    end
    local host_wire_id = tostring(session.host_wire_player_id or "")
    if host_wire_id ~= "" then
        return host_wire_id
    end
    return tostring(session.owner_player_id or MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID)
end

multiplayer_lobby_sender_is_session_host = function(session, sender_wire_id)
    local host_wire_id = multiplayer_lobby_session_host_wire_id(session)
    local sender_id = tostring(sender_wire_id or "")
    return host_wire_id ~= "" and sender_id ~= "" and sender_id == host_wire_id
end

multiplayer_resolve_wire_dispatch_player_id = function(self, session_or_config)
    if type(session_or_config) == "table" then
        local from_config = tostring(session_or_config.wire_dispatch_player_id or "")
        if from_config ~= "" then
            return from_config
        end
        local from_session = multiplayer_lobby_session_host_wire_id(session_or_config)
        if from_session ~= "" then
            return from_session
        end
    end
    local ticket_id = multiplayer_lobby_get_lobby_ticket_id(self)
    if ticket_id ~= "" then
        local ticket = multiplayer_lobby_get_session_by_id(self, ticket_id)
        if not ticket and self.mp_lobby and self.mp_lobby.offers_by_id then
            ticket = self.mp_lobby.offers_by_id[ticket_id]
        end
        local from_ticket = multiplayer_lobby_session_host_wire_id(ticket)
        if from_ticket ~= "" then
            return from_ticket
        end
    end
    local local_offer_id = tostring(self.mp_lobby and self.mp_lobby.local_active_offer_id or "")
    if local_offer_id ~= "" then
        local local_offer = multiplayer_lobby_get_session_by_id(self, local_offer_id)
        local from_local_offer = multiplayer_lobby_session_host_wire_id(local_offer)
        if from_local_offer ~= "" then
            return from_local_offer
        end
    end
    if self.mp_transport and self.mp_transport.steam_is_host and self.mp_transport.steam_is_host() == true then
        return tostring(MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID or "p1")
    end
    return tostring(self.mp_state and self.mp_state.local_player_id or "p2")
end

multiplayer_apply_wire_dispatch_player_id = function(self, session_or_config)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return ""
    end
    local wire_dispatch_id = mp_normalize_network_player_id(multiplayer_resolve_wire_dispatch_player_id(self, session_or_config))
    if wire_dispatch_id == "" then
        wire_dispatch_id = "p1"
    end
    self.mp_state.host_player_id = wire_dispatch_id
    local local_id = tostring(self.mp_state.local_player_id or "")
    if local_id == wire_dispatch_id then
        self.mp_state.debug_active_player_id = wire_dispatch_id
    end
    multiplayer_debug_log(self, string.format(
        "MP WIRE | dispatch_assign host=%s local=%s",
        tostring(wire_dispatch_id),
        tostring(local_id)
    ))
    return wire_dispatch_id
end

multiplayer_apply_steam_lobby_wire_defaults = function(self)
    if not (self and self.mp_state) then
        return
    end
    self.mp_state.host_player_id = "p1"
    if tostring(self.mp_state.local_player_id or "") == "p1" then
        self.mp_state.debug_active_player_id = "p1"
    end
end

multiplayer_is_wire_dispatch_host = function(self)
    if not (self and self.mp_state and self.mp_state.enabled) then
        return true
    end
    return tostring(self.mp_state.local_player_id or "") == tostring(self.mp_state.host_player_id or "")
end

multiplayer_lobby_is_session_host = function(self, session)
    local target_session = session
    if not target_session then
        target_session = multiplayer_lobby_get_active_session(self)
    end
    if not target_session then
        local local_offer_id = tostring(self.mp_lobby and self.mp_lobby.local_active_offer_id or "")
        if local_offer_id ~= "" then
            target_session = multiplayer_lobby_get_session_by_id(self, local_offer_id)
        end
    end
    if not target_session then
        return false
    end
    local local_steam_id = multiplayer_session_ticket_get_local_steam_id(self)
    if local_steam_id ~= "" then
        return MP_SESSION_TICKET.is_session_host(target_session, local_steam_id)
    end
    local local_wire_id = tostring(self.mp_state and self.mp_state.local_player_id or "p1")
    local host_steam_id = tostring(target_session.host_steam_id or "")
    if host_steam_id ~= "" and string.sub(host_steam_id, 1, 11) == "local_host_" then
        return host_steam_id == ("local_host_" .. local_wire_id)
    end
    return multiplayer_lobby_session_host_wire_id(target_session) == local_wire_id
end

multiplayer_lobby_can_host_launch = function(self, session)
    local target_session = session or multiplayer_lobby_get_active_session(self)
    if not target_session then
        return false
    end
    local local_steam_id = multiplayer_session_ticket_get_local_steam_id(self)
    if local_steam_id ~= "" then
        return MP_SESSION_TICKET.can_host_launch(target_session, local_steam_id)
    end
    return multiplayer_lobby_is_session_host(self, target_session)
        and MP_SESSION_TICKET.is_open_lobby_status(target_session.lobby_status or MP_SESSION_TICKET.LOBBY_STATUS_OPEN)
end

multiplayer_lobby_is_local_offer_owner = function(self, session)
    return multiplayer_lobby_is_session_host(self, session)
end

multiplayer_session_ticket_get_local_steam_id = function(self)
    if self.mp_transport and self.mp_transport.steam_get_local_steam_id then
        local steam_id = tostring(self.mp_transport.steam_get_local_steam_id() or "")
        if steam_id ~= "" then
            return steam_id
        end
    end
    return ""
end

multiplayer_session_ticket_ensure_host_allocator = function(self)
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    lobby.host_session_allocator = MP_SESSION_TICKET.ensure_host_allocator(lobby.host_session_allocator)
    if lobby.host_session_allocator._loaded ~= true then
        lobby.host_session_allocator.next_session_number = MP_SESSION_TICKET.load_host_next_session_number()
        lobby.host_session_allocator._loaded = true
    end
    return lobby.host_session_allocator
end

multiplayer_session_ticket_mint_host_session = function(self, publish_status)
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    multiplayer_steam_refresh_local_username(self)
    local allocator = multiplayer_session_ticket_ensure_host_allocator(self)
    local session_number
    session_number, lobby.host_session_allocator = MP_SESSION_TICKET.allocate_session_number(allocator)
    local host_steam_id = multiplayer_session_ticket_get_local_steam_id(self)
    local host_wire_player_id = tostring(MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID or "p1")
    if host_steam_id == "" then
        host_steam_id = "local_host_" .. host_wire_player_id
    end
    local session = MP_SESSION_TICKET.create_session_record({
        host_steam_id = host_steam_id,
        host_wire_player_id = host_wire_player_id,
        session_number = session_number,
        host_display_name = tostring(lobby.local_username or "Host"),
        joined_network_ids = { host_wire_player_id },
        publish_status = publish_status or MP_SESSION_TICKET.PUBLISH_DRAFT,
        lobby_status = MP_SESSION_TICKET.LOBBY_STATUS_OPEN,
        env_name = tostring(ENV_NAME or "LOCAL"),
        game_version = tostring(GAME_VERSION_LABEL or "0"),
        protocol_version = tostring(NET_PROTOCOL_VERSION or "1"),
        updated_at_ms = get_wall_clock_ms(),
    })
    session.status = tostring(session.publish_status or MP_SESSION_TICKET.PUBLISH_DRAFT)
    session.last_seen_local_ms = get_wall_clock_ms()
    session.display_name_by_wire_id = {
        [host_wire_player_id] = mp_lobby_sanitize_name(lobby.local_username or "host")
    }
    multiplayer_debug_log(self, string.format(
        "MP TICKET | mint key=%s number=%s host=%s",
        tostring(session.session_key or ""),
        tostring(session.session_number or ""),
        tostring(session.host_display_name or "")
    ))
    return session
end

multiplayer_lobby_session_is_browse_visible = function(session)
    if type(session) ~= "table" then
        return false
    end
    if session.lobby_status ~= nil and tostring(session.lobby_status or "") ~= "" then
        return MP_SESSION_TICKET.is_browse_visible(session)
    end
    local status = tostring(session.status or "")
    return status == "published_open" or status == "published_private"
end

multiplayer_lobby_prune_stale_offers = function(self)
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    local now_ms = get_wall_clock_ms()
    local stale_after_ms = 90000
    local discovery_stale_after_ms = 12000
    local changed = false
    for offer_id, offer in pairs(lobby.offers_by_id or {}) do
        local is_local_active = tostring(lobby.local_active_offer_id or "") == tostring(offer_id or "")
        if not is_local_active then
            local last_seen = tonumber(offer and offer.last_seen_local_ms or 0) or 0
            if last_seen <= 0 then
                last_seen = tonumber(offer and offer.updated_at_ms or 0) or 0
            end
            local stale_limit = stale_after_ms
            if offer and (offer.steam_discovery == true or string.sub(tostring(offer_id or ""), 1, 3) == "sl:") then
                stale_limit = discovery_stale_after_ms
                if last_seen <= 0 then
                    last_seen = nil
                end
            end
            if last_seen ~= nil and (last_seen <= 0 or (now_ms - last_seen) > stale_limit) then
                lobby.offers_by_id[offer_id] = nil
                changed = true
            end
        end
    end
    if changed then
        multiplayer_lobby_sync_sessions_from_offers(self)
    end
end

multiplayer_lobby_sync_sessions_from_offers = function(self)
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    lobby.sessions = {}
    for _, offer in pairs(lobby.offers_by_id or {}) do
        if offer then
            lobby.sessions[#lobby.sessions + 1] = offer
        end
    end
    table.sort(lobby.sessions, function(a, b)
        return tostring(a and a.id or "") < tostring(b and b.id or "")
    end)
end

multiplayer_lobby_emit_offer_upsert = function(self, session, target_player_id)
    if not (self.mp_state and self.mp_state.enabled and session and session.id) then
        return
    end
    local now_ms = get_wall_clock_ms()
    session.updated_at_ms = now_ms
    local offer_payload = {
        id = tostring(session.id or ""),
        session_key = tostring(session.session_key or session.id or ""),
        session_number = tonumber(session.session_number or 0) or 0,
        host_steam_id = tostring(session.host_steam_id or ""),
        host_wire_player_id = tostring(session.host_wire_player_id or multiplayer_lobby_session_host_wire_id(session)),
        lobby_status = tostring(session.lobby_status or MP_SESSION_TICKET.LOBBY_STATUS_OPEN),
        owner_player_id = tostring(session.owner_player_id or MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID),
        host_display_name = tostring(session.host_display_name or session.host_name or "Host"),
        host_name = tostring(session.host_name or session.host_display_name or "Host"),
        status = tostring(session.status or session.publish_status or "published_open"),
        publish_status = tostring(session.publish_status or session.status or "published_open"),
        env_name = tostring(session.env_name or ENV_NAME or "LOCAL"),
        game_version = tostring(session.game_version or GAME_VERSION_LABEL or "0"),
        protocol_version = tostring(session.protocol_version or NET_PROTOCOL_VERSION or "1"),
        players = math.max(1, tonumber(session.players or 1) or 1),
        max_players = math.max(2, tonumber(session.max_players or 2) or 2),
        is_locked = session.is_locked == true,
        joined_player_ids = multiplayer_clone_simple_table(session.joined_player_ids or {}),
        display_name_by_wire_id = multiplayer_clone_simple_table(session.display_name_by_wire_id or {}),
        updated_at_ms = now_ms
    }
    print(string.format("LOBBY_COMMAND | offer_upsert_send_command | offer=%s owner=%s", tostring(session.id or ""), tostring(session.owner_player_id or "")))
    multiplayer_transport_send_command(self, "lobby_offer_upsert", {
        target_player_id = target_player_id,
        offer = offer_payload
    }, self.mp_state.local_player_id)
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") == "steam" then
        local status = tostring(session.status or "")
        if status == "published_open" or status == "published_private" then
            if self.mp_transport and self.mp_transport.steam_get_lobby_id then
                session.steam_lobby_id = tostring(self.mp_transport.steam_get_lobby_id() or "")
            end
            if self.mp_transport and self.mp_transport.steam_publish_session then
                self.mp_transport.steam_publish_session(session)
            end
        end
    end
end

multiplayer_lobby_reannounce_active_offer = function(self, target_player_id)
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    local offer_id = tostring(lobby.local_active_offer_id or "")
    if offer_id == "" then
        return
    end
    local session = multiplayer_lobby_get_session_by_id(self, offer_id)
    if not session then
        return
    end
    multiplayer_lobby_emit_offer_upsert(self, session, target_player_id)
end

multiplayer_lobby_emit_offer_remove = function(self, offer_id)
    if not (self.mp_state and self.mp_state.enabled and offer_id and offer_id ~= "") then
        return
    end
    local now_ms = get_wall_clock_ms()
    multiplayer_lobby_note_offer_removed(self, offer_id, now_ms)
    print(string.format("LOBBY_COMMAND | offer_remove_send_command | offer=%s owner=%s", tostring(offer_id), tostring(self.mp_state.local_player_id or "")))
    multiplayer_transport_send_command(self, "lobby_offer_remove", {
        offer_id = tostring(offer_id),
        owner_player_id = tostring(self.mp_state.local_player_id or "p1"),
        host_wire_player_id = tostring(self.mp_state.local_player_id or "p1"),
        removed_at_ms = now_ms
    }, self.mp_state.local_player_id)
    multiplayer_lobby_clear_steam_discovery_if_host(self)
end

multiplayer_lobby_tick_offer_presence = function(self, dt)
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    lobby.offer_prune_timer = (tonumber(lobby.offer_prune_timer or 0) or 0) - (tonumber(dt or 0) or 0)
    if lobby.offer_prune_timer <= 0 then
        lobby.offer_prune_timer = 1
        multiplayer_lobby_prune_stale_offers(self)
    end
    lobby.steam_discovery_republish_timer = (tonumber(lobby.steam_discovery_republish_timer or 0) or 0) - (tonumber(dt or 0) or 0)
    if lobby.steam_discovery_republish_timer <= 0 then
        lobby.steam_discovery_republish_timer = 3
        multiplayer_lobby_republish_steam_discovery_if_host(self)
    end
end

multiplayer_lobby_request_find_refresh = function(self)
    if not (self and self.mp_lobby and multiplayer_lobby_is_find_intent(self)) then
        return false
    end
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    if tostring(lobby.pending_join_session_id or "") ~= "" then
        show_mp_lobby_advisory(self, 1.2, "joining")
        return true
    end
    lobby.discovery_browse_count = 0
    lobby.discovery_session_count = -1
    lobby.discovery_refresh_requested_ms = get_wall_clock_ms()
    if self.mp_transport and self.mp_transport.steam_refresh_lobbies then
        self.mp_transport.steam_refresh_lobbies()
    end
    show_mp_lobby_advisory(self, 1.6, "find")
    multiplayer_debug_log(self, "MP LOBBY | finder_refresh_requested")
    return true
end

multiplayer_lobby_merge_incoming_offer_fields = function(existing_offer, offer)
    offer = offer or {}
    if offer.steam_discovery == true then
        local discovery_players = math.max(1, tonumber(offer.players or 1) or 1)
        if type(existing_offer and existing_offer.joined_player_ids) == "table"
            and #existing_offer.joined_player_ids > 0
        then
            return multiplayer_clone_simple_table(existing_offer.joined_player_ids), discovery_players
        end
        return {}, discovery_players
    end
    local incoming_joined = type(offer.joined_player_ids) == "table" and offer.joined_player_ids or {}
    local merged_joined = {}
    if #incoming_joined > 0 then
        merged_joined = multiplayer_clone_simple_table(incoming_joined)
    elseif type(existing_offer and existing_offer.joined_player_ids) == "table" then
        merged_joined = multiplayer_clone_simple_table(existing_offer.joined_player_ids)
    end
    local merged_players = math.max(1, tonumber(offer.players or 0) or 0)
    if #merged_joined > 0 then
        merged_players = math.max(merged_players, #merged_joined)
    end
    local incoming_updated = tonumber(offer.updated_at_ms or 0) or 0
    local existing_updated = tonumber(existing_offer and existing_offer.updated_at_ms or 0) or 0
    if existing_offer
        and incoming_updated > 0
        and existing_updated > 0
        and incoming_updated < existing_updated
    then
        merged_players = math.max(merged_players, tonumber(existing_offer.players or 0) or 0)
        if type(existing_offer.joined_player_ids) == "table"
            and #existing_offer.joined_player_ids >= #merged_joined
        then
            merged_joined = multiplayer_clone_simple_table(existing_offer.joined_player_ids)
            merged_players = math.max(merged_players, #merged_joined)
        elseif #incoming_joined == 0 and type(existing_offer.joined_player_ids) == "table" then
            merged_joined = multiplayer_clone_simple_table(existing_offer.joined_player_ids)
        end
    end
    return merged_joined, merged_players
end

multiplayer_lobby_merge_offer_pin = function(existing_offer, offer)
    local existing_pin = tostring(existing_offer and existing_offer.pin or "")
    local incoming_pin = tostring(offer and offer.pin or "")
    if incoming_pin ~= "" then
        return incoming_pin
    end
    return existing_pin
end

multiplayer_lobby_merge_display_name_maps = function(existing_map, incoming_map)
    local merged = {}
    if type(existing_map) == "table" then
        for wire_id, name in pairs(existing_map) do
            local key = mp_normalize_network_player_id(wire_id)
            local val = mp_lobby_sanitize_name(name)
            if key ~= "" and val ~= "" then
                merged[key] = val
            end
        end
    end
    if type(incoming_map) == "table" then
        for wire_id, name in pairs(incoming_map) do
            local key = mp_normalize_network_player_id(wire_id)
            local val = mp_lobby_sanitize_name(name)
            if key ~= "" and val ~= "" then
                merged[key] = val
            end
        end
    end
    return merged
end

multiplayer_lobby_apply_offer_upsert = function(self, offer)
    multiplayer_lobby_ensure_runtime(self)
    if type(offer) ~= "table" then
        return
    end
    local ticket_id = tostring(offer.id or offer.session_key or "")
    local offer_id = multiplayer_lobby_offer_map_key(offer)
    if offer_id == "" then
        offer_id = ticket_id
    end
    if offer_id == "" then
        return
    end
    local lobby_status = tostring(offer.lobby_status or MP_SESSION_TICKET.LOBBY_STATUS_OPEN)
    if MP_SESSION_TICKET.is_terminal_lobby_status(lobby_status) then
        print(string.format("LOBBY_COMMAND | offer_upsert_drop_terminal | offer=%s status=%s", offer_id, lobby_status))
        return
    end
    local incoming_is_discovery = offer.steam_discovery == true
    if incoming_is_discovery and self.mp_lobby.offer_removed_at_ms_by_id then
        self.mp_lobby.offer_removed_at_ms_by_id[offer_id] = nil
        if ticket_id ~= "" and ticket_id ~= offer_id then
            self.mp_lobby.offer_removed_at_ms_by_id[ticket_id] = nil
        end
    end
    local tombstone_ms = tonumber(self.mp_lobby.offer_removed_at_ms_by_id and self.mp_lobby.offer_removed_at_ms_by_id[offer_id] or 0) or 0
    if tombstone_ms <= 0 and ticket_id ~= "" and ticket_id ~= offer_id then
        tombstone_ms = tonumber(self.mp_lobby.offer_removed_at_ms_by_id and self.mp_lobby.offer_removed_at_ms_by_id[ticket_id] or 0) or 0
    end
    local offer_updated_ms = tonumber(offer.updated_at_ms or 0) or 0
    if tombstone_ms > 0 and not incoming_is_discovery then
        if offer_updated_ms <= 0 or offer_updated_ms <= tombstone_ms then
            print(string.format("LOBBY_COMMAND | offer_upsert_drop_tombstoned | offer=%s discovery=%s", offer_id, tostring(incoming_is_discovery)))
            return
        end
    end
    local owner_player_id = tostring(offer.owner_player_id or MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID)
    local publish_status = tostring(offer.publish_status or offer.status or MP_SESSION_TICKET.PUBLISH_OPEN)
    local incoming_session_key = tostring(offer.session_key or ticket_id or "")
    local incoming_steam_lobby_id = tostring(offer.steam_lobby_id or "")
    if incoming_is_discovery then
        local local_offer_id = tostring(self.mp_lobby.local_active_offer_id or "")
        local local_offer = local_offer_id ~= "" and self.mp_lobby.offers_by_id[local_offer_id] or nil
        if type(local_offer) == "table" and multiplayer_lobby_is_local_offer_owner(self, local_offer) then
            local local_session_key = tostring(local_offer.session_key or local_offer.id or local_offer_id or "")
            local local_steam_lobby_id = tostring(local_offer.steam_lobby_id or "")
            local same_local_session = local_session_key ~= "" and incoming_session_key ~= "" and local_session_key == incoming_session_key
            local same_local_lobby = local_steam_lobby_id ~= "" and incoming_steam_lobby_id ~= "" and local_steam_lobby_id == incoming_steam_lobby_id
            if same_local_session or same_local_lobby then
                local_offer.last_seen_local_ms = get_wall_clock_ms()
                if incoming_steam_lobby_id ~= "" then
                    local_offer.steam_lobby_id = incoming_steam_lobby_id
                end
                return
            end
        end
    end
    if incoming_is_discovery and incoming_steam_lobby_id ~= "" then
        for existing_offer_id, existing_offer in pairs(self.mp_lobby.offers_by_id or {}) do
            if tostring(existing_offer_id or "") ~= offer_id
                and tostring(existing_offer and existing_offer.steam_lobby_id or "") == incoming_steam_lobby_id then
                self.mp_lobby.offers_by_id[existing_offer_id] = nil
            end
        end
    end
    if not incoming_is_discovery then
        for existing_offer_id, existing_offer in pairs(self.mp_lobby.offers_by_id or {}) do
            if tostring(existing_offer_id or "") ~= offer_id then
                local existing_session_key = tostring(existing_offer and existing_offer.session_key or existing_offer_id or "")
                local same_session_key = existing_session_key ~= ""
                    and incoming_session_key ~= ""
                    and existing_session_key == incoming_session_key
                if same_session_key then
                    self.mp_lobby.offers_by_id[existing_offer_id] = nil
                    multiplayer_lobby_note_offer_removed(self, existing_offer_id, get_wall_clock_ms())
                    print(string.format(
                        "LOBBY_COMMAND | offer_upsert_replaced_session_key | old_offer=%s new_offer=%s session_key=%s discovery=false",
                        tostring(existing_offer_id),
                        offer_id,
                        incoming_session_key
                    ))
                end
            end
        end
    end
    local existing_offer = self.mp_lobby.offers_by_id[offer_id]
    local guest_local_id = mp_normalize_network_player_id(self.mp_state and self.mp_state.local_player_id or "")
    local guest_was_in_roster = guest_local_id ~= ""
        and existing_offer
        and multiplayer_lobby_wire_id_in_roster(existing_offer, guest_local_id)
    local incoming_updated_ms = tonumber(offer.updated_at_ms or 0) or 0
    local existing_updated_ms = tonumber(existing_offer and existing_offer.updated_at_ms or 0) or 0
    local merged_joined, merged_players = multiplayer_lobby_merge_incoming_offer_fields(existing_offer, offer)
    self.mp_lobby.offers_by_id[offer_id] = {
        id = ticket_id ~= "" and ticket_id or offer_id,
        session_key = tostring(offer.session_key or (existing_offer and existing_offer.session_key) or ticket_id or offer_id),
        session_number = tonumber(offer.session_number or (existing_offer and existing_offer.session_number) or 0) or 0,
        host_steam_id = tostring(offer.host_steam_id or (existing_offer and existing_offer.host_steam_id) or ""),
        host_wire_player_id = tostring(offer.host_wire_player_id or (existing_offer and existing_offer.host_wire_player_id) or ""),
        lobby_status = lobby_status,
        publish_status = publish_status,
        owner_player_id = owner_player_id,
        host_network_id = tostring(offer.host_network_id or (existing_offer and existing_offer.host_network_id) or MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID),
        host_display_name = tostring(offer.host_display_name or offer.host_name or (existing_offer and existing_offer.host_display_name) or "Host"),
        host_name = tostring(offer.host_name or offer.host_display_name or (existing_offer and existing_offer.host_name) or "Host"),
        status = publish_status,
        env_name = tostring(offer.env_name or ENV_NAME or "LOCAL"),
        game_version = tostring(offer.game_version or GAME_VERSION_LABEL or "0"),
        protocol_version = tostring(offer.protocol_version or NET_PROTOCOL_VERSION or "1"),
        players = merged_players,
        max_players = math.max(2, tonumber(offer.max_players or (existing_offer and existing_offer.max_players) or 2) or 2),
        is_locked = (offer.is_locked == true) or (existing_offer and existing_offer.is_locked == true),
        joined_player_ids = merged_joined,
        steam_id_by_wire_id = multiplayer_clone_simple_table(
            (type(offer.steam_id_by_wire_id) == "table" and offer.steam_id_by_wire_id)
                or (existing_offer and existing_offer.steam_id_by_wire_id)
                or {}
        ),
        wire_id_by_steam_id = multiplayer_clone_simple_table(
            (type(offer.wire_id_by_steam_id) == "table" and offer.wire_id_by_steam_id)
                or (existing_offer and existing_offer.wire_id_by_steam_id)
                or {}
        ),
        display_name_by_wire_id = multiplayer_lobby_merge_display_name_maps(
            existing_offer and existing_offer.display_name_by_wire_id,
            offer.display_name_by_wire_id
        ),
        pin = multiplayer_lobby_merge_offer_pin(existing_offer, offer),
        steam_lobby_id = tostring(offer.steam_lobby_id or (existing_offer and existing_offer.steam_lobby_id) or ""),
        setup_roster_revision = math.max(
            tonumber(offer.setup_roster_revision or 0) or 0,
            tonumber(existing_offer and existing_offer.setup_roster_revision or 0) or 0
        ),
        updated_at_ms = math.max(
            tonumber(offer.updated_at_ms or 0) or 0,
            tonumber(existing_offer and existing_offer.updated_at_ms or 0) or 0
        ),
        last_seen_local_ms = get_wall_clock_ms(),
        steam_discovery = incoming_is_discovery or (existing_offer and existing_offer.steam_discovery == true) or false
    }
    print(string.format("LOBBY_COMMAND | offer_upsert_apply | offer=%s owner=%s", offer_id, owner_player_id))
    multiplayer_lobby_sync_sessions_from_offers(self)
    multiplayer_lobby_try_complete_pending_join_from_offer(self, self.mp_lobby.offers_by_id[offer_id])
    if incoming_is_discovery or multiplayer_lobby_is_host(self) then
        return
    end
    if (self.game_flow_state or FLOW_STATE_GAME) == FLOW_STATE_MP_SETUP then
        local ticket = tostring(self.mp_state.lobby_ticket_id or "")
        if ticket ~= "" and ticket == offer_id and guest_was_in_roster then
            local applied = self.mp_lobby.offers_by_id[offer_id]
            local now_in_roster = applied and multiplayer_lobby_wire_id_in_roster(applied, guest_local_id)
            if not now_in_roster
                and incoming_updated_ms > 0
                and (existing_updated_ms <= 0 or incoming_updated_ms >= existing_updated_ms)
            then
                multiplayer_debug_log(self, string.format(
                    "MP LOBBY | guest_setup_evicted offer=%s local=%s incoming_ms=%d existing_ms=%d",
                    offer_id,
                    guest_local_id,
                    incoming_updated_ms,
                    existing_updated_ms
                ))
                multiplayer_lobby_guest_leave_setup_to_find(self)
            end
        end
    end
end

multiplayer_lobby_apply_offer_remove = function(self, offer_id)
    multiplayer_lobby_ensure_runtime(self)
    local oid = tostring(offer_id or "")
    if oid == "" then
        return
    end
    multiplayer_lobby_note_offer_removed(self, oid, nil)
    print(string.format("LOBBY_COMMAND | offer_remove_apply | offer=%s", oid))
    self.mp_lobby.offers_by_id[oid] = nil
    if tostring(self.mp_lobby.local_active_offer_id or "") == oid then
        self.mp_lobby.local_active_offer_id = ""
    end
    multiplayer_lobby_sync_sessions_from_offers(self)
end

multiplayer_lobby_build_state_payload = function(self)
    local lobby = self.mp_lobby or {}
    multiplayer_lobby_sync_sessions_from_offers(self)
    local sessions = {}
    for _, session in ipairs(lobby.sessions or {}) do
        if session then
            sessions[#sessions + 1] = {
                id = tostring(session.id or ""),
                owner_player_id = tostring(session.owner_player_id or self.mp_state and self.mp_state.local_player_id or "p1"),
                host_name = tostring(session.host_name or "Host"),
                status = tostring(session.status or "published_open"),
                env_name = tostring(session.env_name or ENV_NAME or "LOCAL"),
                game_version = tostring(session.game_version or GAME_VERSION_LABEL or "0"),
                protocol_version = tostring(session.protocol_version or NET_PROTOCOL_VERSION or "1"),
                players = math.max(1, tonumber(session.players or 1) or 1),
                max_players = math.max(2, tonumber(session.max_players or 4) or 4),
                is_locked = session.is_locked == true,
                joined_player_ids = session.joined_player_ids or {}
            }
        end
    end
    return {
        sessions = sessions,
        page_index = math.max(1, tonumber(lobby.page_index or 1) or 1),
        session_counter = tonumber(lobby.session_counter or #sessions) or #sessions
    }
end

multiplayer_lobby_find_session_joined_by_player = function(self, player_id)
    local pid = tostring(player_id or "")
    if pid == "" then
        return nil
    end
    local lobby = self.mp_lobby or {}
    for _, session in ipairs(lobby.sessions or {}) do
        if session and type(session.joined_player_ids) == "table" then
            for _, joined_id in ipairs(session.joined_player_ids) do
                if tostring(joined_id or "") == pid then
                    return session
                end
            end
        end
    end
    return nil
end

multiplayer_lobby_apply_state_payload = function(self, payload)
    multiplayer_lobby_ensure_runtime(self)
    if type(payload) ~= "table" then
        return
    end
    local lobby = self.mp_lobby
    lobby.sessions = {}
    lobby.offers_by_id = {}
    for _, session in ipairs(payload.sessions or {}) do
        local normalized = {
            id = tostring(session.id or ""),
            owner_player_id = tostring(session.owner_player_id or "p1"),
            host_name = tostring(session.host_name or "Host"),
            status = tostring(session.status or "published_open"),
            env_name = tostring(session.env_name or ENV_NAME or "LOCAL"),
            game_version = tostring(session.game_version or GAME_VERSION_LABEL or "0"),
            protocol_version = tostring(session.protocol_version or NET_PROTOCOL_VERSION or "1"),
            players = math.max(1, tonumber(session.players or 1) or 1),
            max_players = math.max(2, tonumber(session.max_players or 4) or 4),
            is_locked = session.is_locked == true,
            joined_player_ids = session.joined_player_ids or {}
        }
        lobby.sessions[#lobby.sessions + 1] = normalized
        lobby.offers_by_id[normalized.id] = normalized
    end
    lobby.page_index = math.max(1, tonumber(payload.page_index or lobby.page_index or 1) or 1)
    lobby.session_counter = tonumber(payload.session_counter or lobby.session_counter or #lobby.sessions) or #lobby.sessions
end

multiplayer_lobby_push_state = function(self, target_player_id)
    if not (self.mp_state and self.mp_state.enabled and self.mp_state.local_player_id == self.mp_state.host_player_id) then
        return
    end
    multiplayer_transport_broadcast_event(self, "lobby_state_updated", {
        target_player_id = target_player_id,
        lobby_state = multiplayer_lobby_build_state_payload(self)
    })
end

multiplayer_lobby_get_session_by_id = function(self, session_id)
    if not (self and self.mp_lobby and session_id) then
        return nil
    end
    local target_id = tostring(session_id or "")
    if target_id == "" then
        return nil
    end
    multiplayer_lobby_ensure_runtime(self)
    local from_offers = self.mp_lobby.offers_by_id and self.mp_lobby.offers_by_id[target_id] or nil
    if from_offers then
        return from_offers
    end
    for _, offer in pairs(self.mp_lobby.offers_by_id or {}) do
        if offer and tostring(offer.id or "") == target_id then
            return offer
        end
    end
    for _, session in ipairs(self.mp_lobby.sessions or {}) do
        if session and tostring(session.id or "") == target_id then
            return session
        end
    end
    return nil
end

multiplayer_lobby_get_published_sessions = function(self)
    local out = {}
    if not (self and self.mp_lobby and self.mp_lobby.sessions) then
        return out
    end
    for _, session in ipairs(self.mp_lobby.sessions) do
        if multiplayer_lobby_session_is_browse_visible(session) then
            out[#out + 1] = session
        end
    end
    return out
end

multiplayer_lobby_page_count = function(self)
    local published = multiplayer_lobby_get_published_sessions(self)
    return math.max(1, math.ceil(#published / MP_LOBBY_SLOTS_PER_PAGE))
end

multiplayer_lobby_get_visible_sessions = function(self)
    local published = multiplayer_lobby_get_published_sessions(self)
    local lobby = self.mp_lobby or {}
    local page_count = multiplayer_lobby_page_count(self)
    local page_index = math.max(1, math.min(page_count, tonumber(lobby.page_index or 1) or 1))
    lobby.page_index = page_index
    local start_idx = ((page_index - 1) * MP_LOBBY_SLOTS_PER_PAGE) + 1
    local out = {}
    for i = 0, MP_LOBBY_SLOTS_PER_PAGE - 1 do
        local session = published[start_idx + i]
        if session then
            out[#out + 1] = session
        end
    end
    return out
end

multiplayer_session_protocol_is_compatible = function(self, session)
    if not session then
        return false
    end
    return tostring(session.protocol_version or NET_PROTOCOL_VERSION or "1") == tostring(NET_PROTOCOL_VERSION or "1")
end

multiplayer_lobby_count_compatible_published_sessions = function(self)
    local published = multiplayer_lobby_get_published_sessions(self)
    local published_total = #published
    local compatible_total = 0
    for _, session in ipairs(published) do
        if multiplayer_session_protocol_is_compatible(self, session) then
            compatible_total = compatible_total + 1
        end
    end
    return published_total, compatible_total
end

multiplayer_lobby_enter_mp_setup_from_session = function(self, session, skip_request_setup)
    if not session then
        return false
    end
    self.multiplayer_mode_active = true
    if self.mp_state then
        self.mp_state.enabled = true
        self.mp_state.debug_active_player_id = self.mp_state.local_player_id
        local ticket_id = tostring(session.id or session.session_key or "")
        self.mp_state.lobby_ticket_id = ticket_id
        self.mp_state.session_id = ticket_id ~= "" and ticket_id or tostring(self.mp_state.session_id or "local_session")
        self.mp_state.player_count = multiplayer_setup_roster_player_count(self, session)
        multiplayer_apply_wire_dispatch_player_id(self, session)
    end
    multiplayer_setup_init_runtime(self)
    if multiplayer_lobby_is_local_offer_owner(self, session) and self.mp_setup then
        multiplayer_setup_sync_player_count_from_roster(self, session)
    end
    if multiplayer_lobby_is_local_offer_owner(self, session) then
        multiplayer_lobby_lifecycle_host(self, MP_LOBBY_LIFECYCLE.HOST_ALONE, {
            session = tostring(session.id or "")
        })
    elseif self.mp_state and self.mp_state.enabled then
        multiplayer_lobby_lifecycle_guest(self, MP_LOBBY_LIFECYCLE.GUEST_IN_ROSTER, {
            session = tostring(session.id or "")
        })
    end
    enter_flow_state(self, FLOW_STATE_MP_SETUP)
    if skip_request_setup ~= true then
        if multiplayer_lobby_is_local_offer_owner(self, session) then
            multiplayer_setup_push_state(self)
        elseif self.mp_state and self.mp_state.enabled then
            multiplayer_transport_send_command(self, "request_setup_state", {}, self.mp_state.local_player_id)
        end
    end
    return true
end

multiplayer_lobby_create_host_draft = function(self)
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    local existing_offer_id = tostring(lobby.local_active_offer_id or "")
    if existing_offer_id ~= "" then
        local existing = multiplayer_lobby_get_session_by_id(self, existing_offer_id)
        if existing and MP_SESSION_TICKET.is_open_lobby_status(existing.lobby_status or MP_SESSION_TICKET.LOBBY_STATUS_OPEN) then
            return true
        end
        lobby.local_active_offer_id = ""
    end
    local session = multiplayer_session_ticket_mint_host_session(self, MP_SESSION_TICKET.PUBLISH_DRAFT)
    if not session then
        return false
    end
    local session_id = tostring(session.id or "")
    lobby.offers_by_id[session_id] = session
    lobby.local_active_offer_id = session_id
    lobby.host_draft_session_id = session_id
    lobby.pending_join_session_id = ""
    multiplayer_lobby_reset_setup_sync_runtime(self, session)
    multiplayer_lobby_sync_sessions_from_offers(self)
    multiplayer_lobby_emit_offer_upsert(self, session)
    return true
end

multiplayer_lobby_publish_host_draft = function(self, private_pin)
    local lobby = self.mp_lobby
    if not lobby then
        return false
    end
    local draft_id = tostring(lobby.local_active_offer_id or lobby.host_draft_session_id or "")
    local session = multiplayer_lobby_get_session_by_id(self, draft_id)
    if not session then
        return false
    end
    if private_pin and private_pin ~= "" then
        session.status = "published_private"
        session.publish_status = MP_SESSION_TICKET.PUBLISH_PRIVATE
        session.is_locked = true
        session.pin = tostring(private_pin)
    else
        session.status = "published_open"
        session.publish_status = MP_SESSION_TICKET.PUBLISH_OPEN
        session.is_locked = false
        session.pin = ""
    end
    session.lobby_status = MP_SESSION_TICKET.LOBBY_STATUS_OPEN
    session.owner_player_id = tostring(MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID)
    session.host_network_id = MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID
    session.host_wire_player_id = tostring(MP_SESSION_TICKET.SESSION_HOST_NETWORK_ID or "p1")
    multiplayer_steam_refresh_local_username(self)
    session.host_display_name = mp_lobby_sanitize_name(lobby.local_username or "host")
    session.host_name = session.host_display_name
    local host_wire_id = tostring(session.host_wire_player_id or "")
    session.display_name_by_wire_id = multiplayer_lobby_merge_display_name_maps(
        session.display_name_by_wire_id,
        { [host_wire_id] = session.host_display_name }
    )
    session.joined_player_ids = { host_wire_id }
    multiplayer_steam_ensure_session_roster_maps(session)
    multiplayer_lobby_reset_setup_sync_runtime(self, session)
    session.players = 1
    session.max_players = 4
    if self.mp_setup then
        multiplayer_setup_sync_player_count_from_roster(self, session)
    end
    lobby.offers_by_id[tostring(session.id or "")] = session
    lobby.pending_join_session_id = ""
    multiplayer_lobby_sync_sessions_from_offers(self)
    if tostring(MULTIPLAYER_TRANSPORT_MODE or "") == "steam"
        and self.mp_transport
        and self.mp_transport.steam_get_lobby_id
        and tostring(self.mp_transport.steam_get_lobby_id() or "") == ""
        and self.mp_transport.steam_request_create_lobby
    then
        self.mp_transport.steam_request_create_lobby()
    end
    lobby.steam_discovery_republish_timer = 0
    multiplayer_lobby_emit_offer_upsert(self, session)
    return multiplayer_lobby_enter_mp_setup_from_session(self, session)
end

multiplayer_lobby_cancel_session = function(self, session_id)
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    local sid = tostring(session_id or "")
    if sid == "" then
        sid = tostring(lobby.local_active_offer_id or lobby.host_draft_session_id or "")
    end
    if sid == "" then
        return false
    end
    local target_session = multiplayer_lobby_get_session_by_id(self, sid)
    if target_session and not multiplayer_lobby_is_session_host(self, target_session) then
        return false
    end
    local removed = false
    for i = #lobby.sessions, 1, -1 do
        local entry = lobby.sessions[i]
        if entry and tostring(entry.id or "") == sid then
            table.remove(lobby.sessions, i)
            removed = true
            break
        end
    end
    if not removed then
        return false
    end
    if target_session then
        MP_SESSION_TICKET.mark_aborted(target_session)
        target_session.status = "aborted"
        target_session.lobby_status = MP_SESSION_TICKET.LOBBY_STATUS_ABORTED
    end
    if tostring(lobby.host_draft_session_id or "") == sid then
        lobby.host_draft_session_id = ""
    end
    if tostring(lobby.local_active_offer_id or "") == sid then
        lobby.local_active_offer_id = ""
    end
    lobby.offers_by_id[sid] = nil
    if self.mp_state and multiplayer_lobby_get_lobby_ticket_id(self) == sid then
        self.mp_state.lobby_ticket_id = ""
        self.mp_state.session_id = "local_session"
        multiplayer_apply_steam_lobby_wire_defaults(self)
    end
    if self.mp_state and self.mp_state.enabled then
        multiplayer_transport_broadcast_event(self, "lobby_session_closed", {
            session_id = sid
        })
    end
    multiplayer_lobby_emit_offer_remove(self, sid)
    return true
end

multiplayer_lobby_remove_player_from_session = function(self, session_id, player_id)
    multiplayer_lobby_ensure_runtime(self)
    local session = multiplayer_lobby_get_session_by_id(self, session_id)
    if not session then
        return false
    end
    if not multiplayer_lobby_is_session_host(self, session) then
        return false
    end
    local pid = mp_normalize_network_player_id(player_id)
    if pid == "" then
        return false
    end
    session.joined_player_ids = session.joined_player_ids or {}
    local removed = false
    for i = #session.joined_player_ids, 1, -1 do
        if mp_normalize_network_player_id(session.joined_player_ids[i]) == pid then
            table.remove(session.joined_player_ids, i)
            removed = true
        end
    end
    if removed then
        multiplayer_steam_release_guest_wire_seat(session, pid)
        session.updated_at_ms = get_wall_clock_ms()
        session.players = math.max(1, math.min(tonumber(session.max_players or 4) or 4, #session.joined_player_ids))
        self.mp_lobby.offers_by_id[tostring(session.id or "")] = session
        multiplayer_lobby_sync_sessions_from_offers(self)
        if self.mp_state and self.mp_state.enabled and multiplayer_lobby_is_session_host(self, session) then
            multiplayer_steam_sync_transport_peer_map(self, session)
        end
        multiplayer_lobby_emit_offer_upsert(self, session)
    end
    return removed
end

multiplayer_lobby_clear_pin_join_state = function(self)
    if not (self and self.mp_lobby) then
        return
    end
    self.mp_lobby.pin_mode = ""
    self.mp_lobby.pin_buffer = ""
    self.mp_lobby.pin_target_session_id = ""
    self.mp_lobby.pin_feedback = ""
    self.mp_lobby.pin_feedback_timer = 0
    self.mp_lobby.pending_join_pin = ""
    self.mp_lobby.pin_join_wire_timeout_timer = 0
    self.mp_lobby.pending_join_wire_sent = false
    self.mp_lobby.pending_join_wire_session_id = ""
end

multiplayer_lobby_abort_guest_join = function(self)
    if not (self and self.mp_lobby) then
        return
    end
    local lobby = self.mp_lobby
    lobby.pending_join_session_id = ""
    lobby.pending_steam_lobby_id = ""
    lobby.pending_join_wire_sent = false
    lobby.pending_join_wire_session_id = ""
    lobby.guest_setup_sync_epoch = 0
    lobby.guest_setup_sync_last_requested_epoch = 0
    multiplayer_lobby_clear_pin_join_state(self)
    multiplayer_reset_steam_wire_handshake(self)
    multiplayer_lobby_lifecycle_guest(self, MP_LOBBY_LIFECYCLE.GUEST_DISCONNECTED, {
        reason = "abort_guest_join"
    })
    if not multiplayer_lobby_is_host(self) then
        if self.mp_transport and self.mp_transport.steam_leave_lobby then
            pcall(self.mp_transport.steam_leave_lobby)
        end
    end
end

multiplayer_lobby_force_guest_disconnect = function(self, reason, target_flow, advisory_kind)
    if not (self and self.mp_state and self.mp_state.enabled and self.mp_lobby) then
        return false
    end
    if multiplayer_lobby_is_session_host(self) then
        return false
    end
    multiplayer_lobby_ensure_runtime(self)
    local lobby = self.mp_lobby
    local session_id = tostring(lobby.pending_join_session_id or "")
    if session_id == "" then
        session_id = multiplayer_lobby_get_lobby_ticket_id(self)
    end
    if session_id ~= "" and session_id ~= "local_session" then
        multiplayer_lobby_guest_prune_local_offer_membership(self, session_id)
    end
    local local_id = mp_normalize_network_player_id(self.mp_state.local_player_id or "")
    if local_id ~= "" and lobby.setup_sync_player_ids then
        lobby.setup_sync_player_ids[local_id] = nil
    end
    lobby.pending_join_session_id = ""
    lobby.pending_steam_lobby_id = ""
    lobby.pending_join_wire_sent = false
    lobby.pending_join_wire_session_id = ""
    lobby.guest_setup_sync_epoch = 0
    lobby.guest_setup_sync_last_requested_epoch = 0
    lobby.pairing_intent = "find"
    multiplayer_lobby_clear_pin_join_state(self)
    self.mp_state.lobby_ticket_id = ""
    self.mp_state.session_id = "local_session"
    multiplayer_apply_steam_lobby_wire_defaults(self)
    if self.mp_transport and self.mp_transport.steam_leave_lobby then
        pcall(self.mp_transport.steam_leave_lobby)
    end
    multiplayer_reset_steam_wire_handshake(self)
    multiplayer_lobby_lifecycle_guest(self, MP_LOBBY_LIFECYCLE.GUEST_DISCONNECTED, {
        reason = tostring(reason or "guest_disconnect")
    })
    self.multiplayer_mode_active = true
    if tostring(target_flow or "chooser") == "lobby" then
        enter_flow_state(self, FLOW_STATE_MP_LOBBY)
        if advisory_kind and advisory_kind ~= "" then
            show_mp_lobby_advisory(self, 2.4, advisory_kind)
        end
    else
        enter_flow_state(self, FLOW_STATE_MP_CHOOSER)
    end
    multiplayer_debug_log(self, string.format(
        "MP LOBBY | guest_force_disconnect reason=%s session=%s flow=%s",
        tostring(reason or ""),
        tostring(session_id or ""),
        tostring(target_flow or "chooser")
    ))
    return true
end

multiplayer_lobby_restore_pin_join_after_reject = function(self, session_id, reason)
    if not (self and self.mp_lobby) then
        return
    end
    local lobby = self.mp_lobby
    local sid = tostring(session_id or lobby.pending_join_session_id or lobby.pin_target_session_id or "")
    lobby.pending_join_session_id = ""
    if sid ~= "" then
        lobby.pin_target_session_id = sid
        lobby.pin_mode = "join_locked"
    end
    lobby.pin_buffer = ""
    lobby.pending_join_pin = ""
    lobby.pin_join_wire_timeout_timer = 0
    lobby.pending_join_wire_sent = false
    lobby.pending_join_wire_session_id = ""
    lobby.pin_feedback = "bad"
    lobby.pin_feedback_timer = 0.75
    multiplayer_debug_log(self, string.format(
        "MP LOBBY | pin_join_rejected reason=%s session=%s",
        tostring(reason or "unknown"),
        sid
    ))
end

multiplayer_lobby_update_pin_join_wire_timeout = function(self, dt)
    local lobby = self.mp_lobby
    if not lobby then
        return
    end
    local pending_id = tostring(lobby.pending_join_session_id or "")
    if pending_id == "" then
        if lobby then
            lobby.pin_join_wire_timeout_timer = 0
        end
        return
    end
    local timer = tonumber(lobby.pin_join_wire_timeout_timer or 0) or 0
    if timer <= 0 then
        return
    end
    timer = math.max(0, timer - (dt or 0))
    lobby.pin_join_wire_timeout_timer = timer
    if timer <= 0 then
        multiplayer_debug_log(self, string.format(
            "MP LOBBY | pin_join_wire_timeout session=%s",
            pending_id
        ))
        multiplayer_lobby_force_guest_disconnect(self, "join_timeout", "lobby", "try_again")
    end
end

multiplayer_lobby_submit_pin_entry = function(self)
    local lobby = self.mp_lobby
    if not lobby then
        return false
    end
    if lobby.pin_mode == "join_locked" then
        local target_session_id = tostring(lobby.pin_target_session_id or "")
        if target_session_id ~= "" and #lobby.pin_buffer == MP_LOBBY_MAX_PIN_LEN then
            lobby.pending_join_session_id = target_session_id
            lobby.pending_join_pin = lobby.pin_buffer
            lobby.pending_join_wire_sent = false
            lobby.pending_join_wire_session_id = ""
            show_mp_lobby_advisory(self, 2.0, "joining")
            multiplayer_debug_log(self, string.format(
                "MP LOBBY | pin_join_submitted session=%s pin_len=%d",
                target_session_id,
                #lobby.pin_buffer
            ))
            local steam_lobby_id = tostring(lobby.pending_steam_lobby_id or "")
            if tostring(MULTIPLAYER_TRANSPORT_MODE or "") == "steam" and steam_lobby_id ~= "" then
                lobby.pin_join_wire_timeout_timer = MP_LOBBY_PIN_JOIN_WIRE_TIMEOUT_S
                if multiplayer_lobby_complete_pending_steam_join(self) ~= true then
                    multiplayer_debug_log(self, string.format(
                        "MP LOBBY | pin_join_wire_deferred session=%s lobby=%s",
                        target_session_id,
                        steam_lobby_id
                    ))
                end
                return true
            end
            multiplayer_transport_send_command(
                self,
                "lobby_join_session",
                multiplayer_lobby_join_wire_payload(self, target_session_id, {
                    pin = lobby.pin_buffer
                }),
                self.mp_state and self.mp_state.local_player_id or "p1"
            )
            return true
        end
        lobby.pin_feedback = "bad"
        lobby.pin_feedback_timer = 0.35
        return true
    end
    if lobby.pin_mode == "host_publish_private" then
        if #lobby.pin_buffer == MP_LOBBY_MAX_PIN_LEN then
            lobby.pin_mode = ""
            lobby.pin_feedback = ""
            return multiplayer_lobby_publish_host_draft(self, lobby.pin_buffer)
        end
        lobby.pin_feedback = "bad"
        lobby.pin_feedback_timer = 0.45
        return true
    end
    local target = multiplayer_lobby_get_session_by_id(self, lobby.pin_target_session_id)
    local expected = tostring(target and target.pin or "")
    if expected ~= "" and lobby.pin_buffer == expected then
        lobby.pin_feedback = "ok"
        lobby.pin_feedback_timer = 0.35
        lobby.pin_mode = ""
        return multiplayer_lobby_enter_mp_setup_from_session(self, target)
    end
    lobby.pin_feedback = "bad"
    lobby.pin_feedback_timer = 0.45
    return true
end

multiplayer_lobby_append_pin_digit = function(self, digit, key_index)
    local lobby = self.mp_lobby
    if not lobby then
        return false
    end
    if #lobby.pin_buffer >= MP_LOBBY_MAX_PIN_LEN then
        return false
    end
    local value = tostring(digit or "")
    if value == "" then
        return false
    end
    lobby.pin_buffer = lobby.pin_buffer .. value
    lobby.pin_feedback = ""
    lobby.pin_key_flash_timers = lobby.pin_key_flash_timers or {}
    if key_index then
        lobby.pin_key_flash_timers[key_index] = 0.18
    end
    print("PIN: " .. value .. " selected")
    if #lobby.pin_buffer >= MP_LOBBY_MAX_PIN_LEN then
        return multiplayer_lobby_submit_pin_entry(self)
    end
    return true
end

multiplayer_lobby_update_pin_feedback_timer = function(self, dt)
    local lobby = self.mp_lobby
    if not lobby then
        return
    end
    if lobby.pin_feedback_timer and lobby.pin_feedback_timer > 0 then
        lobby.pin_feedback_timer = math.max(0, lobby.pin_feedback_timer - (dt or 0))
        if lobby.pin_feedback_timer <= 0 then
            lobby.pin_feedback = ""
        end
    end
    if lobby.pin_key_flash_timers then
        for i = 1, 9 do
            local t = tonumber(lobby.pin_key_flash_timers[i] or 0) or 0
            if t > 0 then
                lobby.pin_key_flash_timers[i] = math.max(0, t - (dt or 0))
            end
        end
    end
end

multiplayer_lobby_hide_non_lobby_ui = function(self, hidden)
    set_ui_square_transform(self, self.ui.flow_title_tutorial_button, -9999, -9999, FLOW_UI_BUTTON_Z, hidden, 280, 70)
    set_ui_square_transform(self, self.ui.flow_title_solo_button, -9999, -9999, FLOW_UI_BUTTON_Z, hidden, 280, 70)
    set_ui_square_transform(self, self.ui.flow_title_multiplayer_button, -9999, -9999, FLOW_UI_BUTTON_Z, hidden, 280, 70)
    set_ui_square_transform(self, self.ui.flow_title_debug_button, -9999, -9999, FLOW_UI_BUTTON_Z, hidden, TITLE_DEBUG_BUTTON_W, TITLE_DEBUG_BUTTON_H)
    set_ui_square_transform(self, self.ui.flow_outro_slide, -9999, -9999, FLOW_UI_PANEL_Z + 0.001, hidden, OUTRO_SLIDE_DEFAULT_W * 0.021, OUTRO_SLIDE_DEFAULT_H * 0.021)
    set_ui_square_transform(self, self.ui.flow_outro_ship, -9999, -9999, FLOW_UI_PANEL_Z, hidden, 280, 120)
    set_ui_square_transform(self, self.ui.flow_outro_skip_button, -9999, -9999, FLOW_UI_BUTTON_Z, hidden, 170, 52)
    set_ui_square_transform(self, self.ui.flow_outro_skip_button_art, -9999, -9999, FLOW_UI_BUTTON_Z + 0.001, hidden, 1, 1)
    set_ui_square_transform(self, self.ui.flow_score_submit_button, -9999, -9999, FLOW_UI_BUTTON_Z, hidden, 250, 56)
    set_ui_square_transform(self, self.ui.flow_score_title_button, -9999, -9999, FLOW_UI_BUTTON_Z, hidden, 250, 56)
    set_ui_square_transform(self, self.ui.flow_solo_setup_panel, -9999, -9999, SOLO_SETUP_PANEL_Z, hidden, SOLO_SETUP_PANEL_SCALE, SOLO_SETUP_PANEL_SCALE)
    set_ui_square_transform(self, self.ui.flow_solo_mission_select, -9999, -9999, SOLO_SETUP_UI_Z + 0.001, hidden, 1, 1)
    set_ui_square_transform(self, self.ui.flow_mp_setup_panel, -9999, -9999, MP_SETUP_PANEL_Z, hidden, MP_SETUP_PANEL_W * 0.021, MP_SETUP_PANEL_H * 0.021)
    if self.ui.flow_mp_mission_buttons then
        for _, btn in ipairs(self.ui.flow_mp_mission_buttons) do
            set_ui_square_transform(self, btn, -9999, -9999, MP_SETUP_UI_Z, hidden, MP_SETUP_MISSION_BTN_W * 0.021, MP_SETUP_MISSION_BTN_H * 0.021)
        end
    end
    if self.ui.flow_mp_count_buttons then
        for _, btn in ipairs(self.ui.flow_mp_count_buttons) do
            set_ui_square_transform(self, btn, -9999, -9999, MP_SETUP_UI_Z, hidden, MP_SETUP_COUNT_BTN_W * 0.021, MP_SETUP_COUNT_BTN_H * 0.021)
        end
    end
    set_ui_square_transform(self, self.ui.flow_mp_count_active_ring, -9999, -9999, MP_SETUP_UI_Z, hidden, MP_SETUP_COUNT_ACTIVE_RING_W * 0.021, MP_SETUP_COUNT_ACTIVE_RING_H * 0.021)
    set_ui_square_transform(self, self.ui.flow_mp_start_disabled_overlay, -9999, -9999, MP_SETUP_UI_Z + 0.001, hidden, MP_SETUP_ACTION_BTN_W * 0.021, MP_SETUP_ACTION_BTN_H * 0.021)
    set_ui_square_transform(self, self.ui.flow_mp_start_enabled_glow, -9999, -9999, MP_SETUP_UI_Z - 0.001, hidden, MP_SETUP_START_GLOW_W * 0.021, MP_SETUP_START_GLOW_H * 0.021)
    set_ui_square_transform(self, self.ui.flow_mp_chooser_back_art, -9999, -9999, FLOW_UI_BUTTON_Z + 0.001, hidden, 1, 1)
    set_ui_square_transform(self, self.ui.flow_mp_chooser_host_art, -9999, -9999, FLOW_UI_BUTTON_Z + 0.001, hidden, 1, 1)
    set_ui_square_transform(self, self.ui.flow_mp_chooser_find_art, -9999, -9999, FLOW_UI_BUTTON_Z + 0.001, hidden, 1, 1)
end

multiplayer_lobby_render_refresh_label = function(self, hidden)
    local letters = self.ui and self.ui.flow_mp_lobby_refresh_letters or nil
    if not letters then
        return
    end
    for _, letter_id in ipairs(letters) do
        set_ui_square_transform(self, letter_id, -9999, -9999, MP_SETUP_UI_Z + 0.004, hidden, 1, 1)
    end
    if not multiplayer_lobby_is_find_intent(self) then
        return
    end
    local text = "refresh"
    local span = (#text - 1) * MP_LOBBY_REFRESH_LABEL_SPACING
    local start_x = MP_LOBBY_REFRESH_BTN_X - (span * 0.5)
    local y = mp_lobby_y(MP_LOBBY_REFRESH_BTN_Y - 25)
    for ci = 1, #text do
        local letter_id = letters[ci]
        if not letter_id then
            break
        end
        local ch = string.sub(text, ci, ci)
        msg.post(msg.url(nil, letter_id, "sprite"), "play_animation", { id = mp_lobby_name_glyph_anim_id(ch) })
        set_ui_square_transform(
            self,
            letter_id,
            start_x + ((ci - 1) * MP_LOBBY_REFRESH_LABEL_SPACING),
            y,
            MP_SETUP_UI_Z + 0.004,
            vmath.vector4(1, 1, 1, 0.95),
            MP_LOBBY_REFRESH_LABEL_SCALE,
            MP_LOBBY_REFRESH_LABEL_SCALE
        )
    end
end

multiplayer_lobby_render_nav_and_actions = function(self, create_tint, page_btn_tint, host_info_tint, hidden)
    local boxes = self.ui and self.ui.flow_mp_lobby_boxes or nil
    if not boxes then
        return
    end
    local find_intent = multiplayer_lobby_is_find_intent(self)
    set_ui_square_transform(self, self.ui.flow_mp_back_button, -9999, -9999, MP_SETUP_UI_Z, vmath.vector4(0, 0, 0, 0), MP_SETUP_ACTION_BTN_W * 0.021, MP_SETUP_ACTION_BTN_H * 0.021)
    set_ui_square_transform(self, self.ui.flow_mp_start_button, -9999, -9999, MP_SETUP_UI_Z, vmath.vector4(0, 0, 0, 0), MP_SETUP_ACTION_BTN_W * 0.021, MP_SETUP_ACTION_BTN_H * 0.021)
    if self.ui.flow_mp_unit_buttons then
        for _, btn in ipairs(self.ui.flow_mp_unit_buttons) do
            set_ui_square_transform(self, btn, -9999, -9999, MP_SETUP_UI_Z, vmath.vector4(0, 0, 0, 0), MP_SETUP_UNIT_POOL_W * 0.021, MP_SETUP_UNIT_POOL_H * 0.021)
        end
    end
    local lobby_back_box_tint = FLOW_BUTTON_HITBOX_DEBUG_VISIBLE and vmath.vector4(0.74, 0.26, 0.26, 0) or vmath.vector4(0.74, 0.26, 0.26, 0)
    set_ui_square_transform(self, boxes[1], MP_LOBBY_BACK_BTN_X + 10, mp_lobby_y(MP_LOBBY_BACK_BTN_Y - 25), MP_SETUP_UI_Z, lobby_back_box_tint, MP_LOBBY_BACK_BTN_W, MP_LOBBY_BACK_BTN_H)
    if self.ui.flow_mp_lobby_back_button then
        set_ui_square_transform(
            self,
            self.ui.flow_mp_lobby_back_button,
            MP_LOBBY_BACK_BTN_X + 10,
            mp_lobby_y(MP_LOBBY_BACK_BTN_Y - 25),
            MP_SETUP_UI_Z + 0.004,
            vmath.vector4(1, 1, 1, 1),
            1,
            MP_LOBBY_BACK_BTN_H * 0.021
        )
    end
    if find_intent then
        set_ui_square_transform(self, boxes[2], MP_LOBBY_REFRESH_BTN_X, mp_lobby_y(MP_LOBBY_REFRESH_BTN_Y - 25), MP_SETUP_UI_Z, create_tint, MP_LOBBY_REFRESH_BTN_W, MP_LOBBY_REFRESH_BTN_H)
    else
        set_ui_square_transform(self, boxes[2], -9999, -9999, MP_SETUP_UI_Z, vmath.vector4(0, 0, 0, 0), MP_LOBBY_CREATE_BTN_W, MP_LOBBY_CREATE_BTN_H)
    end
    multiplayer_lobby_render_refresh_label(self, hidden or vmath.vector4(0, 0, 0, 0))
    set_ui_square_transform(self, boxes[3], MP_LOBBY_PAGE_LEFT_X, mp_lobby_y(MP_LOBBY_HOST_OPEN_BTN_Y), MP_SETUP_UI_Z, page_btn_tint, MP_LOBBY_PAGE_BTN_W, MP_LOBBY_PAGE_BTN_H)
    set_ui_square_transform(self, boxes[4], MP_LOBBY_PAGE_RIGHT_X, mp_lobby_y(MP_LOBBY_HOST_OPEN_BTN_Y), MP_SETUP_UI_Z, page_btn_tint, MP_LOBBY_PAGE_BTN_W, MP_LOBBY_PAGE_BTN_H)
    set_ui_square_transform(self, boxes[5], MP_LOBBY_PAGE_LABEL_X, mp_lobby_y(MP_LOBBY_PAGE_LABEL_Y), MP_SETUP_UI_Z, vmath.vector4(0, 0, 0, 0), MP_LOBBY_PAGE_LABEL_W, MP_LOBBY_PAGE_LABEL_H)
    set_ui_square_transform(self, boxes[6], MP_LOBBY_HOST_INFO_X, mp_lobby_y(MP_LOBBY_HOST_INFO_Y), MP_SETUP_UI_Z, host_info_tint, MP_LOBBY_HOST_INFO_W, MP_LOBBY_HOST_INFO_H)
    local host_btn_hit_tint = FLOW_BUTTON_HITBOX_DEBUG_VISIBLE and vmath.vector4(0.12, 0.7, 0.34, 0.35) or vmath.vector4(0, 0, 0, 0)
    local host_private_hit_tint = FLOW_BUTTON_HITBOX_DEBUG_VISIBLE and vmath.vector4(0.72, 0.44, 0.16, 0.35) or vmath.vector4(0, 0, 0, 0)
    if find_intent then
        set_ui_square_transform(self, boxes[7], -9999, -9999, MP_SETUP_UI_Z, vmath.vector4(0, 0, 0, 0), 1, 1)
        set_ui_square_transform(self, boxes[8], -9999, -9999, MP_SETUP_UI_Z, vmath.vector4(0, 0, 0, 0), 1, 1)
    else
        set_ui_square_transform(self, boxes[7], MP_LOBBY_HOST_OPEN_BTN_X, mp_lobby_y(MP_LOBBY_HOST_OPEN_BTN_Y), MP_SETUP_UI_Z, host_btn_hit_tint, MP_LOBBY_HOST_ACTION_W, MP_LOBBY_HOST_ACTION_H)
        set_ui_square_transform(self, boxes[8], MP_LOBBY_HOST_PRIVATE_BTN_X, mp_lobby_y(MP_LOBBY_HOST_PRIVATE_BTN_Y), MP_SETUP_UI_Z, host_private_hit_tint, MP_LOBBY_HOST_ACTION_W, MP_LOBBY_HOST_ACTION_H)
    end
end

multiplayer_lobby_render_session_cards = function(self, visible_sessions, card_bg, open_bg, locked_bg, empty_bg)
    if not self.ui.flow_mp_lobby_cards then
        return
    end
    local session_index = 1
    local letter_cursor = 1
    local count_cursor = 1
    if self.ui.flow_mp_lobby_name_letters then
        for _, letter_id in ipairs(self.ui.flow_mp_lobby_name_letters) do
            set_ui_square_transform(self, letter_id, -9999, -9999, MP_SETUP_UI_Z + 0.004, vmath.vector4(0, 0, 0, 0), 1, 1)
        end
    end
    if self.ui.flow_mp_lobby_count_digits then
        for _, digit_id in ipairs(self.ui.flow_mp_lobby_count_digits) do
            set_ui_square_transform(self, digit_id, -9999, -9999, MP_SETUP_UI_Z + 0.004, vmath.vector4(0, 0, 0, 0), 1, 1)
        end
    end
    for row = 1, 2 do
        for col = 1, 4 do
            local card_x = MP_LOBBY_CARD_COL_X[col]
            local card_y = mp_lobby_y(MP_LOBBY_CARD_ROW_Y[row])
            local session = visible_sessions[session_index]
            local card_id = self.ui.flow_mp_lobby_cards[session_index]
            local strip_id = self.ui.flow_mp_lobby_status_strips and self.ui.flow_mp_lobby_status_strips[session_index] or nil
            if card_id then
                local tint = empty_bg
                if session then
                    tint = session.is_locked and locked_bg or open_bg
                end
                set_ui_square_transform(self, card_id, card_x, card_y, MP_SETUP_UI_Z + 0.002, vmath.vector4(0, 0, 0, 0), MP_LOBBY_CARD_W, MP_LOBBY_CARD_H)
                if strip_id then
                    set_ui_square_transform(self, strip_id, card_x, card_y - 52, MP_SETUP_UI_Z + 0.003, tint, MP_LOBBY_CARD_W - 34, 56)
                end
                local count_text = nil
                if session and self.ui.flow_mp_lobby_count_digits then
                    local joined_count = type(session.joined_player_ids) == "table" and #session.joined_player_ids or 0
                    local players = math.max(1, tonumber(session.players or 0) or 0, joined_count)
                    local max_players = math.max(2, tonumber(session.max_players or 4) or 4)
                    count_text = string.format("%d/%d", players, max_players)
                    if #count_text > MP_LOBBY_COUNT_MAX_CHARS then
                        count_text = string.sub(count_text, 1, MP_LOBBY_COUNT_MAX_CHARS)
                    end
                end
                if session and self.ui.flow_mp_lobby_name_letters then
                    local name_text = mp_lobby_sanitize_name(session.host_display_name or session.host_name or "host")
                    local name_len = #name_text
                    if name_len > 0 then
                        local name_span = (name_len - 1) * MP_LOBBY_NAME_LETTER_SPACING
                        local count_len = count_text and #count_text or 0
                        local count_span = count_len > 0 and ((count_len - 1) * MP_LOBBY_COUNT_SPACING) or 0
                        local total_span = name_span
                        if count_len > 0 then
                            total_span = total_span + MP_LOBBY_COUNT_NAME_GAP + count_span
                        end
                        local start_x = card_x - (total_span * 0.5)
                        local name_y = card_y + MP_LOBBY_NAME_BASE_Y_OFFSET
                        for ci = 1, name_len do
                            local glyph_id = self.ui.flow_mp_lobby_name_letters[letter_cursor]
                            if not glyph_id then
                                break
                            end
                            local ch = string.sub(name_text, ci, ci)
                            msg.post(msg.url(nil, glyph_id, "sprite"), "play_animation", { id = mp_lobby_name_glyph_anim_id(ch) })
                            set_ui_square_transform(
                                self,
                                glyph_id,
                                start_x + ((ci - 1) * MP_LOBBY_NAME_LETTER_SPACING),
                                name_y,
                                MP_SETUP_UI_Z + 0.004,
                                vmath.vector4(1, 1, 1, 0.95),
                                MP_LOBBY_NAME_SCALE,
                                MP_LOBBY_NAME_SCALE
                            )
                            letter_cursor = letter_cursor + 1
                        end
                        if count_len > 0 then
                            local count_start_x = start_x + name_span + MP_LOBBY_COUNT_NAME_GAP
                            for ci = 1, count_len do
                                local digit_id = self.ui.flow_mp_lobby_count_digits[count_cursor]
                                if not digit_id then
                                    break
                                end
                                local ch = string.sub(count_text, ci, ci)
                                msg.post(msg.url(nil, digit_id, "sprite"), "play_animation", { id = mp_lobby_count_glyph_anim_id(ch) })
                                set_ui_square_transform(
                                    self,
                                    digit_id,
                                    count_start_x + ((ci - 1) * MP_LOBBY_COUNT_SPACING),
                                    name_y,
                                    MP_SETUP_UI_Z + 0.004,
                                    vmath.vector4(1, 1, 1, 0.9),
                                    MP_LOBBY_COUNT_SCALE,
                                    MP_LOBBY_COUNT_SCALE
                                )
                                count_cursor = count_cursor + 1
                            end
                        end
                    end
                end
            end
            session_index = session_index + 1
        end
    end
end

multiplayer_lobby_render_host_publish_buttons = function(self, host_open_tint, host_private_tint, hidden)
    local art_tint = vmath.vector4(1, 1, 1, 1)
    if multiplayer_lobby_is_find_intent(self) then
        if self.ui.flow_mp_lobby_host_public_art then
            set_ui_square_transform(self, self.ui.flow_mp_lobby_host_public_art, -9999, -9999, MP_LOBBY_HOST_ACTION_ART_Z, hidden, 1, 1)
        end
        if self.ui.flow_mp_lobby_host_private_art then
            set_ui_square_transform(self, self.ui.flow_mp_lobby_host_private_art, -9999, -9999, MP_LOBBY_HOST_ACTION_ART_Z, hidden, 1, 1)
        end
    else
        if self.ui.flow_mp_lobby_host_public_art then
            set_ui_square_transform(
                self,
                self.ui.flow_mp_lobby_host_public_art,
                MP_LOBBY_HOST_OPEN_BTN_X,
                mp_lobby_y(MP_LOBBY_HOST_OPEN_BTN_Y),
                MP_LOBBY_HOST_ACTION_ART_Z,
                art_tint,
                1,
                1
            )
        end
        if self.ui.flow_mp_lobby_host_private_art then
            set_ui_square_transform(
                self,
                self.ui.flow_mp_lobby_host_private_art,
                MP_LOBBY_HOST_PRIVATE_BTN_X,
                mp_lobby_y(MP_LOBBY_HOST_PRIVATE_BTN_Y),
                MP_LOBBY_HOST_ACTION_ART_Z,
                art_tint,
                1,
                1
            )
        end
    end
    if self.ui.flow_score_rows then
        for i = 1, #self.ui.flow_score_rows do
            set_ui_square_transform(self, self.ui.flow_score_rows[i], -9999, -9999, FLOW_UI_PANEL_Z, hidden, 300, 28)
        end
